# Database
DB_HOST=your_railway_mysql_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=arabella_paper

# Session
SESSION_SECRET=your_super_secret_key_here

# First admin — created on first boot only, when no users exist yet.
# Leave ADMIN_PASSWORD unset and no account is created.
ADMIN_EMAIL=admin@arabella.com
ADMIN_PASSWORD=set_a_strong_password_here

# Google Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=akhileshvyas@reactwebappav.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
DRIVE_FOLDER_ID=YOUR_DRIVE_FOLDER_ID_HERE

# App
PORT=3000
NODE_ENV=production

# Email — designer assignment notices.
# Leave SMTP_PASS blank and mail is simply off; nothing else changes.
# Google Workspace needs a 16-character App Password, not the login password:
# myaccount.google.com > Security > 2-Step Verification > App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mis@arabellapapers.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="Arabella Papers <mis@arabellapapers.com>"

# Used for the "Open the dashboard" link inside those emails.
APP_URL=https://mis.arabellapapers.com
