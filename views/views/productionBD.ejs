<%# Production Dashboard. Rendered a second time as Old Production, where the
    same board shows the orders from before the August cutoff. %>
<div id="prodRoot"></div>
<script>
var PROD_ARCHIVE = <%= archive ? 'true' : 'false' %>;
document.getElementById('prodRoot').innerHTML = `
<div class="container-fluid py-4">
  ${PROD_ARCHIVE ? `
  <div class="d-flex align-items-center gap-2 mb-2">
    <h4 class="mb-0 text-dark fw-bold"><i class="fas fa-box-archive me-2"></i>Old Production</h4>
  </div>
  <div class="alert alert-secondary py-2 px-3 small mb-3">
    Every order that reached production <b>before 1 August 2026</b>, dispatched ones included.
    This is the record of what came through &mdash; the Production Dashboard shows what is still to do.
  </div>` : ''}
  <div class="d-flex gap-2 mb-3">
    <button class="btn btn-primary smooth-ui" onclick="prod_openBulkModal()"><i class="fas fa-industry me-1"></i> Bulk Stage Update</button>
    <button class="btn ${PROD_ARCHIVE ? 'btn-outline-primary' : 'btn-outline-warning'} smooth-ui" onclick="prod_moveBoards()"><i class="fas ${PROD_ARCHIVE ? 'fa-rotate-left' : 'fa-box-archive'} me-1"></i> ${PROD_ARCHIVE ? 'Move back to Production' : 'Move to Old Production'}</button>
    <button class="btn btn-outline-dark smooth-ui text-dark" onclick="refreshBoard(this, fetchProductionData, 'orders')"><i class="fas fa-sync-alt me-1"></i> Refresh</button>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="card shadow smooth-ui kpi-card" style="border-left:4px solid #ffc107;"><div class="card-body p-3"><h6 class="text-muted mb-1 small">${PROD_ARCHIVE ? 'Old Production Orders' : 'Production Orders'}</h6><h3 class="fw-bold text-warning mb-0" id="prod_boardCount">--</h3></div></div></div>
    ${PROD_ARCHIVE ? '' : `<div class="col-6 col-md-3"><div class="card shadow smooth-ui kpi-card" style="border-left:4px solid #198754;"><div class="card-body p-3"><h6 class="text-muted mb-1 small">Sent to Dispatch</h6><h3 class="fw-bold text-success mb-0" id="prod_dispatchedCount">--</h3></div></div></div>`}
  </div>
  <div class="card bg-light-glass mb-4 shadow-sm">
    <button class="filter-toggle-btn btn-sm py-1 px-3 w-100 d-flex justify-content-between align-items-center rounded" type="button" data-bs-toggle="collapse" data-bs-target="#prodFilterContent">
      <span class="text-dark p-2 fw-bold"><i class="fas fa-filter me-2"></i> Filters & Search</span>
      <i class="fas fa-chevron-down text-dark"></i>
    </button>
    <div id="prodFilterContent" class="collapse">
      <div class="card-body p-2">
        <div class="row g-2 align-items-end">
          <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">Start</label><input type="date" id="prod_startDate" class="form-control form-control-sm" onchange="prodApplyFilters()"></div>
          <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">End</label><input type="date" id="prod_endDate" class="form-control form-control-sm" onchange="prodApplyFilters()"></div>
          <div class="col-12 col-md-3"><label class="form-label text-dark fw-bold small mb-0">Search</label><input type="text" id="prod_search" class="form-control form-control-sm" placeholder="ID, Dealer, Designer..." onkeyup="prodApplyFilters()"></div>
          <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">Client Name</label><select id="prod_filterClient" class="form-select form-select-sm" onchange="prodApplyFilters()"><option value="">All Clients</option></select></div>
          <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">Designer</label><select id="prod_filterDesigner" class="form-select form-select-sm" onchange="prodApplyFilters()"><option value="">All Designers</option></select></div>
          <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">Overall Status</label><select id="prod_filterStatus" class="form-select form-select-sm" onchange="prodApplyFilters()"><option value="">All</option><optgroup label="Production Status"><option value="Pending">Pending</option><option value="In Progress">In Progress</option><option value="Completed">Completed</option></optgroup><optgroup label="Order Type"><option value="Reorder">Re-order</option><option value="Reprint">Re-print</option><option value="Sample">Sampling</option></optgroup></select></div>
          <div class="col-6 col-md-2"><button class="btn btn-secondary btn-sm w-100" onclick="prodClearFilters()">Clear</button></div>
        </div>
      </div>
    </div>
  </div>
  <div class="card bg-light-glass shadow-lg">
    <div class="card-header bg-transparent border-0"><h5 class="mb-0 text-dark fw-bold"><i class="fas fa-tools me-2"></i>Orders in ${PROD_ARCHIVE ? 'Old Production' : 'Production'} Queue</h5></div>
    <div class="card-body p-0">
      <div class="table-responsive" data-fill-height style="overflow-y:auto;position:relative;">
        <table class="table table-hover table-striped mb-0 text-nowrap" style="border-collapse:separate;border-spacing:0;">
          <thead class="table-dark">
            <tr>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;"><input type="checkbox" id="prod_selectAll" onclick="prodToggleSelectAll(this)"></th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">#</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Action</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Dispatch</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">ID</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Production Date</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Dealer</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Client</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Designer</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Client Approval</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;">Dye Status</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;">Block Status</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;">Laser</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;">Output</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Production Stages</th>
            </tr>
          </thead>
          <tbody id="prod_tbody"><tr><td colspan="15" class="text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="prod_viewModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title fw-bold">Order Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="prod_viewBody"></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div>

<!-- Edit Modal -->
<div class="modal fade" id="prod_editModal" tabindex="-1">
  <div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header bg-warning text-dark"><h5 class="modal-title">Update Production: <span id="prod_editId"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <div class="row g-3 mb-3">
        <div class="col-md-4"><label class="small fw-bold">Guest Name</label><select class="form-select" name="Guest_Name"><option value="Pending">Pending</option><option value="No">No GNA</option><option value="GNA Pending">GNA Pending</option><option value="Received">GNA Received</option><option value="Printed">GNA Printed</option></select></div>
        <div class="col-md-4"><label class="small fw-bold">Paper Cutting</label><select class="form-select" name="Paper_Cutting"><option value="Pending">Pending</option><option value="Done">Done</option><option value="Temporary Out of Stock">Temporary Out of Stock</option><option value="Permanent Out of Stock">Permanent Out of Stock</option></select></div>
        <div class="col-md-4"><label class="small fw-bold">Dye Status</label><select class="form-select" name="Dye_Status"><option value="Pending">Pending</option><option value="NO DIE">NO DIE</option><option value="DIE NOT RECEIVED">DIE NOT RECEIVED</option><option value="DIE CUTTING DONE">DIE CUTTING DONE</option><option value="DIE SENT">DIE SENT</option></select></div>
        <div class="col-md-4"><label class="small fw-bold">Block Status</label><select class="form-select" name="Block_Status"><option value="Pending">Pending</option><option value="NO BLOCK">NO BLOCK</option><option value="BLOCK NOT RECEIVED">BLOCK NOT RECEIVED</option><option value="BLOCK PRINTED">BLOCK PRINTED</option><option value="BLOCK SENT">BLOCK SENT</option></select></div>
        <div class="col-md-4"><label class="small fw-bold">Printing</label><select class="form-select" name="Printing"><option value="Pending">Pending</option><option value="Done">Done</option></select></div><div class="col-md-4"><label class="small fw-bold">Printing Type</label><select class="form-select" name="Printing_Type"><option value="">Not set</option><option value="Bell Press">Bell Press</option><option value="UV">UV</option><option value="Thermography">Thermography</option><option value="Letterpress">Letterpress</option><option value="Foil Emboss">Foil Emboss</option><option value="Deboss">Deboss</option><option value="Engraved Letterpress">Engraved Letterpress</option><option value="Digital">Digital</option></select></div>
        <div class="col-md-4"><label class="small fw-bold">Edges</label><select class="form-select" name="Edges"><option value="Pending" selected>Pending</option><option value="No">No</option><option value="Done">Done</option></select></div>
        <div class="col-md-4"><label class="small fw-bold">Laser Cutting</label><select class="form-select" name="Laser_Cutting"><option value="Pending">Pending</option><option value="Done">Done</option><option value="No">No</option></select></div>
        <div class="col-md-4"><label class="small fw-bold">Output</label><select class="form-select" name="Output"><option value="Pending">Pending</option><option value="Done">Done</option><option value="No">No</option></select></div>
        <div class="col-md-12"><label class="small fw-bold text-success">Card Assembly (Final)</label><select class="form-select border-success" name="Card_Assembly"><option value="Pending">Pending</option><option value="Done">Done</option></select></div>
      </div>
      <div class="mb-3"><label class="form-label fw-bold">Remark</label><textarea class="form-control" name="Remark" rows="2"></textarea></div>
      <div class="mb-3"><label class="form-label fw-bold">Reason For Delay</label><textarea class="form-control" name="Reason_For_Delay" rows="2"></textarea></div>
    </div>
    <div class="modal-footer"><button class="btn btn-primary" id="prod_editDispatchBtn" onclick="prod_dispatchFromEdit()"><i class="fas fa-paper-plane me-1"></i> Send to Dispatch</button><button class="btn btn-success" onclick="prod_submitUpdate()"><i class="fas fa-save me-1"></i> Save</button><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button></div>
  </div></div>
</div>

<!-- Bulk Modal -->
<div class="modal fade" id="prod_bulkModal" tabindex="-1">
  <div class="modal-dialog modal-xl"><div class="modal-content">
    <div class="modal-header bg-primary text-white"><h5 class="modal-title">Bulk Production Update</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body p-0"><div class="table-responsive" style="max-height:500px;"><table class="table table-bordered align-middle mb-0"><thead class="sticky-top"><tr><th style="background:#fff;color:#000;">ID</th><th style="background:#fff;color:#000;">Guest</th><th style="background:#fff;color:#000;">Paper</th><th style="background:#fff;color:#000;">Dye</th><th style="background:#fff;color:#000;">Block</th><th style="background:#fff;color:#000;">Print</th><th style="background:#fff;color:#000;">Print Type</th><th style="background:#fff;color:#000;">Edges</th><th style="background:#fff;color:#000;">Laser</th><th style="background:#fff;color:#000;">Output</th><th style="background:#fff;color:#000;">Assembly</th></tr></thead><tbody id="prod_bulkBody" class="bg-white"></tbody></table></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="prod_btnBulk" onclick="prod_submitBulk()"><i class="fas fa-save me-1"></i> Update Selected</button></div>
  </div></div>
</div>
`;

var prod_data = [], prod_filtered = [], prod_selected = new Set(), prod_editId = null;
// var, not const: loadPage() re-runs this whole block every time the tab is
// opened, and a repeat `const` is a parse error that kills the script before it
// can fill #prodRoot — leaving the page blank until a full reload.
var PROD_COLS = ['Guest_Name','Paper_Cutting','Dye_Status','Block_Status','Printing','Printing_Type','Edges','Laser_Cutting','Output','Card_Assembly','Remark','Reason_For_Delay'];

async function fetchProductionData() {
  try {
    const res = await fetch('/api/dashboards/production' + (PROD_ARCHIVE ? '?scope=old' : ''));
    const json = await res.json();
    prod_data = json.data || [];
    // Just what is on this board. There was a second card counting everything
    // that had ever reached production, dispatched orders included, and next to
    // a hundred-row table that number only ever got read as the board being
    // wrong.
    const bc = document.getElementById('prod_boardCount');
    if(bc) bc.textContent = prod_data.length;
    // Same date range as the rows, so the two add up to what August took in.
    // "Sent to", not "Dispatched": an order marked Ready has left the queue but
    // has not gone anywhere yet, and it is counted here.
    const dc = document.getElementById('prod_dispatchedCount');
    if(dc) dc.textContent = json.dispatchedCount != null ? json.dispatchedCount : '--';
    prod_populateFilters(prod_data);
    prodApplyFilters();
    prod_attachScroll();
    return prod_data.length;
  } catch(e) { console.error(e); throw e; }
}
fetchProductionData().catch(() => {});

function prod_populateFilters(data) {
  const designers = new Set(), clients = new Set();
  data.forEach(o => { if(o.Designer) designers.add(o.Designer); if(o.Client_name) clients.add(o.Client_name); });
  prod_fillSelect('prod_filterDesigner', designers);
  prod_fillSelect('prod_filterClient', clients);
}
function prod_fillSelect(id, set) {
  const s = document.getElementById(id); if(!s) return;
  const cur = s.value; s.innerHTML = `<option value="">All</option>`;
  Array.from(set).sort().forEach(v => { const o = document.createElement('option'); o.value=v; o.textContent=v; s.appendChild(o); });
  s.value = cur;
}
// What the client approval column holds when the row is a kind of job rather
// than a stage of one. The filter has to compare against the column instead of
// the production progress for these.
var PROD_ORDER_KINDS = ['Reorder', 'Reprint', 'Sample'];
function prodApplyFilters() {
  const status = (document.getElementById('prod_filterStatus')||{}).value||'';
  const designer = (document.getElementById('prod_filterDesigner')||{}).value||'';
  const client = (document.getElementById('prod_filterClient')||{}).value||'';
  const search = (document.getElementById('prod_search')||{}).value||'';
  // The two date boxes have been sitting here since the board was written
  // without anything reading them - whatever you picked, the queue never
  // moved. They narrow by the date the order was punched, the same as the
  // Orders dashboard.
  const startV = (document.getElementById('prod_startDate')||{}).value||'';
  const endV = (document.getElementById('prod_endDate')||{}).value||'';

  prod_filtered = prod_data.filter(o => {
    if(!o) return false;
    let dm = true;
    if(startV || endV) {
      // Filter on the same date the column shows, or picking a day would
      // hide rows that are plainly in range.
      const od = parseDMY(o.Production_Date);
      if(od) {
        const s = dayStart(startV), e = dayEnd(endV);
        if(s && od < s) dm = false;
        if(e && od > e) dm = false;
      } else dm = false;
    }
    if(!dm) return false;
    const isCompleted = (o.Card_Assembly||'').toLowerCase().includes('done');
    let curStatus = 'Pending';
    if(isCompleted) curStatus = 'Completed';
    else {
      const steps = [o.Guest_Name,o.Paper_Cutting,o.Dye_Status,o.Block_Status,o.Printing,o.Edges,o.Laser_Cutting,o.Output];
      if(steps.some(v => v && !['pending','no','not done','','dye status','block status'].includes((v||'').toLowerCase().trim()))) curStatus = 'In Progress';
    }
    // Pending / In Progress / Completed say how far production has got.
    // Re-order, Re-print and Sampling say what kind of job it is, which is
    // not a stage at all - it is what the client approval column was set to.
    const kind = (o.Design_Approval_Status_From_Client||'').trim().toLowerCase();
    const statusMatch = !status
      || (PROD_ORDER_KINDS.includes(status)
            ? kind === status.toLowerCase()
            : curStatus === status);

    return statusMatch &&
      (!designer || (o.Designer||'').toLowerCase() === designer.toLowerCase()) &&
      (!client || (o.Client_name||'').toLowerCase() === client.toLowerCase()) &&
      (!search || JSON.stringify(o).toLowerCase().includes(search.toLowerCase()));
  });
  prod_renderTable(prod_filtered);
}
function prodClearFilters() {
  ['prod_filterStatus','prod_filterDesigner','prod_filterClient','prod_search','prod_startDate','prod_endDate'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  prodApplyFilters();
}
// Building 5000 rows in one go froze the browser for about a second and a half
// every time this tab opened. Rows go in a batch at a time now, with more added
// as the table is scrolled - the same thing the Orders Dashboard does.
var PROD_BATCH = 50;
var prod_shown = 0, prod_display = [];

function prod_renderTable(data) {
  const tbody = document.getElementById('prod_tbody');
  if(!tbody) return;
  prod_display = data;
  prod_shown = 0;
  tbody.innerHTML = '';
  if(!data.length) { tbody.innerHTML = '<tr><td colspan="14" class="text-center">No orders found.</td></tr>'; return; }
  prod_renderNextBatch();
}

function prod_renderNextBatch() {
  if(prod_shown >= prod_display.length) return;
  const tbody = document.getElementById('prod_tbody');
  if(!tbody) return;
  const batch = prod_display.slice(prod_shown, prod_shown + PROD_BATCH);
  tbody.insertAdjacentHTML('beforeend', batch.map((o, i) => prod_rowHtml(o, prod_shown + i + 1)).join(''));
  prod_shown += batch.length;
}

function prod_rowHtml(o, sr) {
  {
    const isChecked = prod_selected.has(o.ID.toString()) ? 'checked' : '';
    const readyBtn = prod_readyCell(o);
    const badges = prod_getStageBadges(o);
    const clientBadge = prod_getClientBadge(o.Design_Approval_Status_From_Client);
    return `<tr>
      <td><input type="checkbox" class="prod_checkbox" value="${o.ID}" ${isChecked} onchange="prod_handleCheck('${o.ID}',this.checked)"></td>
      <td>${sr}</td>
      <td><div class="d-flex gap-1"><button class="btn btn-sm btn-info" onclick="prod_openView('${o.ID}')"><i class="fas fa-eye text-white"></i></button><button class="btn btn-sm btn-warning" onclick="prod_openEdit('${o.ID}')"><i class="fas fa-edit text-dark"></i></button></div></td>
      <td class="text-center">${readyBtn}</td>
      <td class="fw-bold">${o.ID}</td>
      <td class="text-primary fw-bold">${o.Production_Date||''}</td>
      <td>${o.Dealer_name||''}</td>
      <td>${o.Client_name||''}</td>
      <td><small class="text-muted">${o.Designer||''}</small></td>
      <td>${clientBadge}</td>
      <td>${o.Dye_Status||'-'}</td>
      <td>${o.Block_Status||'-'}</td>
      <td>${o.Laser_Cutting||'-'}</td>
      <td>${o.Output||'-'}</td>
      <td>${badges}</td>
    </tr>`;
  }
}

// The table body scrolls inside .table-responsive, so that is what tells us the
// reader has reached the end of what has been drawn.
function prod_attachScroll() {
  const box = document.querySelector('#prodRoot [data-fill-height]');
  if(!box || box.dataset.lazy) return;
  box.dataset.lazy = '1';
  box.addEventListener('scroll', function() {
    if(box.scrollTop + box.clientHeight >= box.scrollHeight - 150) prod_renderNextBatch();
  });
}
function prod_getClientBadge(s) {
  if(!s) return '';
  const l = s.toLowerCase();
  let c='secondary';
  if(l.includes('final')) c='success';
  else if(l.includes('modification')) c='warning';
  else if(l.includes('reorder')) c='primary';
  else if(l.includes('reprint')) c='info';
  return `<span class="badge rounded-pill bg-${c}">${s}</span>`;
}
// One source of truth for "is this stage finished?" — the badge row, the
// pending-stage hint and the Ready for Dispatch button all read from here, so
// a stage can never count as done in one place and pending in another.
function prod_stageCfg(o) {
  const v = k => (o[k]||'').toString().trim().toLowerCase();
  return [
    {val:v('Guest_Name'), ok:['no','no gna','printed','gna printed'], label:'GNA'},
    {val:v('Paper_Cutting'), ok:['done'], label:'Paper'},
    {val:v('Dye_Status'), ok:['no die','die cutting done','die sent'], label:'Dye'},
    {val:v('Block_Status'), ok:['no block','block printed','block sent'], label:'Block'},
    {val:v('Printing'), ok:['done'], label:'Print'},
    {val:v('Edges'), ok:['no','done'], label:'Edges'},
    {val:v('Laser_Cutting'), ok:['no','done'], label:'Laser'},
    {val:v('Output'), ok:['no','done'], label:'Output'},
    {val:v('Card_Assembly'), ok:['done'], label:'Assembly'},
  ];
}
// Every stage, every row - green for done, red for not. Only the finished
// ones used to be drawn, so a row with three badges could mean six stages
// outstanding or two, and the reader had to remember the full list to tell.
function prod_getStageBadges(o) {
  return prod_stageCfg(o).map(i => {
    const done = i.ok.includes(i.val);
    const title = (i.val || 'not set').replace(/"/g, '&quot;');
    return `<span class="badge bg-${done?'success':'danger'} me-1 mb-1" title="${i.label}: ${title}">${i.label}</span>`;
  }).join('');
}
function prod_pendingStages(o) {
  return prod_stageCfg(o).filter(i => !i.ok.includes(i.val)).map(i => i.label);
}
function prod_readyCell(o) {
  if(o.Dispatch_Status && o.Dispatch_Status.trim()) return `<span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Sent to Dispatch</span>`;
  const pending = prod_pendingStages(o);
  if(!pending.length) return `<button class="btn btn-sm btn-success fw-bold shadow-sm" onclick="prod_markDispatch('${o.ID}')"><i class="fas fa-paper-plane me-1"></i>Ready for Dispatch</button>`;
  return `<span class="badge bg-secondary" title="Still pending: ${pending.join(', ')}"><i class="fas fa-clock me-1"></i>${pending.length} stage${pending.length>1?'s':''} left</span>`;
}
async function prod_openView(orderId) {
  const body = document.getElementById('prod_viewBody');
  body.innerHTML = '<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</div>';
  new bootstrap.Modal(document.getElementById('prod_viewModal')).show();

  // The queue no longer ships every field for every order; this fetches the one
  // being opened.
  let rowData;
  try {
    const res = await fetch('/api/dashboards/order-details/' + encodeURIComponent(orderId));
    const json = await res.json();
    if (!json.success) throw new Error();
    rowData = json.rowData;
  } catch (e) {
    body.innerHTML = '<div class="alert alert-danger m-3">Could not load this order. Please try again.</div>';
    return;
  }

  const linkKeys = ['Upload the one Design file','Upload Design','Revision Design Upload','Approved Design'];
  let html = '<div class="row">';
  for(const key in rowData) {
    let val = rowData[key]; if(!val||val.toString().trim()==='') continue;
    let isLink = false;
    if((linkKeys.includes(key)||key.toLowerCase().includes('upload'))&&val.toString().includes('http')) {
      val = val.toString().split(/[\n,]+/).map(l => l.trim().startsWith('http')?`<a href="${l.trim()}" target="_blank" class="btn btn-sm btn-outline-primary m-1"><i class="fas fa-external-link-alt me-1"></i>View File</a>`:'').join(''); isLink=true;
    }
    const col = key.toLowerCase().includes('remark')||key.length>50?'col-12':'col-md-6';
    html += `<div class="${col} view-item"><span class="view-label">${key}</span><div class="${isLink?'':'view-value'}">${val}</div></div>`;
  }
  body.innerHTML = html+'</div>';
}
// A stage nobody has touched is Pending. Dye and Block used to open on their
// own label - "Dye Status", "Block Status" - which is placeholder text, not a
// state, and 377 imported rows carry it as their value. Read those as Pending.
function prod_stageValue(raw) {
  const v = (raw || '').trim();
  return (v === '' || /^(dye|block) status$/i.test(v)) ? 'Pending' : v;
}

// The sheet used wordings these dropdowns never offered - "No Dye" on 1758
// orders, "No Block" on 1885, "No Guest List" on 1758. Setting a value a
// select does not have leaves it blank, and saving then wrote that blank back
// over a real answer. Give the box the option it is missing instead.
// Printing Type is not a stage: an empty one means nobody has said which
// press was used, not that the work is Pending. Everything else keeps the
// stage reading.
var PROD_NOT_A_STAGE = ['Printing_Type'];

function prod_setSelect(sel, raw, plain) {
  const v = plain ? String(raw || '').trim() : prod_stageValue(raw);
  if(v && !Array.prototype.some.call(sel.options, o => o.value === v)) {
    const opt = document.createElement('option');
    opt.value = v; opt.textContent = v;
    sel.appendChild(opt);
  }
  sel.value = v;
}

function prod_openEdit(id) {
  prod_editId = id;
  const o = prod_data.find(x => x.ID.toString()===id.toString());
  document.getElementById('prod_editId').textContent = id;
  const modal = document.getElementById('prod_editModal');
  PROD_COLS.forEach(col => {
    const input = modal.querySelector(`[name="${col}"]`);
    if(!input) return;
    if(input.tagName === 'SELECT') prod_setSelect(input, o && o[col], PROD_NOT_A_STAGE.indexOf(col) >= 0);
    else input.value = (o && o[col]) || '';
  });

  // An order that has already gone has nowhere left to be sent.
  const gone = !!(o && o.Dispatch_Status && o.Dispatch_Status.trim());
  document.getElementById('prod_editDispatchBtn').classList.toggle('d-none', gone);

  new bootstrap.Modal(modal).show();
}
// Whatever the modal currently shows, written back. Returns false if it did
// not save, so callers can stop rather than carry on with stale stages.
async function prod_saveEdit() {
  const modal = document.getElementById('prod_editModal');
  const updateData = { userEmail: APP_USER.email };
  PROD_COLS.forEach(col => {
    const input = modal.querySelector(`[name="${col}"]`);
    if(input) updateData[col] = input.value;
  });
  try {
    const res = await fetch(`/api/dashboards/production/${prod_editId}`, {method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(updateData)});
    const json = await res.json();
    if(json.success) return true;
    showToast('error', json.error);
    return false;
  } catch(e) { showToast('error','Server error.'); return false; }
}

async function prod_submitUpdate() {
  showLoading(true);
  const saved = await prod_saveEdit();
  showLoading(false);
  if(!saved) return;
  bootstrap.Modal.getInstance(document.getElementById('prod_editModal')).hide();
  showToast('success','Updated!');
  fetchProductionData();
}

// Marking the last stage done and sending the order on are one thought, so
// they are one button. It saves first - otherwise the stage just ticked would
// be thrown away - and then judges readiness on what is on screen, not on the
// copy the board was drawn from.
async function prod_dispatchFromEdit() {
  const modal = document.getElementById('prod_editModal');
  const id = prod_editId;

  showLoading(true);
  const saved = await prod_saveEdit();
  showLoading(false);
  if(!saved) return;

  const order = Object.assign({}, prod_data.find(x => x.ID.toString() === id.toString()));
  PROD_COLS.forEach(col => {
    const input = modal.querySelector(`[name="${col}"]`);
    if(input) order[col] = input.value;
  });

  const pending = prod_pendingStages(order);
  const confirmed = await Swal.fire({
    title: pending.length ? 'Some stages are not finished' : 'Ready for Dispatch?',
    html: pending.length
      ? `Order <b>${id}</b> still shows <b>${pending.join(', ')}</b> unfinished.<br>Send it to the Dispatch Dashboard anyway?`
      : `Order <b>${id}</b> will leave the Production queue and move to the <b>Dispatch Dashboard</b>, where its invoice and tracking number are filled in.`,
    icon: pending.length ? 'warning' : 'question',
    showCancelButton: true,
    confirmButtonText: pending.length ? 'Send anyway' : 'Move to Dispatch',
    confirmButtonColor: pending.length ? '#dc3545' : '#198754',
  });
  if(!confirmed.isConfirmed) { fetchProductionData(); return; }

  showLoading(true);
  try {
    const res = await fetch(`/api/dashboards/production/${id}`, {method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({Dispatch_Status:'Ready',userEmail:APP_USER.email})});
    const json = await res.json();
    showLoading(false);
    if(json.success) {
      prod_selected.delete(id.toString());
      bootstrap.Modal.getInstance(modal).hide();
      showToast('success','Moved to Dispatch Dashboard.');
      fetchProductionData();
    } else showToast('error', json.error);
  } catch(e) { showLoading(false); showToast('error','Server error.'); }
}
async function prod_markDispatch(id) {
  const confirmed = await Swal.fire({
    title: 'Ready for Dispatch?',
    html: `Order <b>${id}</b> will leave the Production queue and move to the <b>Dispatch Dashboard</b>, where its invoice and tracking number are filled in.`,
    icon: 'question',
    showCancelButton: true,
    confirmButtonText: 'Move to Dispatch',
    confirmButtonColor: '#198754',
  });
  if(!confirmed.isConfirmed) return;
  showLoading(true);
  try {
    const res = await fetch(`/api/dashboards/production/${id}`, {method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({Dispatch_Status:'Ready',userEmail:APP_USER.email})});
    const json = await res.json();
    showLoading(false);
    if(json.success) { prod_selected.delete(id.toString()); showToast('success','Moved to Dispatch Dashboard.'); fetchProductionData(); }
    else showToast('error',json.error);
  } catch(e) { showLoading(false); showToast('error','Server error.'); }
}
function prodToggleSelectAll(m) { document.querySelectorAll('.prod_checkbox').forEach(c => { c.checked = m.checked; prod_handleCheck(c.value, m.checked); }); }
function prod_handleCheck(id, checked) { if(checked) prod_selected.add(id.toString()); else prod_selected.delete(id.toString()); }
// The cutoff date handles the old backlog. This is for the rest: an order from
// this month that is never going to be finished, which by date would sit on the
// queue forever. Same button both ways round - the archive sends them back.
async function prod_moveBoards() {
  const ids = [...prod_selected];
  if(!ids.length) { showToast('warning','Select at least one order.'); return; }

  const toOld = !PROD_ARCHIVE;
  const where = toOld ? 'Old Production' : 'the Production Dashboard';
  const confirmed = await Swal.fire({
    title: `Move to ${where}?`,
    html: `<b>${ids.length}</b> order${ids.length > 1 ? 's' : ''} will move to <b>${where}</b>.`
      + `<br><br><span class="text-muted small">Nothing else changes &mdash; stages, dates and dealer stay as they are, and they can be moved back.</span>`,
    icon: 'question',
    showCancelButton: true,
    confirmButtonText: 'Move',
    confirmButtonColor: toOld ? '#fd7e14' : '#0d6efd',
  });
  if(!confirmed.isConfirmed) return;

  showLoading(true);
  try {
    const res = await fetch('/api/dashboards/production/archive', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ ids, archive: toOld }),
    });
    const json = await res.json();
    showLoading(false);
    if(!json.success) { showToast('error', json.error || 'Could not move them.'); return; }
    prod_selected.clear();
    const mc = document.getElementById('prod_selectAll');
    if(mc) mc.checked = false;
    showToast('success', `${json.moved} order${json.moved > 1 ? 's' : ''} moved to ${where}.`);
    fetchProductionData();
  } catch(e) { showLoading(false); showToast('error','Server error.'); }
}

function prod_openBulkModal() {
  if(!prod_selected.size) { showToast('warning','Select at least one order.'); return; }
  const tbody = document.getElementById('prod_bulkBody'); tbody.innerHTML = '';
  prod_selected.forEach(id => {
    const o = prod_data.find(x=>x.ID.toString()===id.toString());
    if(o) tbody.insertAdjacentHTML('beforeend',`<tr class="prod_bulk_row" data-id="${id}">
      <td class="fw-bold">${id}</td>
      <td>${prod_mkSel('Guest_Name',o.Guest_Name,['Pending','No','GNA Pending','Received','Printed'])}</td>
      <td>${prod_mkSel('Paper_Cutting',o.Paper_Cutting,['Pending','Done','Temporary Out of Stock','Permanent Out of Stock'])}</td>
      <td>${prod_mkSel('Dye_Status',o.Dye_Status,['Pending','NO DIE','DIE NOT RECEIVED','DIE CUTTING DONE','DIE SENT'])}</td>
      <td>${prod_mkSel('Block_Status',o.Block_Status,['Pending','NO BLOCK','BLOCK NOT RECEIVED','BLOCK PRINTED','BLOCK SENT'])}</td>
      <td>${prod_mkSel('Printing',o.Printing,['Pending','Done'])}</td>
      <td>${prod_mkSel('Printing_Type',o.Printing_Type,["Bell Press","UV","Thermography","Letterpress","Foil Emboss","Deboss","Engraved Letterpress","Digital"])}</td>
      <td>${prod_mkSel('Edges',o.Edges,['Pending','No','Done'])}</td>
      <td>${prod_mkSel('Laser_Cutting',o.Laser_Cutting,['Pending','Done','No'])}</td>
      <td>${prod_mkSel('Output',o.Output,['Pending','Done','No'])}</td>
      <td>${prod_mkSel('Card_Assembly',o.Card_Assembly,['Pending','Done'])}</td>
    </tr>`);
  });
  new bootstrap.Modal(document.getElementById('prod_bulkModal')).show();
}
function prod_mkSel(name, cur, opts) {
  // Same rule as the single-order modal: an answer the list does not carry
  // still has to be selectable, or bulk update would quietly flatten it.
  const v = PROD_NOT_A_STAGE.indexOf(name) >= 0 ? String(cur || '').trim() : prod_stageValue(cur);
  const list = opts.indexOf(v) < 0 && v ? opts.concat([v]) : opts;
  return `<select class="form-select form-select-sm prod_bulk_input" data-field="${name}">${list.map(o=>`<option value="${o}" ${v===o?'selected':''}>${o}</option>`).join('')}</select>`;
}
async function prod_submitBulk() {
  const rows = document.querySelectorAll('.prod_bulk_row');
  const btn = document.getElementById('prod_btnBulk');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
  const updates = Array.from(rows).map(r => {
    const upd = { ID: r.getAttribute('data-id'), userEmail: APP_USER.email };
    r.querySelectorAll('.prod_bulk_input').forEach(s => { upd[s.getAttribute('data-field')] = s.value; });
    return upd;
  });
  try {
    const res = await fetch('/api/dashboards/production/bulk', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({updates})});
    const json = await res.json();
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-save me-1"></i> Update Selected';
    if(json.success) { prod_selected.clear(); const mc=document.getElementById('prod_selectAll'); if(mc) mc.checked=false; bootstrap.Modal.getInstance(document.getElementById('prod_bulkModal')).hide(); showToast('success','Bulk Updated!'); fetchProductionData(); }
    else showToast('error', json.error);
  } catch(e) { btn.disabled=false; btn.innerHTML='<i class="fas fa-save me-1"></i> Update Selected'; showToast('error','Server error.'); }
}
</script>
