// ── CHARTS ──
var an_charts = {};
var an_all = [], an_filtered = [];

async function fetchAnalytics() {
  try {
    const res = await fetch('/api/dashboards/analytics');
    const json = await res.json();
    an_all = json.data || [];
    an_populateFilters(an_all);
    anApplyFilters();
    anListCounts();
    return an_all.length;
  } catch(e) { console.error(e); throw e; }
}
// This board opens on the current month, first to today. Set the range before
// the first fetch so the numbers are never briefly the whole eight thousand
// and then this month's few hundred. Clear puts every order back.
document.getElementById('an_start').value = monthStartValue();
document.getElementById('an_end').value = todayValue();

fetchAnalytics().catch(() => {});

// ── THE FOUR STATE LISTS ──
// Buttons that show, not buttons that set. The status is changed on Till
// Approval or the production board; these answer "which orders are in that
// state right now", which is the question people were opening three tabs to
// work out. Deliberately not filtered by the dates above: the count of
// reprints outstanding is not a fact about a date range.
var AN_LISTS = {
  Reprint: { title: 'Re-Print Orders', last: 'Client Status' },
  Reorder: { title: 'Re-Order Orders', last: 'Client Status' },
  Sample:  { title: 'Printed Sample Orders', last: 'Client Status' },
  Delay:   { title: 'Delayed Orders', last: 'Days In Production' },
};

// How long a card is allowed to sit on the floor before it is late.
var AN_DELAY_DAYS = 10;

// Days since the order reached production. actual_2 is the date the production
// board itself prints; the older imported rows never got one, so they fall back
// to the punch date the same way the board does.
function an_daysInProduction(order) {
  const started = order.ProductionStart ? new Date(order.ProductionStart) : null;
  if (!started || isNaN(started)) return 0;
  return Math.floor((Date.now() - started.getTime()) / 86400000);
}

// Late means still on the live production board and more than ten days in -
// or somebody has written down why it is late, which says so outright however
// long it has been. Only board orders count, so this list is always part of
// the In Production card above and never larger than it.
function an_isDelayed(order) {
  if (!order.OnBoard) return false;
  return an_daysInProduction(order) > AN_DELAY_DAYS || !!(order.ReasonForDelay || '').trim();
}

function an_inList(order, key) {
  if (key === 'Delay') return an_isDelayed(order);
  return (order.ClientStatus || '').trim().toLowerCase() === key.toLowerCase();
}

function anListCounts() {
  Object.keys(AN_LISTS).forEach(function (key) {
    const el = document.getElementById('an_cnt_' + key);
    if (el) el.textContent = an_all.filter(function (o) { return an_inList(o, key); }).length;
  });
}

var an_listKey = 'Reprint';

function anOpenList(key) {
  an_listKey = key;
  document.getElementById('an_listTitle').textContent = AN_LISTS[key].title;
  document.getElementById('an_listLastCol').textContent = AN_LISTS[key].last;
  document.getElementById('an_listNote').textContent = key === 'Delay'
    ? 'On the production board for more than ' + AN_DELAY_DAYS + ' days, longest wait first.'
    : 'Not filtered by the dates above — this is everything on record.';
  document.getElementById('an_listSearch').value = '';
  anDrawList();
  new bootstrap.Modal(document.getElementById('an_listModal')).show();
}

function anDrawList() {
  const key = an_listKey;
  const q = (document.getElementById('an_listSearch').value || '').toLowerCase().trim();
  const rows = an_all
    .filter(function (o) { return an_inList(o, key); })
    .filter(function (o) {
      return !q || ((o.ID || '') + ' ' + (o.Client || '') + ' ' + (o.Dealer || '') + ' ' + (o.Designer || ''))
        .toLowerCase().includes(q);
    });

  // Longest-waiting first: the top of this list is the day's work.
  if (key === 'Delay') rows.sort(function (a, b) { return an_daysInProduction(b) - an_daysInProduction(a); });

  document.getElementById('an_listCount').textContent =
    rows.length + (rows.length === 1 ? ' order' : ' orders');

  const body = document.getElementById('an_listBody');
  if (!rows.length) {
    body.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Nothing in this state.</td></tr>';
    return;
  }
  body.innerHTML = rows.map(function (o, i) {
    let last;
    if (key === 'Delay') {
      const days = an_daysInProduction(o);
      const reason = (o.ReasonForDelay || '').trim();
      last = '<span class="fw-bold text-danger">' + days + ' days</span>'
        + (reason ? '<div class="small text-muted">' + anEsc(reason) + '</div>' : '');
    } else {
      last = anEsc(o.ClientStatus || '');
    }
    return '<tr>'
      + '<td>' + (i + 1) + '</td>'
      + '<td class="fw-bold">' + anEsc(o.ID) + '</td>'
      + '<td>' + (anEsc(o.Dealer) || '-') + '</td>'
      + '<td>' + (anEsc(o.Client) || '-') + '</td>'
      + '<td>' + (anEsc(o.Designer) || '-') + '</td>'
      + '<td class="text-nowrap">' + (anEsc(o.Date) || '-') + '</td>'
      + '<td class="text-wrap" style="max-width:320px;">' + last + '</td>'
      + '</tr>';
  }).join('');
}

function anEsc(v) {
  return String(v == null ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}


// ── TODAY ──
// The number under each card. It ignores every filter above it on purpose:
// the range answers "how are we doing", this answers "what has happened
// today", and the two must not move together.
async function anFetchToday() {
  const box = document.getElementById('kpi_today_total');
  if (!box) return;                       // the board has been navigated away from
  const res = await fetch('/api/dashboards/today');
  const j = await res.json();
  if (!j.success) return;
  document.getElementById('kpi_today_total').textContent = j.total;
  document.getElementById('kpi_today_indesign').textContent = j.inDesign;
  // Held for the cards, which redraw on every filter change. Redrawn through
  // anApplyFilters rather than straight from an_filtered: this can arrive
  // before the orders have loaded, and a filter that legitimately matches
  // nothing must show nothing, not fall back to every order on record.
  if (j.onProductionBoard != null) {
    an_boardCount = j.onProductionBoard;
    if (an_all.length) anApplyFilters();
  }
  document.getElementById('kpi_today_inprogress').textContent = j.inProgress;
  document.getElementById('kpi_today_dispatched').textContent = j.dispatched;
  document.getElementById('kpi_today_cancelled').textContent = j.cancelled;
}

// Switching tabs rebuilds this view, so an old timer would still be running
// and a second one would be added on top. Clear ours before starting, and let
// it stop itself once the cards it writes to are gone.
if (window.__anTodayTimer) clearInterval(window.__anTodayTimer);
window.__anTodayTimer = setInterval(function () {
  if (!document.getElementById('kpi_today_total')) {
    clearInterval(window.__anTodayTimer);
    window.__anTodayTimer = null;
    return;
  }
  anFetchToday().catch(function () {});
}, 120000);

anFetchToday().catch(() => {});

function an_populateFilters(data) {
  const designers = new Set(), dealers = new Set(), couriers = new Set();
  data.forEach(o => {
    if(o.Designer) designers.add(o.Designer);
    if(o.Dealer) dealers.add(o.Dealer);
    if(o.Courier) couriers.add(o.Courier);
  });
  an_fillSelect('an_filterDesigner', designers);
  an_fillSelect('an_filterDealer', dealers);
  an_fillSelect('an_filterCourier', couriers);
}
function an_fillSelect(id, set) {
  const s = document.getElementById(id); if(!s) return;
  const cur = s.value; s.innerHTML = '<option value="">All</option>';
  Array.from(set).filter(Boolean).sort().forEach(v => { const o=document.createElement('option'); o.value=v; o.textContent=v; s.appendChild(o); });
  s.value = cur;
}

function anApplyFilters() {
  const designer = (document.getElementById('an_filterDesigner')||{}).value||'';
  const dealer = (document.getElementById('an_filterDealer')||{}).value||'';
  const courier = (document.getElementById('an_filterCourier')||{}).value||'';
  const startV = (document.getElementById('an_start')||{}).value||'';
  const endV = (document.getElementById('an_end')||{}).value||'';

  an_filtered = an_all.filter(o => {
    if(!o || !o.ID) return false;
    let dm = true;
    if(startV || endV) {
      const raw = o.RawDate || o.Date;
      const d = raw ? new Date(raw) : null;
      if(d && !isNaN(d)) {
        const s = dayStart(startV), e = dayEnd(endV);
        if(s && d < s) dm = false;
        if(e && d > e) dm = false;
      } else dm = false;
    }
    return dm &&
      (!designer || (o.Designer||'').toLowerCase() === designer.toLowerCase()) &&
      (!dealer || (o.Dealer||'').toLowerCase() === dealer.toLowerCase()) &&
      (!courier || (o.Courier||'').toLowerCase() === courier.toLowerCase());
  });

  renderKPIs(an_filtered);
  renderCharts(an_filtered);
  renderMonthly(an_filtered);
  renderTable(an_filtered);
}

function anClearFilters() {
  ['an_filterDesigner','an_filterDealer','an_filterCourier','an_start','an_end'].forEach(id => { const el=document.getElementById(id); if(el) el.value=''; });
  anApplyFilters();
}

// "In Production" used to be everything left over - total minus dispatched
// minus cancelled - which swept in every order still with the designer or
// waiting on the client, and came out far above what the production board
// showed. The stage now comes from the server, worked out with the same tests
// the board uses, and the order not yet at the floor has a card of its own so
// the four still add up to the total.
// What the production board is carrying right now, straight from the same
// query the board runs. Held here because the cards redraw on every filter
// change while this figure is fetched once and refreshed on its own.
var an_boardCount = null;

function renderKPIs(data) {
  const at = stage => data.filter(o => o.Stage === stage).length;
  document.getElementById('kpi_total').textContent = data.length;
  document.getElementById('kpi_indesign').textContent = at('design');
  // The one card the date filter does not touch. Asked for that way: what is
  // on the floor is a standing figure, not something that belongs to a month,
  // and it has to read the same here as it does on the production board. The
  // other four count orders punched in the period, so this one is deliberately
  // out of that sum - which the card says, under the title.
  document.getElementById('kpi_inprogress').textContent =
    an_boardCount != null ? an_boardCount : at('production');
  document.getElementById('kpi_dispatched').textContent = at('dispatched');
  document.getElementById('kpi_cancelled').textContent = at('cancelled');
}

// ── DESIGNS BY DESIGNER ──
// This chart answers "who drew how much last month", so it counts the month
// the design was finished in, not the month the order came in - a July order
// drawn in August is August's work. It reads its own month box and ignores
// the filters above the page: the two would otherwise fight over the same
// question.
function an_designMonthKey(raw) {
  if(!raw) return '';
  const d = new Date(raw);
  return isNaN(d) ? '' : d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
}

function an_monthLabel(key) {
  const [y, m] = key.split('-').map(Number);
  return new Date(y, m - 1, 1).toLocaleString('en-GB', { month: 'long', year: 'numeric' });
}

// A plain <select> holding 29 months opens a popup taller than the card, and
// Chrome flips it upward so it covers the filters above. The list has to stay
// complete, so the control changes instead: a dropdown we own, capped in height
// and scrolled, always hanging below its button. The chosen month still lives
// in an input with the same id, so everything reading .value is unaffected.
function an_fillMonthPicker(id, keys, current, onPick) {
  const input = document.getElementById(id);
  const btn = document.getElementById(id + 'Btn');
  const menu = document.getElementById(id + 'Menu');
  if(!input || !btn || !menu) return;

  const chosen = keys.indexOf(input.value) >= 0 ? input.value : current;
  input.value = chosen;
  btn.textContent = an_monthLabel(chosen);
  menu.innerHTML = keys.map(k =>
    '<li><button type="button" class="dropdown-item' + (k === chosen ? ' active' : '') +
    '" data-month="' + k + '">' + an_monthLabel(k) + '</button></li>').join('');

  menu.onclick = function(e) {
    const item = e.target.closest('[data-month]');
    if(!item) return;
    input.value = item.dataset.month;
    btn.textContent = item.textContent;
    menu.querySelectorAll('.dropdown-item').forEach(x => x.classList.toggle('active', x === item));
    onPick();
  };
}

function an_fillDesignMonths() {
  const keys = Array.from(new Set(an_all.map(o => an_designMonthKey(o.DesignDone)).filter(Boolean)))
    .sort().reverse();

  const current = todayValue().slice(0, 7);
  if(keys.indexOf(current) < 0) keys.unshift(current);

  an_fillMonthPicker('an_designMonth', keys, current, renderDesignerChart);
}

function renderDesignerChart() {
  const sel = document.getElementById('an_designMonth');
  if(!sel) return;
  const month = sel.value;

  const counts = {};
  an_all.forEach(o => {
    if(an_designMonthKey(o.DesignDone) !== month) return;
    const who = (o.Designer || '').trim() || 'Not assigned';
    counts[who] = (counts[who] || 0) + 1;
  });

  const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
  renderBarChart('chart_designStatus', sorted.map(x => x[0]), sorted.map(x => x[1]));
}

// Chart.js draws no value on a bar, and reading a height off the gridlines
// is guesswork once the bars get short. Print the number above each one.
var AN_BAR_TOTALS = {
  id: 'anBarTotals',
  afterDatasetsDraw(chart) {
    const ctx = chart.ctx;
    ctx.save();
    ctx.font = 'bold 11px system-ui, sans-serif';
    ctx.fillStyle = '#212529';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    chart.getDatasetMeta(0).data.forEach((bar, i) => {
      const v = chart.data.datasets[0].data[i];
      if(v) ctx.fillText(v, bar.x, bar.y - 4);
    });
    ctx.restore();
  },
};

function renderBarChart(canvasId, labels, values) {
  if(an_charts[canvasId]) {
    try { an_charts[canvasId].destroy(); } catch(e) {}
    delete an_charts[canvasId];
  }
  const canvas = document.getElementById(canvasId);
  if(!canvas) return;

  an_charts[canvasId] = new Chart(canvas, {
    type: 'bar',
    data: { labels, datasets: [{ data: values, backgroundColor: '#0d6efd', borderRadius: 4 }] },
    plugins: [AN_BAR_TOTALS],
    options: {
      responsive: true, maintainAspectRatio: false,
      layout: { padding: { top: 18 } },
      plugins: { legend: { display: false } },
      scales: {
        // Whole designs only - half a design is not a thing.
        y: { beginAtZero: true, ticks: { precision: 0 } },
      },
    },
  });
}

// ── PRODUCTION COUNTS ──
// What kind of work the shop is carrying, over everything - not the date
// range above, and not a month. Reads an_all rather than the filtered set on
// purpose: the question is what the business holds altogether.
//
// Fresh Order is everything that is not a repeat, so an order can be both
// Fresh and Production. The rows do not add up to the total and are not
// meant to.
function renderProductionCounts() {
  const kind = o => (o.ClientStatus || '').trim().toLowerCase();
  const count = test => an_all.filter(o => test(kind(o))).length;
  const repeat = ['reorder', 'reprint', 'sample'];

  // Four slices that between them cover every order exactly once: Fresh Order
  // is "not a repeat", and the other three are the repeats. Production was
  // dropped from here because an order approved for production is also a
  // fresh one - the slice sat inside another and made the pie read wrong.
  renderPieChart('chart_production', {
    'Fresh Order': count(k => repeat.indexOf(k) < 0),
    'Sampling': count(k => k === 'sample'),
    'Re-print': count(k => k === 'reprint'),
    'Re-order': count(k => k === 'reorder'),
  });
}

function renderCharts(data) {
  an_fillDesignMonths();
  renderDesignerChart();

  renderProductionCounts();

  an_fillDispatchMonths();
  renderDispatchChart();
}

// ── DISPATCHED, BY MONTH ──
// Counts the parcels that left in the chosen month, so an order taken in
// April and sent in August is August's. "Not Dispatched" has no place here -
// an order that never went out never had a month - which is why the card is
// titled Dispatched rather than Dispatch Status.
function an_fillDispatchMonths() {
  const keys = Array.from(new Set(an_all.map(o => an_designMonthKey(o.DispatchDone)).filter(Boolean)))
    .sort().reverse();

  const current = todayValue().slice(0, 7);
  if(keys.indexOf(current) < 0) keys.unshift(current);

  an_fillMonthPicker('an_dispatchMonth', keys, current, renderDispatchChart);
}

function renderDispatchChart() {
  const sel = document.getElementById('an_dispatchMonth');
  if(!sel) return;
  const month = sel.value;

  const counts = {};
  an_all.forEach(o => {
    if(an_designMonthKey(o.DispatchDone) !== month) return;
    // The imported rows carry a dispatch date but no status word. They went
    // out all the same.
    const s = (o.DispatchStatus || '').trim() || 'Dispatched';
    counts[s] = (counts[s] || 0) + 1;
  });

  // A month with no dispatches would draw an empty circle, which reads as a
  // broken chart rather than an empty one. Say it in words instead.
  const empty = Object.keys(counts).length === 0;
  const note = document.getElementById('an_dispatchEmpty');
  const canvas = document.getElementById('chart_dispatchStatus');
  if(note) note.classList.toggle('d-none', !empty);
  if(canvas) canvas.style.visibility = empty ? 'hidden' : 'visible';

  renderPieChart('chart_dispatchStatus', counts);
}

function renderPieChart(canvasId, countsObj) {
  const labels = Object.keys(countsObj);
  const values = Object.values(countsObj);
  const colors = ['#0d6efd','#198754','#ffc107','#dc3545','#6f42c1','#20c997','#fd7e14','#adb5bd','#0dcaf0','#343a40'];

  if(an_charts[canvasId]) {
    try { an_charts[canvasId].destroy(); } catch(e) {}
    delete an_charts[canvasId];
  }

  const canvas = document.getElementById(canvasId);
  if(!canvas) return;

  an_charts[canvasId] = new Chart(canvas, {
    type: 'pie',
    data: {
      labels,
      datasets: [{ data: values, backgroundColor: colors.slice(0, values.length), borderWidth: 2 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            font: { size: 11 }, boxWidth: 12,
            // The count goes in the legend. One slice is usually so much
            // bigger than the rest that the small ones are a hairline on the
            // pie - readable only if the number is written down.
            generateLabels: chart => {
              const ds = chart.data.datasets[0];
              return chart.data.labels.map((label, i) => ({
                text: label + ' (' + ds.data[i] + ')',
                fillStyle: ds.backgroundColor[i],
                strokeStyle: ds.backgroundColor[i],
                lineWidth: 0,
                index: i,
              }));
            },
          },
        },
        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.raw} (${Math.round(ctx.raw/ctx.chart._metasets[0].total*100)}%)` } }
      }
    }
  });
}

function renderMonthly(data) {
  // Group by Month-Year
  const months = {};
  data.forEach(o => {
    const raw = o.RawDate || o.Date;
    const d = raw ? new Date(raw) : null;
    if(!d || isNaN(d)) return;
    const key = d.toLocaleString('default',{month:'short'})+' '+d.getFullYear();
    if(!months[key]) months[key] = {total:0,dispatched:0,pending:0,cancelled:0};
    months[key].total++;
    if(o.DispatchStatus && o.DispatchStatus.trim()) months[key].dispatched++;
    else if((o.DesignStatus||'').toLowerCase().includes('cancelled')||(o.ClientStatus||'').toLowerCase().includes('cancel')) months[key].cancelled++;
    else months[key].pending++;
  });

  const sorted = Object.entries(months).sort((a,b) => {
    const da = new Date('1 '+a[0]), db = new Date('1 '+b[0]);
    return db - da;
  });

  const tbody = document.getElementById('an_monthlyBody');
  if(!sorted.length) { tbody.innerHTML = '<tr><td colspan="5" class="text-center">No data</td></tr>'; return; }
  tbody.innerHTML = sorted.map(([m, v]) => `
    <tr>
      <td class="fw-bold">${m}</td>
      <td><span class="badge bg-primary">${v.total}</span></td>
      <td><span class="badge bg-success">${v.dispatched}</span></td>
      <td><span class="badge bg-warning">${v.pending}</span></td>
      <td><span class="badge bg-danger">${v.cancelled}</span></td>
    </tr>`).join('');
}

function renderTable(data) {
  const tbody = document.getElementById('an_tbody');
  const badge = document.getElementById('an_count_badge');
  if(badge) badge.textContent = data.length + ' orders';
  if(!data.length) { tbody.innerHTML = '<tr><td colspan="11" class="text-center">No data found.</td></tr>'; return; }

  tbody.innerHTML = data.map((o, i) => {
    const ds = o.DesignStatus||'';
    const cs = o.ClientStatus||'';
    const disp = o.DispatchStatus||'';
    const dsBadge = ds ? `<span class="badge ${ds.toLowerCase().includes('cancelled')?'bg-danger':ds.toLowerCase().includes('proofing')?'bg-success':'bg-secondary'}">${ds}</span>` : '';
    const csBadge = cs ? `<span class="badge ${cs.toLowerCase().includes('final')?'bg-success':cs.toLowerCase().includes('modification')?'bg-warning':'bg-secondary'}">${cs}</span>` : '';
    const dispBadge = disp ? `<span class="badge bg-info text-dark">${disp}</span>` : '<span class="text-muted small">—</span>';
    return `<tr>
      <td>${i + 1}</td>
      <td><small class="text-muted">${o.Date||''}</small></td>
      <td class="fw-bold">${o.ID}</td>
      <td>${o.Dealer||''}</td>
      <td>${o.Client||''}</td>
      <td><small>${o.Designer||''}</small></td>
      <td>${dsBadge}</td>
      <td>${csBadge}</td>
      <td>${dispBadge}</td>
      <td><small>${o.Courier||''}</small></td>
      <td><small>${o.Docket||''}</small></td>
    </tr>`;
  }).join('');
}
</script>

<style>
.kpi-card { border-radius: 8px; }
/* Bootstrap has no purple text helper, and In Design needs a colour of its
   own so the five cards read apart at a glance. */
.text-purple { color: #6f42c1 !important; }
.kpi-card:hover { transform: translateY(-2px); box-shadow: 0 6px 12px rgba(0,0,0,0.15) !important; }
/* Roughly eight months at a time, then scroll - a 29-month list left open
   would be taller than the chart it belongs to. */
.an-month-menu { max-height: 260px; overflow-y: auto; }
.an-month-picker .btn { font-size: .875rem; padding: .25rem .5rem; font-weight: 400; }
</style>
