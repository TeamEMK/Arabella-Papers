          </tr></thead>
          <tbody id="an_monthlyBody"><tr><td colspan="5" class="text-center"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ORDERS TABLE -->
  <div class="card shadow-sm">
    <div class="card-header text-dark fw-bold d-flex justify-content-between align-items-center">
      <span><i class="fas fa-table me-2"></i>All Orders Detail</span>
      <span class="badge bg-primary" id="an_count_badge">0 orders</span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive" style="max-height:300px; overflow-y:auto;">
        <table class="table table-hover table-sm mb-0 text-nowrap">
          <thead class="table-dark"><tr>
            <th style="position:sticky;top:0;background:#212529;color:white;">#</th>
