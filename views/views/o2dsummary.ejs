        <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">End Date</label><input type="date" id="an_end" class="form-control form-control-sm" onchange="anApplyFilters()"></div>
        <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">Designer</label><select id="an_filterDesigner" class="form-select form-select-sm" onchange="anApplyFilters()"><option value="">All</option></select></div>
        <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">Dealer</label><select id="an_filterDealer" class="form-select form-select-sm" onchange="anApplyFilters()"><option value="">All</option></select></div>
