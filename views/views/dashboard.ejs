          </div>
          <div class="col-md-6">
            <label class="form-label text-dark fw-bold">Possible Design Time</label>
            <select id="punchDesignTime" class="form-select" required>
              <option value="" disabled selected>Select...</option>
              <option value="10 Minutes">10 Minutes</option>
              <option value="2 Hours">2 Hours</option>
              <option value="4 Hours">4 Hours</option>
              <option value="EOD">EOD</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label text-dark fw-bold">Upload Files</label>
            <div class="file-box text-center">
              <i class="fas fa-cloud-upload-alt upload-icon"></i>
              <div class="file-text" id="fileText">Click or Drag files here</div>
              <input type="file" id="fileInput" multiple accept=".pdf,.jpg,.jpeg,.png"/>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer d-flex justify-content-between">
        <div class="bulk-actions">
          <button type="button" class="btn btn-outline-dark btn-sm" onclick="goBulkUpload('orders')">
            <i class="fas fa-cloud-upload-alt me-1"></i> Bulk Upload
          </button>
          <button type="button" class="btn btn-outline-secondary btn-sm ms-2" onclick="downloadSample('orders')">
            <i class="fas fa-file-csv me-1"></i> Sample
          </button>
        </div>
        <div>
          <button class="btn btn-primary" id="btnSubmit" onclick="handleFormSubmit()">
            <i class="fas fa-paper-plane me-1"></i> Submit Order
          </button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="resetForm()">Cancel</button>
        </div>
      </div>
    </div>
  </div>
</div>

