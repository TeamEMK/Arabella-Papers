      <td><input type="text" class="form-control form-control-sm border-0 bg-transparent text-dark" id="ds_india_email_${d.id}" value="${d.india_email||''}" readonly></td>
      <td class="text-center">
        <div class="btn-group">
          <button class="btn btn-sm btn-outline-primary" id="btn_edit_india_${d.id}" onclick="toggleDesignerEdit(${d.id},'india')"><i class="fas fa-edit"></i></button>
