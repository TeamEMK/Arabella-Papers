<!-- Punch Order Modal -->
<div class="modal fade" id="orderPunchModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">New Order Punch</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="resetForm()"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label text-dark fw-bold">Email Address</label>
            <input type="email" id="punchEmail" class="form-control" readonly style="background:#e9ecef;"/>
          </div>
          <div class="col-md-6">
            <label class="form-label text-dark fw-bold">Order Punched By</label>
            <div class="radio-group">
              <label class="radio-opt">
