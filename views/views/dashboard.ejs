            <datalist id="dealerList"></datalist>
          </div>
          <div class="col-md-6">
            <label class="form-label text-dark fw-bold">Client Name</label>
            <input list="punchClientList" id="punchClientInput" class="form-control" placeholder="Search or Select Client" required autocomplete="off"/>
            <datalist id="punchClientList"></datalist>
