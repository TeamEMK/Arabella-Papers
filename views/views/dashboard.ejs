function openViewModal(rowData) {
  const modalBody = document.getElementById('viewModalBody');
  const isAdmin = APP_USER.role === 'SuperAdmin' || APP_USER.domain === 'Head';
  const forbidden = ['dealer e-mail','mobile no','dealer email'];
  const linkKeys = ['Upload the one Design file','Upload Design','Revision Design Upload','Approved Design'];
  let html = '<div class="row">';
  for(const key in rowData) {
    if(!key || key === 'rowData') continue;
    if(!isAdmin) { const kl = key.toLowerCase().trim(); if(forbidden.some(f => kl.includes(f))) continue; }
    let value = rowData[key];
    if(!value || value.toString().trim() === '') continue;
    let isLink = false;
    if((linkKeys.includes(key) || key.toLowerCase().includes('upload')) && value.toString().includes('http')) {
      const links = value.toString().split(/[\n,]+/);
      value = links.map((l,i) => l.trim().startsWith('http') ?
        `<a href="${l.trim()}" target="_blank" class="btn btn-sm btn-outline-primary view-link-btn m-1"><i class="fas fa-external-link-alt me-1"></i>View File ${links.length>1?i+1:''}</a>` : '').join(' ');
      isLink = true;
    }
    const col = key.toLowerCase().includes('remark') || key.length > 50 ? 'col-12' : 'col-md-6';
    html += `<div class="${col} view-item"><span class="view-label">${key}</span><div class="${isLink?'':'view-value'}">${value}</div></div>`;
  }
  html += '</div>';
  modalBody.innerHTML = html;
  new bootstrap.Modal(document.getElementById('viewModal')).show();
}

