      <td><input type="text" class="form-control form-control-sm border-0 bg-transparent text-dark" id="ds_over_${d.id}" value="${d.overseas_name||''}" readonly></td>
      <td><input type="text" class="form-control form-control-sm border-0 bg-transparent text-dark" id="ds_over_email_${d.id}" value="${d.overseas_email||''}" readonly></td>
      <td class="text-center">
        <div class="btn-group">
          <button class="btn btn-sm btn-outline-primary" id="btn_edit_over_${d.id}" onclick="toggleDesignerEdit(${d.id},'over')"><i class="fas fa-edit"></i></button>
          <button class="btn btn-sm btn-success d-none" id="btn_save_over_${d.id}" onclick="saveDesigner(${d.id})"><i class="fas fa-save"></i></button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteDesigner(${d.id})"><i class="fas fa-trash"></i></button>
        </div>
      </td>
    </tr>`).join('') || '<tr><td colspan="6" class="text-center">No Designers</td></tr>';
