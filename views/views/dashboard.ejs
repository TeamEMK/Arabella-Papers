    </div>
  </div>
</div>

<script>
// ═══ GLOBAL STATE ═══
var ordersData = [];
var currentDisplaySet = [];
var renderedCount = 0;
var BATCH_SIZE = 50;
var selectedOrderIds = new Set();
var db_forms = {};
var currentEditOrderId = null;

// ═══ INIT ═══
(function() {
  applyPermissions();
  fetchOrdersData();
  fetchFormOptions();
  setupInfiniteScroll();
})();

function setupInfiniteScroll() {
  const container = document.querySelector('.card-body.table-responsive');
  if (container) {
    container.addEventListener('scroll', function() {
      if (container.scrollTop + container.clientHeight >= container.scrollHeight - 100) {
        renderNextBatch();
      }
    });
  }
}

