}
async function saveDesigner(id) {
  const indiaName = document.getElementById(`ds_india_${id}`).value;
  const indiaEmail = document.getElementById(`ds_india_email_${id}`).value;
  const overName = document.getElementById(`ds_over_${id}`).value;
  const overEmail = document.getElementById(`ds_over_email_${id}`).value;
  showLoading(true);
  const res = await fetch(`/api/dashboards/designers/${id}`, {method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({indiaName,indiaEmail,overseasName:overName,overseasEmail:overEmail})});
  showLoading(false);
  const json = await res.json();
  if(json.success) { showToast('success','Designer Updated!'); loadMasterData(); } else showToast('error',json.error);
}
async function deleteDealer(id) {
  if(!confirm('Delete this dealer?')) return;
  const res = await fetch(`/api/dashboards/dealers/${id}`, {method:'DELETE'});
  const json = await res.json();
  if(json.success) { showToast('success','Deleted!'); loadMasterData(); fetchFormOptions(); } else showToast('error',json.error);
}
async function deleteDesigner(id) {
  if(!confirm('Delete this designer?')) return;
  const res = await fetch(`/api/dashboards/designers/${id}`, {method:'DELETE'});
  const json = await res.json();
  if(json.success) { showToast('success','Deleted!'); loadMasterData(); fetchFormOptions(); } else showToast('error',json.error);
}
function filterManageTables() {
  const query = document.getElementById('manageSearchInput').value.toLowerCase().trim();
  ['tbl_manage_dealers','tbl_manage_designers'].forEach(id => {
    const tbody = document.getElementById(id);
    if(!tbody) return;
    Array.from(tbody.getElementsByTagName('tr')).forEach(row => {
      if(row.cells.length < 2) return;
      const inputs = row.querySelectorAll('input');
      const match = Array.from(inputs).some(inp => inp.value.toLowerCase().includes(query));
      row.style.display = match ? '' : 'none';
    });
  });
}

// ═══ BULK UPDATE ═══
function openBulkUpdateModal() {
  if(selectedOrderIds.size === 0) { showToast('warning','Please select at least one order.'); return; }
  const tbody = document.getElementById('bulkUpdateTableBody');
  tbody.innerHTML = '';
  selectedOrderIds.forEach(id => {
    const order = ordersData.find(o => o.ID.toString() === id.toString());
    if(order) {
      tbody.insertAdjacentHTML('beforeend', `
        <tr class="bulk-row" data-id="${id}">
          <td class="fw-bold text-dark">${id}</td>
          <td>
            <select class="form-select form-select-sm bulk-status">
              <option value="Fresh Design">Fresh Design</option>
              <option value="Modification Needed">Modification Needed</option>
              <option value="Proofing Done" selected>Proofing Done</option>
              <option value="Cancelled">Cancelled</option>
            </select>
          </td>
          <td><input type="file" class="form-control form-control-sm bulk-file" accept="image/*,application/pdf"></td>
          <td><input type="text" class="form-control form-control-sm bulk-remark" placeholder="Enter remark..."></td>
        </tr>`);
    }
  });
  new bootstrap.Modal(document.getElementById('bulkUpdateModal')).show();
}

async function submitIndividualBulkUpdate() {
  const rows = document.querySelectorAll('#bulkUpdateTableBody tr.bulk-row');
  const btn = document.getElementById('btnBulkSubmit');
  if(!rows.length) { showToast('warning','No orders selected.'); return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
  const updates = [];
  for(const row of rows) {
    updates.push({ id: row.getAttribute('data-id'), status: row.querySelector('.bulk-status').value, remark: row.querySelector('.bulk-remark').value, userEmail: APP_USER.email });
  }
  try {
    const res = await fetch('/api/orders/bulk-status', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({updates})});
    const json = await res.json();
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-save me-1"></i> Update All Selected';
    if(json.success) {
      selectedOrderIds.clear();
      const mc = document.getElementById('selectAllOrders'); if(mc) mc.checked = false;
      showToast('success',`Updated ${json.count} orders.`);
      bootstrap.Modal.getInstance(document.getElementById('bulkUpdateModal')).hide();
      refreshDashboard();
    } else showToast('error', json.error);
  } catch(e) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-save me-1"></i> Update All Selected'; showToast('error','Server error.'); }
}

// ═══ HELPERS ═══
function populateList(id, array) {
  const list = document.getElementById(id);
  if(!list) return;
  list.innerHTML = '';
  (array||[]).forEach(item => { if(item) { const o = document.createElement('option'); o.value = item; list.appendChild(o); }});
}
function updateDesigners(team) {
  const input = document.getElementById('designerInput');
  input.value = '';
  if(team === 'India') { populateList('designerList', db_forms.indian||[]); input.placeholder = 'Search Indian Designer...'; }
  else { populateList('designerList', db_forms.cassie||[]); input.placeholder = 'Search Cassie Designer...'; }
}
function validateDealerSelection(input) {
  const val = input.value; if(!val) return;
  const list = document.getElementById(input.getAttribute('list'));
  if(!list) return;
  const valid = Array.from(list.options).map(o => o.value);
  if(val && !valid.includes(val)) { showToast('warning','Please select a dealer from the list only.'); input.value = ''; input.focus(); }
}
function validateDesignerSelection(input) {
  const val = input.value; if(!val) return;
  const list = document.getElementById(input.getAttribute('list'));
  if(!list) return;
  const valid = Array.from(list.options).map(o => o.value);
  if(val && !valid.includes(val)) { showToast('warning','Please select a designer from the list only.'); input.value = ''; input.focus(); }
}
function toggleSelectAll(master) {
  document.querySelectorAll('.order-checkbox').forEach(cb => { cb.checked = master.checked; handleCheckboxChange(cb.value, master.checked); });
}
function handleCheckboxChange(id, isChecked) {
  if(isChecked) selectedOrderIds.add(id.toString());
  else selectedOrderIds.delete(id.toString());
}
function resetForm() {
  document.getElementById('punchEmail').value = APP_USER.email;
  document.querySelector('input[name="punchedBy"]:checked') && (document.querySelector('input[name="punchedBy"]:checked').checked = false);
  document.getElementById('punchDealerInput').value = '';
  document.getElementById('punchClientInput').value = '';
  document.getElementById('punchRemarks').value = '';
  document.getElementById('designerInput').value = '';
  document.getElementById('punchDesignTime').value = '';
  document.getElementById('fileInput').value = '';
  document.getElementById('fileText').textContent = 'Click or Drag files here';
  document.getElementById('fileText').style.color = '#6c757d';
}
document.getElementById('fileInput')?.addEventListener('change', function() {
  const txt = document.getElementById('fileText');
  if(this.files.length > 0) { txt.textContent = this.files.length + ' file(s) selected'; txt.style.color = '#198754'; txt.style.fontWeight = 'bold'; }
  else { txt.textContent = 'Click or Drag files here'; txt.style.color = '#6c757d'; txt.style.fontWeight = 'normal'; }
});

// ═══ BULK SHORTCUTS (dealer / designer / order modals) ═══
// Mirrors the server's rule in routes/api/bulk.js — a Designer can add one
// dealer at a time here but is not allowed to import, so the buttons come out
// rather than leading to a 403.
function canBulkUpload() {
  return APP_USER.role === 'SuperAdmin' || APP_USER.domain === 'Head';
}

function downloadSample(type) {
  // Served as an attachment, so this downloads without leaving the page.
  window.location.href = '/api/bulk/template/' + type;
}

function goBulkUpload(type) {
  document.querySelectorAll('.modal.show').forEach(function(m) {
    const inst = bootstrap.Modal.getInstance(m);
    if (inst) inst.hide();
  });
  // Read once by the Bulk Upload view so it opens on the type you came from.
  sessionStorage.setItem('bulkUploadType', type);
  loadPage('bulkUpload');
}

if (!canBulkUpload()) {
  document.querySelectorAll('.bulk-actions').forEach(function(el) { el.remove(); });
}
