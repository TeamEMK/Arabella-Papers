          <div class="col-12">
            <label class="form-label text-dark fw-bold">Remarks / Subject Line</label>
            <textarea id="punchRemarks" class="form-control" placeholder="Enter details..." required></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label text-dark fw-bold">Designer</label>
            <input list="designerList" id="designerInput" class="form-control" placeholder="Select 'Punched By' first..." required autocomplete="off" onchange="validateDesignerSelection(this)"/>
