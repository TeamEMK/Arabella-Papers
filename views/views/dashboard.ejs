      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label text-dark fw-bold">Design Status*</label>
          <div class="form-check" id="optFresh"><input class="form-check-input" type="radio" name="designStatus" id="freshDesign" value="Fresh Design"><label class="form-check-label text-dark" for="freshDesign">Fresh Design</label></div>
