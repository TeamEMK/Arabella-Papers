<div id="dispRoot"></div>
<script>
document.getElementById('dispRoot').innerHTML = `
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-dark fw-bold">Dispatch Dashboard</h3>
    <button class="btn btn-outline-dark smooth-ui text-dark fw-bold" onclick="refreshBoard(this, fetchDispatchData, 'orders')"><i class="fas fa-sync-alt me-1"></i> Refresh</button>
  </div>
  <div class="row g-3 mb-3"><div class="col-6 col-md-3"><div class="card shadow smooth-ui kpi-card" style="border-left:4px solid #198754;"><div class="card-body p-3"><h6 class="text-muted mb-1 small">Till Dispatch Orders</h6><h3 class="fw-bold text-success mb-0" id="dsp_tillCount">--</h3></div></div></div></div>
  <div class="card bg-light-glass mb-4 shadow-sm">
    <button class="filter-toggle-btn btn-sm py-1 px-3 w-100 d-flex justify-content-between align-items-center rounded p-2" type="button" data-bs-toggle="collapse" data-bs-target="#dspFilterContent">
      <span class="p-2 fw-bold"><i class="fas fa-filter me-2"></i> Filters & Search</span>
      <i class="fas fa-chevron-down"></i>
    </button>
    <div id="dspFilterContent" class="collapse">
      <div class="card-body p-2">
        <div class="row g-2 align-items-end text-dark">
          <div class="col-6 col-md-2"><label class="form-label fw-bold small mb-0">Start</label><input type="date" id="dsp_startDate" class="form-control form-control-sm" onchange="dspApplyFilters()"></div>
          <div class="col-6 col-md-2"><label class="form-label fw-bold small mb-0">End</label><input type="date" id="dsp_endDate" class="form-control form-control-sm" onchange="dspApplyFilters()"></div>
          <div class="col-12 col-md-4"><label class="form-label fw-bold small mb-0">Search</label><input type="text" id="dsp_search" class="form-control form-control-sm" placeholder="Search by ID, Courier, Docket..." onkeyup="dspApplyFilters()"></div>
          <div class="col-6 col-md-2"><label class="form-label text-dark fw-bold small mb-0">Status</label><select id="dsp_filterStatus" class="form-select form-select-sm" onchange="dspApplyFilters()"><option value="">All</option><option value="Ready">Ready</option><option value="Dispatched">Dispatched</option><option value="Delivered">Delivered</option></select></div>
          <div class="col-6 col-md-3"><label class="form-label text-dark fw-bold small mb-0">Courier</label><select id="dsp_filterCourier" class="form-select form-select-sm" onchange="dspApplyFilters()"><option value="">All</option></select></div>
          <div class="col-6 col-md-3"><label class="form-label text-dark fw-bold small mb-0">Dealer</label><select id="dsp_filterDealer" class="form-select form-select-sm" onchange="dspApplyFilters()"><option value="">All</option></select></div>
          <div class="col-12 text-end"><button class="btn btn-secondary btn-sm" onclick="dspClearFilters()">Clear</button></div>
        </div>
      </div>
    </div>
  </div>
  <div class="card bg-light-glass shadow-lg">
    <div class="card-header bg-transparent border-0"><h5 class="mb-0 text-dark fw-bold"><i class="fas fa-shipping-fast me-2"></i>Dispatch Queue</h5></div>
    <div class="card-body p-0">
      <div class="table-responsive" data-fill-height style="overflow-y:auto;position:relative;">
        <table class="table table-hover table-striped mb-0 text-nowrap" style="border-collapse:separate;border-spacing:0;">
          <thead class="table-dark">
            <tr>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">#</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">ID</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Dispatch Date</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Dealer</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Client</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Courier</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Docket No</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Invoice No</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Inv. Amount</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Boxes</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Weight</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Vol. Weight</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Status</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Action</th>
            </tr>
          </thead>
          <tbody id="dsp_tbody"><tr><td colspan="14" class="text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Dispatch Edit Modal -->
<div class="modal fade" id="dsp_editModal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header bg-primary text-white"><h5 class="modal-title">Update Dispatch: <span id="dsp_editId"></span></h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold text-dark">Courier Name</label><select id="dsp_courier" class="form-select"></select></div>
        <div class="col-md-6"><label class="form-label fw-bold text-dark">Tracking / Docket No.</label><input type="text" id="dsp_docket" class="form-control" placeholder="Tracking #" required></div>
        <div class="col-md-6"><label class="form-label fw-bold text-dark">Invoice Number</label><input type="text" id="dsp_invoiceNo" class="form-control"></div>
        <div class="col-md-6"><label class="form-label fw-bold text-dark">Invoice Amount</label><input type="number" id="dsp_invoiceAmount" class="form-control"></div>
        <div class="col-md-4"><label class="form-label fw-bold text-dark">Boxes</label><input type="number" id="dsp_boxes" class="form-control" min="1" step="1"></div>
        <div class="col-md-4"><label class="form-label fw-bold text-dark">Weight (kg)</label><input type="number" id="dsp_weight" class="form-control" min="1" step="any"></div>
        <div class="col-md-4"><label class="form-label fw-bold text-dark">Vol. Weight</label><input type="number" id="dsp_volWeight" class="form-control" min="1" step="any"></div>
        <div class="col-12"><label class="form-label fw-bold text-dark">Status</label><select id="dsp_status" class="form-select" required><option value="Ready">Ready</option><option value="Dispatched">Dispatched</option><option value="Delivered">Delivered</option></select></div>
      </div>
    </div>
    <div class="modal-footer justify-content-between"><button class="btn btn-outline-warning" onclick="dsp_revertToProduction()" title="Send this order back to the Production Dashboard"><i class="fas fa-undo me-1"></i>Back to Production</button><div class="d-flex gap-2"><button class="btn btn-success" onclick="dsp_submitUpdate()">Update Dispatch</button><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button></div></div>
  </div></div>
</div>

<!-- View Modal -->
<div class="modal fade" id="dsp_viewModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title fw-bold">Order Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="dsp_viewBody"></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div>
`;

var dsp_data = [], dsp_editId = null;

async function fetchDispatchData() {
  try {
    const res = await fetch('/api/dashboards/dispatch');
    const json = await res.json();
    dsp_data = json.data || [];
    // Whole board, not the filtered view - see the production board.
    const tc = document.getElementById('dsp_tillCount');
    if(tc) tc.textContent = dsp_data.length;
    dsp_populateFilters(dsp_data);
    dspApplyFilters();
    return dsp_data.length;
  } catch(e) { console.error(e); throw e; }
}
fetchDispatchData().catch(() => {});

// The couriers this office uses, whether or not a parcel has gone out with
// one yet, plus anything already written on an order. Another carrier is a
// matter of adding it to this line.
var DSP_KNOWN_COURIERS = ['DHL', 'FedEx', 'UPS'];

function dsp_courierList() {
  const set = new Set(DSP_KNOWN_COURIERS);
  dsp_data.forEach(o => {
    const c = (o.Dispatch_Courier_Name||'').trim();
    if(c) set.add(c);
  });
  return Array.from(set).sort((a,b) => a.localeCompare(b));
}

function dsp_populateFilters(data) {
  const dealers = new Set();
  data.forEach(o => { if(o.Dealer_name) dealers.add(o.Dealer_name); });
  dsp_fillSelect('dsp_filterCourier', new Set(dsp_courierList()));
  dsp_fillSelect('dsp_filterDealer', dealers);
}
function dsp_fillSelect(id, set) {
  const s = document.getElementById(id); if(!s) return;
  const cur = s.value; s.innerHTML = '<option value="">All</option>';
  Array.from(set).sort().forEach(v => { const o = document.createElement('option'); o.value=v; o.textContent=v; s.appendChild(o); });
  s.value = cur;
}
function dspApplyFilters() {
  const status = (document.getElementById('dsp_filterStatus')||{}).value||'';
  const courier = (document.getElementById('dsp_filterCourier')||{}).value||'';
  const dealer = (document.getElementById('dsp_filterDealer')||{}).value||'';
  const search = (document.getElementById('dsp_search')||{}).value||'';
  const startV = (document.getElementById('dsp_startDate')||{}).value||'';
  const endV = (document.getElementById('dsp_endDate')||{}).value||'';

  const filtered = dsp_data.filter(o => {
    if(!o) return false;
    // Narrowed by the day the parcel went out, which is the date on the row.
    // An order still waiting has no dispatch date, so a range excludes it.
    if(startV || endV) {
      const d = parseDMY(o.Dispatch_Date);
      if(!d) return false;
      const s = dayStart(startV), e = dayEnd(endV);
      if(s && d < s) return false;
      if(e && d > e) return false;
    }
    // Same default the table shows: an order handed over by Production carries
    // status 'Ready', and anything blank is treated as Ready too.
    const ds = (o.Dispatch_Status||'Ready').toLowerCase();
    return (!status || ds===status.toLowerCase()) &&
      (!courier || (o.Dispatch_Courier_Name||'').toLowerCase()===courier.toLowerCase()) &&
      (!dealer || (o.Dealer_name||'').toLowerCase()===dealer.toLowerCase()) &&
      (!search || JSON.stringify(o).toLowerCase().includes(search.toLowerCase()));
  });
  dsp_renderTable(filtered);
}
function dspClearFilters() {
  ['dsp_filterStatus','dsp_filterCourier','dsp_filterDealer','dsp_search','dsp_startDate','dsp_endDate'].forEach(id => { const el=document.getElementById(id); if(el) el.value=''; });
  dspApplyFilters();
}
function dsp_renderTable(data) {
  const tbody = document.getElementById('dsp_tbody');
  if(!data.length) { tbody.innerHTML = '<tr><td colspan="13" class="text-center">No orders found.</td></tr>'; return; }
  tbody.innerHTML = data.map((o, i) => {
    const s = o.Dispatch_Status||'Ready';
    let b = 'warning';
    if(s.toLowerCase().includes('dispatched')) b='info';
    if(s.toLowerCase().includes('delivered')) b='success';
    return `<tr>
      <td>${i + 1}</td>
      <td class="fw-bold">${o.ID}</td>
      <td>${o.Dispatch_Date||'-'}</td>
      <td>${o.Dealer_name||''}</td>
      <td>${o.Client_name||''}</td>
      <td>${o.Dispatch_Courier_Name||'-'}</td>
      <td>${o.Docket_No||'-'}</td>
      <td>${o.Invoice_Number||'-'}</td>
      <td>${o.Invoice_Amount||'-'}</td>
      <td>${o.Number_of_Boxes||'-'}</td>
      <td>${o.Weight||'-'}</td>
      <td>${o.Volumetric_Weight||'-'}</td>
      <td><span class="badge bg-${b}">${s}</span></td>
      <td>
        <button class="btn btn-sm btn-info me-1" onclick="dsp_openView('${o.ID}')"><i class="fas fa-eye"></i></button>
        <button class="btn btn-sm btn-primary" onclick="dsp_openEdit('${o.ID}')"><i class="fas fa-shipping-fast"></i></button>
      </td>
    </tr>`;
  }).join('');
}
async function dsp_openView(orderId) {
  const body = document.getElementById('dsp_viewBody');
  body.innerHTML = '<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</div>';
  new bootstrap.Modal(document.getElementById('dsp_viewModal')).show();

  let rowData;
  try {
    const res = await fetch('/api/dashboards/order-details/' + encodeURIComponent(orderId));
    const json = await res.json();
    if (!json.success) throw new Error();
    rowData = json.rowData;
  } catch (e) {
    body.innerHTML = '<div class="alert alert-danger m-3">Could not load this order. Please try again.</div>';
    return;
  }

  const linkKeys = ['Upload the one Design file','Upload Design','Revision Design Upload','Approved Design'];
  let html = '<div class="row">';
  for(const key in rowData) {
    let val = rowData[key]; if(!val||val.toString().trim()==='') continue;
    let isLink = false;
    if((linkKeys.includes(key)||key.toLowerCase().includes('upload'))&&val.toString().includes('http')) {
      val = val.toString().split(/[\n,]+/).map(l=>l.trim().startsWith('http')?`<a href="${l.trim()}" target="_blank" class="btn btn-sm btn-outline-primary m-1"><i class="fas fa-external-link-alt me-1"></i>View File</a>`:'').join(''); isLink=true;
    }
    const col = key.toLowerCase().includes('remark')||key.length>50?'col-12':'col-md-6';
    html += `<div class="${col} view-item"><span class="view-label">${key}</span><div class="${isLink?'':'view-value'}">${val}</div></div>`;
  }
  body.innerHTML = html+'</div>';
}
function dsp_fillCourierSelect(current) {
  const s = document.getElementById('dsp_courier');
  const cur = (current||'').trim();
  const list = dsp_courierList();
  // An order can carry a courier nobody uses any more. Keep it selectable so
  // editing the docket number does not quietly rewrite who carried it.
  if(cur && list.indexOf(cur) < 0) list.push(cur);

  s.innerHTML = '';
  const add = (value, text) => {
    const o = document.createElement('option');
    o.value = value; o.textContent = text;
    s.appendChild(o);
  };
  add('', 'Select courier');
  list.forEach(v => add(v, v));

  s.value = cur;
}

function dsp_openEdit(id) {
  dsp_editId = id;
  const o = dsp_data.find(x => x.ID.toString()===id.toString());
  document.getElementById('dsp_editId').textContent = id;
  dsp_fillCourierSelect(o?.Dispatch_Courier_Name||'');
  document.getElementById('dsp_docket').value = o?.Docket_No||'';
  document.getElementById('dsp_status').value = o?.Dispatch_Status||'Dispatched';
  document.getElementById('dsp_invoiceNo').value = o?.Invoice_Number||'';
  document.getElementById('dsp_invoiceAmount').value = o?.Invoice_Amount||'';
  document.getElementById('dsp_boxes').value = o?.Number_of_Boxes||'';
  document.getElementById('dsp_weight').value = o?.Weight||'';
  document.getElementById('dsp_volWeight').value = o?.Volumetric_Weight||'';
  new bootstrap.Modal(document.getElementById('dsp_editModal')).show();
}
async function dsp_submitUpdate() {
  const val = id => (document.getElementById(id).value||'').trim();
  const body = {
    courier: val('dsp_courier'),
    docket: val('dsp_docket'),
    status: val('dsp_status'),
    invoiceNo: val('dsp_invoiceNo'),
    invoiceAmount: val('dsp_invoiceAmount'),
    boxes: val('dsp_boxes'),
    weight: val('dsp_weight'),
    volWeight: val('dsp_volWeight'),
    userEmail: APP_USER.email,
    userRole: APP_USER.role,
  };
  // The `required` attributes on these inputs do nothing — the modal is not a
  // form and never submits — so an order could be marked Dispatched with no
  // way to trace the parcel. Check it here instead.
  if(body.status !== 'Ready' && (!body.courier || !body.docket)) {
    showToast('warning','Courier name and tracking number are required before marking an order Dispatched.');
    return;
  }
  // Boxes and the two weights each count something real, so nothing below
  // one and never a negative. min= on the inputs is decoration for the same
  // reason as above — the modal never submits, so nothing enforces it.
  for(const [label, raw] of [['Boxes', body.boxes], ['Weight', body.weight], ['Vol. Weight', body.volWeight]]) {
    if(raw === '') continue;
    const n = Number(raw);
    if(!isFinite(n) || n < 1) {
      showToast('warning', label + ' must be 1 or more.');
      return;
    }
  }
  showLoading(true);
  try {
    const res = await fetch(`/api/dashboards/dispatch/${dsp_editId}`, {method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const json = await res.json();
    showLoading(false);
    if(json.success) { bootstrap.Modal.getInstance(document.getElementById('dsp_editModal')).hide(); showToast('success','Dispatch Updated!'); fetchDispatchData(); }
    else showToast('error', json.error);
  } catch(e) { showLoading(false); showToast('error','Server error.'); }
}

// One click on the production modal sends an order here, and it is easy to hit
// against the wrong row. This undoes it. The dispatch date goes with it, which
// is the part worth stopping to read, so the confirmation says so plainly.
async function dsp_revertToProduction() {
  const id = dsp_editId;
  const o = dsp_data.find(x => x.ID.toString() === id.toString());
  const hasDate = !!(o && o.Dispatch_Date);

  const confirmed = await Swal.fire({
    title: 'Send back to Production?',
    html: `Order <b>${id}</b> will leave the Dispatch Dashboard and return to the <b>Production queue</b>.`
      + (hasDate ? `<br><br>Its dispatch date (<b>${o.Dispatch_Date}</b>) will be cleared.` : '')
      + `<br><br><span class="text-muted small">Courier, docket and invoice details are kept.</span>`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Back to Production',
    confirmButtonColor: '#fd7e14',
  });
  if(!confirmed.isConfirmed) return;

  showLoading(true);
  try {
    const res = await fetch(`/api/dashboards/dispatch/${id}/revert`, {
      method: 'PUT',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ userEmail: APP_USER.email }),
    });
    const json = await res.json();
    showLoading(false);
    if(!json.success) { showToast('error', json.error || 'Could not send it back.'); return; }

    bootstrap.Modal.getInstance(document.getElementById('dsp_editModal')).hide();
    fetchDispatchData();

    // Off Dispatch is certain; back on Production is not. An order still
    // sitting at "Proofing Done" with no stage finished does not qualify for
    // that queue, and saying nothing would leave someone hunting for it.
    if(json.onProductionBoard) {
      showToast('success', `${id} is back on the Production Dashboard.`);
    } else {
      Swal.fire({
        title: 'Taken off Dispatch',
        html: `Order <b>${id}</b> is no longer on the Dispatch Dashboard, but it does not appear on the Production queue either`
          + ` - its client approval is still <b>Proofing Done</b> (or blank) and no production stage is marked done.`
          + `<br><br>Set the approval on <b>Till Approval</b>, or mark a stage done, and it will show up there.`,
        icon: 'info',
        confirmButtonText: 'Got it',
      });
    }
  } catch(e) { showLoading(false); showToast('error','Server error.'); }
}
</script>
