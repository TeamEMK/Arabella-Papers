<%# User Activity — one person, both logs, in order %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-dark fw-bold"><i class="fas fa-user-clock me-2"></i>User Activity</h3>
    <button class="btn btn-outline-dark smooth-ui text-dark fw-bold" onclick="refreshBoard(this, uaFetch, 'entries')">
      <i class="fas fa-sync-alt me-1"></i> Refresh
    </button>
  </div>

  <div class="card bg-light-glass mb-3 shadow-sm">
    <div class="card-body p-2">
      <div class="row g-2 align-items-end text-dark">
        <div class="col-12 col-md-4">
          <label class="form-label fw-bold small mb-0">Person</label>
          <select id="ua_user" class="form-select form-select-sm" onchange="uaFetch()">
            <option value="">Choose somebody...</option>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <label class="form-label fw-bold small mb-0">Start</label>
          <input type="date" id="ua_from" class="form-control form-control-sm" onchange="uaFetch()">
        </div>
        <div class="col-6 col-md-2">
          <label class="form-label fw-bold small mb-0">End</label>
          <input type="date" id="ua_to" class="form-control form-control-sm" onchange="uaFetch()">
        </div>
        <div class="col-6 col-md-2">
          <label class="form-label fw-bold small mb-0">Show</label>
          <select id="ua_kind" class="form-select form-select-sm" onchange="uaRender()">
            <option value="">Everything</option>
            <option value="Order">Order work</option>
            <option value="Account">Logins</option>
          </select>
        </div>
        <div class="col-6 col-md-2 text-end">
          <button class="btn btn-secondary btn-sm w-100" onclick="uaClear()">Clear</button>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-3" id="ua_cards" style="display:none;">
    <div class="col-6 col-md-3"><div class="card shadow smooth-ui kpi-card" style="border-left:4px solid #0d6efd;"><div class="card-body p-3"><h6 class="text-muted mb-1 small">Logins</h6><h3 class="fw-bold text-primary mb-0" id="ua_logins">--</h3></div></div></div>
    <div class="col-6 col-md-3"><div class="card shadow smooth-ui kpi-card" style="border-left:4px solid #198754;"><div class="card-body p-3"><h6 class="text-muted mb-1 small">Order actions</h6><h3 class="fw-bold text-success mb-0" id="ua_orders">--</h3></div></div></div>
    <div class="col-6 col-md-3"><div class="card shadow smooth-ui kpi-card" style="border-left:4px solid #6c757d;"><div class="card-body p-3"><h6 class="text-muted mb-1 small">First seen</h6><div class="fw-bold text-dark" id="ua_first">--</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card shadow smooth-ui kpi-card" style="border-left:4px solid #6c757d;"><div class="card-body p-3"><h6 class="text-muted mb-1 small">Last seen</h6><div class="fw-bold text-dark" id="ua_last">--</div></div></div></div>
  </div>

  <div class="card bg-light-glass shadow-lg">
    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
      <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-list-ul me-2"></i>Timeline</h5>
      <span class="text-muted small" id="ua_count"></span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive" style="max-height:60vh;overflow:auto;">
        <table class="table table-hover table-sm mb-0 align-middle">
          <thead class="table-dark">
            <tr>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">#</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">When</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">What</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Order</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Field</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">From</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">To</th>
            </tr>
          </thead>
          <tbody id="ua_tbody">
            <tr><td colspan="7" class="text-center py-4 text-muted">Choose somebody above.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
var ua_rows = [];

var ua_esc = v => String(v == null ? '' : v)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// The API hands back whatever MySQL gives for a DATETIME. Read as a plain
// local time: these are IST wall-clock values and re-zoning them here would
// move every entry by five and a half hours.
function ua_when(v) {
  if (!v) return '-';
  const s = String(v).replace('T', ' ').replace('Z', '');
  const d = new Date(s.slice(0, 19).replace(' ', 'T'));
  if (isNaN(d)) return ua_esc(s.slice(0, 16));
  return d.toLocaleString('en-GB', {
    day: '2-digit', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit', hour12: true,
  });
}

// Account entries are the ones that say nothing about an order, so they are
// the ones worth marking - a wall of identical "Updated" rows with the odd
// Login in it is hard to read otherwise.
var UA_PILL = {
  Login: 'primary', Logout: 'secondary', 'Bulk Import': 'info',
  Created: 'success', Updated: 'light', 'Correction raised': 'danger',
  'Correction done': 'success', 'Dispatch Notice': 'info',
};

async function uaPeople() {
  const sel = document.getElementById('ua_user');
  try {
    const json = await fetch('/api/user-activity/people').then(r => r.json());
    if (!json.success) return;
    sel.innerHTML = '<option value="">Choose somebody...</option>'
      + (json.data || []).map(p =>
        '<option value="' + p.id + '">' + ua_esc(p.username)
        + (p.role ? ' — ' + ua_esc(p.role) : '') + '</option>').join('');
  } catch (e) { /* the table below says enough */ }
}

window.uaFetch = async function () {
  const userId = (document.getElementById('ua_user') || {}).value || '';
  const tbody = document.getElementById('ua_tbody');
  const cards = document.getElementById('ua_cards');

  if (!userId) {
    ua_rows = [];
    cards.style.display = 'none';
    document.getElementById('ua_count').textContent = '';
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Choose somebody above.</td></tr>';
    return 0;
  }

  const params = new URLSearchParams({ userId: userId });
  const put = (key, id) => {
    const v = (document.getElementById(id) || {}).value || '';
    if (v.trim()) params.set(key, v.trim());
  };
  put('from', 'ua_from');
  put('to', 'ua_to');

  tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr>';

  const json = await fetch('/api/user-activity?' + params.toString()).then(r => r.json());
  if (!json.success) {
    cards.style.display = 'none';
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">'
      + ua_esc(json.error || 'Could not load this.') + '</td></tr>';
    return 0;
  }

  ua_rows = json.data || [];
  const s = json.summary || {};
  cards.style.display = '';
  document.getElementById('ua_logins').textContent = s.logins == null ? '--' : s.logins;
  document.getElementById('ua_orders').textContent = s.orderActions == null ? '--' : s.orderActions;
  document.getElementById('ua_first').textContent = ua_when(s.firstSeen);
  document.getElementById('ua_last').textContent = ua_when(s.lastSeen);

  uaRender();
  return ua_rows.length;
};

window.uaRender = function () {
  const kind = (document.getElementById('ua_kind') || {}).value || '';
  const rows = ua_rows.filter(r => !kind || r.Kind === kind);
  const tbody = document.getElementById('ua_tbody');

  document.getElementById('ua_count').textContent = rows.length
    ? rows.length + ' entries' + (ua_rows.length >= 500 ? ' (newest 500)' : '')
    : '';

  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Nothing recorded for this filter.</td></tr>';
    return;
  }

  tbody.innerHTML = rows.map((r, i) =>
    '<tr>'
    + '<td>' + (i + 1) + '</td>'
    + '<td class="text-muted text-nowrap">' + ua_when(r.At) + '</td>'
    + '<td><span class="badge bg-' + (UA_PILL[r.Action] || 'light')
      + (UA_PILL[r.Action] && UA_PILL[r.Action] !== 'light' ? '' : ' text-dark')
      + '">' + ua_esc(r.Action) + '</span></td>'
    + '<td class="fw-bold">' + (ua_esc(r.Order_ID) || '-') + '</td>'
    + '<td>' + (ua_esc(r.Field) || '-') + '</td>'
    + '<td class="small text-muted">' + (ua_esc(r.Old_Value) || '-') + '</td>'
    + '<td class="small">' + (ua_esc(r.New_Value) || '-') + '</td>'
    + '</tr>').join('');
};

window.uaClear = function () {
  ['ua_from', 'ua_to', 'ua_kind'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  uaFetch();
};

uaPeople();
</script>
