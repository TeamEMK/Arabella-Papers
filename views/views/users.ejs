<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-dark fw-bold">User Management</h3>
    <div>
      <button class="btn btn-outline-dark smooth-ui text-dark fw-bold me-2" onclick="usrFetch()">
        <i class="fas fa-sync-alt me-1"></i> Refresh
      </button>
      <button class="btn btn-primary fw-bold" onclick="usrOpenForm()">
        <i class="fas fa-user-plus me-1"></i> Add User
      </button>
    </div>
  </div>

  <div class="card bg-light-glass shadow-lg">
    <div class="card-header bg-transparent border-0">
      <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-users me-2"></i>Accounts</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive" data-fill-height style="overflow-y:auto;position:relative;">
        <table class="table table-hover table-striped mb-0 text-nowrap" style="border-collapse:separate;border-spacing:0;">
          <thead class="table-dark">
            <tr>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Name</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Emp ID</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Email</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Role</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Domain</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Last Login</th>
              <th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">Action</th>
            </tr>
          </thead>
          <tbody id="usr_tbody">
            <tr><td colspan="7" class="text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ADD / EDIT USER MODAL -->
<div class="modal fade" id="usr_formModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="usr_formTitle">Add User</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="usr_form" autocomplete="off">
        <div class="modal-body">
          <div id="usr_formError" class="alert alert-danger py-2 small d-none"></div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold text-dark" for="usr_username">Name</label>
              <input type="text" class="form-control" id="usr_username" required/>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold text-dark" for="usr_empId">Emp ID</label>
              <input type="text" class="form-control" id="usr_empId" placeholder="EMP002"/>
            </div>
            <div class="col-12">
              <label class="form-label fw-bold text-dark" for="usr_email">Email</label>
              <input type="email" class="form-control" id="usr_email" required/>
            </div>
            <div class="col-md-7">
              <label class="form-label fw-bold text-dark" for="usr_role">Role</label>
              <select class="form-select" id="usr_role" required></select>
            </div>
            <div class="col-md-5">
              <label class="form-label fw-bold text-dark" for="usr_domain">Domain</label>
              <select class="form-select" id="usr_domain">
                <option value="">None</option>
                <option value="Head">Head</option>
              </select>
              <div class="form-text">Head unlocks Orders, Till Approval and Analytics.</div>
            </div>
            <div class="col-12">
              <label class="form-label fw-bold text-dark" for="usr_password">Password</label>
              <input type="password" class="form-control" id="usr_password" minlength="8" autocomplete="new-password"/>
              <div class="form-text" id="usr_passwordHint">At least 8 characters.</div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="usr_submit">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function () {
  let usrRows = [];
  let usrCurrentId = null;
  let usrEditingId = null;
  let usrModal = null;

  function esc(v) {
    return String(v === null || v === undefined ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function fmtDate(v) {
    if (!v) return '<span class="text-muted">Never</span>';
    const d = new Date(v);
    return isNaN(d) ? esc(v) : d.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' });
  }

  function roleBadge(role) {
    const tone = role === 'SuperAdmin' ? 'danger'
      : role === 'Accounts' ? 'success'
      : role.indexOf('Production') === 0 ? 'warning text-dark'
      : role === 'TillApprover' ? 'info text-dark'
      : 'secondary';
    return '<span class="badge bg-' + tone + '">' + esc(role) + '</span>';
  }

  window.usrFetch = async function () {
    const tbody = document.getElementById('usr_tbody');
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr>';
    try {
      const res = await fetch('/api/users');
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Could not load users.');

      usrRows = data.users;
      usrCurrentId = data.currentUserId;

      const select = document.getElementById('usr_role');
      select.innerHTML = data.roles.map(function (r) {
        return '<option value="' + esc(r) + '">' + esc(r) + '</option>';
      }).join('');

      usrRender();
    } catch (err) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">' + esc(err.message) + '</td></tr>';
    }
  };

  function usrRender() {
    const tbody = document.getElementById('usr_tbody');
    if (!usrRows.length) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No users yet.</td></tr>';
      return;
    }
    tbody.innerHTML = usrRows.map(function (u) {
      const isSelf = u.id === usrCurrentId;
      return '<tr>'
        + '<td class="fw-bold">' + esc(u.username)
        + (isSelf ? ' <span class="badge bg-light text-dark border ms-1">you</span>' : '') + '</td>'
        + '<td>' + esc(u.emp_id) + '</td>'
        + '<td>' + esc(u.email) + '</td>'
        + '<td>' + roleBadge(u.role || '') + '</td>'
        + '<td>' + (u.domain ? esc(u.domain) : '<span class="text-muted">—</span>') + '</td>'
        + '<td>' + fmtDate(u.last_login) + '</td>'
        + '<td>'
        + '<button class="btn btn-sm btn-outline-primary me-1" onclick="usrOpenForm(' + u.id + ')" title="Edit">'
        + '<i class="fas fa-pen"></i></button>'
        + '<button class="btn btn-sm btn-outline-danger" onclick="usrDelete(' + u.id + ')" title="Delete"'
        + (isSelf ? ' disabled' : '') + '><i class="fas fa-trash"></i></button>'
        + '</td>'
        + '</tr>';
    }).join('');
  }

  function usrError(message) {
    const box = document.getElementById('usr_formError');
    box.textContent = message;
    box.classList.remove('d-none');
  }

  window.usrOpenForm = function (id) {
    const user = id ? usrRows.find(function (u) { return u.id === id; }) : null;
    usrEditingId = user ? user.id : null;

    document.getElementById('usr_form').reset();
    document.getElementById('usr_formError').classList.add('d-none');
    document.getElementById('usr_formTitle').textContent = user ? 'Edit User' : 'Add User';
    document.getElementById('usr_username').value = user ? user.username : '';
    document.getElementById('usr_empId').value = user ? (user.emp_id || '') : '';
    document.getElementById('usr_email').value = user ? user.email : '';
    document.getElementById('usr_role').value = user ? user.role : 'Designer';
    document.getElementById('usr_domain').value = user ? (user.domain || '') : '';
    document.getElementById('usr_password').value = '';

    // On edit the password field is optional — blank means "leave it alone".
    document.getElementById('usr_password').required = !user;
    document.getElementById('usr_passwordHint').textContent = user
      ? 'Leave blank to keep the current password.'
      : 'At least 8 characters.';

    if (!usrModal) usrModal = new bootstrap.Modal(document.getElementById('usr_formModal'));
    usrModal.show();
  };

  document.getElementById('usr_form').addEventListener('submit', async function (e) {
    e.preventDefault();
    const btn = document.getElementById('usr_submit');
    document.getElementById('usr_formError').classList.add('d-none');

    const payload = {
      username: document.getElementById('usr_username').value.trim(),
      empId: document.getElementById('usr_empId').value.trim(),
      email: document.getElementById('usr_email').value.trim(),
      role: document.getElementById('usr_role').value,
      domain: document.getElementById('usr_domain').value,
      password: document.getElementById('usr_password').value,
    };

    btn.disabled = true;
    try {
      const res = await fetch(usrEditingId ? '/api/users/' + usrEditingId : '/api/users', {
        method: usrEditingId ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (data.success) {
        usrModal.hide();
        showToast('success', usrEditingId ? 'User updated' : 'User created');
        usrFetch();
      } else {
        usrError(data.error || 'Could not save the user.');
      }
    } catch (err) {
      usrError('Network error. Please try again.');
    } finally {
      btn.disabled = false;
    }
  });

  window.usrDelete = async function (id) {
    const user = usrRows.find(function (u) { return u.id === id; });
    if (!user) return;

    const confirmed = await Swal.fire({
      title: 'Delete this user?',
      html: '<b>' + esc(user.username) + '</b><br><span class="text-muted">' + esc(user.email) + '</span>',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Delete',
      confirmButtonColor: '#dc3545',
    });
    if (!confirmed.isConfirmed) return;

    showLoading(true);
    try {
      const res = await fetch('/api/users/' + id, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        showToast('success', 'User deleted');
        usrFetch();
      } else {
        showToast('error', data.error || 'Could not delete the user.');
      }
    } catch (err) {
      showToast('error', 'Network error. Please try again.');
    } finally {
      showLoading(false);
    }
  };

  usrFetch();
})();
</script>
