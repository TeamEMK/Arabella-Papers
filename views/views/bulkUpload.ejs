<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-dark fw-bold">Bulk Upload</h3>
  </div>

  <div class="card bg-light-glass shadow-sm mb-4">
    <div class="card-body">
      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
          <label class="form-label fw-bold text-dark small mb-1" for="blk_type">What are you importing?</label>
          <select id="blk_type" class="form-select" onchange="blkReset()">
            <option value="orders">Orders</option>
            <option value="dealers">Dealers</option>
            <option value="designers">Designers</option>
          </select>
        </div>
        <div class="col-12 col-md-5">
          <label class="form-label fw-bold text-dark small mb-1" for="blk_file">File (.xlsx or .csv)</label>
          <input type="file" id="blk_file" class="form-control" accept=".xlsx,.csv,text/csv" onchange="blkPreview()"/>
        </div>
        <div class="col-12 col-md-4 text-md-end">
          <button class="btn btn-outline-dark fw-bold me-2" onclick="blkTemplate()">
            <i class="fas fa-download me-1"></i> Template
          </button>
          <button class="btn btn-success fw-bold" id="blk_importBtn" onclick="blkImport()" disabled>
            <i class="fas fa-cloud-upload-alt me-1"></i> Import
          </button>
        </div>
      </div>

      <div class="mt-3 small text-muted" id="blk_columnHint"></div>
    </div>
  </div>

  <div id="blk_alert"></div>

  <div class="card bg-light-glass shadow-lg d-none" id="blk_previewCard">
    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
      <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-table me-2"></i>Preview</h5>
      <div id="blk_summary"></div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive" style="max-height:460px;overflow-y:auto;position:relative;">
        <table class="table table-hover table-striped mb-0 text-nowrap" style="border-collapse:separate;border-spacing:0;">
          <thead class="table-dark"><tr id="blk_thead"></tr></thead>
          <tbody id="blk_tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const COLUMNS = {
    orders: ['Email Address', 'Order Punched By', 'Name of Dealer', 'Client Name', 'Remarks / Subject Line', 'Designer', 'Possible Design Time'],
    dealers: ['Dealer Name', 'Email', 'Mobile No'],
    designers: ['Designer Name', 'Email'],
  };
  const KEYS = {
    orders: ['email', 'punchedBy', 'dealer', 'client', 'remarks', 'designer', 'designTime'],
    dealers: ['name', 'email', 'mobile'],
    designers: ['name', 'email'],
  };

  let blkRows = [];

  function esc(v) {
    return String(v === null || v === undefined ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function alertBox(tone, html) {
    document.getElementById('blk_alert').innerHTML =
      '<div class="alert alert-' + tone + '">' + html + '</div>';
  }

  function currentType() {
    return document.getElementById('blk_type').value;
  }

  function showColumnHint() {
    const cols = COLUMNS[currentType()];
    document.getElementById('blk_columnHint').innerHTML =
      '<i class="fas fa-info-circle me-1"></i>Expected headers in row 1: '
      + cols.map(function (c) { return '<code>' + esc(c) + '</code>'; }).join(' &nbsp;');
  }

  window.blkReset = function () {
    blkRows = [];
    document.getElementById('blk_file').value = '';
    document.getElementById('blk_alert').innerHTML = '';
    document.getElementById('blk_previewCard').classList.add('d-none');
    document.getElementById('blk_importBtn').disabled = true;
    showColumnHint();
  };

  window.blkTemplate = function () {
    window.location.href = '/api/bulk/template/' + currentType();
  };

  window.blkPreview = async function () {
    const input = document.getElementById('blk_file');
    if (!input.files.length) return;

    document.getElementById('blk_alert').innerHTML = '';
    document.getElementById('blk_previewCard').classList.add('d-none');
    document.getElementById('blk_importBtn').disabled = true;
    showLoading(true);

    const body = new FormData();
    body.append('type', currentType());
    body.append('file', input.files[0]);

    try {
      const res = await fetch('/api/bulk/preview', { method: 'POST', body: body });
      const data = await res.json();
      if (!data.success) {
        alertBox('danger', '<i class="fas fa-times-circle me-2"></i>' + esc(data.error));
        return;
      }
      blkRows = data.rows;
      renderPreview(data.summary);
      document.getElementById('blk_importBtn').disabled = data.summary.ready === 0;
      if (data.summary.ready === 0) {
        alertBox('warning', '<i class="fas fa-exclamation-triangle me-2"></i>No row is ready to import. Fix the problems below and upload again.');
      }
    } catch (err) {
      alertBox('danger', 'Could not read that file. Please try again.');
    } finally {
      showLoading(false);
    }
  };

  function renderPreview(summary) {
    const type = currentType();
    const cols = COLUMNS[type];
    const keys = KEYS[type];

    document.getElementById('blk_summary').innerHTML =
      '<span class="badge bg-success me-1">' + summary.ready + ' ready</span>'
      + (summary.skipped ? '<span class="badge bg-secondary me-1">' + summary.skipped + ' skipped</span>' : '')
      + (summary.invalid ? '<span class="badge bg-danger">' + summary.invalid + ' with errors</span>' : '');

    document.getElementById('blk_thead').innerHTML =
      ['Row', 'Status'].concat(cols).map(function (h) {
        return '<th style="position:sticky;top:0;z-index:1020;background:#212529;color:white;border-top:0;">' + esc(h) + '</th>';
      }).join('');

    document.getElementById('blk_tbody').innerHTML = blkRows.map(function (r) {
      let status, rowClass;
      if (r.errors.length) {
        status = '<span class="badge bg-danger">Error</span>';
        rowClass = ' class="table-danger"';
      } else if (r.data.__skip) {
        status = '<span class="badge bg-secondary">Skip</span>';
        rowClass = ' class="table-secondary"';
      } else {
        status = '<span class="badge bg-success">Ready</span>';
        rowClass = '';
      }

      const notes = r.errors.concat(r.warnings);
      const noteHtml = notes.length
        ? '<div class="small ' + (r.errors.length ? 'text-danger' : 'text-muted') + '">'
          + notes.map(esc).join('<br>') + '</div>'
        : '';

      return '<tr' + rowClass + '>'
        + '<td class="fw-bold">' + r.line + '</td>'
        + '<td>' + status + noteHtml + '</td>'
        + keys.map(function (k) {
            return '<td>' + esc(r.data[k]) + '</td>';
          }).join('')
        + '</tr>';
    }).join('');

    document.getElementById('blk_previewCard').classList.remove('d-none');
  }

  window.blkImport = async function () {
    const ready = blkRows.filter(function (r) { return !r.errors.length && !r.data.__skip; });
    if (!ready.length) return;

    const confirmed = await Swal.fire({
      title: 'Import ' + ready.length + ' rows?',
      text: 'Rows with errors and duplicates will be left out.',
      icon: 'question',
      showCancelButton: true,
      confirmButtonText: 'Import',
    });
    if (!confirmed.isConfirmed) return;

    showLoading(true);
    document.getElementById('blk_importBtn').disabled = true;
    try {
      const res = await fetch('/api/bulk/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          type: currentType(),
          rows: ready.map(function (r) { return { line: r.line, data: r.data }; }),
        }),
      });
      const data = await res.json();
      if (data.success) {
        showToast('success', data.imported + ' rows imported');
        alertBox('success', '<i class="fas fa-check-circle me-2"></i><b>' + data.imported
          + '</b> rows imported successfully.'
          + (data.rejected && data.rejected.length
            ? ' ' + data.rejected.length + ' were rejected on a second check.' : ''));
        blkRows = [];
        document.getElementById('blk_previewCard').classList.add('d-none');
        document.getElementById('blk_file').value = '';
      } else {
        alertBox('danger', '<i class="fas fa-times-circle me-2"></i>' + esc(data.error));
        document.getElementById('blk_importBtn').disabled = false;
      }
    } catch (err) {
      alertBox('danger', 'Import failed. Please try again.');
      document.getElementById('blk_importBtn').disabled = false;
    } finally {
      showLoading(false);
    }
  };

  showColumnHint();
})();
</script>
