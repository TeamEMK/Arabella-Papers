<%# PMS Dashboard — the four figures, the step-wise pipeline, what ships this
    week and what came in last. The pipeline is the point of the page: it says
    where orders are piling up, which no list of orders can show at a glance. %>
<div class="container-fluid py-4" id="pmRoot">
  <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
      <h3 class="mb-0 text-dark fw-bold"><i class="fas fa-gauge-high me-2"></i>PMS Dashboard</h3>
      <div class="text-muted small" id="pm_sub">Where every order is, and what is waiting.</div>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-dark smooth-ui text-dark fw-bold" onclick="loadPage('pmsTasks')"><i class="fas fa-list-check me-1"></i> My Tasks</button>
      <button class="btn btn-outline-dark smooth-ui text-dark fw-bold" onclick="refreshBoard(this, pm_load, 'pms')"><i class="fas fa-sync-alt me-1"></i> Refresh</button>
    </div>
  </div>

  <div class="alert alert-secondary d-none" id="pm_offWarn">
    <i class="fas fa-circle-info me-1"></i>
    <b>The step board is off.</b> No order is getting steps yet. Set the start
    date in <b>Step Settings</b> to switch it on — orders punched from that day
    join the board, and everything older is left alone.
  </div>

  <div class="row g-3 mb-3 row-cols-2 row-cols-lg-4">
    <div class="col">
      <div class="card shadow smooth-ui kpi-card" style="cursor:pointer;border-left:4px solid #198754;" onclick="pm_go('active')">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-2 mb-1">
            <i class="fas fa-box text-success"></i><h6 class="text-muted mb-0 small">Active Orders</h6>
          </div>
          <h3 class="fw-bold text-success mb-0" id="pm_n_running">--</h3>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card shadow smooth-ui kpi-card" style="cursor:pointer;border-left:4px solid #dc3545;" onclick="pm_go('late')">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-2 mb-1">
            <i class="fas fa-triangle-exclamation text-danger"></i><h6 class="text-muted mb-0 small">Delayed Orders</h6>
          </div>
          <h3 class="fw-bold text-danger mb-0" id="pm_n_late">--</h3>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card shadow smooth-ui kpi-card" style="cursor:pointer;border-left:4px solid #0d6efd;" onclick="loadPage('pmsTasks')">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-2 mb-1">
            <i class="fas fa-square-check text-primary"></i><h6 class="text-muted mb-0 small">My Pending Tasks</h6>
          </div>
          <h3 class="fw-bold text-primary mb-0" id="pm_n_mine">--</h3>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card shadow smooth-ui kpi-card" style="border-left:4px solid #6c757d;">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-2 mb-1">
            <i class="fas fa-circle-check text-secondary"></i><h6 class="text-muted mb-0 small">Completed (this month)</h6>
          </div>
          <h3 class="fw-bold text-secondary mb-0" id="pm_n_done">--</h3>
        </div>
      </div>
    </div>
  </div>

  <!-- THE PIPELINE. Every step, in order, with what is sitting on it. This is
       the screen that answers "where is the work stuck", which a list of
       orders sorted by date cannot. -->
  <div class="card shadow smooth-ui mb-3">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h5 class="mb-0 fw-bold"><i class="fas fa-diagram-project me-2"></i>Step-wise Pipeline</h5>
        <div class="d-flex align-items-center gap-2">
          <span class="text-muted small d-none d-md-inline">Pending orders at each step · click to view</span>
          <button class="btn btn-sm btn-outline-secondary smooth-ui" onclick="pm_scroll(-1)"><i class="fas fa-chevron-left"></i></button>
          <button class="btn btn-sm btn-outline-secondary smooth-ui" onclick="pm_scroll(1)"><i class="fas fa-chevron-right"></i></button>
        </div>
      </div>
      <div class="d-flex gap-2 pb-2" id="pm_pipe"
           style="overflow-x:auto;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;"></div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-6">
      <div class="card shadow smooth-ui h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 fw-bold"><i class="far fa-calendar me-2"></i>Upcoming Deliveries</h6>
            <a href="javascript:void(0)" class="small" onclick="pm_go('late')">View delayed &rarr;</a>
          </div>
          <div id="pm_upcoming"></div>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-6">
      <div class="card shadow smooth-ui h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 fw-bold"><i class="fas fa-box me-2"></i>Recent Orders</h6>
            <a href="javascript:void(0)" class="small" onclick="pm_go('all')">View all &rarr;</a>
          </div>
          <div id="pm_recent"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// `var`, prefixed. loadPage() re-runs this whole script every time the tab is
// opened, and a top-level `const` is a parse error the second time.
var pm_data = null;

function pm_esc(s) {
  return String(s === null || s === undefined ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/** 'YYYY-MM-DD...' -> '12 Oct'. Already IST; nothing is converted here. */
function pm_day(s) {
  if (!s) return '';
  var m = String(s).match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (!m) return String(s);
  var MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return Number(m[3]) + ' ' + MON[Number(m[2]) - 1] + ' ' + m[1];
}

function pm_ago(s) {
  if (!s) return '';
  var t = Date.parse(String(s).replace(' ', 'T') + '+05:30');
  if (isNaN(t)) return '';
  var h = Math.floor((Date.now() - t) / 3600000);
  if (h < 1) return 'just now';
  if (h < 24) return h + ' hour' + (h === 1 ? '' : 's') + ' ago';
  var d = Math.floor(h / 24);
  return d + ' day' + (d === 1 ? '' : 's') + ' ago';
}

/** Hand the Orders tab a filter to open on. */
function pm_go(which) {
  try { sessionStorage.setItem('pmsOrdersTab', which); } catch (e) {}
  loadPage('pmsOrders');
}

function pm_scroll(dir) {
  var el = document.getElementById('pm_pipe');
  el.scrollLeft += dir * Math.max(240, el.clientWidth * 0.8);
}

async function pm_load() {
  try {
    var r = await fetch('/api/pms/dashboard');
    var j = await r.json();
    if (!j.success) throw new Error(j.error || 'Could not load.');
    pm_data = j;

    document.getElementById('pm_n_running').textContent = j.counts.running;
    document.getElementById('pm_n_late').textContent = j.counts.late;
    document.getElementById('pm_n_mine').textContent = j.counts.mine;
    document.getElementById('pm_n_done').textContent = j.counts.finishedThisMonth;

    var sub = j.counts.mine
      ? 'You have ' + j.counts.mine + ' step' + (j.counts.mine === 1 ? '' : 's') + ' waiting.'
      : 'You have no pending steps.';
    document.getElementById('pm_sub').textContent = sub;

    // The board being off is the explanation for every zero on this page, so
    // say it rather than letting the screen look merely quiet.
    document.getElementById('pm_offWarn').classList.toggle('d-none', j.counts.running > 0
      || j.pipeline.some(function (p) { return p.pending > 0; }));

    pm_drawPipe(j.pipeline);
    pm_drawUpcoming(j.upcoming);
    pm_drawRecent(j.recent);
  } catch (e) {
    document.getElementById('pm_pipe').innerHTML =
      '<div class="text-danger p-3">' + pm_esc(e.message) + '</div>';
  }
}

function pm_drawPipe(pipe) {
  var total = pipe.reduce(function (a, p) { return a + p.pending; }, 0);

  var all = '<div class="flex-shrink-0 rounded p-3 text-white" style="min-width:190px;'
    + 'cursor:pointer;background:#4b5320;" onclick="pm_go(\'active\')">'
    + '<div class="small opacity-75">ALL</div>'
    + '<div class="fw-bold">All Orders · Full Data</div>'
    + '<div class="mt-3 d-flex justify-content-between align-items-end">'
    + '<span class="fs-4 fw-bold">' + total + '</span>'
    + '<span class="badge bg-light text-dark">' + total + ' pending</span></div></div>';

  var cards = pipe.map(function (p) {
    var hot = p.late > 0;
    var dim = p.pending === 0;
    return '<div class="flex-shrink-0 rounded p-3 border' + (hot ? ' border-danger' : '')
      + (dim ? ' bg-light' : ' bg-white')
      + '" style="min-width:190px;cursor:pointer;' + (hot ? 'border-width:2px;' : '')
      + '" onclick="pm_go(\'step:' + p.step_order + '\')">'
      + '<div class="small text-muted">STEP ' + p.step_order + '</div>'
      + '<div class="fw-semibold' + (dim ? ' text-muted' : '') + '" style="min-height:2.6em;line-height:1.3;">'
      + pm_esc(p.name) + '</div>'
      + (p.tat_days === null
        ? '<div class="small text-warning-emphasis">no TAT</div>'
        : '<div class="small text-muted">TAT ' + p.tat_days + 'd</div>')
      + '<div class="mt-2 d-flex justify-content-between align-items-end">'
      + '<span class="fs-5 fw-bold' + (dim ? ' text-muted' : '') + '">' + p.pending
      + '</span><span class="small text-muted">pending</span>'
      + '</div>'
      + (hot ? '<div class="mt-1"><span class="badge bg-danger-subtle text-danger-emphasis">'
        + p.late + ' late</span></div>' : '')
      + '</div>';
  }).join('');

  document.getElementById('pm_pipe').innerHTML = all + cards;
}

function pm_drawUpcoming(list) {
  var el = document.getElementById('pm_upcoming');
  if (!list || !list.length) {
    el.innerHTML = '<div class="text-muted small py-3">Nothing with a dispatch date set.</div>';
    return;
  }
  el.innerHTML = list.map(function (o) {
    return '<div class="d-flex justify-content-between align-items-start py-2 border-bottom">'
      + '<div><div class="fw-semibold">' + pm_esc(o.order_id) + ' · ' + pm_esc(o.client_name || '') + '</div>'
      + '<div class="small text-muted">' + pm_esc(o.dealer_name || '')
      + (o.order_type ? ' · ' + pm_esc(o.order_type) : '') + '</div></div>'
      + '<div class="text-end"><span class="badge '
      + (o.late > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-light text-dark border') + '">'
      + pm_day(o.due) + '</span>'
      + '<div class="small text-muted">Step ' + o.step_order + '</div></div>'
      + '</div>';
  }).join('');
}

function pm_drawRecent(list) {
  var el = document.getElementById('pm_recent');
  if (!list || !list.length) {
    el.innerHTML = '<div class="text-muted small py-3">No orders on the board yet.</div>';
    return;
  }
  el.innerHTML = list.map(function (o) {
    return '<div class="d-flex justify-content-between align-items-start py-2 border-bottom">'
      + '<div><div class="fw-semibold">' + pm_esc(o.order_id) + ' · ' + pm_esc(o.client_name || '') + '</div>'
      + '<div class="small text-muted">' + pm_esc(o.dealer_name || '') + ' · ' + pm_ago(o.timestamp) + '</div></div>'
      + '<div class="text-end">' + (o.step_order
        ? '<span class="badge bg-secondary">S' + o.step_order + ' · ' + pm_esc(o.step_name) + '</span>'
        : '<span class="badge bg-success-subtle text-success-emphasis">Completed</span>')
      + '</div></div>';
  }).join('');
}

pm_load();
</script>
