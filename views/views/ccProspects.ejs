<%# ══════════════════════════════════════════════════════
    CARLSON CRAFT RETAILERS

    The board is the fifty states, because that is how the work divides:
    somebody takes a state, works its regions, moves on. Clicking a state
    opens its regions and its shops underneath, so the whole thing is one
    page rather than a list you have to go back from.

    The counts are worked out in the database. Reading 7,041 rows into the
    page to add them up would be most of a megabyte before anything is drawn.
 ══════════════════════════════════════════════════════ %>
<div class="container-fluid py-3">

  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h4 class="mb-0 fw-bold">
      <i class="fas fa-store me-2 text-primary"></i>CC Prospects
      <span class="text-muted fw-normal fs-6 ms-2">Carlson Craft retailers, by state</span>
    </h4>
    <button class="btn btn-sm btn-outline-dark" onclick="cc_boot()">
      <i class="fas fa-sync-alt me-1"></i>Refresh
    </button>
  </div>

  <div class="row g-2 mb-3" id="cc_tiles"></div>

  <%# ── The fifty states ── %>
  <div class="card bg-light-glass shadow-sm smooth-ui p-2 mb-3">
    <div class="card-body p-2">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h6 class="fw-bold mb-0 me-2">The fifty states</h6>
        <select id="cc_sort" class="form-select form-select-sm" style="max-width:190px" onchange="cc_drawStates()">
          <option value="retailers">Most retailers first</option>
          <option value="with_email">Most with an email</option>
          <option value="with_phone">Most with a phone</option>
          <option value="state">A to Z</option>
        </select>
        <span class="text-muted small ms-auto" id="cc_statesNote"></span>
      </div>
      <div id="cc_states" class="cc-grid"></div>
    </div>
  </div>

  <%# ── One state, opened ── %>
  <div class="card bg-light-glass shadow-sm smooth-ui p-2" id="cc_detail" hidden>
    <div class="card-body p-2">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h6 class="fw-bold mb-0" id="cc_detailTitle"></h6>
        <button class="btn btn-sm btn-link text-decoration-none" onclick="cc_close()">clear</button>
        <div class="ms-auto d-flex flex-wrap gap-2">
          <input type="text" id="cc_q" class="form-control form-control-sm" style="max-width:230px"
                 placeholder="Shop, city, email, phone, ZIP..." onkeyup="cc_debounce()">
          <select id="cc_region" class="form-select form-select-sm" style="max-width:220px" onchange="cc_list()"></select>
          <select id="cc_has" class="form-select form-select-sm" style="max-width:160px" onchange="cc_list()">
            <option value="">Any contact</option>
            <option value="email">Has an email</option>
            <option value="phone">Has a phone</option>
            <option value="neither">Has neither</option>
          </select>
          <select id="cc_type" class="form-select form-select-sm" style="max-width:150px" onchange="cc_list()">
            <option value="">Any kind</option>
            <option value="store">A shop</option>
            <option value="online">Online only</option>
          </select>
          <button class="btn btn-sm btn-outline-success" onclick="cc_excel(this)">
            <i class="fas fa-file-excel me-1"></i>Excel
          </button>
        </div>
      </div>
      <div class="table-responsive" style="max-height:58vh;overflow:auto;">
        <table class="table table-hover table-striped mb-0 text-nowrap align-middle">
          <thead class="table-dark">
            <tr>
              <th style="position:sticky;top:0;background:#212529;color:#fff;">Retailer</th>
              <th style="position:sticky;top:0;background:#212529;color:#fff;">City</th>
              <th style="position:sticky;top:0;background:#212529;color:#fff;">Region</th>
              <th style="position:sticky;top:0;background:#212529;color:#fff;">Phone</th>
              <th style="position:sticky;top:0;background:#212529;color:#fff;">Email</th>
              <th style="position:sticky;top:0;background:#212529;color:#fff;">Kind</th>
            </tr>
          </thead>
          <tbody id="cc_body"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  .cc-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:8px; }
  .cc-state { text-align:left; border:1px solid rgba(0,0,0,.08); border-radius:8px; background:#fff;
              padding:10px 12px; cursor:pointer; transition:.12s; }
  .cc-state:hover { border-color:#0d6efd; transform:translateY(-1px); }
  .cc-state.on { border-color:#0d6efd; box-shadow:0 0 0 2px rgba(13,110,253,.18); }
  .cc-state .nm { font-weight:600; font-size:14px; }
  .cc-state .big { font-size:22px; font-weight:700; line-height:1.1; }
  .cc-state .sub { font-size:11px; color:#6c757d; }
  /* The bar is the state against the biggest one, so the shape of the
     country is readable without a map. */
  .cc-bar { height:4px; border-radius:3px; background:#e9ecef; margin-top:7px; overflow:hidden; }
  .cc-bar i { display:block; height:100%; background:#0d6efd; }
  /* The tiles open the list they count, so they have to look as though they
     can be pressed. */
  .cc-tile { cursor:pointer; transition:.12s; }
  .cc-tile:hover { transform:translateY(-1px); box-shadow:0 .35rem .8rem rgba(0,0,0,.12) !important; }
  .cc-tile:focus-visible { outline:2px solid #0d6efd; outline-offset:2px; }
</style>

<script>
(function () {
  var STATES = [], TOTALS = null, ROWS = [], PICKED = null, timer = null;
  var esc = function (v) {
    return String(v === null || v === undefined ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  };
  var n = function (v) { return Number(v || 0).toLocaleString('en-US'); };

  window.cc_boot = async function () {
    document.getElementById('cc_states').innerHTML =
      '<div class="text-muted p-2"><i class="fas fa-spinner fa-spin me-2"></i>Loading…</div>';
    try {
      var j = await (await fetch('/api/cc-prospects/board')).json();
      if (!j.success) {
        document.getElementById('cc_states').innerHTML =
          '<div class="text-danger p-2">' + esc(j.error) + '</div>';
        return;
      }
      STATES = j.states; TOTALS = j.totals;
      cc_drawTiles();
      cc_drawStates();
    } catch (e) {
      document.getElementById('cc_states').innerHTML = '<div class="text-danger p-2">Server error.</div>';
    }
  };

  // Every tile opens the list it counts, across all fifty states. A number
  // somebody is looking at is a number they want to see behind - "6,640 with
  // an email" is only useful if the next click is the 6,640.
  //
  // States is the exception: its list is the board already on screen, so it
  // takes you there rather than opening the same thing twice.
  var TILES = [
    { label: 'Retailers', key: 'retailers', cls: '', filter: {} },
    { label: 'States', key: 'states', cls: '', scroll: true },
    { label: 'With an email', key: 'with_email', cls: 'text-success', filter: { has: 'email' } },
    { label: 'With a phone', key: 'with_phone', cls: 'text-success', filter: { has: 'phone' } },
    { label: 'Online only', key: 'online_only', cls: 'text-warning', filter: { type: 'online' } },
  ];

  function cc_drawTiles() {
    document.getElementById('cc_tiles').innerHTML = TILES.map(function (t, i) {
      return '<div class="col-6 col-md-4 col-xl">'
        + '<div class="card bg-light-glass shadow-sm smooth-ui h-100 cc-tile" onclick="cc_tile(' + i + ')"'
        + ' role="button" tabindex="0" onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();cc_tile(' + i + ')}">'
        + '<div class="card-body py-2">'
        + '<div class="text-muted small text-uppercase">' + t.label + '</div>'
        + '<div class="fs-4 fw-bold ' + t.cls + '">' + n(TOTALS[t.key]) + '</div>'
        + '</div></div></div>';
    }).join('');
  }

  window.cc_tile = function (i) {
    var t = TILES[i];
    if (t.scroll) {
      document.getElementById('cc_states').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
    // Across every state, so the state cards lose their highlight.
    PICKED = null;
    cc_drawStates();
    document.getElementById('cc_detail').hidden = false;
    document.getElementById('cc_q').value = '';
    document.getElementById('cc_has').value = t.filter.has || '';
    document.getElementById('cc_type').value = t.filter.type || '';
    cc_fillRegions(null);
    cc_list();
    document.getElementById('cc_detail').scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  window.cc_drawStates = function () {
    var by = document.getElementById('cc_sort').value;
    var list = STATES.slice().sort(function (a, b) {
      if (by === 'state') return a.state.localeCompare(b.state);
      return Number(b[by]) - Number(a[by]);
    });
    var most = Math.max.apply(null, STATES.map(function (s) { return Number(s.retailers); }));

    document.getElementById('cc_statesNote').textContent =
      STATES.length + ' states · ' + n(TOTALS.regions) + ' regions between them';

    document.getElementById('cc_states').innerHTML = list.map(function (s) {
      var pct = Math.round(Number(s.retailers) / most * 100);
      return '<div class="cc-state' + (PICKED === s.state ? ' on' : '') + '"'
        + ' onclick="cc_open(' + JSON.stringify(s.state).replace(/"/g, '&quot;') + ')">'
        + '<div class="nm">' + esc(s.state) + ' <span class="text-muted small">' + esc(s.state_code || '') + '</span></div>'
        + '<div class="big">' + n(s.retailers) + '</div>'
        + '<div class="sub">' + n(s.with_email) + ' email · ' + n(s.with_phone) + ' phone</div>'
        + '<div class="sub">' + n(s.regions) + ' regions · ' + n(s.cities) + ' towns</div>'
        + '<div class="cc-bar"><i style="width:' + pct + '%"></i></div>'
        + '</div>';
    }).join('');
  };

  // Regions only mean something inside one state - there are 328 of them
  // across the fifty - so the dropdown is emptied and disabled without one.
  async function cc_fillRegions(state) {
    var sel = document.getElementById('cc_region');
    sel.innerHTML = '<option value="">Every region</option>';
    sel.disabled = !state;
    if (!state) return;
    try {
      var j = await (await fetch('/api/cc-prospects/regions?state=' + encodeURIComponent(state))).json();
      if (j.success) {
        sel.innerHTML += j.rows.map(function (r) {
          return '<option value="' + esc(r.region) + '">' + esc(r.region) + ' (' + r.retailers + ')</option>';
        }).join('');
      }
    } catch (e) {}
  }

  window.cc_open = async function (state) {
    PICKED = state;
    cc_drawStates();
    document.getElementById('cc_detail').hidden = false;
    document.getElementById('cc_q').value = '';
    document.getElementById('cc_has').value = '';
    document.getElementById('cc_type').value = '';

    await cc_fillRegions(state);
    cc_list();
    document.getElementById('cc_detail').scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  window.cc_close = function () {
    PICKED = null;
    document.getElementById('cc_detail').hidden = true;
    cc_drawStates();
  };

  window.cc_debounce = function () { clearTimeout(timer); timer = setTimeout(cc_list, 300); };

  window.cc_list = async function () {
    var p = new URLSearchParams({
      state: PICKED || '',
      region: document.getElementById('cc_region').value,
      q: document.getElementById('cc_q').value,
      has: document.getElementById('cc_has').value,
      type: document.getElementById('cc_type').value,
      limit: 2000,
    });
    var body = document.getElementById('cc_body');
    body.innerHTML = '<tr><td colspan="6" class="text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading…</td></tr>';
    try {
      var j = await (await fetch('/api/cc-prospects?' + p)).json();
      if (!j.success) { body.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">' + esc(j.error) + '</td></tr>'; return; }
      ROWS = j.rows;
      // Named by what is actually being looked at, so somebody who clicked a
      // tile does not read it as the whole list.
      var scope = PICKED || 'All fifty states';
      var narrowed = [];
      if (document.getElementById('cc_has').value === 'email') narrowed.push('with an email');
      if (document.getElementById('cc_has').value === 'phone') narrowed.push('with a phone');
      if (document.getElementById('cc_has').value === 'neither') narrowed.push('with neither');
      if (document.getElementById('cc_type').value === 'online') narrowed.push('online only');
      if (document.getElementById('cc_type').value === 'store') narrowed.push('shops');
      document.getElementById('cc_detailTitle').textContent =
        scope + (narrowed.length ? ', ' + narrowed.join(' and ') : '')
        + ' — ' + (j.shown < j.total
          ? ('showing ' + n(j.shown) + ' of ' + n(j.total))
          : (n(j.total) + ' retailer' + (j.total === 1 ? '' : 's')));
      if (!ROWS.length) { body.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Nobody matches.</td></tr>'; return; }

      body.innerHTML = ROWS.map(function (r) {
        var where = [r.address, r.suite].filter(Boolean).join(', ');
        return '<tr>'
          + '<td class="fw-bold">' + esc(r.retailer)
            + (where ? '<div class="small text-muted fw-normal">' + esc(where) + '</div>' : '')
          + '</td>'
          // Across all fifty, the town alone does not say where it is.
          + '<td class="small">' + esc(r.city || '—')
            + (PICKED ? '' : ' <span class="badge bg-light text-dark border">' + esc(r.state_code || r.state) + '</span>')
            + (r.zip ? '<div class="text-muted">' + esc(r.zip) + '</div>' : '') + '</td>'
          + '<td class="small">' + esc(r.region || '—') + '</td>'
          + '<td class="small">' + (r.phone ? '<a href="tel:' + esc(r.phone) + '">' + esc(r.phone) + '</a>' : '<span class="text-muted">—</span>') + '</td>'
          + '<td class="small">' + (r.email ? '<a href="mailto:' + esc(r.email) + '">' + esc(r.email) + '</a>' : '<span class="text-muted">—</span>')
            + (r.website ? '<div><a href="' + esc(/^https?:/i.test(r.website) ? r.website : 'http://' + r.website) + '" target="_blank" rel="noopener" class="text-muted">website</a></div>' : '')
          + '</td>'
          + '<td class="small">' + (/online/i.test(r.store_type || '')
              ? '<span class="badge bg-warning text-dark">Online only</span>'
              : '<span class="text-muted">Shop</span>') + '</td>'
          + '</tr>';
      }).join('');
    } catch (e) {
      body.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Server error.</td></tr>';
    }
  };

  window.cc_excel = function (btn) {
    var cols = ['Retailer', 'State', 'Region', 'City', 'Address', 'Suite', 'ZIP',
                'Phone', 'Email', 'Website', 'Kind', 'Notes'];
    var rows = ROWS.map(function (r) {
      return [r.retailer, r.state, r.region, r.city, r.address, r.suite, r.zip,
              r.phone, r.email, r.website, r.store_type, r.notes];
    });
    downloadXlsx('CC Prospects' + (PICKED ? ' - ' + PICKED : ''), cols, rows, btn);
  };

  cc_boot();
})();
</script>
