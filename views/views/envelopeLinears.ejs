<%# Envelope Linears — sections and their categories down the side, the
    designs of whichever one is picked filling the page beside them. %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0 text-dark fw-bold">
      <i class="fas fa-envelope-open-text me-2"></i>Envelope Linears
    </h3>
    <div class="d-flex gap-2">
      <%# On a phone the list is above the designs and both are long, so it
          folds away rather than making somebody scroll past 21 names. %>
      <button class="btn btn-outline-dark smooth-ui text-dark fw-bold d-lg-none"
              type="button" onclick="el_toggleSide()">
        <i class="fas fa-list me-1"></i> Categories
      </button>
      <a class="btn btn-outline-dark smooth-ui fw-bold" href="/linears"
         target="_blank" rel="noopener">
        <i class="fas fa-up-right-from-square me-1"></i> Open the public page
      </a>
      <button class="btn btn-outline-dark smooth-ui fw-bold d-none"
              type="button" id="el_manageBtn" onclick="el_toggleManage()">
        <i class="fas fa-pen me-1"></i> <span id="el_manageLbl">Manage</span>
      </button>
      <button class="btn btn-outline-dark smooth-ui text-dark fw-bold"
              onclick="refreshBoard(this, el_fetch, 'designs')">
        <i class="fas fa-sync-alt me-1"></i> Refresh
      </button>
    </div>
  </div>

  <%# The link is the point of having a public page at all, so it is on the
      screen rather than something to be reconstructed from memory when a
      customer asks for it. %>
  <div class="alert alert-light border d-flex flex-wrap align-items-center gap-2 py-2">
    <span class="text-muted small">Customers open this - no login:</span>
    <code id="el_link" class="small"></code>
    <button class="btn btn-sm btn-outline-secondary" onclick="el_copyLink()">
      <i class="fas fa-copy me-1"></i>Copy
    </button>
    <span class="text-muted small ms-auto">
      Every design that is not hidden is on it, full size.
    </span>
  </div>

  <div class="row g-3">
    <%# ── The side ── %>
    <div class="col-12 col-lg-3" id="el_side">
      <div class="card bg-light-glass shadow-sm el-sidecard">
        <div class="card-body p-2">
          <input type="text" id="el_q" class="form-control form-control-sm mb-1"
                 placeholder="blue flower, red damask, monogram..."
                 oninput="el_searchSoon()">
          <div class="form-text small mb-2" id="el_qHint">Try a colour and a kind.</div>
          <button type="button" id="el_newBtn"
                  class="btn btn-sm btn-dark w-100 mb-2 fw-bold d-none"
                  onclick="el_openNew()">
            <i class="fas fa-plus me-1"></i> New category
          </button>
          <div id="el_nav">
            <div class="text-center text-muted py-4">
              <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            </div>
          </div>
          <div class="text-muted small px-2 pt-2 border-top" id="el_count"></div>
        </div>
      </div>
    </div>

    <%# ── The designs ── %>
    <div class="col-12 col-lg-9">
      <div id="el_body">
        <div class="text-center text-muted py-5">
          <div class="spinner-border text-primary" role="status"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Making a category, and the section it sits in. One box for both: a
    section is only a name on a category, so there is nothing to make first. %>
<div class="modal fade" id="el_newModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold text-dark" id="el_newTitle">New category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label fw-bold small mb-1">Section</label>
        <input type="text" id="el_newSection" class="form-control" list="el_sectionList"
               placeholder="Pick one, or type a new name">
        <datalist id="el_sectionList"></datalist>
        <div class="form-text">Type a name that is not in the list and a new section is made.</div>

        <label class="form-label fw-bold small mb-1 mt-3">Category</label>
        <input type="text" id="el_newCategory" class="form-control"
               placeholder="Floral &amp; Botanical">
        <div class="text-danger small mt-2" id="el_newErr"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-dark fw-bold" id="el_newSave"
                onclick="el_saveNew()">Save</button>
      </div>
    </div>
  </div>
</div>

<%# The full design, over everything. The design catalogue opens its
    pictures the same way. %>
<div class="el-lb" id="el_lb" onclick="el_lbClose(event)">
  <button type="button" class="el-lb-x" onclick="el_lbClose(event, true)" title="Close">&times;</button>
  <button type="button" class="el-lb-nav el-lb-prev" onclick="el_lbStep(event, -1)">&lsaquo;</button>
  <img id="el_lbImg" alt="">
  <button type="button" class="el-lb-nav el-lb-next" onclick="el_lbStep(event, 1)">&rsaquo;</button>
  <div class="el-lb-cap" id="el_lbCap"></div>
</div>

<style>
  /* Stays put while the designs beside it are scrolled - the whole point of
     putting the list down the side rather than above. */
  @media (min-width: 992px) {
    .el-sidecard { position: sticky; top: 1rem; max-height: calc(100vh - 2rem); overflow-y: auto; }
  }
  .el-sechead2 {
    width: 100%; text-align: left; border: 0; background: none;
    font-weight: 700; color: #2f2c28; font-size: .9rem;
    padding: .45rem .5rem; border-radius: 6px;
    display: flex; align-items: center; gap: .4rem;
  }
  .el-sechead2:hover { background: rgba(0,0,0,.04); }
  .el-sechead2 .el-caret { transition: transform .15s ease; font-size: .7rem; color: #8a8178; }
  .el-sechead2.open .el-caret { transform: rotate(90deg); }
  .el-catlink {
    display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    width: 100%; text-align: left; border: 0; background: none;
    cursor: pointer; user-select: none;
    padding: .32rem .5rem .32rem 1.45rem; border-radius: 6px;
    font-size: .84rem; color: #5a544c; line-height: 1.3;
  }
  .el-catlink:hover { background: rgba(0,0,0,.05); color: #2f2c28; }
  .el-catlink.on { background: #2f2c28; color: #fff; font-weight: 600; }
  .el-catlink .el-n { font-size: .72rem; opacity: .7; flex: none; }

  /* The designs */
  .el-head {
    display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap;
    margin-bottom: .75rem; padding-bottom: .4rem;
    border-bottom: 2px solid rgba(0,0,0,.08);
  }
  .el-head h4 { margin: 0; font-weight: 700; color: #2f2c28; }
  .el-back {
    border: 1px solid rgba(0,0,0,.15); background: #fff; border-radius: 6px;
    color: #5a544c; font-size: .82rem; font-weight: 700;
    padding: .2rem .55rem; line-height: 1.4; align-self: center;
  }
  .el-back:hover { background: #2f2c28; border-color: #2f2c28; color: #fff; }
  .el-design {
    border: 1px solid rgba(0,0,0,.08); border-radius: 8px;
    overflow: hidden; background: #fff; display: block;
  }
  .el-design[role="button"] { cursor: zoom-in; }
  .el-design:hover { box-shadow: 0 .4rem .9rem rgba(0,0,0,.12); }
  .el-design .el-pic {
    height: 190px; background: #f4f1ec;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .el-design .el-pic img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .el-design .el-lbl { padding: .35rem .5rem; font-size: .74rem; color: #8a8178; }
  .el-where {
    font-size: .7rem; color: #8a8178; padding: .2rem .1rem 0;
    cursor: pointer; text-decoration: underline dotted;
  }
  .el-where:hover { color: #2f2c28; }

  /* The Manage button while it is on. Spelled out rather than borrowed from
     Bootstrap's utilities so the background and the writing on it can never
     arrive separately - that is a black button with nothing on it. */
  #el_manageBtn.el-managing,
  #el_manageBtn.el-managing:hover,
  #el_manageBtn.el-managing:focus {
    background-color: #2f2c28;
    border-color: #2f2c28;
    color: #fff;
  }
  #el_manageBtn.el-managing i { color: #fff; }

  .el-catlink .el-x {
    border: 0; background: none; color: inherit; opacity: .45;
    font-size: .72rem; padding: 0 .15rem; line-height: 1;
  }
  .el-catlink .el-x:hover { opacity: 1; color: #dc3545; }
  .el-catlink.on .el-x:hover { color: #ffb3bb; }
  .el-tilewrap { position: relative; height: 100%; }
  .el-tilewrap .el-del {
    position: absolute; top: .3rem; right: .3rem; z-index: 2;
    background: rgba(255,255,255,.94); border: 1px solid rgba(0,0,0,.14);
    border-radius: 50%; width: 1.7rem; height: 1.7rem; line-height: 1;
    color: #dc3545; font-size: .75rem; padding: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .el-tilewrap .el-del:hover { background: #dc3545; color: #fff; border-color: #dc3545; }
  .el-drop {
    border: 2px dashed rgba(0,0,0,.2); border-radius: 10px;
    padding: 1.1rem; text-align: center; color: #8a8178;
    background: #faf8f5; margin-bottom: .9rem;
  }
  .el-drop.over { border-color: #2f2c28; background: #f1ece5; color: #2f2c28; }

  /* 1055 is Bootstrap's modal, and other things on this app sit high too.
     Above all of it, or the click appears to do nothing at all. */
  .el-lb {
    position: fixed; inset: 0; z-index: 2000;
    background: rgba(20,18,16,.92);
    display: none; align-items: center; justify-content: center;
    padding: 3.5rem 4rem;
  }
  .el-lb.on { display: flex; }
  .el-lb img {
    max-width: 100%; max-height: 100%;
    object-fit: contain; border-radius: 6px;
    box-shadow: 0 1rem 3rem rgba(0,0,0,.5);
  }
  .el-lb-cap {
    position: absolute; left: 0; right: 0; bottom: 1rem;
    text-align: center; color: #e8e2d9; font-size: .85rem;
    pointer-events: none;
  }
  .el-lb-x {
    position: absolute; top: .6rem; right: 1rem;
    background: none; border: 0; color: #e8e2d9;
    font-size: 2.4rem; line-height: 1; cursor: pointer; opacity: .8;
  }
  .el-lb-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(0,0,0,.35); border: 0; color: #fff;
    font-size: 2.6rem; line-height: 1; cursor: pointer;
    width: 3rem; height: 4.5rem; opacity: .75;
  }
  .el-lb-nav:hover, .el-lb-x:hover { opacity: 1; }
  .el-lb-prev { left: .4rem; border-radius: 0 6px 6px 0; }
  .el-lb-next { right: .4rem; border-radius: 6px 0 0 6px; }
  @media (max-width: 575px) {
    .el-lb { padding: 3rem .5rem; }
    .el-lb-nav { width: 2.2rem; font-size: 2rem; }
  }
</style>

<script>
let el_sections = [];
// Which sections are folded open in the side list. A set of names rather
// than a flag per row, so a redraw after a search does not lose them.
let el_openSet = new Set();
let el_pickedId = 0;
// The designs of whichever category is showing, so the arrows in the
// lightbox have something to step through. Only the ones that actually have
// a picture: an arrow that lands on a blank is worse than one that skips it.
let el_shown = [];
let el_at = -1;
// Whether this person is allowed to change anything, as answered by the
// board. Not worked out here from a role name: the rule belongs to the
// server, and a screen holding its own copy eventually draws a button the
// server refuses.
let el_canManage = false;
// What the search box is showing, so the panel knows whether it is looking
// at a category or at the answer to a question.
let el_searchOn = false;
let el_searchTimer = null;
let el_manage = false;

function el_esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

async function el_fetch() {
  try {
    const res = await fetch('/api/envelope-linears/board');
    const json = await res.json();
    if (!json.success) throw new Error(json.error || 'Could not load.');
    el_sections = json.sections || [];
    el_canManage = !!json.canManage;
    document.getElementById('el_manageBtn').classList.toggle('d-none', !el_canManage);
    if (!el_canManage) el_manage = false;
    el_paintManage();
    // Everything open to begin with: the whole list is 21 names and somebody
    // arriving wants to see what there is, not to go hunting for it.
    el_sections.forEach(s => el_openSet.add(s.section));
    el_render();
    // Lands on something rather than on an empty page telling them to pick.
    if (!el_pickedId) {
      const first = el_sections.reduce((f, s) => f || s.items.find(i => i.count), null);
      if (first) el_pick(first.id);
    }
    return json.designs || 0;
  } catch (e) {
    // The container, not a cell inside it: on a first load that failed the
    // list was never drawn, and writing into a child that does not exist is
    // how a failure becomes a blank page with nothing said.
    const box = document.getElementById('el_nav');
    if (box) {
      box.innerHTML = '<div class="alert alert-danger m-0 small">Could not load Envelope Linears.</div>';
    }
    return 0;
  }
}

function el_toggleSection(name) {
  if (el_openSet.has(name)) el_openSet.delete(name); else el_openSet.add(name);
  el_render();
}

function el_toggleSide() {
  document.getElementById('el_side').classList.toggle('d-none');
}

/** Draws the side list. The designs beside it are left alone. */
function el_render() {
  const box = document.getElementById('el_nav');
  if (!box) return;
  const q = (document.getElementById('el_q').value || '').trim().toLowerCase();

  let cats = 0, designs = 0;
  const blocks = el_sections.map(s => {
    const items = s.items.filter(it => !q
      || String(it.category || '').toLowerCase().includes(q)
      || String(s.section || '').toLowerCase().includes(q));
    if (!items.length) return '';
    cats += items.length;
    items.forEach(it => { designs += it.count; });

    // A search opens whatever it found. Typing a name and being shown a
    // folded-up section with the answer hidden inside is not a search.
    const open = q ? true : el_openSet.has(s.section);
    const rows = !open ? '' : items.map(it => {
      // A BUTTON CANNOT GO INSIDE A BUTTON.
      //
      // The row used to be a <button> with the bin as another <button> inside
      // it, which is not HTML a browser will accept: the parser closes the
      // outer one where the inner one starts, so the bin fell out of the row
      // and landed on a line of its own underneath every category. It looked
      // like a styling problem and was a nesting one.
      //
      // So the row is a div that behaves like a button - clickable, reachable
      // by keyboard - and the bin is a real button inside it.
      const bin = el_manage
        ? `<button type="button" class="el-x" title="Remove this category"
             onclick="event.stopPropagation();el_removeCategory(${it.id},
               ${JSON.stringify(it.category).replace(/"/g, '&quot;')}, ${it.count || 0})">
             <i class="fas fa-trash"></i></button>`
        : '';
      return `
        <div class="el-catlink${it.id === el_pickedId ? ' on' : ''}"
             role="button" tabindex="0"
             data-id="${it.id}" onclick="el_pick(${it.id})"
             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();el_pick(${it.id});}">
          <span class="flex-grow-1">${el_esc(it.category)}</span>
          <span class="el-n">${it.count || 0}</span>${bin}
        </div>`;
    }).join('');

    return `<div class="mb-1">
        <button type="button" class="el-sechead2${open ? ' open' : ''}"
                onclick="el_toggleSection(${JSON.stringify(s.section)
                  .replace(/"/g, '&quot;')})">
          <i class="fas fa-chevron-right el-caret"></i>
          <span class="flex-grow-1">${el_esc(s.section)}</span>
          <span class="text-muted small fw-normal">${items.length}</span>
        </button>
        ${rows}
      </div>`;
  }).filter(Boolean).join('');

  box.innerHTML = blocks
    || '<div class="text-muted small text-center py-3">Nothing matches that.</div>';

  const count = document.getElementById('el_count');
  if (count) {
    count.textContent = cats + (cats === 1 ? ' category, ' : ' categories, ')
      + designs + (designs === 1 ? ' design' : ' designs');
  }
}

/**
 * Back to the list of categories.
 *
 * On a phone this is the whole way back: picking a category hides the list,
 * so without this there is nothing to return to but the browser's own back
 * button, which leaves the tab altogether. On a wide screen the list never
 * went away, so Back just lets go of the category - which is still worth
 * having after scrolling through twenty designs.
 */
function el_back() {
  el_pickedId = 0;
  el_shown = [];
  el_at = -1;
  document.getElementById('el_side').classList.remove('d-none');
  document.getElementById('el_body').innerHTML =
    '<div class="text-center text-muted py-5">'
    + '<i class="fas fa-envelope-open-text fa-2x mb-2 d-block opacity-50"></i>'
    + 'Pick a category from the list.</div>';
  el_render();                 // nothing is highlighted any more
  // The list is above the designs on a phone, and Back is at the top of the
  // designs - which can be a long way down the page by now.
  const side = document.getElementById('el_side');
  if (window.innerWidth < 992 && side.scrollIntoView) {
    side.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}

/** Opens one category in the panel beside the list. */
async function el_pick(id) {
  el_pickedId = id;
  el_searchOn = false;
  el_render();
  const body = document.getElementById('el_body');
  body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
  // On a phone the list is stacked above the designs, so leaving it open
  // means picking a category and seeing nothing happen below the fold.
  if (window.innerWidth < 992) document.getElementById('el_side').classList.add('d-none');

  try {
    const res = await fetch('/api/envelope-linears/category/' + id);
    const json = await res.json();
    if (!json.success) throw new Error(json.error || 'Could not load.');
    // Somebody clicked another category while this one was still coming.
    // Without this the slower answer lands last and overwrites the one they
    // are actually looking at.
    if (el_pickedId !== id) return;

    el_shown = json.items.filter(it => it.hasImage);
    el_at = -1;

    const head = `<div class="el-head">
        <button type="button" class="el-back" onclick="el_back()" title="Back to the list">
          <i class="fas fa-arrow-left"></i><span class="d-none d-sm-inline ms-1">Back</span>
        </button>
        <h4>${el_esc(json.category)}</h4>
        <span class="text-muted small">${el_esc(json.section)}</span>
        <span class="text-muted small ms-auto">${json.items.length}
          ${json.items.length === 1 ? 'design' : 'designs'}</span>
      </div>`;

    // The box that takes pictures. Above the grid rather than below it: in an
    // empty category there is no grid to be below.
    const adder = el_manage ? `
      <div class="el-drop" id="el_drop"
           ondragover="event.preventDefault();this.classList.add('over')"
           ondragleave="this.classList.remove('over')"
           ondrop="event.preventDefault();this.classList.remove('over');el_addFiles(event.dataTransfer.files)">
        <i class="fas fa-images fa-lg d-block mb-2 opacity-50"></i>
        Drop pictures here, or
        <label class="fw-bold text-decoration-underline" style="cursor:pointer;">
          choose them
          <input type="file" accept="image/*" multiple class="d-none"
                 onchange="el_addFiles(this.files);this.value='';">
        </label>
        <div class="small mt-1">JPG, PNG or WebP. Big ones are shrunk before they are sent.</div>
        <div class="small fw-bold mt-1 text-dark" id="el_progress"></div>
      </div>` : '';

    if (!json.items.length) {
      body.innerHTML = head + adder + '<div class="text-center text-muted py-5">'
        + 'Nothing has been put in this category yet.</div>';
      return;
    }

    body.innerHTML = head + adder + '<div class="row g-3">' + json.items.map(it => {
      // NOT lazy. A category is about twenty pictures and somebody who just
      // opened it wants all of them.
      const pic = it.hasThumb
        ? `<img src="/api/envelope-linears/thumb/${it.id}" alt="">`
        : '<i class="fas fa-image text-muted"></i>';
      const label = it.code || it.name || ('Design ' + (it.page || ''));
      // The tile shows the thumbnail - that is why this page is quick - and
      // clicking it opens the full picture over the page, the way the design
      // catalogue does. A design with no picture stored is left as a plain
      // box rather than something that looks clickable and is not.
      const open = it.hasImage
        ? `<div class="el-design" role="button" tabindex="0" onclick="el_lb(${it.id})">`
        : (it.url
            ? `<a href="${el_esc(it.url)}" target="_blank" rel="noopener" class="el-design text-decoration-none">`
            : '<div class="el-design">');
      const close = it.hasImage ? '</div>' : (it.url ? '</a>' : '</div>');
      // The bin is a SIBLING of the tile inside a wrapper, not a child of it
      // and not loose after it.
      //
      // Loose after it was the bug: the rule that pins it to the corner is
      // written as .el-tilewrap .el-del, and a bin sitting outside the tile
      // matched nothing at all, so it dropped into the flow underneath every
      // design. A sibling rather than a child because the tile is sometimes
      // an <a>, and a button inside a link is the same kind of nesting a
      // browser quietly takes apart.
      const bin = el_manage
        ? `<button type="button" class="el-del" title="Remove this design"
             onclick="event.stopPropagation();el_removeDesign(${it.id})">
             <i class="fas fa-trash"></i></button>`
        : '';
      return `<div class="col-6 col-sm-4 col-lg-3 col-xxl-2">
          <div class="el-tilewrap">
            ${open}<div class="el-pic">${pic}</div>
            <div class="el-lbl text-truncate">${el_esc(label)}</div>${close}${bin}
          </div>
        </div>`;
    }).join('') + '</div>';
  } catch (e) {
    body.innerHTML = '<div class="alert alert-danger m-0">Could not load that category.</div>';
  }
}

// ── SEARCHING ─────────────────────────────────────────────
//
// The box does two things at once, and that is on purpose. It narrows the
// list of categories beside it, AND it asks the server for designs that
// answer to what was typed - so "chinois" finds a category and "blue
// flower" finds twenty pictures.

function el_searchSoon() {
  // The category list is local, so it narrows on the keystroke.
  el_render();
  clearTimeout(el_searchTimer);
  const q = (document.getElementById('el_q').value || '').trim();
  if (q.length < 2) {
    // Back to whatever was open before the typing started.
    if (el_searchOn) {
      el_searchOn = false;
      document.getElementById('el_qHint').textContent = 'Try a colour and a kind.';
      if (el_pickedId) el_pick(el_pickedId); else el_back();
    }
    return;
  }
  document.getElementById('el_qHint').textContent = 'Looking...';
  // Not on every keystroke: "blue flower" is eleven of them and the first
  // ten answers are thrown away.
  el_searchTimer = setTimeout(() => el_search(q), 350);
}

async function el_search(q) {
  const body = document.getElementById('el_body');
  try {
    const res = await fetch('/api/envelope-linears/search?q=' + encodeURIComponent(q));
    const json = await res.json();
    if (!json.success) throw new Error(json.error || 'Could not search.');
    // Somebody typed on while this was coming back.
    const now = (document.getElementById('el_q').value || '').trim();
    if (now !== q) return;

    el_searchOn = true;
    el_pickedId = 0;
    el_render();
    el_shown = json.items.filter(it => it.hasImage);
    el_at = -1;

    document.getElementById('el_qHint').textContent =
      json.found + (json.found === 1 ? ' design' : ' designs');

    const head = '<div class="el-head">'
      + '<button type="button" class="el-back" onclick="el_clearSearch()" '
      + 'title="Back to the list"><i class="fas fa-arrow-left"></i>'
      + '<span class="d-none d-sm-inline ms-1">Back</span></button>'
      + '<h4>' + el_esc(q) + '</h4>'
      + '<span class="text-muted small ms-auto">' + json.found
      + (json.found === 1 ? ' design' : ' designs')
      + (json.found > json.items.length ? ', showing ' + json.items.length : '')
      + '</span></div>';

    if (!json.items.length) {
      body.innerHTML = head + '<div class="text-center text-muted py-5">'
        + 'Nothing matches that. Try a colour on its own - blue, gold, red - '
        + 'or the kind of pattern.</div>';
      return;
    }

    // The category is shown under each one, because a result from nowhere
    // in particular is a result somebody cannot go back to.
    body.innerHTML = head + '<div class="row g-3">' + json.items.map(it => {
      const pic = it.hasThumb
        ? '<img src="/api/envelope-linears/thumb/' + it.id + '" alt="">'
        : '<i class="fas fa-image text-muted"></i>';
      const label = it.code || it.name || ('Design ' + (it.page || ''));
      const open = it.hasImage
        ? '<div class="el-design" role="button" tabindex="0" onclick="el_lb(' + it.id + ')">'
        : '<div class="el-design">';
      return '<div class="col-6 col-sm-4 col-lg-3 col-xxl-2">'
        + '<div class="el-tilewrap">' + open
        + '<div class="el-pic">' + pic + '</div>'
        + '<div class="el-lbl text-truncate">' + el_esc(label) + '</div>'
        + '</div>'
        + '<div class="el-where text-truncate" title="' + el_esc(it.category) + '" '
        + 'onclick="el_pick(' + it.categoryId + ')">' + el_esc(it.category) + '</div>'
        + '</div></div>';
    }).join('') + '</div>';
  } catch (e) {
    document.getElementById('el_qHint').textContent = 'Could not search.';
    body.innerHTML = '<div class="alert alert-danger m-0">Could not search.</div>';
  }
}

function el_clearSearch() {
  document.getElementById('el_q').value = '';
  el_searchOn = false;
  document.getElementById('el_qHint').textContent = 'Try a colour and a kind.';
  el_render();
  el_back();
}

// ── MANAGING ──────────────────────────────────────────────

function el_toggleManage() {
  el_manage = !el_manage;
  el_paintManage();
  el_render();
  // The designs panel carries the Add box and the delete buttons, so it has
  // to be drawn again - but only if something is open.
  if (el_pickedId) el_pick(el_pickedId);
}

function el_paintManage() {
  const btn = document.getElementById('el_manageBtn');
  if (btn) {
    // ONE class on, one class off, and the colours in the stylesheet.
    //
    // This used to swap btn-outline-dark for btn-dark and text-dark for
    // text-white - four classes in flight at once, and if a page was drawn
    // holding the dark background without the white text it was a black
    // button with nothing readable on it. The office photographed exactly
    // that. Which of the four lost its race hardly matters: the cure is to
    // stop racing, so the button keeps the class list it was written with
    // and a single state class says which state it is in.
    btn.classList.toggle('el-managing', el_manage);
    document.getElementById('el_manageLbl').textContent = el_manage ? 'Done' : 'Manage';
  }
  const add = document.getElementById('el_newBtn');
  if (add) add.classList.toggle('d-none', !(el_canManage && el_manage));
}

function el_openNew() {
  document.getElementById('el_newSection').value = '';
  document.getElementById('el_newCategory').value = '';
  document.getElementById('el_newErr').textContent = '';
  document.getElementById('el_sectionList').innerHTML =
    el_sections.map(s => '<option value="' + el_esc(s.section) + '">').join('');
  new bootstrap.Modal(document.getElementById('el_newModal')).show();
}

async function el_saveNew() {
  const section = document.getElementById('el_newSection').value.trim();
  const category = document.getElementById('el_newCategory').value.trim();
  const err = document.getElementById('el_newErr');
  err.textContent = '';
  if (!section || !category) {
    err.textContent = 'Both a section and a category name, please.';
    return;
  }
  const btn = document.getElementById('el_newSave');
  btn.disabled = true;
  try {
    const res = await fetch('/api/envelope-linears', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ section, category }),
    });
    const j = await res.json();
    if (!j.success) { err.textContent = j.error || 'Could not save that.'; return; }
    bootstrap.Modal.getInstance(document.getElementById('el_newModal')).hide();
    await el_fetch();
    el_openSet.add(section);
    el_render();
    el_pick(j.id);                 // straight into the empty one, ready for pictures
  } catch (e) {
    err.textContent = 'Server error.';
  } finally {
    btn.disabled = false;
  }
}

async function el_removeCategory(id, name, count) {
  const warn = count
    ? name + ' and its ' + count + (count === 1 ? ' design' : ' designs')
    : name;
  if (!confirm('Remove ' + warn + '? This cannot be undone.')) return;
  try {
    const res = await fetch('/api/envelope-linears/' + id, { method: 'DELETE' });
    const j = await res.json();
    if (!j.success) { alert(j.error || 'Could not remove that.'); return; }
    if (el_pickedId === id) {
      el_pickedId = 0;
      document.getElementById('el_body').innerHTML =
        '<div class="text-center text-muted py-5">Pick a category.</div>';
    }
    await el_fetch();
  } catch (e) { alert('Server error.'); }
}

async function el_removeDesign(id) {
  if (!confirm('Remove this design? This cannot be undone.')) return;
  try {
    const res = await fetch('/api/envelope-linears/item/' + id, { method: 'DELETE' });
    const j = await res.json();
    if (!j.success) { alert(j.error || 'Could not remove that.'); return; }
    const open = el_pickedId;
    await el_fetch();          // the count in the side list follows it
    el_pickedId = open;
    el_pick(open);
  } catch (e) { alert('Server error.'); }
}

// ── PICTURES ──────────────────────────────────────────────
//
// Shrunk here, in the browser, before anything is sent. Two reasons and both
// of them matter: a phone camera JPEG is 6MB and Vercel refuses a request
// body over 4.5MB outright - the refusal never reaches our code, so the only
// cure is not to send it - and three hundred unshrunk designs would put
// hundreds of megabytes into a database that is dumped every night.
const EL_MAX_SIDE = 2000;     // enough to look at full screen
const EL_THUMB = 280;         // what the grid shows
const EL_QUALITY = 0.85;

function el_drawn(img, maxSide, quality) {
  const scale = Math.min(1, maxSide / Math.max(img.naturalWidth, img.naturalHeight));
  const c = document.createElement('canvas');
  c.width = Math.max(1, Math.round(img.naturalWidth * scale));
  c.height = Math.max(1, Math.round(img.naturalHeight * scale));
  const ctx = c.getContext('2d');
  // White underneath: a PNG with a transparent background becomes black when
  // it is turned into a JPEG, and a liner on black is not the liner.
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, c.width, c.height);
  ctx.drawImage(img, 0, 0, c.width, c.height);
  return c.toDataURL('image/jpeg', quality);
}

function el_readImage(file) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('not a picture')); };
    img.src = url;
  });
}

async function el_addFiles(files) {
  if (!files || !files.length) return;
  const id = el_pickedId;
  const box = document.getElementById('el_progress');
  const list = Array.from(files);
  let done = 0;
  const failed = [];

  for (const file of list) {
    if (box) {
      box.textContent = 'Adding ' + (done + 1) + ' of ' + list.length + ' — ' + file.name;
    }
    try {
      if (!/^image\//.test(file.type)) throw new Error('not a picture');
      const img = await el_readImage(file);
      const image = el_drawn(img, EL_MAX_SIDE, EL_QUALITY);
      const thumb = el_drawn(img, EL_THUMB, 0.72);
      const res = await fetch('/api/envelope-linears/' + id + '/items', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          image, thumb, sourceFile: file.name,
          name: file.name.replace(/\.[^.]+$/, ''),
          width: img.naturalWidth, height: img.naturalHeight,
        }),
      });
      const j = await res.json();
      if (!j.success) throw new Error(j.error || 'refused');
      done++;
    } catch (e) {
      // Named, not swallowed. Twenty pictures where two would not go should
      // say which two rather than quietly adding eighteen.
      failed.push(file.name + ' (' + e.message + ')');
    }
  }

  if (box) {
    box.textContent = done + ' added'
      + (failed.length ? ', ' + failed.length + ' would not go: ' + failed.join(', ') : '');
  }
  await el_fetch();
  el_pickedId = id;
  await el_pick(id);
  if (failed.length) {
    const after = document.getElementById('el_progress');
    if (after) {
      after.innerHTML = '<span class="text-danger">' + el_esc(failed.length
        + (failed.length === 1 ? ' picture would not go: ' : ' pictures would not go: ')
        + failed.join(', ')) + '</span>';
    }
  }
}

function el_lbShow(i) {
  if (i < 0 || i >= el_shown.length) return;
  el_at = i;
  const it = el_shown[i];
  document.getElementById('el_lbImg').src = '/api/envelope-linears/image/' + it.id;
  document.getElementById('el_lbCap').textContent =
    (it.code || it.name || ('Design ' + (it.page || '')))
    + (el_shown.length > 1 ? '  (' + (i + 1) + ' of ' + el_shown.length + ')' : '');
  document.getElementById('el_lb').classList.add('on');
}

function el_lb(id) {
  el_lbShow(el_shown.findIndex(it => it.id === id));
}

function el_lbStep(ev, by) {
  // Without this the click reaches the backdrop underneath and shuts the
  // picture the arrow was supposed to change.
  if (ev) ev.stopPropagation();
  if (!el_shown.length) return;
  el_lbShow((el_at + by + el_shown.length) % el_shown.length);
}

function el_lbClose(ev, force) {
  // Only the backdrop itself closes it. Clicking the picture does not, or
  // every attempt to look closely at a liner shuts the thing being looked at.
  if (force || !ev || ev.target.id === 'el_lb') {
    document.getElementById('el_lb').classList.remove('on');
    // Emptied so a big picture is not still being fetched behind a closed
    // lightbox, and so the next one does not flash the last one first.
    document.getElementById('el_lbImg').removeAttribute('src');
  }
}

document.addEventListener('keydown', ev => {
  const lb = document.getElementById('el_lb');
  if (!lb || !lb.classList.contains('on')) return;
  if (ev.key === 'Escape') { ev.stopPropagation(); el_lbClose(null, true); }
  else if (ev.key === 'ArrowRight') el_lbStep(null, 1);
  else if (ev.key === 'ArrowLeft') el_lbStep(null, -1);
}, true);

document.getElementById('el_link').textContent = window.location.origin + '/linears';

function el_copyLink() {
  navigator.clipboard.writeText(window.location.origin + '/linears')
    .then(function () { showToast('success', 'Link copied'); })
    .catch(function () { showToast('warning', 'Could not copy - select it by hand'); });
}

el_fetch();
</script>
