<%# Step Settings — the TAT, the role and the on/off switch for each step.
    The names and the order are not editable here: rows already written
    against a step carry copies of both, and an order halfway through must
    not have its board reshuffled under the floor. %>
<div class="container-fluid py-4" id="paRoot">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h3 class="mb-0 text-dark fw-bold"><i class="fas fa-sliders me-2"></i>Step Settings</h3>
      <div class="text-muted small">How many working days each step is allowed, and who answers for it.</div>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary smooth-ui fw-bold" onclick="pa_openAdd()"><i class="fas fa-plus me-1"></i> Add Step</button>
      <button class="btn btn-outline-dark smooth-ui text-dark fw-bold" onclick="refreshBoard(this, pa_load, 'pmsAdmin')"><i class="fas fa-sync-alt me-1"></i> Refresh</button>
    </div>
  </div>

  <!-- The switch. Without this the whole PMS is inert, so it goes above the
       catalogue rather than at the bottom of it. -->
  <div class="card shadow smooth-ui mb-3">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
          <h6 class="fw-bold mb-1"><i class="fas fa-power-off me-2"></i>Board start date</h6>
          <div class="text-muted small" style="max-width:48rem;">
            Orders punched <b>on or after</b> this day get steps and appear on the board.
            Everything older is left alone — there are thousands of finished orders in
            the system, and giving them steps would open one on every single one.
            <b>Leave it empty to switch the board off.</b>
          </div>
          <div class="small mt-1" id="pa_state"></div>
        </div>
        <div class="d-flex gap-2 align-items-start">
          <input type="date" class="form-control form-control-sm" style="width:11rem;" id="pa_start">
          <button class="btn btn-sm btn-success smooth-ui" onclick="pa_saveStart(this)">Save</button>
        </div>
      </div>
    </div>
  </div>

  <div class="alert alert-warning d-none" id="pa_warn">
    <i class="fas fa-triangle-exclamation me-1"></i>
    <b id="pa_missing"></b>
    Until a step has one it still runs and still records who did it and when —
    it just cannot be called late, because there is no date to be late against.
    <div class="small mt-1">
      These start empty on purpose. What each production stage really takes
      cannot be recovered from the old data: 92% of orders have every
      production stage stamped within the same minute, because one form writes
      them all at the end. A number guessed here would print a due date on the
      floor's board and then mark them late against it.
    </div>
  </div>

  <div class="card shadow smooth-ui">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table align-middle mcard mb-0">
          <thead class="table-dark">
            <tr>
              <th style="width:3rem;">#</th>
              <th>Step</th>
              <th>Runs when</th>
              <th style="width:9rem;">TAT (days)</th>
              <th style="width:13rem;">Who</th>
              <th style="width:6rem;">On</th>
              <th style="width:10rem;">Order</th>
              <th style="width:9rem;"></th>
            </tr>
          </thead>
          <tbody id="pa_rows"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="pa_addModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Add a step</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Step name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="pa_n_name" placeholder="e.g. Foil Stamping" maxlength="120">
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Where does it go?</label>
          <select class="form-select" id="pa_n_pos"></select>
          <div class="form-text">Everything from here down moves one place along.</div>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-7">
            <label class="form-label small fw-semibold">Runs when</label>
            <select class="form-select" id="pa_n_cond">
              <option value="">Always</option>
            </select>
          </div>
          <div class="col-5">
            <label class="form-label small fw-semibold">TAT (days)</label>
            <input type="number" min="0" max="365" step="0.5" class="form-control" id="pa_n_tat" placeholder="leave empty">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Who answers for it</label>
          <input type="text" class="form-control" id="pa_n_role" placeholder="e.g. Production">
          <div class="form-text">A role. It decides whose My Tasks the step shows on.</div>
        </div>
        <div class="alert alert-secondary small mb-0">
          <i class="fas fa-circle-info me-1"></i>
          This reaches <b>orders punched from now on</b>. Orders already running keep
          the flow they started with — a step appearing behind where the floor has
          already got to could never be done.
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary smooth-ui" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary smooth-ui" onclick="pa_add(this)">Add step</button>
      </div>
    </div>
  </div>
</div>

<script>
var pa_steps = [];
var pa_conds = [];

// What each condition key means, in the words the office uses. The key alone
// ('die') tells a reader nothing about which orders it lets through.
var PA_COND = {
  revision: 'Client asked for changes',
  guest_name: 'Guest list / addressing given',
  die: 'Die needed',
  block: 'Block needed',
  edges: 'Edges needed',
  laser: 'Laser cutting needed',
  output: 'Output needed',
};

function pa_esc(s) {
  return String(s === null || s === undefined ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

async function pa_loadStart() {
  try {
    var r = await fetch('/api/pms/start-date');
    var j = await r.json();
    if (!j.success) return;
    document.getElementById('pa_start').value = j.startDate || '';
    document.getElementById('pa_state').innerHTML = j.startDate
      ? '<span class="badge bg-success-subtle text-success-emphasis">Board is on</span>'
        + ' <span class="text-muted">from ' + pa_esc(j.startDate) + ' · '
        + j.onBoard + ' step row(s) written so far</span>'
      : '<span class="badge bg-secondary">Board is off</span>'
        + ' <span class="text-muted">no order is getting steps</span>';
  } catch (e) { /* the catalogue below still matters */ }
}

async function pa_saveStart(btn) {
  var v = document.getElementById('pa_start').value;
  if (v && !window.confirm('Orders punched on or after ' + v + ' will get steps.\n\n'
      + 'Older orders are left alone. Continue?')) return;
  var old = btn.innerHTML;
  btn.disabled = true; btn.textContent = '...';
  try {
    var r = await fetch('/api/pms/start-date', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ startDate: v }),
    });
    var j = await r.json();
    if (!j.success) throw new Error(j.error || 'Could not save.');
    await pa_loadStart();
  } catch (e) {
    alert(e.message || 'Could not save.');
  }
  btn.disabled = false; btn.innerHTML = old;
}

async function pa_load() {
  await pa_loadStart();
  try {
    var r = await fetch('/api/pms/steps');
    var j = await r.json();
    if (!j.success) throw new Error(j.error || 'Could not load the steps.');
    pa_steps = j.steps || [];
    pa_conds = j.conditions || [];

    var warn = document.getElementById('pa_warn');
    if (j.missingTat > 0) {
      document.getElementById('pa_missing').textContent = j.missingTat === 1
        ? '1 step has no TAT yet.'
        : j.missingTat + ' steps have no TAT yet.';
      warn.classList.remove('d-none');
    } else {
      warn.classList.add('d-none');
    }
    pa_draw();
  } catch (e) {
    document.getElementById('pa_rows').innerHTML =
      '<tr><td colspan="7" class="text-center text-danger py-4">' + pa_esc(e.message) + '</td></tr>';
  }
}

function pa_draw() {
  var body = document.getElementById('pa_rows');
  body.innerHTML = pa_steps.map(function (s) {
    var when = s.condition_key
      ? '<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">'
        + pa_esc(PA_COND[s.condition_key] || s.condition_key) + '</span>'
      : '<span class="text-muted small">Always</span>';

    return '<tr' + (s.is_active ? '' : ' class="opacity-50"') + '>'
      + '<td class="text-muted">' + s.step_order + '</td>'
      + '<td><span class="fw-semibold">' + pa_esc(s.name) + '</span>'
      + (s.note ? '<div class="small text-muted">' + pa_esc(s.note) + '</div>' : '')
      + '</td>'
      + '<td>' + when + '</td>'
      + '<td><input type="number" min="0" max="365" step="0.5" class="form-control form-control-sm'
      + (s.tat_days === null ? ' border-warning' : '') + '" id="pa_tat_' + s.id + '" value="'
      + (s.tat_days === null ? '' : s.tat_days) + '" placeholder="not set"></td>'
      + '<td><input type="text" class="form-control form-control-sm" id="pa_role_' + s.id
      + '" value="' + pa_esc(s.doer_role || '') + '" placeholder="role"></td>'
      + '<td><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="pa_on_'
      + s.id + '"' + (s.is_active ? ' checked' : '') + '></div></td>'
      + '<td><div class="btn-group btn-group-sm">'
      + '<button class="btn btn-outline-secondary" title="Move up" onclick="pa_move(' + s.id + ",'up')\">"
      + '<i class="fas fa-arrow-up"></i></button>'
      + '<button class="btn btn-outline-secondary" title="Move down" onclick="pa_move(' + s.id + ",'down')\">"
      + '<i class="fas fa-arrow-down"></i></button>'
      + '</div></td>'
      + '<td class="text-end"><div class="btn-group btn-group-sm">'
      + '<button class="btn btn-outline-success" onclick="pa_save(' + s.id + ', this)">Save</button>'
      + '<button class="btn btn-outline-danger" title="Remove" onclick="pa_remove(' + s.id + ', '
      + JSON.stringify(s.name).replace(/"/g, '&quot;') + ')"><i class="fas fa-trash"></i></button>'
      + '</div></td>'
      + '</tr>';
  }).join('');

  if (window.mcardStamp) mcardStamp(body.closest('table'));
}

async function pa_save(id, btn) {
  var step = pa_steps.filter(function (s) { return s.id === id; })[0];
  if (!step) return;
  var raw = document.getElementById('pa_tat_' + id).value;
  var old = btn.innerHTML;
  btn.disabled = true; btn.textContent = '...';

  try {
    var r = await fetch('/api/pms/steps/' + id, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        tat_days: raw,
        doer_role: document.getElementById('pa_role_' + id).value,
        note: step.note || '',
        is_active: document.getElementById('pa_on_' + id).checked,
      }),
    });
    var j = await r.json();
    if (!j.success) throw new Error(j.error || 'Could not save.');
    btn.className = 'btn btn-sm btn-success smooth-ui';
    btn.textContent = 'Saved';
    setTimeout(function () {
      btn.className = 'btn btn-sm btn-outline-success smooth-ui';
      btn.innerHTML = old; btn.disabled = false;
    }, 1200);
    await pa_load();
  } catch (e) {
    btn.disabled = false; btn.innerHTML = old;
    alert(e.message || 'Could not save.');
  }
}

// ── ADD, MOVE, REMOVE ──

function pa_openAdd() {
  document.getElementById('pa_n_name').value = '';
  document.getElementById('pa_n_tat').value = '';
  document.getElementById('pa_n_role').value = '';

  // Positions, named by what currently sits there, so picking one does not
  // mean counting rows in the table behind the dialog.
  var pos = document.getElementById('pa_n_pos');
  pos.innerHTML = pa_steps.map(function (s) {
    return '<option value="' + s.step_order + '">Before ' + s.step_order + ' · '
      + pa_esc(s.name) + '</option>';
  }).join('') + '<option value="' + (pa_steps.length + 1) + '" selected>At the end</option>';

  var cond = document.getElementById('pa_n_cond');
  cond.innerHTML = '<option value="">Always</option>'
    + pa_conds.map(function (k) {
      return '<option value="' + k + '">' + pa_esc(PA_COND[k] || k) + '</option>';
    }).join('');

  bootstrap.Modal.getOrCreateInstance(document.getElementById('pa_addModal')).show();
}

async function pa_add(btn) {
  var name = document.getElementById('pa_n_name').value.trim();
  if (!name) { alert('The step needs a name.'); return; }
  var old = btn.innerHTML;
  btn.disabled = true; btn.textContent = '...';
  try {
    var r = await fetch('/api/pms/steps', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: name,
        step_order: Number(document.getElementById('pa_n_pos').value),
        condition_key: document.getElementById('pa_n_cond').value,
        tat_days: document.getElementById('pa_n_tat').value,
        doer_role: document.getElementById('pa_n_role').value,
      }),
    });
    var j = await r.json();
    if (!j.success) throw new Error(j.error || 'Could not add it.');
    bootstrap.Modal.getInstance(document.getElementById('pa_addModal')).hide();
    await pa_load();
  } catch (e) {
    alert(e.message || 'Could not add it.');
  }
  btn.disabled = false; btn.innerHTML = old;
}

async function pa_move(id, dir) {
  try {
    var r = await fetch('/api/pms/steps/' + id + '/move', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dir: dir }),
    });
    var j = await r.json();
    if (!j.success) throw new Error(j.error || 'Could not move it.');
    await pa_load();
  } catch (e) {
    alert(e.message || 'Could not move it.');
  }
}

async function pa_remove(id, name) {
  if (!window.confirm('Remove "' + name + '" from the flow?')) return;
  try {
    var r = await fetch('/api/pms/steps/' + id, { method: 'DELETE' });
    var j = await r.json();
    if (!j.success) {
      // A step orders have been through cannot go without taking their
      // history with it, so offer the switch instead of just refusing.
      if (j.inUse && window.confirm(j.error + '\n\nSwitch it off now?')) {
        var s = pa_steps.filter(function (x) { return x.id === id; })[0] || {};
        await fetch('/api/pms/steps/' + id, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tat_days: s.tat_days, doer_role: s.doer_role,
            note: s.note, is_active: false }),
        });
        await pa_load();
        return;
      }
      throw new Error(j.error || 'Could not remove it.');
    }
    await pa_load();
  } catch (e) {
    alert(e.message || 'Could not remove it.');
  }
}

pa_load();
</script>
