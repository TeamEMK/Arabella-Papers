<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Design Catalogue — Arabella Papers</title>
  <%# Standalone: no session here, so the portal's shell cannot be reused.
      The look is borrowed from it instead - the same charcoal panel and the
      same yellow - over a layout built for somebody browsing designs rather
      than working a board. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <style>
    :root {
      --ink: #212529;          /* the portal's panel */
      --gold: #ffcc00;         /* and its accent */
      --page: #f4f6f9;
      --line: rgba(0,0,0,.08);
      --muted: #6c757d;
      --rail: 268px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--page);
      font-family: Inter, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: #1b1f23;
      -webkit-font-smoothing: antialiased;
    }
    .serif { font-family: 'Cormorant Garamond', Georgia, serif; }

    /* ── the rail ─────────────────────────────── */
    .rail {
      position: fixed; inset: 0 auto 0 0; width: var(--rail);
      background: var(--ink); color: #d7dce1;
      display: flex; flex-direction: column;
      box-shadow: 2px 0 18px rgba(0,0,0,.28); z-index: 40;
    }
    .rail-head { padding: 26px 22px 20px; border-bottom: 1px solid rgba(255,255,255,.08); }
    .rail-mark {
      display: inline-block; background: #fff; color: var(--ink);
      font-weight: 600; letter-spacing: .22em; font-size: 12px;
      padding: 9px 12px; border-radius: 3px;
    }
    .rail-sub { color: var(--gold); font-size: 12.5px; letter-spacing: .14em; margin-top: 12px; text-transform: uppercase; }
    .rail-nav { padding: 16px 12px; overflow-y: auto; flex: 1; }
    .rail-label { font-size: 10.5px; letter-spacing: .18em; color: #8b939b; padding: 6px 10px 10px; text-transform: uppercase; }
    .cat {
      display: flex; align-items: center; gap: 11px; width: 100%;
      background: transparent; border: 0; border-radius: 9px;
      padding: 11px 12px; color: #d7dce1; cursor: pointer;
      font-size: 14.5px; text-align: left; transition: background .15s, color .15s;
    }
    .cat:hover { background: rgba(255,255,255,.08); color: var(--gold); }
    .cat.on {
      background: rgba(255,204,0,.14); color: var(--gold);
      font-weight: 600; box-shadow: inset 3px 0 0 var(--gold);
    }
    .cat .n { margin-left: auto; font-size: 12px; color: #8b939b; }
    .cat.on .n { color: var(--gold); }
    .rail-foot { padding: 16px 22px 22px; border-top: 1px solid rgba(255,255,255,.08); font-size: 12px; color: #8b939b; line-height: 1.6; }

    /* ── the page ─────────────────────────────── */
    .main { margin-left: var(--rail); min-height: 100vh; }
    .top {
      position: sticky; top: 0; z-index: 30;
      background: rgba(244,246,249,.92); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
      padding: 20px 34px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    }
    .top h1 { font-size: 30px; font-weight: 500; margin: 0; letter-spacing: .01em; }
    .top .count { color: var(--muted); font-size: 13px; }
    .search {
      margin-left: auto; position: relative; min-width: 260px;
    }
    .search input {
      width: 100%; padding: 11px 14px 11px 38px; border-radius: 10px;
      border: 1px solid var(--line); background: #fff; font-size: 14px;
      font-family: inherit; outline: 0; transition: box-shadow .15s, border-color .15s;
    }
    .search input:focus { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(255,204,0,.35); }
    .search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #adb5bd; font-size: 13px; }

    .grid { padding: 28px 34px 140px; display: grid; gap: 22px;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
    .tile {
      background: #fff; border-radius: 14px; overflow: hidden;
      border: 1px solid var(--line); box-shadow: 0 1px 3px rgba(16,24,40,.05);
      transition: transform .18s ease, box-shadow .18s ease; position: relative;
    }
    .tile:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(16,24,40,.12); }
    .tile.picked { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(255,204,0,.4); }
    /* A fixed frame with the art contained in it. A catalogue of mixed shapes
       looks like a jumble cropped to fill, and cropping cuts the motif
       somebody is trying to look at. */
    .frame { height: 250px; background: #fcfcfd; display: flex;
             align-items: center; justify-content: center; cursor: zoom-in; padding: 14px; }
    .frame img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .cap { padding: 13px 15px 15px; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 10px; }
    .cap .name { font-size: 14px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cap .sub { font-size: 11.5px; color: var(--muted); letter-spacing: .04em; }
    .pick {
      margin-left: auto; width: 30px; height: 30px; flex: 0 0 30px; border-radius: 50%;
      border: 1.5px solid #ced4da; background: #fff; color: #ced4da; cursor: pointer;
      display: flex; align-items: center; justify-content: center; font-size: 12px;
      transition: all .15s;
    }
    .pick:hover { border-color: var(--ink); color: var(--ink); }
    .tile.picked .pick { background: var(--gold); border-color: var(--gold); color: var(--ink); }

    .empty { grid-column: 1/-1; text-align: center; padding: 90px 20px; color: var(--muted); }

    /* ── the tray that appears once something is picked ── */
    .tray {
      position: fixed; left: var(--rail); right: 0; bottom: 0; z-index: 35;
      background: var(--ink); color: #fff; padding: 16px 34px;
      display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
      transform: translateY(110%); transition: transform .22s ease;
      box-shadow: 0 -8px 26px rgba(0,0,0,.26);
    }
    .tray.up { transform: translateY(0); }
    .tray .lead { font-size: 15px; }
    .tray .lead b { color: var(--gold); }
    .tray input[type=email] {
      flex: 1 1 240px; max-width: 340px; padding: 11px 14px; border-radius: 9px;
      border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.07);
      color: #fff; font-family: inherit; font-size: 14px; outline: 0;
    }
    .tray input[type=email]::placeholder { color: #8b939b; }
    .tray input[type=email]:focus { border-color: var(--gold); background: rgba(255,255,255,.12); }
    .btn {
      border: 0; border-radius: 9px; padding: 11px 20px; font-family: inherit;
      font-size: 14px; font-weight: 600; cursor: pointer; transition: filter .15s, opacity .15s;
    }
    .btn-gold { background: var(--gold); color: var(--ink); }
    .btn-gold:hover { filter: brightness(1.07); }
    .btn-gold:disabled { opacity: .55; cursor: default; filter: none; }
    .btn-ghost { background: transparent; color: #d7dce1; border: 1px solid rgba(255,255,255,.2); }
    .btn-ghost:hover { background: rgba(255,255,255,.08); color: #fff; }
    .tray .said { font-size: 13.5px; }
    .said.ok { color: var(--gold); }
    .said.bad { color: #ff9b9b; }

    /* ── zoom ─────────────────────────────────── */
    .lb { position: fixed; inset: 0; background: rgba(12,14,16,.92); z-index: 60;
          display: none; align-items: center; justify-content: center; padding: 30px; }
    .lb.on { display: flex; }
    .lb img { max-width: 94vw; max-height: 82vh; object-fit: contain;
              background: #fff; border-radius: 10px; padding: 10px; }
    .lb .cap2 { position: absolute; bottom: 26px; left: 0; right: 0; text-align: center; color: #e9ecef; font-size: 14px; }
    .lb .x { position: absolute; top: 22px; right: 26px; background: transparent; border: 0;
             color: #e9ecef; font-size: 26px; cursor: pointer; line-height: 1; }

    /* ── phone ────────────────────────────────── */
    .burger { display: none; background: transparent; border: 0; font-size: 20px; color: var(--ink); cursor: pointer; }
    .scrim { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 39; }
    @media (max-width: 900px) {
      .rail { transform: translateX(-100%); transition: transform .2s ease; }
      .rail.open { transform: translateX(0); }
      .scrim.on { display: block; }
      .main { margin-left: 0; }
      .tray { left: 0; }
      .burger { display: inline-flex; }
      .top, .grid { padding-left: 18px; padding-right: 18px; }
      .top h1 { font-size: 24px; }
      .search { min-width: 100%; margin-left: 0; order: 3; }
    }
  </style>
</head>
<body>

<aside class="rail" id="rail">
  <div class="rail-head">
    <div class="rail-mark">ARABELLA PAPERS</div>
    <div class="rail-sub serif" style="font-size:15px;letter-spacing:.1em">Design Catalogue</div>
  </div>
  <nav class="rail-nav" id="cats"></nav>
  <div class="rail-foot">
    Pick the designs you like, then have them emailed to yourself.<br>
    Quote the code when you place your order.
  </div>
</aside>
<div class="scrim" id="scrim" onclick="c_rail(false)"></div>

<main class="main">
  <header class="top">
    <button class="burger" onclick="c_rail(true)" aria-label="Categories"><i class="fas fa-bars"></i></button>
    <div>
      <h1 class="serif" id="c_title">All designs</h1>
      <div class="count" id="c_count"></div>
    </div>
    <div class="search">
      <i class="fas fa-magnifying-glass"></i>
      <input type="search" id="c_search" placeholder="Search a name or code..." oninput="c_render()" autocomplete="off">
    </div>
  </header>

  <section class="grid" id="c_grid">
    <div class="empty"><i class="fas fa-spinner fa-spin"></i> Loading the catalogue...</div>
  </section>
</main>

<div class="tray" id="c_tray">
  <div class="lead"><b id="c_picked">0</b> selected</div>
  <input type="email" id="c_email" placeholder="your@email.com" autocomplete="email">
  <button class="btn btn-gold" id="c_send" onclick="c_send()">
    <i class="fas fa-paper-plane"></i> Email these to me
  </button>
  <button class="btn btn-ghost" onclick="c_clear()">Clear</button>
  <div class="said" id="c_said"></div>
</div>

<div class="lb" id="c_lb" onclick="c_zoomOff(event)">
  <button class="x" onclick="c_zoomOff(event, true)" aria-label="Close">&times;</button>
  <img id="c_lbImg" alt="">
  <div class="cap2" id="c_lbCap"></div>
</div>

<script>
var c_items = [], c_cat = '', c_pick = new Set();

var esc = function (v) {
  return String(v == null ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
};

function c_rail(open) {
  document.getElementById('rail').classList.toggle('open', open);
  document.getElementById('scrim').classList.toggle('on', open);
}

function c_cats() {
  var counts = {};
  c_items.forEach(function (i) { counts[i.category] = (counts[i.category] || 0) + 1; });
  var cats = Object.keys(counts).sort();
  document.getElementById('cats').innerHTML =
    '<div class="rail-label">Categories</div>'
    + ['', ].concat(cats).map(function (c) {
        return '<button class="cat' + (c === c_cat ? ' on' : '') + '" onclick="c_pickCat(\'' + esc(c) + '\')">'
          + '<i class="fas fa-' + (c ? 'layer-group' : 'border-all') + '" style="width:15px;opacity:.75"></i>'
          + '<span>' + (c ? esc(c) : 'All designs') + '</span>'
          + '<span class="n">' + (c ? counts[c] : c_items.length) + '</span></button>';
      }).join('');
}

function c_pickCat(cat) {
  c_cat = cat;
  document.getElementById('c_title').textContent = cat || 'All designs';
  c_cats();
  c_render();
  c_rail(false);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function c_shown() {
  var q = (document.getElementById('c_search').value || '').toLowerCase().trim();
  return c_items.filter(function (i) {
    if (c_cat && i.category !== c_cat) return false;
    if (!q) return true;
    return (i.name || '').toLowerCase().indexOf(q) > -1
        || (i.code || '').toLowerCase().indexOf(q) > -1
        || (i.category || '').toLowerCase().indexOf(q) > -1;
  });
}

function c_render() {
  var rows = c_shown();
  document.getElementById('c_count').textContent =
    rows.length + (rows.length === 1 ? ' design' : ' designs');

  var grid = document.getElementById('c_grid');
  if (!rows.length) {
    grid.innerHTML = '<div class="empty">Nothing matches that. Try another word, or pick a different category.</div>';
    return;
  }
  grid.innerHTML = rows.map(function (i) {
    return '<article class="tile' + (c_pick.has(i.id) ? ' picked' : '') + '" id="t' + i.id + '">'
      + '<div class="frame" onclick="c_zoom(' + i.id + ')">'
      + '<img loading="lazy" src="/catalogue/image/' + i.id + '" alt="' + esc(i.name || i.category) + '">'
      + '</div>'
      + '<div class="cap">'
      + '<div style="min-width:0">'
      + '<div class="name">' + (esc(i.name) || esc(i.category)) + '</div>'
      + '<div class="sub">' + esc(i.category) + (i.code ? ' &middot; ' + esc(i.code) : '') + '</div>'
      + '</div>'
      + '<button class="pick" onclick="c_toggle(' + i.id + ')" title="Select"><i class="fas fa-check"></i></button>'
      + '</div></article>';
  }).join('');
}

function c_toggle(id) {
  if (c_pick.has(id)) c_pick.delete(id); else c_pick.add(id);
  var t = document.getElementById('t' + id);
  if (t) t.classList.toggle('picked', c_pick.has(id));
  c_tray();
}

function c_clear() {
  c_pick.clear();
  c_render();
  c_tray();
  c_say('', '');
}

function c_tray() {
  document.getElementById('c_picked').textContent = c_pick.size;
  document.getElementById('c_tray').classList.toggle('up', c_pick.size > 0);
}

function c_say(msg, kind) {
  var el = document.getElementById('c_said');
  el.textContent = msg;
  el.className = 'said ' + (kind || '');
}

function c_zoom(id) {
  var i = c_items.find(function (x) { return x.id === id; });
  if (!i) return;
  document.getElementById('c_lbImg').src = '/catalogue/image/' + i.id;
  document.getElementById('c_lbCap').textContent =
    (i.name || i.category) + (i.code ? ' · ' + i.code : '');
  document.getElementById('c_lb').classList.add('on');
}
function c_zoomOff(ev, force) {
  if (force || ev.target.id === 'c_lb') document.getElementById('c_lb').classList.remove('on');
}
document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') document.getElementById('c_lb').classList.remove('on');
});

async function c_send() {
  var email = (document.getElementById('c_email').value || '').trim();
  if (!email) { c_say('Enter your email address.', 'bad'); return; }
  if (!c_pick.size) { c_say('Pick a design first.', 'bad'); return; }

  var btn = document.getElementById('c_send');
  btn.disabled = true;
  c_say('Sending...', '');
  try {
    var res = await fetch('/catalogue/api/email', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, ids: Array.from(c_pick) }),
    });
    var json = await res.json();
    if (!json.success) { c_say(json.error || 'Could not send it.', 'bad'); return; }
    c_say('Sent to ' + email, 'ok');
    c_pick.clear();
    c_render();
    setTimeout(function () { c_tray(); c_say('', ''); }, 2600);
  } catch (e) {
    c_say('Could not reach us just now. Please try again.', 'bad');
  } finally {
    btn.disabled = false;
  }
}

(async function () {
  try {
    var json = await fetch('/catalogue/api/items').then(function (r) { return r.json(); });
    if (!json.success) throw new Error(json.error);
    c_items = json.data || [];
    c_cats();
    c_render();
  } catch (e) {
    document.getElementById('c_grid').innerHTML =
      '<div class="empty">Could not load the catalogue. Please try again in a moment.</div>';
  }
})();
</script>
</body>
</html>
