<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Design Catalogue — Arabella Papers</title>
  <%# Standalone: no session here, so the portal's shell cannot be reused.
      Dark and gold rather than the portal's grey, because this is the page
      the client sends to brides and planners choosing an expensive order -
      the white scans glow against the dark, which is the whole trick. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <style>
    :root {
      --void: #15171a;        /* the field everything sits on */
      --rail-bg: #121417;
      /* Warm gold, not the portal's yellow taken down - that read olive
         against the dark. This is the foil on a wedding card. */
      --gold: #c99a3b;
      --gold-lit: #d8ad55;
      --paper: #f7f4ed;       /* the scans are white; the mat is warmer */
      --dim: #8a8578;
      --hair: rgba(201,162,39,.22);
      --rail: 286px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--void);
      color: #e8e4da;
      font-family: Jost, 'Segoe UI', sans-serif;
      font-weight: 300;
      -webkit-font-smoothing: antialiased;
    }
    .serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    ::selection { background: var(--gold); color: #000; }

    /* ── the rail ─────────────────────────────── */
    .rail {
      position: fixed; inset: 0 auto 0 0; width: var(--rail);
      background: var(--rail-bg); border-right: 1px solid rgba(201,154,59,.3);
      display: flex; flex-direction: column; z-index: 40;
    }
    .crest { padding: 30px 26px 22px; text-align: center; }
    .crest .mark { color: var(--gold); width: 58px; height: 58px; display: inline-block; }
    .crest h1 {
      font-family: 'Cormorant Garamond', serif; font-weight: 400;
      font-size: 27px; letter-spacing: .24em; margin: 14px 0 0;
      color: #fff; text-indent: .24em;
    }
    .crest .papers {
      font-family: 'Cormorant Garamond', serif; font-size: 15px;
      letter-spacing: .4em; color: #cfc9ba; text-indent: .4em; margin-top: 2px;
    }
    .crest .rule { height: 1px; background: var(--hair); margin: 16px 34px; }
    .crest .tag {
      font-size: 9.5px; letter-spacing: .26em; color: var(--dim);
      line-height: 1.9; text-indent: .26em;
    }

    /* No inner scrollbar. Six volumes and a button fit; a bar appearing down
       the middle of the rail is the one thing on this page that would look
       like a settings screen. If the list ever outgrows the rail, the rail
       scrolls as a whole. */
    .cats { padding: 10px 0; }
    .rail { overflow-y: auto; scrollbar-width: none; }
    .rail::-webkit-scrollbar { width: 0; height: 0; }
    .cat {
      display: flex; align-items: center; gap: 15px; width: 100%;
      background: transparent; border: 0; border-left: 2px solid transparent;
      padding: 15px 26px; color: #d8d3c7; cursor: pointer;
      font-family: Jost, sans-serif; font-weight: 300;
      font-size: 13px; letter-spacing: .17em; text-align: left;
      text-transform: uppercase; transition: background .18s, color .18s, border-color .18s;
    }
    .cat svg { color: var(--gold); width: 19px; height: 19px; flex: 0 0 19px; opacity: .8; transition: opacity .18s; }
    .cat:hover { background: rgba(201,162,39,.06); color: #fff; }
    .cat:hover svg { opacity: 1; }
    .cat.on {
      background: linear-gradient(90deg, rgba(201,162,39,.16), transparent 85%);
      border-left-color: var(--gold); color: #fff;
    }
    .cat.on svg { opacity: 1; }
    .cat .n { margin-left: auto; font-size: 12px; letter-spacing: .06em; color: var(--dim); }
    .cat.on .n { color: var(--gold-lit); }

    .rail-b { padding: 22px 26px 30px; margin-top: auto; }
    .ownbtn {
      display: block; width: 100%; padding: 15px 10px;
      background: transparent; border: 1px solid rgba(201,154,59,.5); border-radius: 10px;
      color: var(--gold-lit); font-family: Jost, sans-serif; font-weight: 400;
      font-size: 11px; letter-spacing: .2em; text-transform: uppercase;
      cursor: pointer; line-height: 1.7; transition: background .18s, border-color .18s;
    }
    .ownbtn:hover { background: rgba(201,162,39,.12); border-color: var(--gold); }
    .ownbtn i { display: block; font-size: 15px; margin-bottom: 7px; opacity: .85; }
    .creed {
      margin-top: 26px; text-align: center; font-size: 9.5px;
      letter-spacing: .3em; color: var(--dim); line-height: 2.3; text-indent: .3em;
    }
    .creed .sep { color: var(--gold); opacity: .6; margin-bottom: 8px; font-size: 11px; }

    /* ── the page ─────────────────────────────── */
    .main { margin-left: var(--rail); min-height: 100vh; }
    .masthead { padding: 42px 46px 30px; display: flex; align-items: flex-end; gap: 26px; flex-wrap: wrap; }
    .eyebrow {
      font-size: 11px; letter-spacing: .42em; color: var(--gold);
      text-transform: uppercase; text-indent: .42em; margin-bottom: 12px;
      display: flex; align-items: center; gap: 18px;
    }
    .eyebrow i { flex: 0 0 86px; height: 1px; background: var(--gold); opacity: .55; }
    .masthead h2 {
      font-family: 'Cormorant Garamond', serif; font-weight: 400;
      font-size: 62px; line-height: .95; margin: 0; color: #fff;
      letter-spacing: .04em; text-transform: uppercase;
    }
    .titlewrap { min-width: 0; }
    .underline { height: 1px; background: var(--gold); width: 92px; margin-top: 16px; opacity: .8; }
    .countline {
      font-family: 'Cormorant Garamond', serif; font-style: italic;
      font-size: 20px; color: var(--dim); padding-bottom: 10px; white-space: nowrap;
    }
    .countline::before {
      content: ''; display: inline-block; width: 46px; height: 1px;
      background: var(--hair); vertical-align: middle; margin-right: 18px;
    }
    .search { margin-left: auto; position: relative; min-width: 330px; padding-bottom: 6px; }
    .kbd {
      position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
      font-family: Jost, sans-serif; font-size: 11px; letter-spacing: .1em;
      color: var(--dim); border: 1px solid var(--hair); border-radius: 4px;
      padding: 3px 7px; pointer-events: none;
    }
    .search input {
      width: 100%; padding: 15px 58px 15px 54px; border-radius: 40px;
      border: 1px solid var(--hair); background: rgba(255,255,255,.03);
      color: #efebe1; font-family: Jost, sans-serif; font-weight: 300;
      font-size: 13.5px; letter-spacing: .04em; outline: 0;
      transition: border-color .18s, background .18s;
    }
    .search input::placeholder { color: #6f6a5f; }
    .search input:focus { border-color: var(--gold); background: rgba(201,162,39,.05); }
    .search .ring {
      position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
      width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--hair);
      display: flex; align-items: center; justify-content: center;
      color: var(--gold); font-size: 11px; pointer-events: none;
    }

    .grid { padding: 10px 46px 150px; display: grid; gap: 26px;
            grid-template-columns: repeat(auto-fill, minmax(218px, 1fr)); }
    .tile { position: relative; cursor: default; }
    /* The scan is white; it is matted on warm paper and lifted off the dark
       field. That contrast is doing most of the work on this page, so the
       frame stays quiet and never crops. */
    /* Near-white rather than cream. The scans are white paper with their own
       margins, so a cream mat behind them drew a second rectangle inside the
       first and the card read as a picture of a page instead of a page. */
    .sheet-img {
      background: #fdfcf9; padding: 10px; height: 282px; position: relative;
      display: flex; align-items: center; justify-content: center;
      cursor: zoom-in; box-shadow: 0 10px 34px rgba(0,0,0,.55);
      transition: transform .22s ease, box-shadow .22s ease;
    }
    /* The hairline ruled inside the sheet, the way a printed plate is keyed
       inside the trim. It is drawn rather than part of the scan, so it sits
       true on every page whatever that page's own margins are. */
    .sheet-img::after {
      content: ''; position: absolute; inset: 7px;
      border: 1px solid rgba(26,22,14,.17); pointer-events: none;
    }
    .sheet-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .tile:hover .sheet-img { transform: translateY(-5px); box-shadow: 0 20px 48px rgba(0,0,0,.7); }
    .cap {
      background: #141518; border: 1px solid rgba(255,255,255,.05); border-top: 0;
      padding: 13px 15px; display: flex; align-items: center; gap: 11px;
    }
    .cap .who { min-width: 0; flex: 1; }
    .cap .name {
      font-family: 'Cormorant Garamond', serif; font-size: 19px; color: #f0ece2;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.25;
    }
    .cap .sub {
      font-size: 9.5px; letter-spacing: .2em; color: var(--dim);
      text-transform: uppercase; margin-top: 5px; text-indent: .2em;
    }
    .pick {
      width: 26px; height: 26px; flex: 0 0 26px; border-radius: 50%;
      border: 1px solid rgba(201,162,39,.45); background: transparent;
      color: transparent; cursor: pointer; font-size: 10px;
      display: flex; align-items: center; justify-content: center; transition: all .18s;
    }
    .pick:hover { border-color: var(--gold); color: rgba(201,162,39,.5); }
    .tile.picked .sheet-img { box-shadow: 0 0 0 2px var(--gold), 0 18px 44px rgba(0,0,0,.7); }
    .tile.picked .pick { background: var(--gold); border-color: var(--gold); color: #17181b; }

    .empty {
      grid-column: 1/-1; text-align: center; padding: 110px 20px; color: var(--dim);
      font-family: 'Cormorant Garamond', serif; font-size: 22px; font-style: italic;
    }

    /* ── the tray ─────────────────────────────── */
    .tray {
      position: fixed; left: var(--rail); right: 0; bottom: 0; z-index: 35;
      background: rgba(14,15,17,.97); backdrop-filter: blur(14px);
      border-top: 1px solid var(--hair); padding: 19px 46px;
      display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
      transform: translateY(115%); transition: transform .26s ease;
    }
    .tray.up { transform: translateY(0); }
    .tray .lead { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--dim); }
    .tray .lead b { color: var(--gold-lit); font-size: 15px; letter-spacing: .04em; }
    .tray input[type=email] {
      flex: 1 1 250px; max-width: 350px; padding: 13px 18px; border-radius: 40px;
      border: 1px solid var(--hair); background: rgba(255,255,255,.03);
      color: #efebe1; font-family: Jost, sans-serif; font-weight: 300; font-size: 13.5px; outline: 0;
    }
    .tray input[type=email]::placeholder { color: #6f6a5f; }
    .tray input[type=email]:focus { border-color: var(--gold); }
    .btn {
      border: 1px solid transparent; border-radius: 40px; padding: 13px 26px;
      font-family: Jost, sans-serif; font-weight: 400; font-size: 11px;
      letter-spacing: .2em; text-transform: uppercase; cursor: pointer;
      transition: filter .18s, background .18s, opacity .18s;
    }
    .btn-gold { background: var(--gold); color: #17181b; }
    .btn-gold:hover { filter: brightness(1.12); }
    .btn-gold:disabled { opacity: .5; cursor: default; filter: none; }
    .btn-wire { background: transparent; color: var(--gold-lit); border-color: rgba(201,162,39,.4); }
    .btn-wire:hover { background: rgba(201,162,39,.1); }
    .btn-plain { background: transparent; color: var(--dim); }
    .btn-plain:hover { color: #fff; }
    .said { font-size: 12.5px; letter-spacing: .1em; }
    .said.ok { color: var(--gold-lit); }
    .said.bad { color: #e08a8a; }

    /* ── the customer's own design ────────────── */
    .sheet { position: fixed; inset: 0; z-index: 55; display: none;
             align-items: center; justify-content: center; padding: 24px;
             background: rgba(5,6,7,.82); backdrop-filter: blur(4px); }
    .sheet.on { display: flex; }
    .card {
      background: #141518; border: 1px solid var(--hair); border-radius: 3px;
      width: 100%; max-width: 540px; max-height: 92vh;
      display: flex; flex-direction: column; box-shadow: 0 30px 80px rgba(0,0,0,.8);
    }
    .card-h { padding: 32px 34px 22px; text-align: center; border-bottom: 1px solid rgba(255,255,255,.05); }
    .card-h .orn { color: var(--gold); font-size: 17px; margin-bottom: 14px; }
    .card-h h3 { font-family: 'Cormorant Garamond', serif; font-weight: 400;
                 font-size: 31px; margin: 0; color: #fff; }
    .card-h p { margin: 10px 0 0; color: var(--dim); font-size: 13px; line-height: 1.7; }
    .card-b { padding: 24px 34px; overflow-y: auto; }
    .fld { margin-bottom: 17px; }
    .fld label {
      display: block; font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 8px; text-indent: .22em;
    }
    .fld input[type=text], .fld input[type=email], .fld textarea, .fld input[type=file] {
      width: 100%; padding: 13px 15px; border: 1px solid rgba(255,255,255,.1);
      background: rgba(255,255,255,.03); color: #efebe1; border-radius: 2px;
      font-family: Jost, sans-serif; font-weight: 300; font-size: 13.5px; outline: 0;
    }
    .fld input::placeholder, .fld textarea::placeholder { color: #5f5b53; }
    .fld textarea { resize: vertical; min-height: 90px; }
    .fld input:focus, .fld textarea:focus { border-color: var(--gold); }
    .fld .hint { font-size: 11.5px; color: var(--dim); margin-top: 7px; }
    .card-f { padding: 20px 34px 28px; border-top: 1px solid rgba(255,255,255,.05);
              display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }

    /* ── drawn ornament ───────────────────────────
       The reference has photographed dried flowers and a wax seal in these
       corners. These are drawn instead, and kept faint on purpose: the page
       is carrying 141 pieces of real line art and a loud ornament would be
       competing with the thing people came to look at. */
    .bot { position: absolute; pointer-events: none; color: var(--gold); }
    /* The photographs come on a black ground rather than with real
       transparency, because image generators rarely give an alpha channel.
       Screen blending drops black to nothing and keeps everything lighter
       than it, so a gold sprig on black composites onto this page cleanly
       with no cutting out - and the page's own background is near-black,
       which is what makes the trick hold. */
    .photo { position: absolute; pointer-events: none; mix-blend-mode: screen; }
    .photo-rail { left: 0; bottom: 0; width: 100%; opacity: .55; }
    .photo-top { right: 0; top: 0; width: 620px; max-width: 46%; opacity: .5; }
    @media (max-width: 980px) { .photo-top { display: none; } }
    /* Clear of the button rather than behind it: a faint drawing under a
       bordered control reads as a smudge on the screen, not as ornament. */
    .bot-rail { left: -22px; bottom: -6px; width: 172px; opacity: .15; }
    .bot-top { right: 30px; top: 8px; width: 290px; opacity: .13; }
    @media (max-width: 980px) { .bot-top { display: none; } }

    /* ── zoom ─────────────────────────────────── */
    .lb { position: fixed; inset: 0; background: rgba(5,6,7,.95); z-index: 60;
          display: none; align-items: center; justify-content: center; padding: 34px; }
    .lb.on { display: flex; }
    .lb img { max-width: 92vw; max-height: 80vh; object-fit: contain;
              background: var(--paper); padding: 18px; box-shadow: 0 30px 90px rgba(0,0,0,.9); }
    .lb .cap2 {
      position: absolute; bottom: 28px; left: 0; right: 0; text-align: center;
      color: var(--dim); font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase;
    }
    .lb .x { position: absolute; top: 26px; right: 30px; background: transparent;
             border: 0; color: var(--dim); font-size: 27px; cursor: pointer; line-height: 1; }
    .lb .x:hover { color: var(--gold); }

    /* ── phone ────────────────────────────────── */
    .burger { display: none; background: transparent; border: 0; color: var(--gold);
              font-size: 19px; cursor: pointer; padding: 0 4px 10px 0; }
    .scrim { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.65); z-index: 39; }
    @media (max-width: 980px) {
      .rail { transform: translateX(-100%); transition: transform .24s ease; }
      .rail.open { transform: translateX(0); }
      .scrim.on { display: block; }
      .main { margin-left: 0; }
      .tray { left: 0; padding: 16px 20px; }
      .burger { display: inline-block; }
      .masthead { padding: 26px 20px 20px; }
      .grid { padding: 6px 20px 150px; }
      .masthead h2 { font-size: 38px; }
      .countline { font-size: 16px; }
      .countline::before { display: none; }
      .search { min-width: 100%; margin-left: 0; order: 4; }
    }
  </style>
</head>
<body>

<aside class="rail" id="rail">
  <%# Drawn rather than set in an icon font. A medallion is the thing a
      stationer's mark actually looks like, and no icon in Font Awesome is
      one - the nearest was a pinwheel. %>
  <div class="crest">
    <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.1">
        <circle cx="32" cy="32" r="5.5"/>
        <circle cx="32" cy="32" r="14.5" stroke-opacity=".5"/>
        <circle cx="32" cy="32" r="21" stroke-opacity=".28"/>
        <g stroke-opacity=".9">
          <path d="M32 10c3.6 4.2 3.6 9.3 0 13.5-3.6-4.2-3.6-9.3 0-13.5z"/>
          <path d="M32 54c-3.6-4.2-3.6-9.3 0-13.5 3.6 4.2 3.6 9.3 0 13.5z"/>
          <path d="M10 32c4.2-3.6 9.3-3.6 13.5 0-4.2 3.6-9.3 3.6-13.5 0z"/>
          <path d="M54 32c-4.2 3.6-9.3 3.6-13.5 0 4.2-3.6 9.3-3.6 13.5 0z"/>
        </g>
        <g stroke-opacity=".6">
          <path d="M16.4 16.4c4.9 1.4 8.1 4.6 9.5 9.5-4.9-1.4-8.1-4.6-9.5-9.5z"/>
          <path d="M47.6 47.6c-4.9-1.4-8.1-4.6-9.5-9.5 4.9 1.4 8.1 4.6 9.5 9.5z"/>
          <path d="M47.6 16.4c-1.4 4.9-4.6 8.1-9.5 9.5 1.4-4.9 4.6-8.1 9.5-9.5z"/>
          <path d="M16.4 47.6c1.4-4.9 4.6-8.1 9.5-9.5-1.4 4.9-4.6 8.1-9.5 9.5z"/>
        </g>
      </g>
    </svg>
    <h1 class="serif">ARABELLA</h1>
    <div class="papers">PAPERS</div>
    <div class="rule"></div>
    <div class="tag">LUXURY WEDDING STATIONERY<br>JAIPUR</div>
  </div>
  <nav class="cats" id="cats"></nav>
  <div class="rail-b">
    <button class="ownbtn" onclick="c_own(true)">
      <i class="fas fa-cloud-arrow-up"></i>
      Send us your<br>own design
    </button>
    <div class="creed">
      <div class="sep">&#10086;</div>
      FINE PAPERS<br>TIMELESS<br>CELEBRATIONS
    </div>
  </div>
  <%# The photograph if it is there, the drawing if it is not.
      onerror rather than a server-side check: this page is served from a
      view with no filesystem look-up in it, and a missing file should leave
      the ornament it replaced in place rather than a broken image icon. %>
  <img class="photo photo-rail" src="/ornament/sprig.png" alt=""
       onerror="this.remove(); document.getElementById('botRail').style.display='';">
  <svg id="botRail" style="display:none" class="bot bot-rail" viewBox="0 0 160 210" fill="none" stroke="currentColor"
       stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
    <path d="M18 208C26 160 44 118 76 86"/>
    <path d="M30 170c-9-7-13-17-12-29 11 3 19 11 22 22M34 158c10-4 20-2 29 6-8 8-18 10-29 6"/>
    <path d="M48 134c-9-6-14-15-14-27 11 2 20 9 24 20M52 124c10-5 20-4 29 3-7 9-17 12-28 8"/>
    <path d="M66 104c-8-6-12-15-12-25 10 2 18 8 22 18M70 96c10-5 20-5 29 1-7 9-16 13-27 10"/>
    <path d="M10 190C22 150 30 108 26 66"/>
    <path d="M26 66c-5 5-8 12-7 20 7-2 11-8 11-16M26 66c5 5 8 12 7 20-7-2-11-8-11-16"/>
    <g stroke-width="1">
      <circle cx="96" cy="74" r="3.4"/><circle cx="106" cy="62" r="2.6"/>
      <circle cx="90" cy="60" r="2.2"/><circle cx="112" cy="76" r="2"/>
      <path d="M86 84c6-4 13-5 20-3"/>
    </g>
  </svg>
</aside>
<div class="scrim" id="scrim" onclick="c_rail(false)"></div>

<main class="main">
  <img class="photo photo-top" src="/ornament/seal.png" alt=""
       onerror="this.remove(); document.getElementById('botTop').style.display='';">
  <%# The corner spray and seal the reference photographs, drawn. Behind the
      masthead and faint, so the title still reads first. %>
  <svg id="botTop" style="display:none" class="bot bot-top" viewBox="0 0 300 150" fill="none" stroke="currentColor"
       stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
    <path d="M298 10c-44 2-82 16-114 42"/>
    <path d="M262 18c-4-9-3-18 3-26 7 7 9 16 5 26M268 22c9-5 18-5 27 1-7 8-16 10-26 6"/>
    <path d="M226 36c-5-8-5-17 0-26 8 6 11 15 8 25M232 42c8-6 17-8 27-3-6 9-15 12-25 9"/>
    <path d="M192 60c-6-8-7-17-3-26 9 5 13 13 11 24M198 68c8-7 17-10 27-6-5 9-14 14-24 11"/>
    <path d="M290 54c-30 6-56 20-78 42"/>
    <g stroke-width="1">
      <circle cx="176" cy="96" r="3"/><circle cx="166" cy="106" r="2.3"/>
      <circle cx="186" cy="106" r="2"/>
    </g>
    <%# the seal %>
    <g transform="translate(118 96)">
      <circle r="17" stroke-width="1.3"/>
      <circle r="11.5" stroke-opacity=".6"/>
      <path d="M0-7.5C2.6-4 2.6-1 0 2.5-2.6-1-2.6-4 0-7.5zM7.5 0C4 2.6 1 2.6-2.5 0 1-2.6 4-2.6 7.5 0z"
            stroke-opacity=".8"/>
    </g>
  </svg>
  <header class="masthead">
    <div class="titlewrap">
      <button class="burger" onclick="c_rail(true)" aria-label="Categories"><i class="fas fa-bars"></i></button>
      <%# The rule runs on from the words rather than under them, which is
          what the reference does and what sets the eyebrow apart from a
          label. %>
      <div class="eyebrow"><span>Design Catalogue</span><i></i></div>
      <h2 class="serif" id="c_title">All Designs</h2>
      <div class="underline"></div>
    </div>
    <div class="countline" id="c_count"></div>
    <div class="search">
      <span class="ring"><i class="fas fa-magnifying-glass"></i></span>
      <input type="search" id="c_search" placeholder="Search designs, codes..." oninput="c_render()" autocomplete="off">
      <%# Shown because the reference shows it - so it has to actually work,
          or it is a picture of a feature. Ctrl on Windows, Command on a Mac,
          and the label follows whichever this machine is. %>
      <kbd class="kbd" id="c_kbd">&#8984;K</kbd>
    </div>
  </header>

  <section class="grid" id="c_grid">
    <div class="empty">Bringing out the catalogue...</div>
  </section>
</main>

<div class="tray" id="c_tray">
  <div class="lead"><b id="c_picked">0</b> &nbsp;selected</div>
  <input type="email" id="c_email" placeholder="your@email.com" autocomplete="email">
  <button class="btn btn-gold" id="c_send" onclick="c_send()">Email these to me</button>
  <button class="btn btn-plain" onclick="c_clear()">Clear</button>
  <div class="said" id="c_said"></div>
</div>

<%# For the customer who has their own monogram or font. It goes to the office
    and nowhere else - the sender does not choose who receives it. %>
<div class="sheet" id="c_own" onclick="c_ownOff(event)">
  <div class="card" onclick="event.stopPropagation()">
    <div class="card-h">
      <div class="orn">&#10086;</div>
      <h3 class="serif">Send us your own design</h3>
      <p>Made your own monogram, or have a font you would like used?<br>
         Send it across and we will come back to you.</p>
    </div>
    <div class="card-b">
      <div class="fld">
        <label for="o_name">Your name</label>
        <input type="text" id="o_name" autocomplete="name" placeholder="Optional">
      </div>
      <div class="fld">
        <label for="o_email">Your email</label>
        <input type="email" id="o_email" autocomplete="email" placeholder="your@email.com">
        <div class="hint">So we can reply to you.</div>
      </div>
      <div class="fld">
        <label for="o_note">Anything you want to tell us</label>
        <textarea id="o_note" placeholder="What it is, where you would like it used..."></textarea>
      </div>
      <div class="fld">
        <label for="o_files">Your design</label>
        <input type="file" id="o_files" multiple accept="image/*,application/pdf,.ai,.eps">
        <div class="hint">Pictures or a PDF, up to three files, 4 MB each.</div>
      </div>
    </div>
    <div class="card-f">
      <button class="btn btn-gold" id="o_send" onclick="c_ownSend()">Send it</button>
      <button class="btn btn-plain" onclick="c_own(false)">Cancel</button>
      <div class="said" id="o_said"></div>
    </div>
  </div>
</div>

<div class="lb" id="c_lb" onclick="c_zoomOff(event)">
  <button class="x" onclick="c_zoomOff(event, true)" aria-label="Close">&times;</button>
  <img id="c_lbImg" alt="">
  <div class="cap2" id="c_lbCap"></div>
</div>

<script>
var c_items = [], c_cat = '', c_pick = new Set();

var esc = function (v) {
  return String(v == null ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
};

// A drawn mark for each volume, not an icon from a font.
//
// Font Awesome has a crown and a flower and a box, and a row of those beside
// words like Monograms and Motifs looks like a settings menu. These are line
// drawings of the thing each volume actually contains - a rule, a letterform,
// a cipher, a bloom, a sheet, a repeat.
var CAT_MARK = {
  'Borders':    '<path d="M2 6h16M2 10h16M2 14h16" stroke-opacity=".9"/><path d="M6 6v8M14 6v8" stroke-opacity=".45"/>',
  'Fonts':      '<path d="M4 16 10 4l6 12M6.6 12h6.8"/>',
  'Monograms':  '<path d="M10 3c3.9 0 7 3.1 7 7s-3.1 7-7 7-7-3.1-7-7 3.1-7 7-7z" stroke-opacity=".35"/><path d="M7 13V7l3 4 3-4v6"/>',
  'Motifs':     '<path d="M10 3c1.9 2.3 1.9 5.1 0 7.4-1.9-2.3-1.9-5.1 0-7.4zM3 10c2.3-1.9 5.1-1.9 7.4 0-2.3 1.9-5.1 1.9-7.4 0zM17 10c-2.3 1.9-5.1 1.9-7.4 0 2.3-1.9 5.1-1.9 7.4 0zM10 17c-1.9-2.3-1.9-5.1 0-7.4 1.9 2.3 1.9 5.1 0 7.4z"/>',
  'Order Form': '<path d="M5 3h7l3 3v11H5z"/><path d="M12 3v3h3" stroke-opacity=".5"/><path d="M7.5 9.5h5M7.5 12.5h5" stroke-opacity=".7"/>',
  'Patterns':   '<path d="M4 4h5v5H4zM11 4h5v5h-5zM4 11h5v5H4zM11 11h5v5h-5z" stroke-opacity=".75"/>',
};
var CAT_ALL = '<path d="M10 2.5 12.3 7l5 .7-3.6 3.5.9 5-4.6-2.4L5.4 16l.9-5L2.7 7.7l5-.7z"/>';

function c_mark(cat) {
  return '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" '
    + 'stroke-linecap="round" stroke-linejoin="round">'
    + (cat ? (CAT_MARK[cat] || CAT_ALL) : CAT_ALL) + '</svg>';
}

function c_rail(open) {
  document.getElementById('rail').classList.toggle('open', open);
  document.getElementById('scrim').classList.toggle('on', open);
}

function c_cats() {
  var counts = {};
  c_items.forEach(function (i) { counts[i.category] = (counts[i.category] || 0) + 1; });
  var cats = Object.keys(counts).sort();
  document.getElementById('cats').innerHTML =
    [''].concat(cats).map(function (c) {
      return '<button class="cat' + (c === c_cat ? ' on' : '') + '" onclick="c_pickCat(\'' + esc(c) + '\')">'
        + c_mark(c)
        + '<span>' + (c ? esc(c) : 'All Designs') + '</span>'
        + '<span class="n">' + (c ? counts[c] : c_items.length) + '</span></button>';
    }).join('');
}

function c_pickCat(cat) {
  c_cat = cat;
  document.getElementById('c_title').textContent = cat || 'All Designs';
  c_cats();
  c_render();
  c_rail(false);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function c_shown() {
  var q = (document.getElementById('c_search').value || '').toLowerCase().trim();
  return c_items.filter(function (i) {
    if (c_cat && i.category !== c_cat) return false;
    if (!q) return true;
    return (i.name || '').toLowerCase().indexOf(q) > -1
        || (i.code || '').toLowerCase().indexOf(q) > -1
        || (i.category || '').toLowerCase().indexOf(q) > -1;
  });
}

function c_render() {
  var rows = c_shown();
  document.getElementById('c_count').textContent =
    rows.length + (rows.length === 1 ? ' design' : ' designs');

  var grid = document.getElementById('c_grid');
  if (!rows.length) {
    grid.innerHTML = '<div class="empty">Nothing here matches that.</div>';
    return;
  }
  grid.innerHTML = rows.map(function (i) {
    return '<article class="tile' + (c_pick.has(i.id) ? ' picked' : '') + '" id="t' + i.id + '">'
      + '<div class="sheet-img" onclick="c_zoom(' + i.id + ')">'
      + '<img loading="lazy" src="/catalogue/thumb/' + i.id + '" alt="' + esc(i.name || i.category) + '">'
      + '</div>'
      + '<div class="cap">'
      + '<div class="who">'
      + '<div class="name">' + (esc(i.name) || esc(i.category)) + '</div>'
      + '<div class="sub">' + esc(i.category) + (i.code ? ' &middot; ' + esc(i.code) : '') + '</div>'
      + '</div>'
      + '<button class="pick" onclick="c_toggle(' + i.id + ')" title="Select"><i class="fas fa-check"></i></button>'
      + '</div></article>';
  }).join('');
}

function c_toggle(id) {
  if (c_pick.has(id)) c_pick.delete(id); else c_pick.add(id);
  var t = document.getElementById('t' + id);
  if (t) t.classList.toggle('picked', c_pick.has(id));
  c_tray();
}

function c_clear() {
  c_pick.clear();
  c_render();
  c_tray();
  c_say('', '');
}

function c_tray() {
  document.getElementById('c_picked').textContent = c_pick.size;
  document.getElementById('c_tray').classList.toggle('up', c_pick.size > 0);
}

function c_say(msg, kind) {
  var el = document.getElementById('c_said');
  el.textContent = msg;
  el.className = 'said ' + (kind || '');
}

function c_zoom(id) {
  var i = c_items.find(function (x) { return x.id === id; });
  if (!i) return;
  document.getElementById('c_lbImg').src = '/catalogue/image/' + i.id;
  document.getElementById('c_lbCap').textContent =
    (i.name || i.category) + (i.code ? ' · ' + i.code : '');
  document.getElementById('c_lb').classList.add('on');
}
function c_zoomOff(ev, force) {
  if (force || ev.target.id === 'c_lb') document.getElementById('c_lb').classList.remove('on');
}
// The badge says a shortcut exists, so there is one. Ctrl on Windows and
// Linux, Command on a Mac, and the badge is relabelled to match the machine
// it is being read on rather than always claiming a Mac key.
if (!/Mac|iPhone|iPad/.test(navigator.platform || '')) {
  document.getElementById('c_kbd').textContent = 'Ctrl K';
}
document.addEventListener('keydown', function (e) {
  if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
    e.preventDefault();
    var box = document.getElementById('c_search');
    box.focus();
    box.select();
    return;
  }
  if (e.key !== 'Escape') return;
  // The zoom sits above the form, so it closes first: pressing Escape with
  // both open should put back what was just covered, not throw away a form
  // somebody has been typing into.
  var lb = document.getElementById('c_lb');
  if (lb.classList.contains('on')) { lb.classList.remove('on'); return; }
  c_own(false);
});

function c_own(open) {
  document.getElementById('c_own').classList.toggle('on', open);
  if (open) {
    c_rail(false);
    c_ownSay('', '');
    setTimeout(function () { document.getElementById('o_email').focus(); }, 60);
  }
}
function c_ownOff(ev) { if (ev.target.id === 'c_own') c_own(false); }

function c_ownSay(msg, kind) {
  var el = document.getElementById('o_said');
  el.textContent = msg;
  el.className = 'said ' + (kind || '');
}

async function c_ownSend() {
  var email = (document.getElementById('o_email').value || '').trim();
  var files = document.getElementById('o_files').files;
  if (!email) { c_ownSay('We need your email to reply.', 'bad'); return; }
  if (!files.length) { c_ownSay('Attach your design first.', 'bad'); return; }

  var fd = new FormData();
  fd.append('name', document.getElementById('o_name').value);
  fd.append('email', email);
  fd.append('note', document.getElementById('o_note').value);
  for (var i = 0; i < files.length; i++) fd.append('files', files[i]);

  // Said on the button itself, because this waits on an SMTP server and takes
  // several seconds with a real picture attached. A small word beside a button
  // that still looks pressable reads as stuck rather than busy.
  var btn = document.getElementById('o_send');
  var label = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending';
  c_ownSay('This can take a few seconds.', '');
  try {
    var json = await fetch('/catalogue/api/theirs', { method: 'POST', body: fd })
      .then(function (r) { return r.json(); });
    if (!json.success) { c_ownSay(json.error || 'It did not go.', 'bad'); return; }
    c_ownSay('Sent — we will be in touch.', 'ok');
    document.getElementById('o_note').value = '';
    document.getElementById('o_files').value = '';
    setTimeout(function () { c_own(false); }, 1800);
  } catch (e) {
    c_ownSay('Could not reach us just now. Please try again.', 'bad');
  } finally {
    btn.disabled = false;
    btn.innerHTML = label;
  }
}

async function c_send() {
  var email = (document.getElementById('c_email').value || '').trim();
  if (!email) { c_say('Enter your email address.', 'bad'); return; }
  if (!c_pick.size) { c_say('Pick a design first.', 'bad'); return; }

  var btn = document.getElementById('c_send');
  var label = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending';
  c_say('This can take a few seconds.', '');
  try {
    var res = await fetch('/catalogue/api/email', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, ids: Array.from(c_pick) }),
    });
    var json = await res.json();
    if (!json.success) { c_say(json.error || 'Could not send it.', 'bad'); return; }
    c_say('Sent to ' + email, 'ok');
    c_pick.clear();
    c_render();
    setTimeout(function () { c_tray(); c_say('', ''); }, 2600);
  } catch (e) {
    c_say('Could not reach us just now. Please try again.', 'bad');
  } finally {
    btn.disabled = false;
    btn.innerHTML = label;
  }
}

(async function () {
  try {
    var json = await fetch('/catalogue/api/items').then(function (r) { return r.json(); });
    if (!json.success) throw new Error(json.error);
    c_items = json.data || [];
    c_cats();
    c_render();
  } catch (e) {
    document.getElementById('c_grid').innerHTML =
      '<div class="empty">Could not bring out the catalogue just now.</div>';
  }
})();
</script>
</body>
</html>
