<%# ══════════════════════════════════════════════════════
    INLINE BULK UPLOAD — the widget, shared by every page that has a list
    worth importing.

    Drop `<div class="bulk-inline" data-bulk-type="orders"></div>` inside a
    modal and this builds the sample-download, file picker, preview table and
    import button into it. The type has to be one routes/api/bulk.js knows.

    Each page says what to do once rows have landed:

      window.bulkAfterImport = async (type) => { ... };

    which is the only part that differs — the dashboard refreshes its dealer
    and designer dropdowns, Recruitment reloads its board. Everything else is
    the same wherever it is used, which is why it is in here and not copied
    into each page.

    It is raw JavaScript, no <script> tag: include it inside the page's own
    script block. APP_USER comes from app.ejs, so it is there on every page.
 ══════════════════════════════════════════════════════ %>
// ═══ INLINE BULK UPLOAD (dealer / designer / order modals) ═══
// Mirrors the server's rule in routes/api/bulk.js — a Designer can add one
// dealer at a time from these modals but may not import, so the whole section
// comes out rather than leading to a 403.
function canBulkUpload() {
  return APP_USER.role === 'SuperAdmin' || APP_USER.domain === 'Head';
}

function bulkEsc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function downloadSample(type) {
  // Served as an attachment, so this downloads without leaving the page.
  window.location.href = '/api/bulk/template/' + type;
}

// One template mounted in three modals, so the markup does not get triplicated.
function renderBulkInline() {
  document.querySelectorAll('.bulk-inline').forEach(function(box) {
    const type = box.getAttribute('data-bulk-type');
    if (!canBulkUpload()) { box.remove(); return; }

    box.innerHTML =
      '<div class="d-flex align-items-center my-3">'
      + '<hr class="flex-grow-1 m-0"/>'
      + '<span class="px-2 small fw-bold text-muted text-uppercase" style="letter-spacing:.06em;">or bulk upload csv</span>'
      + '<hr class="flex-grow-1 m-0"/>'
      + '</div>'
      + '<div class="d-flex flex-wrap gap-2 align-items-center">'
      + '<input type="file" class="form-control form-control-sm bulk-file" accept=".csv,.xlsx" style="max-width:250px;"/>'
      + '<button type="button" class="btn btn-success btn-sm fw-bold bulk-go"><i class="fas fa-upload me-1"></i>Upload CSV</button>'
      + '<button type="button" class="btn btn-outline-secondary btn-sm bulk-sample"><i class="fas fa-download me-1"></i>Sample</button>'
      + '</div>'
      + '<div class="small text-muted mt-2 bulk-format">Loading format...</div>';

    box.querySelector('.bulk-sample').addEventListener('click', function() { downloadSample(type); });
    box.querySelector('.bulk-go').addEventListener('click', function() { runBulkUpload(type, box); });

    loadBulkFormat(type, box);
  });
}

// The format line is built from the same column config the importer validates
// against, so it can never describe a file the server would reject.
async function loadBulkFormat(type, box) {
  const line = box.querySelector('.bulk-format');
  try {
    const res = await fetch('/api/bulk/columns/' + type);
    const data = await res.json();
    if (!data.success) throw new Error('failed');

    const parts = data.columns.map(function(c) {
      let s = bulkEsc(c.header);
      if (c.allowed) s += ' (' + c.allowed.map(bulkEsc).join('/') + ')';
      else if (c.hint) s += ' (' + bulkEsc(c.hint) + ')';
      else if (c.required) s += ' (required)';
      else return s;
      // Both at once for the one column that is compulsory and needs an
      // example, rather than silently dropping one of the two.
      if (c.required && c.hint) s += ' (required)';
      return s;
    });
    line.innerHTML = '<b>Format:</b> ' + parts.join(', ')
      + ' &mdash; .csv or .xlsx, headers in row 1, up to 2000 rows.';
  } catch (e) {
    line.textContent = 'Download the sample to see the expected columns.';
  }
}

async function runBulkUpload(type, box) {
  const input = box.querySelector('.bulk-file');
  const btn = box.querySelector('.bulk-go');
  if (!input.files.length) { showToast('warning', 'Choose a file first.'); return; }

  const body = new FormData();
  body.append('type', type);
  body.append('file', input.files[0]);
  // The preview's "already exists" check compares against one team's names, so
  // it has to know which team before it can flag anything.
  if (type === 'designers') body.append('team', selectedDesignerTeam());

  btn.disabled = true;
  showLoading(true);
  try {
    // Always previewed first: a spreadsheet nobody has checked is exactly where
    // a bad row would otherwise land silently in the table.
    const res = await fetch('/api/bulk/preview', { method: 'POST', body: body });
    const data = await res.json();
    if (!data.success) { showLoading(false); await bulkAlert('error', 'Could not read that file', data.error); return; }

    const ready = data.rows.filter(function(r) { return !r.errors.length && !r.data.__skip; });
    showLoading(false);

    if (!ready.length) {
      await bulkAlert('error', 'Nothing to import', bulkProblemHtml(data));
      return;
    }

    // A clean single-tab file imports on one click; anything else has to be
    // looked at. A workbook of several tabs counts as "anything else" even
    // when every row is clean: the office should see which tabs were read and
    // how many rows each gave before a thousand people go in, since reading
    // the wrong set of tabs is the one mistake here that looks like success.
    if (data.summary.invalid || data.summary.skipped || (data.sheets || []).length > 1) {
      const go = await Swal.fire({
        title: 'Import ' + ready.length + ' of ' + data.summary.total + ' rows?',
        html: bulkProblemHtml(data),
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Import ' + ready.length + ' rows',
      });
      if (!go.isConfirmed) { btn.disabled = false; return; }
    }

    showLoading(true);
    const imp = await fetch('/api/bulk/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      // Designers go into a different column per team, so the import has to be
      // told which one the modal is currently set to.
      body: JSON.stringify({
        type: type,
        team: type === 'designers' ? selectedDesignerTeam() : undefined,
        // The tab travels with the row so a rejection can name a place
        // somebody can open, and so the import's own fallbacks (an empty
        // Position takes the tab name) see what the preview saw.
        rows: ready.map(function(r) { return { line: r.line, sheet: r.sheet, data: r.data }; }),
      }),
    });
    const result = await imp.json();
    showLoading(false);

    if (!result.success) { await bulkAlert('error', 'Import failed', result.error); btn.disabled = false; return; }

    input.value = '';
    showToast('success', result.imported + ' rows imported');
    if (window.bulkAfterImport) await window.bulkAfterImport(type);
  } catch (e) {
    showLoading(false);
    await bulkAlert('error', 'Import failed', 'Network error. Please try again.');
  } finally {
    btn.disabled = false;
  }
}

/**
 * Which tabs were read, and how many rows each one gave.
 *
 * Shown whenever there is more than one, because the alternative is what used
 * to happen: a workbook of eleven department tabs imported the first and
 * reported a cheerful success, and 930 people were missing with nothing on
 * screen to suggest it. A count per tab is something the office can check
 * against their own file at a glance.
 */
function bulkSheetsHtml(data) {
  const sheets = data.sheets || [];
  if (sheets.length < 2) return '';
  const total = sheets.reduce(function (n, s) { return n + s.rows; }, 0);
  return '<div class="small text-start border rounded p-2 mb-2">'
    + '<div class="fw-bold mb-1">Read ' + total + ' rows from ' + sheets.length + ' tabs</div>'
    + sheets.map(function (s) {
        return '<div class="d-flex justify-content-between"><span>' + bulkEsc(s.name)
          + '</span><span class="text-muted">' + s.rows + '</span></div>';
      }).join('')
    + '</div>';
}

// Warnings that explain what the import understood rather than what is wrong
// with the file. On the office's list 959 of 1136 rows carry one, so printing
// them per row buried the nine rows somebody could actually go and fix. Said
// once, in the summary, instead.
function bulkIsReading(w) { return /^Read "/.test(w); }

function bulkProblemHtml(data) {
  // Rows with errors first, always. They are the ones that will not import
  // and the only ones anybody can do something about; listing them after a
  // screenful of duplicates is hiding the actionable half of the message.
  const broken = data.rows.filter(function(r) { return r.errors.length; });
  const skipped = data.rows.filter(function(r) { return !r.errors.length && r.data.__skip; });
  const bad = broken.concat(skipped);

  const shown = bad.slice(0, 8).map(function(r) {
    const why = r.errors.length
      ? r.errors.join('; ')
      : r.warnings.filter(function(w) { return !bulkIsReading(w); }).join('; ');
    // "Row 42" is no use in a workbook of eleven tabs.
    const where = r.sheet ? bulkEsc(r.sheet) + ' row ' + r.line : 'Row ' + r.line;
    return '<li class="text-start small">'
      + (r.errors.length ? '<span class="text-danger fw-bold">' + where + '</span>' : where)
      + ': ' + bulkEsc(why) + '</li>';
  }).join('');

  const reading = data.rows.filter(function(r) {
    return r.warnings.some(bulkIsReading);
  }).length;

  return '<div class="mb-2 small">'
    + data.summary.ready + ' ready &middot; '
    + data.summary.skipped + ' duplicate &middot; '
    + data.summary.invalid + ' with errors</div>'
    + bulkSheetsHtml(data)
    + (reading ? '<div class="small text-muted text-start mb-2">'
        + reading + (reading === 1 ? ' row had' : ' rows had')
        + ' a Status that is not one of the stages — each was read as '
        + 'Applied or Rejected, and the original wording is kept on the candidate.</div>' : '')
    + '<ul class="mb-0">' + shown + '</ul>'
    + (bad.length > 8 ? '<div class="small text-muted mt-1">...and ' + (bad.length - 8) + ' more</div>' : '');
}

function bulkAlert(icon, title, html) {
  return Swal.fire({ icon: icon, title: title, html: html });
}

// Imported names have to reach the dropdowns in these same modals, or the next
// order punch will not find the dealer that was just added.

// Mounted here rather than by each page, so a page that includes this gets
// the widget by including it and nothing else. The markup is already in the
// DOM by the time a view's scripts run.
renderBulkInline();
