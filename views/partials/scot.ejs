<%# ══════════════════════════════════════════════════════
    S.C.O.T. — THE CALLING LIST

    The panel itself: the filters, the table and the script that fills it.

    It used to fold out of the Orders Dashboard as well, which is why it is a
    partial. Once it had a tab of its own that fold-out was the same list in
    two places, so it was taken off the dashboard; the partial stays, because
    one file is still the right home for a thing this size.

    The sheet does the thinking. It already works out each client's ordering
    rhythm and when they are due again, and nothing in here recalculates any
    of it - two answers to one question is how a number starts being argued
    about in a meeting.

    Self-contained on purpose: the escape helper is its own rather than
    bulkEsc from the bulkUpload partial, which is only loaded on two pages
    and would leave this one throwing on a page that did not have it.
    downloadXlsx comes from app.ejs, so it is on every page.
 ══════════════════════════════════════════════════════ %>
<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
  <select id="scot_when" class="form-select form-select-sm" style="max-width:220px" onchange="scot_render()">
    <option value="due">Due now or overdue</option>
    <option value="soon">Due in the next 7 days</option>
    <option value="all">Everyone on the list</option>
  </select>
  <input type="text" id="scot_search" class="form-control form-control-sm" style="max-width:220px"
         placeholder="Client name..." onkeyup="scot_render()">
  <button class="btn btn-sm btn-outline-dark" onclick="scot_load(true)"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
  <button class="btn btn-sm btn-outline-success" onclick="scot_download(this)"><i class="fas fa-file-excel me-1"></i>Excel</button>
  <a class="btn btn-sm btn-outline-primary ms-auto" id="scot_sheetLink" target="_blank" rel="noopener" href="#">
    <i class="fas fa-up-right-from-square me-1"></i>Open the sheet
  </a>
</div>
<div class="text-muted small mb-2" id="scot_note">Opening…</div>

<%# Ours, and only ours. Nothing in this box is written back into the sheet. %>
<div class="modal fade" id="scot_noteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-phone-volume me-2"></i><span id="scot_noteClient"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="text-muted small mb-3" id="scot_noteWhen"></div>
        <div class="mb-3">
          <label class="form-label fw-bold">Status</label>
          <select class="form-select" id="scot_noteStatus">
            <option value="">Not set</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
        <div class="mb-1">
          <label class="form-label fw-bold">Remark</label>
          <textarea class="form-control" id="scot_noteRemark" rows="4"
                    placeholder="What came of the call, or what to say next time."></textarea>
        </div>
        <div class="form-text" id="scot_noteBy"></div>
        <div class="form-text">Kept here, not in the sheet — the sheet's own working out is left alone.</div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-primary" onclick="scot_saveNote(this)">Save</button>
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* The row opens the note box, so it has to look as though it can be
     pressed. */
  .scot-row { cursor:pointer; }
  .scot-tile { cursor:pointer; transition:.12s; }
  .scot-tile:hover { transform:translateY(-1px); box-shadow:0 .35rem .8rem rgba(0,0,0,.12) !important; }
  .scot-tile:focus-visible { outline:2px solid #0d6efd; outline-offset:2px; }
</style>
<div class="table-responsive" style="max-height:<%= typeof scotTall !== 'undefined' && scotTall ? '68vh' : '380px' %>;overflow-y:auto;">
  <table class="mcard table table-hover table-striped mb-0 text-nowrap">
    <thead class="table-dark">
      <tr>
        <th style="position:sticky;top:0;background:#212529;color:white;">Client</th>
        <th style="position:sticky;top:0;background:#212529;color:white;">Orders every</th>
        <th style="position:sticky;top:0;background:#212529;color:white;">Last order</th>
        <th style="position:sticky;top:0;background:#212529;color:white;">Days since</th>
        <th style="position:sticky;top:0;background:#212529;color:white;">Orders so far</th>
        <th style="position:sticky;top:0;background:#212529;color:white;">Expected</th>
        <th style="position:sticky;top:0;background:#212529;color:white;">Overdue by</th>
        <%# Ours, not the sheet's. The sheet does the thinking and is left
            alone; these two are what the office decides about a client. %>
        <th style="position:sticky;top:0;background:#212529;color:white;">Status</th>
        <th style="position:sticky;top:0;background:#212529;color:white;">Remark</th>
        <th style="position:sticky;top:0;background:#212529;color:white;width:3rem;"></th>
      </tr>
    </thead>
    <tbody id="scot_tbody"><tr><td colspan="10" class="text-center py-3 text-muted">Loading…</td></tr></tbody>
  </table>
</div>

<script>
var scot_rows = [], scot_shown = [], scot_loaded = false;

function scot_esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

async function scot_load(fresh) {
  var note = document.getElementById('scot_note');
  if (!note) return;
  note.textContent = fresh ? 'Reading the sheet again…' : 'Reading the sheet…';
  document.getElementById('scot_tbody').innerHTML =
    '<tr><td colspan="10" class="text-center py-3"><i class="fas fa-spinner fa-spin me-2"></i>Loading…</td></tr>';
  try {
    var res = await fetch('/api/scot/calling-list' + (fresh ? '?fresh=1' : ''));
    var json = await res.json();
    if (!json.success) {
      note.textContent = '';
      document.getElementById('scot_tbody').innerHTML =
        '<tr><td colspan="10" class="text-center py-3 text-danger">' + scot_esc(json.error || 'Could not read the sheet.') + '</td></tr>';
      return;
    }
    scot_loaded = true;
    scot_rows = json.list || [];
    document.getElementById('scot_sheetLink').href = json.sheetUrl;

    var tiles = document.getElementById('scot_tiles');
    if (tiles) {
      document.getElementById('scot_tileDue').textContent = json.due;
      document.getElementById('scot_tileSoon').textContent = json.soon;
      document.getElementById('scot_tileTotal').textContent = json.total;
      tiles.classList.remove('d-none');
    }

    note.textContent = json.due + ' due now, ' + json.soon + ' in the next 7 days, '
      + json.total + ' clients on the list · read at ' + json.readAt;
    scot_render();
  } catch (e) {
    note.textContent = '';
    document.getElementById('scot_tbody').innerHTML =
      '<tr><td colspan="10" class="text-center py-3 text-danger">Server error.</td></tr>';
  }
}

function scot_render() {
  var when = document.getElementById('scot_when').value;
  var q = (document.getElementById('scot_search').value || '').toLowerCase().trim();

  scot_shown = scot_rows.filter(function (c) {
    if (when === 'due' && !(c.late !== null && c.late >= 0)) return false;
    if (when === 'soon' && !(c.late !== null && c.late < 0 && c.late >= -7)) return false;
    if (q && c.client.toLowerCase().indexOf(q) < 0) return false;
    return true;
  });

  var body = document.getElementById('scot_tbody');
  if (!scot_shown.length) {
    body.innerHTML = '<tr><td colspan="10" class="text-center py-3 text-muted">Nobody here.</td></tr>';
    return;
  }
  body.innerHTML = scot_shown.map(function (c) {
    // How late, said in words rather than as a signed number: -3 for "due in
    // three days" is a thing to decode, not to read.
    var when2 = c.late === null
      ? '<span class="text-muted">-</span>'
      : c.late > 0 ? '<span class="badge bg-danger">' + c.late + ' day' + (c.late === 1 ? '' : 's') + '</span>'
      : c.late === 0 ? '<span class="badge bg-warning text-dark">today</span>'
      : '<span class="text-muted small">in ' + (-c.late) + ' day' + (c.late === -1 ? '' : 's') + '</span>';
    return '<tr class="scot-row" data-client="' + scot_esc(c.client) + '">'
      + '<td class="fw-bold">' + scot_esc(c.client) + '</td>'
      + '<td>' + (c.frequency ? scot_esc(c.frequency) : '<span class="text-muted">not enough history</span>') + '</td>'
      + '<td>' + scot_esc(c.lastOrder || '-') + '</td>'
      + '<td>' + (c.daysSince === null ? '-' : c.daysSince) + '</td>'
      + '<td>' + (c.totalOrders === null ? '-' : c.totalOrders) + '</td>'
      + '<td>' + scot_esc(c.expectedNext || '-') + '</td>'
      + '<td>' + when2 + '</td>'
      + '<td class="small">' + scot_statusBadge(c.status) + '</td>'
      + '<td class="small" style="max-width:18rem;white-space:normal;">'
        + (c.remark
            ? scot_esc(String(c.remark).length > 110 ? String(c.remark).slice(0, 110) + '\u2026' : c.remark)
            : '<span class="text-muted">-</span>') + '</td>'
      + '<td><button class="btn btn-sm btn-outline-primary" onclick="scot_edit(this)"'
        + ' title="Status and remark"><i class="fas fa-pen"></i></button></td>'
      + '</tr>';
  }).join('');
}

function scot_statusBadge(v) {
  var st = String(v || '').toLowerCase();
  if (st === 'active') return '<span class="badge bg-success">Active</span>';
  if (st === 'inactive') return '<span class="badge bg-secondary">Inactive</span>';
  return '<span class="text-muted">-</span>';
}

// ── The office's own note on a client ──
//
// Saved here, never into the sheet. The sheet works out the rhythm and the
// expected date, and our rows beside its formulas is one bad cell reference
// away from changing a number somebody relies on.
var scot_editing = null;

function scot_edit(el) {
  var tr = el.closest ? el.closest('tr.scot-row') : el;
  if (!tr) return;
  var name = tr.dataset.client;
  var c = (scot_rows || []).find(function (x) { return x.client === name; });
  if (!c) return;
  scot_editing = c;
  document.getElementById('scot_noteClient').textContent = c.client;
  document.getElementById('scot_noteWhen').textContent =
    (c.frequency ? 'Orders every ' + c.frequency + '. ' : '')
    + (c.lastOrder ? 'Last order ' + c.lastOrder + '.' : '');
  document.getElementById('scot_noteStatus').value = String(c.status || '').toLowerCase();
  document.getElementById('scot_noteRemark').value = c.remark || '';
  document.getElementById('scot_noteBy').textContent = c.noteBy ? ('Last changed by ' + c.noteBy) : '';
  new bootstrap.Modal(document.getElementById('scot_noteModal')).show();
}

async function scot_saveNote(btn) {
  if (!scot_editing) return;
  var old = btn.innerHTML;
  btn.disabled = true; btn.textContent = '\u2026';
  try {
    var j = await (await fetch('/api/scot/note', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        client: scot_editing.client,
        status: document.getElementById('scot_noteStatus').value,
        remark: document.getElementById('scot_noteRemark').value,
      }),
    })).json();
    if (!j.success) throw new Error(j.error || 'Could not save it.');
    // Written onto the row in hand rather than re-reading the sheet, which
    // takes three seconds and has not changed.
    scot_editing.status = j.status;
    scot_editing.remark = j.remark;
    bootstrap.Modal.getInstance(document.getElementById('scot_noteModal')).hide();
    scot_render();
    if (window.showToast) showToast('success', 'Saved.');
  } catch (e) {
    if (window.showToast) showToast('error', e.message); else alert(e.message);
  }
  btn.disabled = false; btn.innerHTML = old;
}

// One listener on the table, not an onclick per row: the body is rewritten
// on every keystroke in the search box. The pen is off the right-hand edge
// at this width, so the row has to open the box as well.
document.getElementById('scot_tbody').addEventListener('click', function (e) {
  if (e.target.closest('a, button, input, label')) return;
  var tr = e.target.closest('tr.scot-row');
  if (tr) scot_edit(tr);
});

function scot_download(btn) {
  // The office's own two go in as well. An export without them is a copy of
  // the sheet, which they already have.
  var cols = ['Client', 'Orders every', 'Last order', 'Days since', 'Orders so far',
              'Expected', 'Overdue by (days)', 'Status', 'Remark'];
  var rows = (scot_shown || []).map(function (c) {
    return [c.client, c.frequency, c.lastOrder,
            c.daysSince === null ? '' : c.daysSince,
            c.totalOrders === null ? '' : c.totalOrders,
            c.expectedNext, c.late === null ? '' : c.late,
            c.status || '', c.remark || ''];
  });
  downloadXlsx('SCOT calling list', cols, rows, btn);
}

// Somebody who opened the calling list came to see the calling list.
scot_load(false);
</script>
