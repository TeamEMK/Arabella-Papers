<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= signedIn ? 'Your studio' : 'Sign in' %> — <%= wordmark %></title>
  <%# Standalone, like the liner book and the catalogue: there is no office
      session out here, so the portal's shell cannot be reused. The same
      dark and gold as those two on purpose - a customer sent all three
      links should not feel they have arrived at three companies. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# THREE FACES, EACH WITH ONE JOB.
      Bodoni Moda is a Didone - hairline thins against heavy stems, the cut
      the fashion books have been set in for two hundred years - and it
      carries every heading. Italiana is its opposite number in capitals,
      wide and thin, for the wordmark, the buttons and the field labels.
      Tenor Sans reads the small print without arguing with either.
      The liner book and the catalogue keep Cormorant; this page is the
      front door and is allowed to be dressed better than the rooms. %>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Italiana&family=Tenor+Sans&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <style>
    :root {
      --void: #15171a;
      --card: #191c20;
      --gold: #c99a3b;
      --gold-lit: #d8ad55;
      --paper: #f7f4ed;
      --dim: #8a8578;
      --hair: rgba(201,162,39,.22);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    /* The engraved oval behind the card is centred on the gate, and the gate
       is narrower than the window - so on a wide screen the ornament hung
       about 52px past the right edge and gave the page a horizontal
       scrollbar over empty space. It is decorative and already runs off the
       side by design; clipping it at the edge of the page takes the
       scrollbar away without moving anything that can be seen. */
    html, body { overflow-x: hidden; }
    /* The whole window, so the card sits in the middle of the screen and the
       sign-off sits on the bottom of it. Without this the page is only as
       tall as the card and leaves a band of dead black underneath, which
       reads as a page that failed to finish loading. */
    body {
      min-height: 100vh;
      background: var(--void);
      color: #e8e4da;
      font-family: 'Tenor Sans', 'Segoe UI', sans-serif;
      font-weight: 400;
      -webkit-font-smoothing: antialiased;
      display: flex; flex-direction: column;
    }
    /* The welcome line on the signed-in page. Bodoni, like every other
       heading here - Cormorant stays only where it is doing the quiet
       italic work under a heading. */
    .serif { font-family: 'Bodoni Moda', Georgia, serif; }
    ::selection { background: var(--gold); color: #000; }
    /* The scrollbar is gone, the scrolling is not - as on the liner book. */
    html, body { scrollbar-width: none; -ms-overflow-style: none; }
    html::-webkit-scrollbar, body::-webkit-scrollbar { width: 0; height: 0; display: none; }
    a { color: inherit; }

    /* ── the mark ─────────────────────────────── */
    header { padding: 42px 22px 0; text-align: center; }
    .mark {
      font-family: Italiana, Georgia, serif; font-weight: 400;
      font-size: 1.44rem; letter-spacing: .26em; text-transform: uppercase;
      color: var(--gold-lit); line-height: 1.5;
    }
    .mark small {
      display: block; font-family: 'Tenor Sans', sans-serif; font-size: .58rem;
      letter-spacing: .32em; text-transform: uppercase; color: var(--dim);
      margin-top: 10px;
    }
    .pill {
      display: inline-block; margin-top: 14px; padding: 3px 12px;
      border: 1px solid var(--hair); border-radius: 999px;
      font-size: .56rem; letter-spacing: .3em; color: var(--gold);
    }
    .rule { height: 1px; background: var(--hair); max-width: 440px; margin: 26px auto 0; }

    main { flex: 1 0 auto; display: flex; align-items: center; justify-content: center;
           padding: 34px 22px 60px; }

    /* ── THE SIGNED-OUT PAGE IS TWO HALVES ──
       Left, what is behind the door; right, the door. A sign-in card alone
       on a dark page tells a customer nothing about what they are signing
       in to - and this link is sent cold, to somebody who has never seen
       the inside of it. */
    .stage {
      display: grid; grid-template-columns: 1.72fr 1fr;
      min-height: 100vh; width: 100%;
    }
    /* THE PHOTOGRAPH IS THE HALF, NOT A BLOCK INSIDE IT.
       Set as a block in the flow it ran past the bottom of the window and
       was cut in two by the fold - and a picture half off the screen is
       worse than none. As the background of the half it is always whole,
       always the right size, and the words sit on it.
       It is shot on near-black already, so the veil over it is only enough
       to keep the text readable where the cream paper is brightest. */
    .showing {
      position: relative;
      /* FLUID, NOT FIXED. At 50% browser zoom the window is 3840 CSS
         pixels wide and every fixed size here became a postage stamp
         in an acre of black. Each measure below is a clamp: a floor
         for a laptop, a ceiling so nothing becomes a poster, and vw
         in between so the page grows with the glass. */
      padding: clamp(34px, 2.8vw, 252px) clamp(44px, 4vw, 330px)
               clamp(24px, 2.2vw, 180px);
      display: flex; flex-direction: column; justify-content: center;
      border-right: 1px solid var(--hair); overflow: hidden;
      --panel: clamp(320px, 23vw, 2940px);
      /* FULL BLEED, AS THE DRAWING HAS IT. The photograph ran to all four
         sides of its half there; here it was a panel floating in black,
         which is honest about the crop and nothing like the render.
         It could not bleed before because the subject sits in the MIDDLE
         of the frame: filling a tall half put the liners straight under
         the words. So the picture was changed rather than the layout -
         hero-wide.jpg is the same plate with the photograph's own black
         carried out to the left for the words to sit on, and bands top
         and bottom bringing the canvas to the shape half a 16:9 window
         actually is. What a narrow window crops is the bands, which is
         nothing anybody would miss. */
      background:
        linear-gradient(90deg,
          rgba(18,20,23,.90) 0,
          rgba(18,20,23,.74) calc(var(--panel) * .72),
          rgba(18,20,23,.10) var(--panel),
          rgba(18,20,23,0)   calc(var(--panel) + 120px)),
        url('/portal/hero-wide.jpg') center/cover no-repeat,
        var(--void);
    }
    /* A breath of gold across it, so the half is not a flat rectangle of
       the same black as the one beside it. */
    .showing::before {
      content: ''; position: absolute; inset: -30% -40% auto -20%; height: 90%;
      background: radial-gradient(ellipse at 40% 40%, rgba(201,154,59,.10), transparent 62%);
      pointer-events: none;
    }
    .showing > * { position: relative; }
    /* THE MARK AS A PRESS MARK, NOT A LINE OF TYPE.
       A sprig over the name and the trade between two rules - which is how
       the office's own printed matter is set, and what the reference
       drawing asked for. */
    .crest-mark { text-align: center; max-width: 430px; }
    .crest-mark .nm { white-space: nowrap; }
    .crest-mark .sprig { color: var(--gold); opacity: .9; margin-bottom: 14px; }
    .crest-mark .nm {
      font-family: 'Bodoni Moda', Georgia, serif; font-weight: 400;
      font-size: clamp(1.4rem, 1.55vw, 9.6rem);
      letter-spacing: .3em; text-transform: uppercase;
      color: var(--paper); line-height: 1.2;
    }
    .crest-mark .trade {
      display: flex; align-items: center; gap: 14px; margin-top: 14px;
      font-family: Italiana, Georgia, serif;
      font-size: clamp(.6rem, .6vw, 4.5rem);
      letter-spacing: .42em; text-transform: uppercase; color: var(--gold);
    }
    .crest-mark .trade::before, .crest-mark .trade::after {
      content: ''; flex: 1; height: 1px; background: var(--hair);
    }

    /* The headline is set in capitals, three lines, the last one italic
       gold - the shape the reference uses and the reason it reads as a
       title page rather than as a sentence. */
    .shout {
      font-family: 'Bodoni Moda', Georgia, serif; font-weight: 400;
      font-size: clamp(2.1rem, 3.6vw, 21rem); line-height: 1.04;
      letter-spacing: .015em; text-transform: uppercase; color: var(--paper);
      margin: 22px 0 14px; max-width: 13ch;
    }
    .shout em { font-style: italic; color: var(--gold-lit); letter-spacing: .01em; }
    /* A rule that stops in a lozenge, the way a printer ends a flourish. */
    .flourish { display: flex; align-items: center; margin: 18px 0 20px;
                max-width: clamp(220px, 15vw, 1920px); }
    .flourish::before { content: ''; flex: 1; height: 1px; background: var(--gold); opacity: .55; }
    .flourish i { color: var(--gold); font-size: .5rem; margin-left: 8px; }
    .shout-sub {
      color: var(--dim); font-size: clamp(.95rem, 1.05vw, 7.2rem);
      line-height: 1.6; max-width: 46ch; margin: 0 0 22px;
    }
    .points { list-style: none; margin: 0; padding: 0; max-width: 46ch; }
    /* Held to a column so the lines do not run out over the brightest part
       of the photograph, where cream paper and grey type meet. */
    .shout, .shout-sub, .points, .signoff,
    /* MEASURED IN THE SAME UNIT AS THE TYPE.
       A column capped in ch does not grow when the type does - ch is a
       fraction of the font the element itself is set in, and these are set
       in vw. At 25% zoom the result was 70px words wrapping four to a line
       in a column still sized for a laptop. The panel is the measure now,
       and the panel is a fraction of the window like everything else. */
    .showing > .flourish { max-width: calc(var(--panel) - 4vw); }
    /* The mark is given its own width - the column that suits a paragraph
       is narrower than the name. */
    /* The same measure as the words under it. Capped in rem it stopped
       growing with the type, and the trade line broke over two lines. */
    .showing > .crest-mark { max-width: calc(var(--panel) - 4vw); }
    .points li { display: flex; gap: 17px; margin-bottom: 14px; align-items: flex-start; }
    .points i {
      color: var(--gold); font-size: clamp(.92rem, .95vw, 6rem);
      width: clamp(40px, 2.8vw, 228px); height: clamp(40px, 2.8vw, 228px);
      flex: 0 0 clamp(40px, 2.8vw, 228px);
      border: 1px solid rgba(201,162,39,.4); display: grid; place-items: center;
    }
    .points b { display: block; font-family: 'Bodoni Moda', Georgia, serif; font-weight: 500;
                font-size: clamp(.9rem, .95vw, 5.1rem); letter-spacing: .16em;
                text-transform: uppercase; color: var(--paper); margin-bottom: 5px; }
    .points span { font-size: clamp(.84rem, .9vw, 4.5rem); color: var(--dim);
                   line-height: 1.55; }

    /* THE PICTURE IS OPTIONAL ON PURPOSE. Nothing here breaks if
       /portal/hero.jpg has not been put there yet - the <img> takes itself
       off the page and the half reads as a column of words, which is what
       it was before anybody drew anything. */
    .signoff { margin-top: auto; padding-top: 18px; color: var(--dim);
               font-size: clamp(.66rem, .7vw, 4.2rem); letter-spacing: .14em; }

    /* IT WAS A CARD IN A FIELD OF BLACK. Three things were added and none
       of them is decoration for its own sake: an engraved oval behind the
       card, which is the shape printed on the cards in the photograph
       beside it; the three names under the form, so the page says what is
       inside before anybody signs in; and a line at the foot for the
       person who cannot get in, who until now had nothing to do but
       leave. */
    .gate {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; padding: 46px 30px; position: relative;
      background:
        radial-gradient(ellipse at 60% 35%, rgba(201,154,59,.07), transparent 58%),
        var(--void);
    }
    /* Bigger than the card and fainter than the first attempt, where it
       cleared the card's top edge by an inch and read as a stray arc
       rather than as a frame around it. */
    .gate .oval {
      position: absolute; top: 50%; left: 50%;
      width: min(44vw, 1100px); height: min(92vh, 1400px);
      transform: translate(-50%, -50%); pointer-events: none; opacity: .5;
    }
    .gate .oval svg { width: 100%; height: 100%; }
    .help {
      margin-top: 30px; text-align: center; color: var(--dim);
      font-size: clamp(.74rem, .8vw, 4.8rem);
      letter-spacing: .04em; position: relative;
    }
    .help a { color: var(--gold); text-decoration: none; border-bottom: 1px solid var(--hair); }
    .help a:hover { color: var(--gold-lit); }

    /* The three names, inside the card under the form. Set as initials and
       a hairline rather than as a sentence: it is a reminder of what is
       behind the door, not another thing to read. */
    .inside {
      margin-top: 26px; padding-top: 20px;
      display: flex; justify-content: space-between; gap: 0;
    }
    .inside span {
      flex: 1; text-align: center; font-family: Italiana, Georgia, serif;
      font-size: clamp(.58rem, .62vw, 4.05rem); letter-spacing: .18em;
      text-transform: uppercase;
      color: #a9a294; line-height: 1.7;
    }
    /* Hairlines between them rather than around them - the divider belongs
       to the gap, and a border on each would draw three boxes. */
    .inside span + span { border-left: 1px solid var(--hair); }
    .inside i { display: block; color: var(--gold); margin-bottom: 8px;
                font-size: clamp(.95rem, 1vw, 6rem); }
    /* The lozenge rule above the three, as in the drawing. */
    .inside-rule { margin-top: 24px; text-align: center; }
    .inside-rule::before, .inside-rule::after {
      content: ''; display: inline-block; width: clamp(150px, 9vw, 780px); height: 1px;
      background: var(--hair); vertical-align: middle; margin: 0 10px;
    }
    .inside-rule i { color: var(--gold); font-size: .48rem; vertical-align: middle; }
    /* The line the example calls a tagline: small, wide and quiet, up in the
       corner where it is read once and then ignored. */
    /* IN THE FLOW, NOT PINNED TO THE CORNER. Pinned, it sat behind the
       card the moment the card grew - the register panel is four fields
       tall - and three lines of gold reading through a dark card is not a
       detail anybody would have drawn on purpose. Above the card it is
       the first thing read and it never collides with anything. */
    .whisper {
      margin-bottom: 24px; text-align: center;
      font-family: Italiana, Georgia, serif;
      font-size: .62rem; letter-spacing: .34em; text-transform: uppercase;
      color: var(--gold); line-height: 2; opacity: .85;
    }
    .whisper br { display: none; }

    @media (max-width: 1040px) {
      .stage { grid-template-columns: 1fr; }
      .showing { border-right: 0; border-bottom: 1px solid var(--hair);
                 padding: 38px 26px 30px;
                 background:
                   linear-gradient(180deg, rgba(21,23,26,.95), rgba(21,23,26,.90)),
                   url('/portal/hero.jpg') center/cover no-repeat, var(--void); }
      .whisper { display: none; }
      .gate { padding: 34px 22px 50px; }
      .gate .oval { display: none; }
    }

    /* ── the card ─────────────────────────────── */
    /* CENTRED, ASKED FOR IN THOSE WORDS. A form reads faster ranged left,
       which is why it was - but this one is four fields on a dark card
       with a rule and a lozenge over it, and ranged left it sat off to one
       side of its own ornament. The inputs keep their text left, where a
       half-typed address belongs. */
    .card { text-align: center; }
    .card input { text-align: left; }
    /* THE FRAME IS THE PANEL. In the reference the card is a tall gold
       rectangle standing in the dark with the arcs of a much larger oval
       passing behind it - a plate in a frame, not a form in a box. */
    .card {
      width: 100%; max-width: clamp(430px, 30vw, 3450px);
      background: rgba(20,23,26,.90);
      border: 1px solid rgba(201,162,39,.5);
      padding: clamp(38px, 2.4vw, 192px) clamp(32px, 2.1vw, 168px)
               clamp(30px, 1.9vw, 144px);
      position: relative; backdrop-filter: blur(2px);
      box-shadow: 0 30px 90px rgba(0,0,0,.5);
    }
    /* A rule with a lozenge in the middle, the way a printer rules off a
       heading. Drawn in CSS so there is no third image to load. */
    .crest { text-align: center; margin: 0 0 20px; }
    .crest::before, .crest::after {
      content: ''; display: inline-block; width: clamp(104px, 7vw, 570px); height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold));
      vertical-align: middle; margin: 0 12px; opacity: .8;
    }
    .crest::after { background: linear-gradient(90deg, var(--gold), transparent); }
    .crest i { color: var(--gold); font-size: .56rem; vertical-align: middle; }
    .card h1 {
      font-family: 'Bodoni Moda', Georgia, serif; font-weight: 400;
      font-size: clamp(2.3rem, 2.9vw, 19.5rem); margin: 0 0 6px; color: var(--paper);
      letter-spacing: .005em; line-height: 1.05;
    }
    .card p.sub { margin: 0 0 28px; color: #bdb6a6;
                  font-size: clamp(1rem, 1.05vw, 6.6rem); font-style: italic;
                  font-family: 'Cormorant Garamond', Georgia, serif; line-height: 1.5; }

    label { display: block; font-family: Italiana, Georgia, serif;
            font-size: clamp(.62rem, .66vw, 4.2rem);
            letter-spacing: .26em; text-transform: uppercase; color: var(--gold);
            margin: 0 0 8px; text-align: left; }
    input {
      width: 100%; background: rgba(13,15,18,.72);
      border: 1px solid rgba(201,162,39,.45);
      color: #e8e4da; font-family: 'Tenor Sans', sans-serif;
      padding: clamp(12px, .95vw, 60px) clamp(14px, 1vw, 66px);
      font-size: clamp(.92rem, .95vw, 5.7rem);
      margin-bottom: clamp(16px, 1.1vw, 102px); transition: border-color .15s;
    }
    input:focus { outline: none; border-color: var(--gold-lit);
                  box-shadow: 0 0 0 1px rgba(201,162,39,.25); }

    /* ── SHOWING THE PASSWORD ──
       Typed on a phone, in a hall, with one thumb: a password nobody can
       read back is a password typed twice. The eye is wired in script
       rather than written into each form, so the three password fields on
       this page - sign in, register, new password - all get it and a
       fourth one added later does too.

       The box is relative only where there is a toggle, so the ordinary
       fields keep their own layout. The input is given room on the right
       so the longest password does not run under the eye. */
    .pw-wrap { position: relative; }
    .pw-wrap input { padding-right: clamp(46px, 3.4vw, 210px); }
    .pw-eye {
      position: absolute; top: 0; right: 0;
      /* As tall as the field itself, so the target is the whole right-hand
         end of it rather than a small circle somebody has to aim at. */
      height: calc(100% - clamp(16px, 1.1vw, 102px));
      display: flex; align-items: center; justify-content: center;
      width: clamp(44px, 3.2vw, 200px);
      background: none; border: 0; cursor: pointer; padding: 0;
      color: var(--gold); opacity: .72; transition: opacity .15s, color .15s;
      font-size: clamp(.85rem, .9vw, 5rem);
    }
    .pw-eye:hover, .pw-eye:focus-visible { opacity: 1; color: var(--gold-lit); }
    .pw-eye:focus-visible { outline: 1px solid var(--gold-lit); outline-offset: -2px; }
    /* The six digits are read off a phone and typed one at a time. Wide and
       spaced so a 6 and an 8 are not the same shape at a glance. */
    input.code {
      text-align: center; font-size: 1.5rem; letter-spacing: .48em;
      padding-left: .48em; font-family: 'Cormorant Garamond', Georgia, serif;
    }
    .btn {
      width: 100%; color: #15171a; border: 0;
      background: linear-gradient(176deg, #e0b65c 0%, var(--gold) 46%, #b9872f 100%);
      padding: clamp(14px, 1.05vw, 72px) 14px;
      font-family: Italiana, Georgia, serif; font-weight: 400;
      font-size: clamp(.84rem, .9vw, 5.7rem); letter-spacing: .24em;
      text-transform: uppercase;
      cursor: pointer; transition: background .15s;
    }
    .btn:hover { background: linear-gradient(176deg, #ecc472 0%, var(--gold-lit) 50%, #c79337 100%); }
    .btn[disabled] { opacity: .5; cursor: default; }
    .btn-quiet {
      background: none; color: var(--dim); border: 1px solid var(--hair);
      margin-top: 10px;
    }
    .btn-quiet:hover { background: rgba(201,162,39,.07); color: var(--paper); }
    .linkline { margin-top: 18px; font-size: clamp(.8rem, .85vw, 5.1rem);
                color: var(--dim); text-align: center; }
    .linkline a { color: var(--gold); text-decoration: none; border-bottom: 1px solid var(--hair);
                  cursor: pointer; }
    .linkline a:hover { color: var(--gold-lit); }

    .says { font-size: .82rem; line-height: 1.5; margin: 0 0 16px; padding: 10px 12px;
            border-left: 2px solid var(--gold); background: rgba(201,162,39,.06);
            color: var(--paper); display: none; }
    .says.bad { border-left-color: #b4544a; background: rgba(180,84,74,.08); }
    .says.on { display: block; }

    .panel { display: none; }
    .panel.on { display: block; }

    /* ── the four doors ───────────────────────── */
    /* THE SAME ROOM AS THE SIGN-IN, NOT A DIFFERENT ONE.
       The photograph is behind this page too, veiled almost to black -
       enough that the page has a floor and a corner, not enough to make a
       card harder to read. Fixed, so it does not slide about under them. */
    body.inside-page {
      background:
        linear-gradient(180deg, rgba(19,21,24,.975), rgba(19,21,24,.99)),
        url('/portal/hero-wide.jpg') center/cover no-repeat fixed,
        var(--void);
    }
    /* Four doors, two by two. Four across made each one a column of
       words on a laptop; two rows of two keeps a door the shape of a
       door. Three across is still right where there is room for it. */
    .doors { display: grid; gap: clamp(20px, 1.6vw, 108px); width: 100%;
             max-width: clamp(960px, 72vw, 6900px);
             grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 1500px) { .doors { grid-template-columns: repeat(4, 1fr); } }
    .door {
      position: relative; background: rgba(23,26,30,.94);
      border: 1px solid rgba(201,162,39,.34);
      padding: clamp(32px, 2.2vw, 168px) clamp(26px, 1.9vw, 138px)
               clamp(28px, 1.8vw, 132px);
      text-decoration: none; display: block;
      transition: border-color .18s, transform .18s, box-shadow .18s;
    }
    /* A second rule set in from the first, the way a card is ruled inside
       its own edge. Drawn on the box rather than added as markup, so there
       is nothing extra in the page to keep in step. */
    .door::after {
      content: ''; position: absolute; inset: 7px; border: 1px solid rgba(201,162,39,.09);
      pointer-events: none; transition: border-color .18s;
    }
    .door:hover {
      border-color: var(--gold); transform: translateY(-3px);
      box-shadow: 0 22px 50px rgba(0,0,0,.45);
    }
    .door:hover::after { border-color: rgba(201,162,39,.28); }
    .door i { color: var(--gold); font-size: clamp(1.28rem, 1.4vw, 9rem); }
    .door h2 {
      font-family: 'Bodoni Moda', Georgia, serif; font-weight: 400;
      font-size: clamp(1.3rem, 1.5vw, 9.6rem); margin: 18px 0 10px;
      color: var(--paper);
    }
    .door p { margin: 0; font-size: clamp(.84rem, .9vw, 5.4rem);
              color: var(--dim); line-height: 1.6; }
    .door .go { margin-top: 18px; font-family: Italiana, Georgia, serif;
                font-size: .56rem; letter-spacing: .28em;
                text-transform: uppercase; color: var(--gold); }
    .welcome { text-align: center; margin-bottom: 34px; }
    .welcome .serif { font-size: clamp(1.72rem, 2.1vw, 13.2rem); color: var(--paper); }
    .welcome div { color: var(--dim); font-size: clamp(.82rem, .88vw, 5.1rem);
                   margin-top: 8px; }
    /* The same ruled lozenge that heads the sign-in card, so the two sides
       of the portal are obviously one place. */
    .welcome .crest { margin-bottom: 18px; }

    footer { flex: 0 0 auto; padding: 0 22px 34px; text-align: center;
             color: var(--dim); font-size: .7rem; letter-spacing: .12em; }
    footer a { color: var(--gold); text-decoration: none; cursor: pointer; }

    @media (max-width: 860px) { .doors { grid-template-columns: 1fr; max-width: 430px; } }
  </style>
  <link rel="stylesheet" href="/css/public-mobile.css">
</head>
<body class="<%= signedIn ? 'inside-page' : '' %>">

<% if (signedIn) { %>
<header>
  <div class="mark"><%= wordmark %><small>Fine Stationery</small></div>
  <% if (pill) { %><div class="pill"><%= pill %></div><% } %>
  <div class="rule"></div>
</header>
<% } %>

<main style="<%= signedIn ? '' : 'padding:0;display:block;' %>">
<% if (signedIn) { %>
  <div style="width:100%;max-width:980px;">
    <div class="welcome">
      <div class="crest"><i class="fa-solid fa-diamond"></i></div>
      <div class="serif">Welcome back<%= who && who.name ? ', ' + who.name.split(' ')[0] : '' %></div>
      <div><%= who ? who.email : '' %></div>
    </div>
    <div class="doors">
      <%# In the same tab, at this portal's own address. A new tab is a
           second window the customer has to find their way back from, and
           the page they landed on would not know who had signed in. %>
      <a class="door" href="/client/<%= brand %>/liners">
        <i class="fa-solid fa-envelope-open"></i>
        <h2>Envelope Liners</h2>
        <p>316 liners in five collections, each with a code of its own,
           and a search that understands “blue floral”.</p>
        <div class="go">Open the book &nbsp;&rsaquo;</div>
      </a>
      <a class="door" href="/client/<%= brand %>/catalogue">
        <i class="fa-solid fa-feather-pointed"></i>
        <h2>Design Catalogue</h2>
        <p>Borders, fonts, monograms, motifs and patterns — everything that
           can go on a card, in one book.</p>
        <div class="go">Open the catalogue &nbsp;&rsaquo;</div>
      </a>
      <a class="door" href="/client/<%= brand %>/stock">
        <i class="fa-solid fa-layer-group"></i>
        <h2>Paper Stock</h2>
        <p>What is on the shelf right now, by series — codes, thicknesses
           and whether it is in.</p>
        <div class="go">See the stock &nbsp;&rsaquo;</div>
      </a>
      <a class="door" href="/client/<%= brand %>/quote">
        <i class="fa-solid fa-calculator"></i>
        <h2>Price Calculator</h2>
        <p>Price a job while they are still with you, on your own rates,
           and send the estimate as a PDF.</p>
        <div class="go">Open the calculator &nbsp;&rsaquo;</div>
      </a>
    </div>
  </div>
<% } else { %>
  <div class="stage">

    <!-- WHAT IS BEHIND THE DOOR. The link is sent cold, so the page says
         what it is before it asks for anything. -->
    <section class="showing">
      <div class="crest-mark">
        <%# A sprig over the name. Drawn, not photographed: it has to sit on
            a dark panel at any size and a cut-out would carry an edge. %>
        <svg class="sprig" width="86" height="26" viewBox="0 0 86 26" fill="none"
             xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M43 25V9" stroke="currentColor" stroke-width="1"/>
          <path d="M43 9c0-4 3-7 7-8-1 5-3 8-7 8zM43 9c0-4-3-7-7-8 1 5 3 8 7 8z"
                fill="currentColor" fill-opacity=".65"/>
          <path d="M43 17c0-3 3-6 8-7-1 4-4 7-8 7zM43 17c0-3-3-6-8-7 1 4 4 7 8 7z"
                fill="currentColor" fill-opacity=".45"/>
          <path d="M2 23h26M58 23h26" stroke="currentColor" stroke-opacity=".45" stroke-width="1"/>
        </svg>
        <div class="nm"><%= wordmark %></div>
        <%# The trade between two rules, and the one word that tells the two
            links apart folded in beside it - a pill under a mark this
            formal read as a sticker. %>
        <div class="trade"><span><%= pill ? pill + ' · ' : '' %>Fine Stationery</span></div>
      </div>

      <h1 class="shout">Bespoke<br>Wedding<br><em>Stationery</em></h1>
      <p class="shout-sub">
        Everything you show a couple, in one place — every liner we print,
        every design we draw, and your own prices.
      </p>
      <div class="flourish"><i class="fa-solid fa-diamond"></i></div>

      <ul class="points">
        <li>
          <i class="fa-solid fa-envelope-open"></i>
          <div>
            <b>Envelope Liners</b>
            <span>316 liners in five collections, each with a code of its own,
                  and a search that understands “blue floral”.</span>
          </div>
        </li>
        <li>
          <i class="fa-solid fa-feather-pointed"></i>
          <div>
            <b>Design Catalogue</b>
            <span>Borders, fonts, monograms, motifs and patterns — everything
                  that can go on a card, in one book.</span>
          </div>
        </li>
        <li>
          <i class="fa-solid fa-layer-group"></i>
          <div>
            <b>Paper Stock</b>
            <span>What is on the shelf right now, by series — codes,
                  thicknesses and whether it is in.</span>
          </div>
        </li>
        <li>
          <i class="fa-solid fa-calculator"></i>
          <div>
            <b>Price Calculator</b>
            <span>Price a job while they are still with you, on your own
                  rates, and send the estimate as a PDF.</span>
          </div>
        </li>
      </ul>

      <div class="signoff">&copy; <%= new Date().getFullYear() %> <%= wordmark %></div>
    </section>

    <!-- THE DOOR -->
    <section class="gate">
      <%# The engraved oval off the cards in the photograph, drawn rather
          than photographed so it stays crisp at any size and costs nothing
          to load. Behind the card, barely there. %>
      <div class="oval" aria-hidden="true">
        <svg viewBox="0 0 300 380" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="150" cy="190" rx="132" ry="178" stroke="#c99a3b" stroke-opacity=".34" stroke-width="1"/>
          <path d="M150 6 l8 11 -8 11 -8 -11 z" fill="#c99a3b" fill-opacity=".34"/>
          <path d="M150 352 l8 11 -8 11 -8 -11 z" fill="#c99a3b" fill-opacity=".34"/>
          <%# Two sprigs climbing the inside of the frame, as the drawing
              has them: line art, so they stay hairline at any size. %>
          <g stroke="#c99a3b" stroke-opacity=".30" stroke-width="1" fill="none">
            <path d="M44 128c0 46 0 78 0 124"/>
            <path d="M44 150c-11-2-18-9-20-19 11 1 18 8 20 19zM44 150c11-2 18-9 20-19-11 1-18 8-20 19z"/>
            <path d="M44 188c-11-2-18-9-20-19 11 1 18 8 20 19zM44 188c11-2 18-9 20-19-11 1-18 8-20 19z"/>
            <path d="M44 226c-11-2-18-9-20-19 11 1 18 8 20 19zM44 226c11-2 18-9 20-19-11 1-18 8-20 19z"/>
            <path d="M256 128c0 46 0 78 0 124"/>
            <path d="M256 150c-11-2-18-9-20-19 11 1 18 8 20 19zM256 150c11-2 18-9 20-19-11 1-18 8-20 19z"/>
            <path d="M256 188c-11-2-18-9-20-19 11 1 18 8 20 19zM256 188c11-2 18-9 20-19-11 1-18 8-20 19z"/>
            <path d="M256 226c-11-2-18-9-20-19 11 1 18 8 20 19zM256 226c11-2 18-9 20-19-11 1-18 8-20 19z"/>
          </g>
        </svg>
      </div>
      <div class="card">
        <div class="crest"><i class="fa-solid fa-diamond"></i></div>
    <div class="says" id="says"></div>

    <!-- ── sign in ── -->
    <div class="panel on" id="p-in">
      <h1>Sign in</h1>
      <p class="sub">The liner book, the catalogue and your prices.</p>
      <label for="in-email">Email</label>
      <input id="in-email" type="email" autocomplete="email" placeholder="you@company.com">
      <label for="in-pass">Password</label>
      <input id="in-pass" type="password" autocomplete="current-password">
      <button class="btn" onclick="signIn(this)">Sign in</button>
      <div class="linkline"><a onclick="show('p-forgot')">Forgotten your password?</a></div>
      <div class="linkline">No account yet? <a onclick="show('p-up')">Register</a></div>
    </div>

    <!-- ── register ── -->
    <div class="panel" id="p-up">
      <h1>Register</h1>
      <p class="sub">A six-digit code confirms your email. It takes a minute.</p>
      <label for="up-name">Your name</label>
      <input id="up-name" autocomplete="name">
      <label for="up-company">Company <span style="color:var(--dim);">(optional)</span></label>
      <input id="up-company" autocomplete="organization">
      <label for="up-email">Email</label>
      <input id="up-email" type="email" autocomplete="email">
      <label for="up-pass">Password</label>
      <input id="up-pass" type="password" autocomplete="new-password"
             placeholder="At least eight characters">
      <button class="btn" onclick="register(this)">Send me a code</button>
      <div class="linkline">Already registered? <a onclick="show('p-in')">Sign in</a></div>
    </div>

    <!-- ── the code ── -->
    <div class="panel" id="p-code">
      <h1>Your code</h1>
      <p class="sub" id="code-sub">Six digits, sent to your email. It is good for ten minutes.</p>
      <label for="code">Code</label>
      <input id="code" class="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code">
      <button class="btn" onclick="verify(this)">Confirm</button>
      <button class="btn btn-quiet" id="again" onclick="resend(this)">Send another code</button>
      <div class="linkline"><a onclick="show('p-in')">Back to sign in</a></div>
    </div>

    <!-- ── forgotten ── -->
    <div class="panel" id="p-forgot">
      <h1>Forgotten password</h1>
      <p class="sub">Give the address you registered with and we will send a code.</p>
      <label for="fg-email">Email</label>
      <input id="fg-email" type="email" autocomplete="email">
      <button class="btn" onclick="forgot(this)">Send me a code</button>
      <div class="linkline"><a onclick="show('p-in')">Back to sign in</a></div>
    </div>

    <!-- ── new password ── -->
    <div class="panel" id="p-reset">
      <h1>New password</h1>
      <p class="sub">Type the code from your email and the password you would like.</p>
      <label for="rs-code">Code</label>
      <input id="rs-code" class="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code">
      <label for="rs-pass">New password</label>
      <input id="rs-pass" type="password" autocomplete="new-password"
             placeholder="At least eight characters">
      <button class="btn" onclick="reset(this)">Set it and sign in</button>
      <button class="btn btn-quiet" onclick="resend(this, 'reset')">Send another code</button>
      <div class="linkline"><a onclick="show('p-in')">Back to sign in</a></div>
    </div>

        <div class="inside-rule"><i class="fa-solid fa-diamond"></i></div>
        <div class="inside">
          <span><i class="fa-regular fa-envelope-open"></i>Liner book</span>
          <span><i class="fa-regular fa-images"></i>Design catalogue</span>
          <span><i class="fa-regular fa-money-bill-1"></i>Price calculator</span>
        </div>
      </div>

      <div class="help">
        Trouble getting in? Write to
        <a href="mailto:info@arabellapapers.com">info@arabellapapers.com</a>
      </div>
    </section>

  </div>
<% } %>
</main>

<%# The signed-out page signs itself off at the foot of its left half, so a
    second line here would be the same words twice on one screen. %>
<% if (signedIn) { %>
<footer>
  <a onclick="signOut()">Sign out</a> &nbsp;·&nbsp;
  <%= wordmark %><% if (pill) { %> · <%= pill %><% } %>
</footer>
<% } %>

<script>
(function () {
  var BRAND = <%- JSON.stringify(brand) %>;
  var API = '/client/' + BRAND + '/api/';
  var signedIn = <%- signedIn ? 'true' : 'false' %>;
  var waiting = '';   // the address the code on screen belongs to

  function say(text, bad) {
    var box = document.getElementById('says');
    if (!box) return;
    box.textContent = text || '';
    box.className = 'says' + (text ? ' on' : '') + (bad ? ' bad' : '');
  }
  window.show = function (id) {
    say('');
    var all = document.querySelectorAll('.panel');
    for (var i = 0; i < all.length; i++) all[i].classList.toggle('on', all[i].id === id);
    var first = document.querySelector('#' + id + ' input');
    if (first) first.focus();
  };

  // Every call goes through here, so a button cannot be pressed twice while
  // the first press is still in the air - which on a register button is two
  // accounts, and on a code button is two codes.
  async function ask(path, body, btn) {
    var was = btn ? btn.textContent : '';
    if (btn) { btn.disabled = true; btn.textContent = 'One moment…'; }
    try {
      var r = await fetch(API + path, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      var j = await r.json();
      return j || {};
    } catch (e) {
      return { success: false, error: 'The connection dropped. Please try again.' };
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = was; }
    }
  }

  var val = function (id) { return (document.getElementById(id).value || '').trim(); };

  window.register = async function (btn) {
    var email = val('up-email');
    var j = await ask('register', {
      name: val('up-name'), company: val('up-company'),
      email: email, password: document.getElementById('up-pass').value,
    }, btn);
    if (!j.success) return say(j.error, true);
    waiting = email;
    show('p-code');
    document.getElementById('code-sub').textContent =
      'Six digits, sent to ' + email + '. It is good for ten minutes.';
    // An address that already has an account is told nothing here. It is
    // sent the same way as everybody else and will simply have no code -
    // which is what the sign-in page and the forgotten-password door are
    // for, and is the whole point of not saying.
    say(j.known ? 'If that address has an account, a code is on its way to it.' : '');
  };

  window.verify = async function (btn) {
    var j = await ask('verify', { email: waiting, code: val('code') }, btn);
    if (!j.success) return say(j.error, true);
    location.reload();
  };

  window.resend = async function (btn, purpose) {
    var j = await ask('resend', { email: waiting, purpose: purpose || 'verify' }, btn);
    say(j.success ? 'Another code is on its way.' : j.error, !j.success);
  };

  window.signIn = async function (btn) {
    var email = val('in-email');
    var j = await ask('login', {
      email: email, password: document.getElementById('in-pass').value,
    }, btn);
    if (!j.success) return say(j.error, true);
    if (j.step === 'verify') {
      // Signed up but never finished. The password was right, so this is
      // them - they are shown the code step rather than a refusal.
      waiting = email;
      show('p-code');
      say('Your email has not been confirmed yet. A code is on its way to ' + email + '.');
      return;
    }
    location.reload();
  };

  window.forgot = async function (btn) {
    var email = val('fg-email');
    var j = await ask('forgot', { email: email }, btn);
    if (!j.success) return say(j.error, true);
    waiting = email;
    show('p-reset');
    say(j.message || 'If that address has an account, a code is on its way to it.');
  };

  window.reset = async function (btn) {
    var j = await ask('reset', {
      email: waiting, code: val('rs-code'),
      password: document.getElementById('rs-pass').value,
    }, btn);
    if (!j.success) return say(j.error, true);
    location.reload();
  };

  window.signOut = async function () {
    await ask('logout', {});
    location.reload();
  };

  // Enter sends the panel that is open, because nothing here is a <form> -
  // a form would reload the page and lose which address the code belongs to.
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' || signedIn) return;
    var open = document.querySelector('.panel.on');
    if (!open) return;
    var go = open.querySelector('.btn');
    if (go) { e.preventDefault(); go.click(); }
  });
}());
</script>
<script>
// ── THE EYE ON EVERY PASSWORD FIELD ──
//
// Done here rather than in the markup so all three forms on this card -
// sign in, register, set a new password - get it from one place, and so
// does a fourth one added later. Nothing else on the page has to know.
//
// The field goes back to hidden when the card changes panel: a password
// left readable on a shared screen is the reason the dots are there.
(function () {
  function wrap(input) {
    if (input.closest('.pw-wrap')) return;
    var box = document.createElement('div');
    box.className = 'pw-wrap';
    input.parentNode.insertBefore(box, input);
    box.appendChild(input);

    var eye = document.createElement('button');
    eye.type = 'button';
    eye.className = 'pw-eye';
    eye.setAttribute('aria-label', 'Show password');
    eye.setAttribute('aria-pressed', 'false');
    eye.innerHTML = '<i class="fa-regular fa-eye" aria-hidden="true"></i>';
    box.appendChild(eye);

    eye.addEventListener('click', function () {
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      eye.setAttribute('aria-pressed', show ? 'true' : 'false');
      eye.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      eye.innerHTML = '<i class="fa-regular fa-eye' + (show ? '-slash' : '')
        + '" aria-hidden="true"></i>';
      // The caret goes back where it was: on a phone the keyboard is up
      // and losing the place is worse than not seeing the word.
      var at = input.value.length;
      input.focus();
      try { input.setSelectionRange(at, at); } catch (e) {}
    });
  }

  function hideAll() {
    document.querySelectorAll('.pw-wrap input[type="text"]').forEach(function (i) {
      var eye = i.parentNode.querySelector('.pw-eye');
      i.type = 'password';
      if (eye) {
        eye.setAttribute('aria-pressed', 'false');
        eye.setAttribute('aria-label', 'Show password');
        eye.innerHTML = '<i class="fa-regular fa-eye" aria-hidden="true"></i>';
      }
    });
  }

  document.querySelectorAll('input[type="password"]').forEach(wrap);

  // show() moves the card from one panel to another. Wrapped rather than
  // edited, so the panels keep knowing nothing about this.
  if (typeof window.show === 'function') {
    var theirs = window.show;
    window.show = function () { hideAll(); return theirs.apply(this, arguments); };
  }
  // And nothing is left readable for whoever opens this laptop next.
  window.addEventListener('pagehide', hideAll);
})();
</script>
</body>
</html>
