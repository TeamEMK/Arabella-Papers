<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= signedIn ? 'Your studio' : 'Sign in' %> — <%= wordmark %></title>
  <%# Standalone, like the liner book and the catalogue: there is no office
      session out here, so the portal's shell cannot be reused. The same
      dark and gold as those two on purpose - a customer sent all three
      links should not feel they have arrived at three companies. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# THREE FACES, EACH WITH ONE JOB.
      Bodoni Moda is a Didone - hairline thins against heavy stems, the cut
      the fashion books have been set in for two hundred years - and it
      carries every heading. Italiana is its opposite number in capitals,
      wide and thin, for the wordmark, the buttons and the field labels.
      Tenor Sans reads the small print without arguing with either.
      The liner book and the catalogue keep Cormorant; this page is the
      front door and is allowed to be dressed better than the rooms. %>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Italiana&family=Tenor+Sans&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <style>
    :root {
      --void: #15171a;
      --card: #191c20;
      --gold: #c99a3b;
      --gold-lit: #d8ad55;
      --paper: #f7f4ed;
      --dim: #8a8578;
      --hair: rgba(201,162,39,.22);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    /* The whole window, so the card sits in the middle of the screen and the
       sign-off sits on the bottom of it. Without this the page is only as
       tall as the card and leaves a band of dead black underneath, which
       reads as a page that failed to finish loading. */
    body {
      min-height: 100vh;
      background: var(--void);
      color: #e8e4da;
      font-family: 'Tenor Sans', 'Segoe UI', sans-serif;
      font-weight: 400;
      -webkit-font-smoothing: antialiased;
      display: flex; flex-direction: column;
    }
    /* The welcome line on the signed-in page. Bodoni, like every other
       heading here - Cormorant stays only where it is doing the quiet
       italic work under a heading. */
    .serif { font-family: 'Bodoni Moda', Georgia, serif; }
    ::selection { background: var(--gold); color: #000; }
    /* The scrollbar is gone, the scrolling is not - as on the liner book. */
    html, body { scrollbar-width: none; -ms-overflow-style: none; }
    html::-webkit-scrollbar, body::-webkit-scrollbar { width: 0; height: 0; display: none; }
    a { color: inherit; }

    /* ── the mark ─────────────────────────────── */
    header { padding: 42px 22px 0; text-align: center; }
    .mark {
      font-family: Italiana, Georgia, serif; font-weight: 400;
      font-size: 1.44rem; letter-spacing: .26em; text-transform: uppercase;
      color: var(--gold-lit); line-height: 1.5;
    }
    .mark small {
      display: block; font-family: 'Tenor Sans', sans-serif; font-size: .58rem;
      letter-spacing: .32em; text-transform: uppercase; color: var(--dim);
      margin-top: 10px;
    }
    .pill {
      display: inline-block; margin-top: 14px; padding: 3px 12px;
      border: 1px solid var(--hair); border-radius: 999px;
      font-size: .56rem; letter-spacing: .3em; color: var(--gold);
    }
    .rule { height: 1px; background: var(--hair); max-width: 440px; margin: 26px auto 0; }

    main { flex: 1 0 auto; display: flex; align-items: center; justify-content: center;
           padding: 34px 22px 60px; }

    /* ── THE SIGNED-OUT PAGE IS TWO HALVES ──
       Left, what is behind the door; right, the door. A sign-in card alone
       on a dark page tells a customer nothing about what they are signing
       in to - and this link is sent cold, to somebody who has never seen
       the inside of it. */
    .stage {
      display: grid; grid-template-columns: 1.08fr .92fr;
      min-height: 100vh; width: 100%;
    }
    /* THE PHOTOGRAPH IS THE HALF, NOT A BLOCK INSIDE IT.
       Set as a block in the flow it ran past the bottom of the window and
       was cut in two by the fold - and a picture half off the screen is
       worse than none. As the background of the half it is always whole,
       always the right size, and the words sit on it.
       It is shot on near-black already, so the veil over it is only enough
       to keep the text readable where the cream paper is brightest. */
    .showing {
      position: relative; padding: 46px 56px 40px;
      display: flex; flex-direction: column; justify-content: center;
      border-right: 1px solid var(--hair); overflow: hidden;
      background:
        linear-gradient(100deg, rgba(21,23,26,.97) 0%, rgba(21,23,26,.93) 38%,
                                rgba(21,23,26,.72) 68%, rgba(21,23,26,.55) 100%),
        url('/portal/hero.jpg') center/cover no-repeat,
        var(--void);
    }
    /* A breath of gold across it, so the half is not a flat rectangle of
       the same black as the one beside it. */
    .showing::before {
      content: ''; position: absolute; inset: -30% -40% auto -20%; height: 90%;
      background: radial-gradient(ellipse at 40% 40%, rgba(201,154,59,.10), transparent 62%);
      pointer-events: none;
    }
    .showing > * { position: relative; }
    .shout {
      font-family: 'Bodoni Moda', Georgia, serif; font-weight: 400;
      font-size: clamp(2rem, 3.2vw, 2.9rem); line-height: 1.16; color: var(--paper);
      /* Room above it: the wordmark is a mark, not the first line of the
         sentence, and with no gap the two read as one block. */
      margin: 30px 0 16px; max-width: 17ch;
    }
    .shout em { font-style: italic; color: var(--gold-lit); }
    .shout-sub {
      color: var(--dim); font-size: .95rem; line-height: 1.7; max-width: 46ch;
      margin: 0 0 30px;
    }
    .points { list-style: none; margin: 0; padding: 0; max-width: 46ch; }
    /* Held to a column so the lines do not run out over the brightest part
       of the photograph, where cream paper and grey type meet. */
    .showing > .mark, .showing .pill, .shout, .shout-sub, .points, .signoff { max-width: 50ch; }
    .points li { display: flex; gap: 15px; margin-bottom: 19px; }
    .points i {
      color: var(--gold); font-size: .96rem; width: 34px; height: 34px; flex: 0 0 34px;
      border: 1px solid var(--hair); display: grid; place-items: center;
    }
    .points b { display: block; font-family: Italiana, Georgia, serif; font-weight: 400;
                font-size: .92rem; letter-spacing: .1em; text-transform: uppercase;
                color: var(--paper); margin-bottom: 5px; }
    .points span { font-size: .84rem; color: var(--dim); line-height: 1.55; }

    /* THE PICTURE IS OPTIONAL ON PURPOSE. Nothing here breaks if
       /portal/hero.jpg has not been put there yet - the <img> takes itself
       off the page and the half reads as a column of words, which is what
       it was before anybody drew anything. */
    .signoff { margin-top: auto; padding-top: 34px; color: var(--dim);
               font-size: .66rem; letter-spacing: .14em; }

    /* IT WAS A CARD IN A FIELD OF BLACK. Three things were added and none
       of them is decoration for its own sake: an engraved oval behind the
       card, which is the shape printed on the cards in the photograph
       beside it; the three names under the form, so the page says what is
       inside before anybody signs in; and a line at the foot for the
       person who cannot get in, who until now had nothing to do but
       leave. */
    .gate {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; padding: 46px 30px; position: relative;
      background:
        radial-gradient(ellipse at 60% 35%, rgba(201,154,59,.07), transparent 58%),
        var(--void);
    }
    /* Bigger than the card and fainter than the first attempt, where it
       cleared the card's top edge by an inch and read as a stray arc
       rather than as a frame around it. */
    .gate .oval {
      position: absolute; top: 50%; left: 50%; width: 700px; height: 860px;
      transform: translate(-50%, -52%); pointer-events: none; opacity: .34;
    }
    .gate .oval svg { width: 100%; height: 100%; }
    .help {
      margin-top: 30px; text-align: center; font-size: .74rem; color: var(--dim);
      letter-spacing: .04em; position: relative;
    }
    .help a { color: var(--gold); text-decoration: none; border-bottom: 1px solid var(--hair); }
    .help a:hover { color: var(--gold-lit); }

    /* The three names, inside the card under the form. Set as initials and
       a hairline rather than as a sentence: it is a reminder of what is
       behind the door, not another thing to read. */
    .inside {
      margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--hair);
      display: flex; justify-content: space-between; gap: 10px;
    }
    .inside span {
      flex: 1; text-align: center; font-family: Italiana, Georgia, serif;
      font-size: .58rem; letter-spacing: .16em; text-transform: uppercase;
      color: var(--dim); line-height: 1.7;
    }
    .inside i { display: block; color: var(--gold); font-size: .82rem; margin-bottom: 7px;
                font-family: 'Font Awesome 6 Free'; }
    /* The line the example calls a tagline: small, wide and quiet, up in the
       corner where it is read once and then ignored. */
    /* IN THE FLOW, NOT PINNED TO THE CORNER. Pinned, it sat behind the
       card the moment the card grew - the register panel is four fields
       tall - and three lines of gold reading through a dark card is not a
       detail anybody would have drawn on purpose. Above the card it is
       the first thing read and it never collides with anything. */
    .whisper {
      margin-bottom: 24px; text-align: center;
      font-family: Italiana, Georgia, serif;
      font-size: .62rem; letter-spacing: .34em; text-transform: uppercase;
      color: var(--gold); line-height: 2; opacity: .85;
    }
    .whisper br { display: none; }

    @media (max-width: 1040px) {
      .stage { grid-template-columns: 1fr; }
      .showing { border-right: 0; border-bottom: 1px solid var(--hair);
                 padding: 38px 26px 30px;
                 background:
                   linear-gradient(180deg, rgba(21,23,26,.95), rgba(21,23,26,.90)),
                   url('/portal/hero.jpg') center/cover no-repeat, var(--void); }
      .whisper { display: none; }
      .gate { padding: 34px 22px 50px; }
      .gate .oval { display: none; }
    }

    /* ── the card ─────────────────────────────── */
    /* CENTRED, ASKED FOR IN THOSE WORDS. A form reads faster ranged left,
       which is why it was - but this one is four fields on a dark card
       with a rule and a lozenge over it, and ranged left it sat off to one
       side of its own ornament. The inputs keep their text left, where a
       half-typed address belongs. */
    .card { text-align: center; }
    .card input { text-align: left; }
    .card {
      width: 100%; max-width: 448px; background: rgba(25,28,32,.94);
      border: 1px solid var(--hair); padding: 38px 34px 32px;
      position: relative; backdrop-filter: blur(2px);
      box-shadow: 0 30px 80px rgba(0,0,0,.45);
    }
    /* A rule with a lozenge in the middle, the way a printer rules off a
       heading. Drawn in CSS so there is no third image to load. */
    .crest { text-align: center; margin: 0 0 22px; }
    .crest::before, .crest::after {
      content: ''; display: inline-block; width: 52px; height: 1px;
      background: var(--hair); vertical-align: middle; margin: 0 10px;
    }
    .crest i { color: var(--gold); font-size: .62rem; vertical-align: middle; }
    .card h1 {
      font-family: 'Bodoni Moda', Georgia, serif; font-weight: 400;
      font-size: 1.76rem; margin: 0 0 7px; color: var(--paper);
      letter-spacing: .005em;
    }
    .card p.sub { margin: 0 0 26px; color: var(--dim); font-size: .95rem; font-style: italic;
                  font-family: 'Cormorant Garamond', Georgia, serif; line-height: 1.5; }

    label { display: block; font-family: Italiana, Georgia, serif; font-size: .62rem;
            letter-spacing: .26em; text-transform: uppercase; color: var(--gold);
            margin: 0 0 8px; text-align: center; }
    input {
      width: 100%; background: #111316; border: 1px solid var(--hair);
      color: #e8e4da; padding: 12px 14px; font-family: 'Tenor Sans', sans-serif;
      font-size: .92rem; margin-bottom: 16px; transition: border-color .15s;
    }
    input:focus { outline: none; border-color: var(--gold); }
    /* The six digits are read off a phone and typed one at a time. Wide and
       spaced so a 6 and an 8 are not the same shape at a glance. */
    input.code {
      text-align: center; font-size: 1.5rem; letter-spacing: .48em;
      padding-left: .48em; font-family: 'Cormorant Garamond', Georgia, serif;
    }
    .btn {
      width: 100%; background: var(--gold); color: #15171a; border: 0;
      padding: 14px 14px; font-family: Italiana, Georgia, serif; font-weight: 400;
      font-size: .84rem; letter-spacing: .24em; text-transform: uppercase;
      cursor: pointer; transition: background .15s;
    }
    .btn:hover { background: var(--gold-lit); }
    .btn[disabled] { opacity: .5; cursor: default; }
    .btn-quiet {
      background: none; color: var(--dim); border: 1px solid var(--hair);
      margin-top: 10px;
    }
    .btn-quiet:hover { background: rgba(201,162,39,.07); color: var(--paper); }
    .linkline { margin-top: 18px; font-size: .8rem; color: var(--dim); text-align: center; }
    .linkline a { color: var(--gold); text-decoration: none; border-bottom: 1px solid var(--hair);
                  cursor: pointer; }
    .linkline a:hover { color: var(--gold-lit); }

    .says { font-size: .82rem; line-height: 1.5; margin: 0 0 16px; padding: 10px 12px;
            border-left: 2px solid var(--gold); background: rgba(201,162,39,.06);
            color: var(--paper); display: none; }
    .says.bad { border-left-color: #b4544a; background: rgba(180,84,74,.08); }
    .says.on { display: block; }

    .panel { display: none; }
    .panel.on { display: block; }

    /* ── the three doors ──────────────────────── */
    /* THE SAME ROOM AS THE SIGN-IN, NOT A DIFFERENT ONE.
       The photograph is behind this page too, veiled almost to black -
       enough that the page has a floor and a corner, not enough to make a
       card harder to read. Fixed, so it does not slide about under them. */
    body.inside-page {
      background:
        linear-gradient(180deg, rgba(21,23,26,.955), rgba(21,23,26,.975)),
        url('/portal/hero.jpg') center/cover no-repeat fixed,
        var(--void);
    }
    .doors { display: grid; gap: 22px; width: 100%; max-width: 1000px;
             grid-template-columns: repeat(3, 1fr); }
    .door {
      position: relative; background: rgba(25,28,32,.92);
      border: 1px solid var(--hair); padding: 32px 26px 28px;
      text-decoration: none; display: block;
      transition: border-color .18s, transform .18s, box-shadow .18s;
    }
    /* A second rule set in from the first, the way a card is ruled inside
       its own edge. Drawn on the box rather than added as markup, so there
       is nothing extra in the page to keep in step. */
    .door::after {
      content: ''; position: absolute; inset: 7px; border: 1px solid rgba(201,162,39,.09);
      pointer-events: none; transition: border-color .18s;
    }
    .door:hover {
      border-color: var(--gold); transform: translateY(-3px);
      box-shadow: 0 22px 50px rgba(0,0,0,.45);
    }
    .door:hover::after { border-color: rgba(201,162,39,.28); }
    .door i { color: var(--gold); font-size: 1.28rem; }
    .door h2 {
      font-family: 'Bodoni Moda', Georgia, serif; font-weight: 400;
      font-size: 1.3rem; margin: 16px 0 9px; color: var(--paper);
    }
    .door p { margin: 0; font-size: .84rem; color: var(--dim); line-height: 1.6; }
    .door .go { margin-top: 18px; font-family: Italiana, Georgia, serif;
                font-size: .56rem; letter-spacing: .28em;
                text-transform: uppercase; color: var(--gold); }
    .welcome { text-align: center; margin-bottom: 34px; }
    .welcome .serif { font-size: 1.72rem; color: var(--paper); }
    .welcome div { color: var(--dim); font-size: .82rem; margin-top: 7px; }
    /* The same ruled lozenge that heads the sign-in card, so the two sides
       of the portal are obviously one place. */
    .welcome .crest { margin-bottom: 18px; }

    footer { flex: 0 0 auto; padding: 0 22px 34px; text-align: center;
             color: var(--dim); font-size: .7rem; letter-spacing: .12em; }
    footer a { color: var(--gold); text-decoration: none; cursor: pointer; }

    @media (max-width: 860px) { .doors { grid-template-columns: 1fr; max-width: 430px; } }
  </style>
</head>
<body class="<%= signedIn ? 'inside-page' : '' %>">

<% if (signedIn) { %>
<header>
  <div class="mark"><%= wordmark %><small>Fine Stationery</small></div>
  <% if (pill) { %><div class="pill"><%= pill %></div><% } %>
  <div class="rule"></div>
</header>
<% } %>

<main style="<%= signedIn ? '' : 'padding:0;display:block;' %>">
<% if (signedIn) { %>
  <div style="width:100%;max-width:980px;">
    <div class="welcome">
      <div class="crest"><i class="fa-solid fa-diamond"></i></div>
      <div class="serif">Welcome back<%= who && who.name ? ', ' + who.name.split(' ')[0] : '' %></div>
      <div><%= who ? who.email : '' %></div>
    </div>
    <div class="doors">
      <a class="door" href="/liners" target="_blank" rel="noopener">
        <i class="fa-solid fa-envelope-open"></i>
        <h2>Envelope Liner Book</h2>
        <p>Every liner we print, by collection, with its own code — and a search
           that understands "blue floral" as well as it understands CT-FB-01.</p>
        <div class="go">Open the book &nbsp;&rsaquo;</div>
      </a>
      <a class="door" href="/catalogue" target="_blank" rel="noopener">
        <i class="fa-solid fa-feather-pointed"></i>
        <h2>Design Catalogue</h2>
        <p>Forms, motifs and patterns — the shapes a card can take and the
           work that can go on it.</p>
        <div class="go">Open the catalogue &nbsp;&rsaquo;</div>
      </a>
      <a class="door" href="<%= quoteHref %>" target="_blank" rel="noopener">
        <i class="fa-solid fa-calculator"></i>
        <h2>Price Calculator</h2>
        <p>Price a job yourself — quantities, cards, finishes — and take the
           estimate away as a PDF.</p>
        <div class="go">Open the calculator &nbsp;&rsaquo;</div>
      </a>
    </div>
  </div>
<% } else { %>
  <div class="stage">

    <!-- WHAT IS BEHIND THE DOOR. The link is sent cold, so the page says
         what it is before it asks for anything. -->
    <section class="showing">
      <div class="mark" style="text-align:left;font-size:1.18rem;">
        <%= wordmark %><small style="letter-spacing:.3em;">Fine Stationery</small>
      </div>
      <%# The one word that tells the two links apart, as on the quote pages
          and on the signed-in header. Kept as its own pill rather than
          folded into the line above, so it is the same mark in both places
          and there is something to point at when somebody asks which link
          they are looking at. %>
      <% if (pill) { %><div class="pill" style="margin-top:12px;"><%= pill %></div><% } %>

      <h1 class="shout">The book, the catalogue and your <em>prices</em>.</h1>
      <p class="shout-sub">
        One place for everything you show a couple — every liner we print,
        every design we draw, and a calculator that prices the job while
        they are still sitting with you.
      </p>

      <ul class="points">
        <li>
          <i class="fa-solid fa-envelope-open"></i>
          <div>
            <b>Envelope Liner Book</b>
            <span>Every liner, by collection, each with its own code — and a
                  search that understands “blue floral” as well as CT-FB-01.</span>
          </div>
        </li>
        <li>
          <i class="fa-solid fa-feather-pointed"></i>
          <div>
            <b>Design Catalogue</b>
            <span>Forms, motifs and patterns: the shapes a card can take and
                  the work that can go on it.</span>
          </div>
        </li>
        <li>
          <i class="fa-solid fa-calculator"></i>
          <div>
            <b>Price Calculator</b>
            <span>Quantities, cards and finishes, priced on your own list, and
                  taken away as a PDF.</span>
          </div>
        </li>
      </ul>

      <div class="signoff">&copy; <%= new Date().getFullYear() %> <%= wordmark %></div>
    </section>

    <!-- THE DOOR -->
    <section class="gate">
      <div class="whisper">Every liner. Every design. One link.</div>
      <%# The engraved oval off the cards in the photograph, drawn rather
          than photographed so it stays crisp at any size and costs nothing
          to load. Behind the card, barely there. %>
      <div class="oval" aria-hidden="true">
        <svg viewBox="0 0 280 340" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="140" cy="170" rx="104" ry="146" stroke="#c99a3b" stroke-opacity=".30" stroke-width="1"/>
          <ellipse cx="140" cy="170" rx="96" ry="138" stroke="#c99a3b" stroke-opacity=".16" stroke-width="1"/>
          <path d="M140 18 l7 10 -7 10 -7 -10 z" fill="#c99a3b" fill-opacity=".30"/>
          <path d="M140 302 l7 10 -7 10 -7 -10 z" fill="#c99a3b" fill-opacity=".30"/>
        </svg>
      </div>
      <div class="card">
        <div class="crest"><i class="fa-solid fa-diamond"></i></div>
    <div class="says" id="says"></div>

    <!-- ── sign in ── -->
    <div class="panel on" id="p-in">
      <h1>Sign in</h1>
      <p class="sub">The liner book, the catalogue and the calculator, in one place.</p>
      <label for="in-email">Email</label>
      <input id="in-email" type="email" autocomplete="email" placeholder="you@company.com">
      <label for="in-pass">Password</label>
      <input id="in-pass" type="password" autocomplete="current-password">
      <button class="btn" onclick="signIn(this)">Sign in</button>
      <div class="linkline"><a onclick="show('p-forgot')">Forgotten your password?</a></div>
      <div class="linkline">No account yet? <a onclick="show('p-up')">Register</a></div>
    </div>

    <!-- ── register ── -->
    <div class="panel" id="p-up">
      <h1>Register</h1>
      <p class="sub">We will send a six-digit code to your email to confirm it.</p>
      <label for="up-name">Your name</label>
      <input id="up-name" autocomplete="name">
      <label for="up-company">Company <span style="color:var(--dim);">(optional)</span></label>
      <input id="up-company" autocomplete="organization">
      <label for="up-email">Email</label>
      <input id="up-email" type="email" autocomplete="email">
      <label for="up-pass">Password</label>
      <input id="up-pass" type="password" autocomplete="new-password"
             placeholder="At least eight characters">
      <button class="btn" onclick="register(this)">Send me a code</button>
      <div class="linkline">Already registered? <a onclick="show('p-in')">Sign in</a></div>
    </div>

    <!-- ── the code ── -->
    <div class="panel" id="p-code">
      <h1>Your code</h1>
      <p class="sub" id="code-sub">Six digits, sent to your email. It is good for ten minutes.</p>
      <label for="code">Code</label>
      <input id="code" class="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code">
      <button class="btn" onclick="verify(this)">Confirm</button>
      <button class="btn btn-quiet" id="again" onclick="resend(this)">Send another code</button>
      <div class="linkline"><a onclick="show('p-in')">Back to sign in</a></div>
    </div>

    <!-- ── forgotten ── -->
    <div class="panel" id="p-forgot">
      <h1>Forgotten password</h1>
      <p class="sub">Give the address you registered with and we will send a code.</p>
      <label for="fg-email">Email</label>
      <input id="fg-email" type="email" autocomplete="email">
      <button class="btn" onclick="forgot(this)">Send me a code</button>
      <div class="linkline"><a onclick="show('p-in')">Back to sign in</a></div>
    </div>

    <!-- ── new password ── -->
    <div class="panel" id="p-reset">
      <h1>New password</h1>
      <p class="sub">Type the code from your email and the password you would like.</p>
      <label for="rs-code">Code</label>
      <input id="rs-code" class="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code">
      <label for="rs-pass">New password</label>
      <input id="rs-pass" type="password" autocomplete="new-password"
             placeholder="At least eight characters">
      <button class="btn" onclick="reset(this)">Set it and sign in</button>
      <button class="btn btn-quiet" onclick="resend(this, 'reset')">Send another code</button>
      <div class="linkline"><a onclick="show('p-in')">Back to sign in</a></div>
    </div>

        <div class="inside">
          <span><i class="fa-solid fa-envelope-open"></i>Liner<br>book</span>
          <span><i class="fa-solid fa-feather-pointed"></i>Design<br>catalogue</span>
          <span><i class="fa-solid fa-calculator"></i>Price<br>calculator</span>
        </div>
      </div>

      <div class="help">
        Trouble getting in? Write to
        <a href="mailto:info@arabellapapers.com">info@arabellapapers.com</a>
      </div>
    </section>

  </div>
<% } %>
</main>

<%# The signed-out page signs itself off at the foot of its left half, so a
    second line here would be the same words twice on one screen. %>
<% if (signedIn) { %>
<footer>
  <a onclick="signOut()">Sign out</a> &nbsp;·&nbsp;
  <%= wordmark %><% if (pill) { %> · <%= pill %><% } %>
</footer>
<% } %>

<script>
(function () {
  var BRAND = <%- JSON.stringify(brand) %>;
  var API = '/client/' + BRAND + '/api/';
  var signedIn = <%- signedIn ? 'true' : 'false' %>;
  var waiting = '';   // the address the code on screen belongs to

  function say(text, bad) {
    var box = document.getElementById('says');
    if (!box) return;
    box.textContent = text || '';
    box.className = 'says' + (text ? ' on' : '') + (bad ? ' bad' : '');
  }
  window.show = function (id) {
    say('');
    var all = document.querySelectorAll('.panel');
    for (var i = 0; i < all.length; i++) all[i].classList.toggle('on', all[i].id === id);
    var first = document.querySelector('#' + id + ' input');
    if (first) first.focus();
  };

  // Every call goes through here, so a button cannot be pressed twice while
  // the first press is still in the air - which on a register button is two
  // accounts, and on a code button is two codes.
  async function ask(path, body, btn) {
    var was = btn ? btn.textContent : '';
    if (btn) { btn.disabled = true; btn.textContent = 'One moment…'; }
    try {
      var r = await fetch(API + path, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      var j = await r.json();
      return j || {};
    } catch (e) {
      return { success: false, error: 'The connection dropped. Please try again.' };
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = was; }
    }
  }

  var val = function (id) { return (document.getElementById(id).value || '').trim(); };

  window.register = async function (btn) {
    var email = val('up-email');
    var j = await ask('register', {
      name: val('up-name'), company: val('up-company'),
      email: email, password: document.getElementById('up-pass').value,
    }, btn);
    if (!j.success) return say(j.error, true);
    waiting = email;
    show('p-code');
    document.getElementById('code-sub').textContent =
      'Six digits, sent to ' + email + '. It is good for ten minutes.';
    // An address that already has an account is told nothing here. It is
    // sent the same way as everybody else and will simply have no code -
    // which is what the sign-in page and the forgotten-password door are
    // for, and is the whole point of not saying.
    say(j.known ? 'If that address has an account, a code is on its way to it.' : '');
  };

  window.verify = async function (btn) {
    var j = await ask('verify', { email: waiting, code: val('code') }, btn);
    if (!j.success) return say(j.error, true);
    location.reload();
  };

  window.resend = async function (btn, purpose) {
    var j = await ask('resend', { email: waiting, purpose: purpose || 'verify' }, btn);
    say(j.success ? 'Another code is on its way.' : j.error, !j.success);
  };

  window.signIn = async function (btn) {
    var email = val('in-email');
    var j = await ask('login', {
      email: email, password: document.getElementById('in-pass').value,
    }, btn);
    if (!j.success) return say(j.error, true);
    if (j.step === 'verify') {
      // Signed up but never finished. The password was right, so this is
      // them - they are shown the code step rather than a refusal.
      waiting = email;
      show('p-code');
      say('Your email has not been confirmed yet. A code is on its way to ' + email + '.');
      return;
    }
    location.reload();
  };

  window.forgot = async function (btn) {
    var email = val('fg-email');
    var j = await ask('forgot', { email: email }, btn);
    if (!j.success) return say(j.error, true);
    waiting = email;
    show('p-reset');
    say(j.message || 'If that address has an account, a code is on its way to it.');
  };

  window.reset = async function (btn) {
    var j = await ask('reset', {
      email: waiting, code: val('rs-code'),
      password: document.getElementById('rs-pass').value,
    }, btn);
    if (!j.success) return say(j.error, true);
    location.reload();
  };

  window.signOut = async function () {
    await ask('logout', {});
    location.reload();
  };

  // Enter sends the panel that is open, because nothing here is a <form> -
  // a form would reload the page and lose which address the code belongs to.
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' || signedIn) return;
    var open = document.querySelector('.panel.on');
    if (!open) return;
    var go = open.querySelector('.btn');
    if (go) { e.preventDefault(); go.click(); }
  });
}());
</script>
</body>
</html>
