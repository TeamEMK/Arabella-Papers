<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Paper stock — <%= wordmark %></title>
<%#
  THE FOURTH DOOR: WHAT IS ON THE SHELF

  The office keeps this list on its own Stock screen - series, code,
  and whether it is in. A customer asking "do you have Colorplan
  Ebony in 540?" was a phone call; this is that list, read-only, in the
  same room as the liner book and the catalogue.

  NOTHING INTERNAL IS SHOWN. The office's own note column is not read at
  all - it carries supplier names and prices and is nobody's business out
  here - and the route reads through the portal's restricted database
  login, which may see this table and no other.
%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<style>
  /* The tokens the other two rooms use. Copied rather than imported: each
     of these pages is served on its own. */
  :root {
    --void: #15171a;
    --rail-bg: #121417;
    --gold: #c99a3b;
    --gold-lit: #d8ad55;
    --dim: #8a8578;
    --hair: rgba(201,162,39,.22);
    --rail: 286px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  html { background: var(--void); }
  body {
    background: var(--void); color: #e8e4da;
    font-family: Jost, 'Segoe UI', sans-serif; font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }
  .serif { font-family: 'Cormorant Garamond', Georgia, serif; }
  ::selection { background: var(--gold); color: #000; }

  .rail {
    position: fixed; inset: 0 auto 0 0; width: var(--rail);
    background: var(--rail-bg); border-right: 1px solid rgba(201,154,59,.3);
    display: flex; flex-direction: column; z-index: 40;
    padding: 30px 26px 26px; overflow-y: auto; scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { width: 0; height: 0; }
  .mark {
    font-size: 1.45rem; letter-spacing: .22em; color: #fff; line-height: 1.25;
    text-indent: .22em; text-align: center;
  }
  .mark small {
    display: block; font-size: .62rem; letter-spacing: .4em;
    color: #cfc9ba; margin-top: 6px; text-indent: .4em;
  }
  .mark-rule { height: 1px; background: var(--hair); margin: 18px 6px 24px; }

  .seek-label {
    font-size: .6rem; letter-spacing: .32em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 10px; text-indent: .32em;
  }
  .seek { position: relative; }
  .seek i {
    position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
    color: var(--gold); opacity: .7; font-size: .8rem;
  }
  .seek input {
    width: 100%; background: rgba(13,15,18,.72); border: 1px solid rgba(201,162,39,.4);
    color: #e8e4da; font-family: inherit; font-size: .85rem;
    padding: 11px 12px 11px 34px;
  }
  .seek input:focus { outline: none; border-color: var(--gold-lit); }

  /* The series, as a list. Which one is open is kept in the address so a
     customer can send somebody the shelf they were looking at. */
  .cats { margin: 24px 0 0; }
  .cat {
    display: flex; align-items: center; gap: 12px; width: 100%;
    background: transparent; border: 0; border-left: 2px solid transparent;
    padding: 11px 10px; color: #d8d3c7; cursor: pointer; text-align: left;
    font-family: inherit; font-weight: 300; font-size: .72rem;
    letter-spacing: .14em; text-transform: uppercase;
    transition: background .18s, color .18s, border-color .18s;
  }
  .cat:hover { background: rgba(201,162,39,.06); color: #fff; }
  .cat.on {
    background: linear-gradient(90deg, rgba(201,162,39,.16), transparent 85%);
    border-left-color: var(--gold); color: #fff;
  }
  .cat .n { margin-left: auto; font-size: .66rem; color: var(--dim); }
  .cat.on .n { color: var(--gold-lit); }

  .creed {
    margin-top: auto; padding-top: 26px; text-align: center; font-size: .58rem;
    letter-spacing: .3em; color: var(--dim); line-height: 2.3; text-indent: .3em;
  }
  .creed .sep { color: var(--gold); opacity: .6; display: block; margin-bottom: 8px; }

  .main { margin-left: var(--rail); min-height: 100vh; padding: 0 0 60px; }
  .masthead { padding: 48px 46px 26px; }
  .eyebrow {
    font-size: .68rem; letter-spacing: .42em; color: var(--gold);
    text-transform: uppercase; text-indent: .42em; margin-bottom: 14px;
    display: flex; align-items: center; gap: 18px;
  }
  .eyebrow i { flex: 0 0 86px; height: 1px; background: var(--gold); opacity: .55; }
  .masthead h1 {
    font-family: 'Cormorant Garamond', serif; font-weight: 400; margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.6rem); line-height: .98; color: #fff;
    letter-spacing: .05em; text-transform: uppercase;
  }
  .underline { height: 1px; background: var(--gold); width: 92px; margin-top: 18px; opacity: .8; }
  .lede { margin: 16px 0 0; max-width: 60ch; color: var(--dim); font-size: .95rem; line-height: 1.75; }

  .sheets { padding: 10px 46px 0; }
  .shelf { margin-bottom: 42px; }
  .shelf h2 {
    font-family: 'Cormorant Garamond', serif; font-weight: 400;
    font-size: 1.5rem; letter-spacing: .08em; color: #fff; margin: 0 0 14px;
    text-transform: uppercase; padding-bottom: 10px; border-bottom: 1px solid var(--hair);
  }
  table { width: 100%; border-collapse: collapse; }
  th {
    text-align: left; font-weight: 400; font-size: .6rem; letter-spacing: .22em;
    text-transform: uppercase; color: var(--gold); padding: 0 14px 10px 0;
  }
  td {
    padding: 13px 14px 13px 0; border-top: 1px solid rgba(201,162,39,.12);
    font-size: .92rem; color: #e2ded4; vertical-align: top;
  }
  td.code { font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; color: var(--gold-lit); white-space: nowrap; }

  /* In, out, or ask. Said in words as well as colour - the office's own
     third state is a sentence, not a state. */
  .pill {
    display: inline-block; padding: 5px 13px; border-radius: 999px;
    font-size: .62rem; letter-spacing: .16em; text-transform: uppercase;
    border: 1px solid currentColor; white-space: nowrap;
  }
  .pill.in { color: #8fbf8a; }
  .pill.out { color: #d08a8a; }
  .pill.ask { color: var(--gold-lit); text-transform: none; letter-spacing: .06em; }
  .pill.none { color: var(--dim); }

  .empty { padding: 60px 46px; color: var(--dim); font-size: .95rem; }
  .foot {
    margin-left: var(--rail); padding: 10px 46px 46px; color: var(--dim);
    font-size: .72rem; line-height: 1.8;
  }

  @media (max-width: 900px) {
    :root { --rail: 0px; }
    .rail {
      position: static; width: auto; inset: auto; padding: 22px 18px;
      border-right: 0; border-bottom: 1px solid var(--hair);
      max-height: 42vh;
    }
    .creed { display: none; }
    .main, .foot { margin-left: 0; }
    .masthead, .sheets, .foot, .empty { padding-left: 18px; padding-right: 18px; }
    /* Three columns, and the status is a whole sentence on one of the
       three states, so it still wants more room than a phone has. A
       scrollbar under the shelf is easier than squeezing it. */
    .shelf { overflow-x: auto; }
    table { min-width: 460px; }
  }
</style>
</head>
<body>
<% if (typeof portalHome !== 'undefined' && portalHome) { %>
<a href="<%= portalHome %>" style="
   position:fixed;top:0;left:0;right:0;z-index:999;display:block;
   background:rgba(16,18,21,.94);border-bottom:1px solid rgba(201,162,39,.28);
   color:#c99a3b;text-decoration:none;font-family:Jost,'Segoe UI',sans-serif;
   font-size:.62rem;letter-spacing:.26em;text-transform:uppercase;
   padding:9px 20px;backdrop-filter:blur(3px);">
  &lsaquo;&nbsp;&nbsp;Back to your account
</a>
<div style="height:34px;"></div>
<% } %>

<aside class="rail">
  <div class="mark serif"><%= wordmark %><small>Fine Stationery</small></div>
  <div class="mark-rule"></div>

  <div class="seek-label">Search the stock</div>
  <div class="seek">
    <i class="fas fa-search"></i>
    <input type="text" id="q" autocomplete="off" placeholder="colorplan, ebony, vellum…">
  </div>

  <div class="cats" id="cats"></div>

  <div class="creed">
    <span class="sep">&#10022;</span>
    Fine Papers<br>Timeless<br>Celebrations
  </div>
</aside>

<main class="main">
  <header class="masthead">
    <div class="eyebrow"><i></i> Paper stock</div>
    <h1 class="serif">On the shelf</h1>
    <div class="underline"></div>
    <p class="lede">What we are holding right now, by series. Anything marked
      to be confirmed is worth a line to the office before you promise a date.</p>
  </header>

  <div class="sheets" id="sheets"></div>
</main>

<div class="foot">
  Stock moves. If something you need is out, write to
  <a href="mailto:info@arabellapapers.com" style="color:var(--gold-lit);">info@arabellapapers.com</a>
  &mdash; most of it comes back within the week, and we will tell you when.
</div>

<script>
// The rows are sent with the page rather than fetched: this is a list the
// office types by hand, a few hundred lines at most, and a second request
// for it would only be a second thing to go wrong.
var ITEMS = <%- JSON.stringify(items) %>;

function esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

// In, out, or ask. The office's third state is a whole sentence ("Please
// confirm before placing an order"), so it is matched on its sense rather
// than on an exact string somebody may edit.
function pill(status) {
  var s = String(status || '').trim();
  if (!s) return '<span class="pill none">Not said</span>';
  var low = s.toLowerCase();
  var cls = /out of stock|not available|nil/.test(low) ? 'out'
    : /in stock|available/.test(low) ? 'in' : 'ask';
  return '<span class="pill ' + cls + '">' + esc(s) + '</span>';
}

var open = '';   // which series is showing; '' is all of them

function matches(i, needle) {
  if (!needle) return true;
  return [i.category, i.code, i.name, i.status]
    .join(' ').toLowerCase().indexOf(needle) > -1;
}

function draw() {
  var needle = (document.getElementById('q').value || '').trim().toLowerCase();
  var rows = ITEMS.filter(function (i) {
    return (!open || i.category === open) && matches(i, needle);
  });

  // The rail: every series, with how many of it is showing.
  var counts = {};
  ITEMS.forEach(function (i) {
    if (!matches(i, needle)) return;
    counts[i.category] = (counts[i.category] || 0) + 1;
  });
  var cats = Object.keys(counts).sort();
  document.getElementById('cats').innerHTML =
    '<button class="cat' + (open ? '' : ' on') + '" data-cat="">'
    + 'All series<span class="n">' + rows.length + '</span></button>'
    + cats.map(function (c) {
      return '<button class="cat' + (c === open ? ' on' : '') + '" data-cat="' + esc(c) + '">'
        + esc(c) + '<span class="n">' + counts[c] + '</span></button>';
    }).join('');

  if (!rows.length) {
    document.getElementById('sheets').innerHTML =
      '<div class="empty">Nothing here by that name. Try the series or the code.</div>';
    return;
  }

  // Grouped by series, so a long list reads as shelves rather than a wall.
  var by = {};
  rows.forEach(function (i) { (by[i.category] = by[i.category] || []).push(i); });
  document.getElementById('sheets').innerHTML = Object.keys(by).sort().map(function (c) {
    return '<section class="shelf"><h2>' + esc(c) + '</h2>'
      + '<table><thead><tr><th>Code</th><th>Paper</th><th>Status</th></tr></thead><tbody>'
      + by[c].map(function (i) {
        return '<tr>'
          + '<td class="code">' + (esc(i.code) || '—') + '</td>'
          + '<td>' + (esc(i.name) || '—') + '</td>'
          + '<td>' + pill(i.status) + '</td>'
          + '</tr>';
      }).join('')
      + '</tbody></table></section>';
  }).join('');
}

document.getElementById('cats').addEventListener('click', function (e) {
  var btn = e.target.closest('.cat');
  if (!btn) return;
  open = btn.getAttribute('data-cat') || '';
  draw();
  window.scrollTo({ top: 0, behavior: 'smooth' });
});
document.getElementById('q').addEventListener('input', draw);
draw();
</script>
</body>
</html>
