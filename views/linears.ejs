<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Envelope Liners — Arabella Papers</title>
  <%# Standalone, like the design catalogue: there is no session out here, so
      the portal's shell cannot be reused. Same dark and gold as the
      catalogue on purpose - a customer sent both links should not feel they
      have arrived at two different companies. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <style>
    :root {
      --void: #15171a;
      --rail-bg: #121417;
      --gold: #c99a3b;
      --gold-lit: #d8ad55;
      --paper: #f7f4ed;
      --dim: #8a8578;
      --hair: rgba(201,162,39,.22);
      --rail: 286px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--void);
      color: #e8e4da;
      font-family: Jost, 'Segoe UI', sans-serif;
      font-weight: 300;
      -webkit-font-smoothing: antialiased;
    }
    .serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    ::selection { background: var(--gold); color: #000; }
    a { color: inherit; }

    /* ── the rail ─────────────────────────────── */
    .rail {
      position: fixed; inset: 0 auto 0 0; width: var(--rail);
      background: var(--rail-bg); border-right: 1px solid var(--hair);
      padding: 28px 22px; overflow-y: auto; z-index: 20;
    }
    .mark { font-size: 1.55rem; letter-spacing: .04em; color: var(--paper); }
    .mark small {
      display: block; font-family: Jost, sans-serif; font-size: .64rem;
      letter-spacing: .34em; text-transform: uppercase; color: var(--gold);
      margin-top: 6px;
    }
    .seek { position: relative; margin: 26px 0 6px; }
    .seek input {
      width: 100%; background: #0d0f11; border: 1px solid var(--hair);
      color: var(--paper); font-family: inherit; font-size: .86rem;
      padding: 10px 12px 10px 32px; outline: none;
    }
    .seek input:focus { border-color: var(--gold); }
    .seek i {
      position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
      color: var(--gold); font-size: .78rem;
    }
    .seek-note { font-size: .68rem; color: var(--dim); letter-spacing: .04em; min-height: 1em; }

    .sec { margin-top: 20px; }
    .sec-name {
      font-size: .62rem; letter-spacing: .26em; text-transform: uppercase;
      color: var(--gold); padding-bottom: 7px; border-bottom: 1px solid var(--hair);
    }
    .cat {
      display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
      padding: 7px 2px; cursor: pointer; color: #cfcabd; font-size: .86rem;
      border-bottom: 1px solid rgba(255,255,255,.04);
    }
    .cat:hover { color: var(--paper); }
    .cat.on { color: var(--gold-lit); }
    .cat span:last-child { font-size: .68rem; color: var(--dim); flex: none; }

    /* ── the field ────────────────────────────── */
    .field { margin-left: var(--rail); padding: 34px 40px 70px; }
    .head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 22px; }
    .head h1 { margin: 0; font-size: 2rem; font-weight: 400; color: var(--paper); letter-spacing: .01em; }
    .head .where { font-size: .66rem; letter-spacing: .26em; text-transform: uppercase; color: var(--gold); }
    .head .tally { margin-left: auto; font-size: .74rem; color: var(--dim); }
    .back {
      background: none; border: 1px solid var(--hair); color: var(--dim);
      font-family: inherit; font-size: .72rem; letter-spacing: .16em;
      text-transform: uppercase; padding: 6px 12px; cursor: pointer;
    }
    .back:hover { border-color: var(--gold); color: var(--gold-lit); }

    .grid { display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
    .piece { cursor: zoom-in; }
    .piece .mat {
      background: var(--paper); aspect-ratio: 1 / 1; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      border: 1px solid rgba(255,255,255,.06);
      transition: border-color .18s ease, transform .18s ease;
    }
    .piece:hover .mat { border-color: var(--gold); transform: translateY(-2px); }
    .piece img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .piece .cap {
      margin-top: 8px; font-size: .68rem; letter-spacing: .14em;
      text-transform: uppercase; color: var(--dim);
    }
    .piece .cap b { display: block; color: #cfcabd; font-weight: 400; letter-spacing: .12em; }

    .empty { padding: 70px 0; text-align: center; color: var(--dim); }

    /* ── one design, full size ────────────────── */
    .lb {
      position: fixed; inset: 0; z-index: 90; background: rgba(8,9,10,.95);
      display: none; align-items: center; justify-content: center; padding: 60px;
    }
    .lb.on { display: flex; }
    .lb img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .lb .cap2 {
      position: absolute; left: 0; right: 0; bottom: 22px; text-align: center;
      font-size: .7rem; letter-spacing: .24em; text-transform: uppercase;
      color: var(--dim); pointer-events: none;
    }
    .lb button {
      position: absolute; background: none; border: 0; color: var(--dim);
      cursor: pointer; font-size: 2rem; line-height: 1;
    }
    .lb button:hover { color: var(--gold-lit); }
    .lb .x { top: 18px; right: 26px; }
    .lb .prev { left: 20px; top: 50%; transform: translateY(-50%); font-size: 2.6rem; }
    .lb .next { right: 20px; top: 50%; transform: translateY(-50%); font-size: 2.6rem; }

    .foot { margin-left: var(--rail); padding: 0 40px 40px; color: var(--dim); font-size: .7rem; letter-spacing: .1em; }

    @media (max-width: 900px) {
      :root { --rail: 0px; }
      .rail {
        position: static; width: auto; inset: auto;
        border-right: 0; border-bottom: 1px solid var(--hair); padding: 22px 18px;
      }
      .field, .foot { margin-left: 0; padding-left: 18px; padding-right: 18px; }
      .lb { padding: 46px 12px; }
    }
  </style>
</head>
<body>

<aside class="rail">
  <div class="mark serif">Arabella Papers<small>Envelope Liners</small></div>

  <div class="seek">
    <i class="fas fa-search"></i>
    <input type="text" id="q" autocomplete="off" placeholder="blue flower, gold geometric...">
  </div>
  <div class="seek-note" id="qnote"></div>

  <div id="rail"></div>
</aside>

<main class="field">
  <div id="field">
    <div class="empty">Loading…</div>
  </div>
</main>

<div class="foot">Shown here is what is currently in stock as a liner. Ask the office for anything you cannot see.</div>

<div class="lb" id="lb" onclick="lbClose(event)">
  <button class="x" onclick="lbClose(event, true)" title="Close">&times;</button>
  <button class="prev" onclick="lbStep(event, -1)">&lsaquo;</button>
  <img id="lbImg" alt="">
  <button class="next" onclick="lbStep(event, 1)">&rsaquo;</button>
  <div class="cap2" id="lbCap"></div>
</div>

<script>
var sections = [];
var picked = 0;
var shown = [];
var at = -1;
var seekTimer = null;

function esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

async function boot() {
  try {
    var r = await fetch('/linears/api/board');
    var j = await r.json();
    if (!j.success) throw new Error('no');
    sections = j.sections || [];
    drawRail();
    var first = null;
    for (var i = 0; i < sections.length && !first; i++) {
      if (sections[i].items.length) first = sections[i].items[0];
    }
    if (first) openCat(first.id);
    else document.getElementById('field').innerHTML =
      '<div class="empty">Nothing is published here yet.</div>';
  } catch (e) {
    document.getElementById('field').innerHTML =
      '<div class="empty">Could not load the liners just now. Please try again shortly.</div>';
  }
}

function drawRail() {
  var html = '';
  for (var i = 0; i < sections.length; i++) {
    var s = sections[i];
    html += '<div class="sec"><div class="sec-name">' + esc(s.section) + '</div>';
    for (var k = 0; k < s.items.length; k++) {
      var it = s.items[k];
      html += '<div class="cat' + (it.id === picked ? ' on' : '') + '" onclick="openCat(' + it.id + ')">'
        + '<span>' + esc(it.category) + '</span><span>' + it.count + '</span></div>';
    }
    html += '</div>';
  }
  document.getElementById('rail').innerHTML = html;
}

// Not called `open`: window already has one of those, and quietly replacing
// it for the whole page so that a category id can be passed where a URL was
// expected is the kind of thing that breaks something else six months later.
async function openCat(id) {
  picked = id;
  drawRail();
  document.getElementById('q').value = '';
  document.getElementById('qnote').textContent = '';
  var field = document.getElementById('field');
  field.innerHTML = '<div class="empty">Loading…</div>';
  try {
    var r = await fetch('/linears/api/category/' + id);
    var j = await r.json();
    if (!j.success) throw new Error('no');
    if (picked !== id) return;      // somebody picked another while this came
    shown = j.items.filter(function (x) { return x.hasImage; });
    at = -1;
    field.innerHTML =
      '<div class="head"><h1 class="serif">' + esc(j.category) + '</h1>'
      + '<span class="where">' + esc(j.section) + '</span>'
      + '<span class="tally">' + j.items.length
      + (j.items.length === 1 ? ' design' : ' designs') + '</span></div>'
      + tiles(j.items, false);
  } catch (e) {
    field.innerHTML = '<div class="empty">Could not load that just now.</div>';
  }
}

function tiles(items, withCategory) {
  if (!items.length) return '<div class="empty">Nothing here.</div>';
  var html = '<div class="grid">';
  for (var i = 0; i < items.length; i++) {
    var it = items[i];
    // Lazy here and NOT inside the lightbox: this is an ordinary page being
    // scrolled, which is what lazy loading is for, while the one picture
    // somebody has just asked to see must start loading at once.
    var pic = it.hasThumb
      ? '<img src="/linears/thumb/' + it.id + '" alt="' + esc(it.code) + '" loading="lazy">'
      : '';
    html += '<div class="piece" onclick="lb(' + it.id + ')">'
      + '<div class="mat">' + pic + '</div>'
      + '<div class="cap"><b>' + esc(it.code) + '</b>'
      + (withCategory ? esc(it.category) : '') + '</div></div>';
  }
  return html + '</div>';
}

function seekSoon() {
  clearTimeout(seekTimer);
  var q = (document.getElementById('q').value || '').trim();
  if (q.length < 2) {
    document.getElementById('qnote').textContent = '';
    return;
  }
  document.getElementById('qnote').textContent = 'Looking…';
  seekTimer = setTimeout(function () { seek(q); }, 350);
}

async function seek(q) {
  var field = document.getElementById('field');
  try {
    var r = await fetch('/linears/api/search?q=' + encodeURIComponent(q));
    var j = await r.json();
    if (!j.success) throw new Error('no');
    var now = (document.getElementById('q').value || '').trim();
    if (now !== q) return;

    picked = 0;
    drawRail();
    shown = j.items.filter(function (x) { return x.hasImage; });
    at = -1;
    document.getElementById('qnote').textContent =
      j.found + (j.found === 1 ? ' design' : ' designs');

    field.innerHTML =
      '<div class="head">'
      + '<button class="back" onclick="clearSeek()">&larr; All liners</button>'
      + '<h1 class="serif">' + esc(q) + '</h1>'
      + '<span class="tally">' + j.found + (j.found === 1 ? ' design' : ' designs')
      + (j.found > j.items.length ? ', showing ' + j.items.length : '') + '</span></div>'
      + (j.items.length ? tiles(j.items, true)
        : '<div class="empty">Nothing matches that. Try a colour on its own — '
          + 'blue, gold, red — or the kind of pattern.</div>');
  } catch (e) {
    document.getElementById('qnote').textContent = '';
    field.innerHTML = '<div class="empty">Could not search just now.</div>';
  }
}

function clearSeek() {
  document.getElementById('q').value = '';
  document.getElementById('qnote').textContent = '';
  var first = null;
  for (var i = 0; i < sections.length && !first; i++) {
    if (sections[i].items.length) first = sections[i].items[0];
  }
  if (first) openCat(first.id);
}

function lbShow(i) {
  if (i < 0 || i >= shown.length) return;
  at = i;
  document.getElementById('lbImg').src = '/linears/image/' + shown[i].id;
  document.getElementById('lbCap').textContent = shown[i].code
    + (shown.length > 1 ? '  ·  ' + (i + 1) + ' of ' + shown.length : '');
  document.getElementById('lb').classList.add('on');
}

function lb(id) {
  for (var i = 0; i < shown.length; i++) if (shown[i].id === id) return lbShow(i);
}

function lbStep(ev, by) {
  if (ev) ev.stopPropagation();
  if (!shown.length) return;
  lbShow((at + by + shown.length) % shown.length);
}

function lbClose(ev, force) {
  // Only the backdrop closes it. Clicking the picture does not, or every
  // attempt to look closely at a liner shuts the thing being looked at.
  if (force || !ev || ev.target.id === 'lb') {
    document.getElementById('lb').classList.remove('on');
    document.getElementById('lbImg').removeAttribute('src');
  }
}

document.addEventListener('keydown', function (ev) {
  var box = document.getElementById('lb');
  if (!box.classList.contains('on')) return;
  if (ev.key === 'Escape') lbClose(null, true);
  else if (ev.key === 'ArrowRight') lbStep(null, 1);
  else if (ev.key === 'ArrowLeft') lbStep(null, -1);
});

document.getElementById('q').addEventListener('input', seekSoon);
boot();
</script>
</body>
</html>
