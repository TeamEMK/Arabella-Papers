<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Envelope Liners — Arabella Papers</title>
  <%# Standalone, like the design catalogue: there is no session out here, so
      the portal's shell cannot be reused. Same dark and gold as the
      catalogue on purpose - a customer sent both links should not feel they
      have arrived at two different companies. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <style>
    :root {
      --void: #15171a;
      --rail-bg: #121417;
      --gold: #c99a3b;
      --gold-lit: #d8ad55;
      --paper: #f7f4ed;
      --dim: #8a8578;
      --hair: rgba(201,162,39,.22);
      --rail: 286px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--void);
      color: #e8e4da;
      font-family: Jost, 'Segoe UI', sans-serif;
      font-weight: 300;
      -webkit-font-smoothing: antialiased;
    }
    .serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    ::selection { background: var(--gold); color: #000; }

    /* THE SCROLLBAR IS GONE, THE SCROLLING IS NOT.
       Two grey bars down a page like this one are the only parts of it
       the browser drew. Hidden rather than styled: a thin dark one still
       reads as a mechanism, and there is nothing here to operate.
       Everything still scrolls - wheel, trackpad, touch, Page Down and
       the keyboard - so nothing is taken away but the sight of it. */
    html, body, .rail { scrollbar-width: none; -ms-overflow-style: none; }
    html::-webkit-scrollbar, body::-webkit-scrollbar,
    .rail::-webkit-scrollbar { width: 0; height: 0; display: none; }
    a { color: inherit; }

    /* ── the rail ─────────────────────────────── */
    .rail {
      position: fixed; inset: 0 auto 0 0; width: var(--rail);
      background: var(--rail-bg); border-right: 1px solid var(--hair);
      padding: 28px 22px; overflow-y: auto; z-index: 20;
    }
    /* The name is set wide and small rather than big and tight. A letter-
       spaced serif cap reads as a press mark; the same words at 2rem read
       as a logo somebody made in a hurry. */
    .mark {
      font-size: 1.12rem; letter-spacing: .22em; text-transform: uppercase;
      color: var(--gold-lit); text-align: center; line-height: 1.5;
    }
    .mark small {
      display: block; font-family: Jost, sans-serif; font-size: .56rem;
      letter-spacing: .3em; text-transform: uppercase; color: var(--dim);
      margin-top: 8px;
    }
    .mark-rule { height: 1px; background: var(--hair); margin: 20px 0 0; }
    .seek-label {
      font-size: .58rem; letter-spacing: .28em; text-transform: uppercase;
      color: var(--gold); margin: 26px 0 8px; font-style: italic;
    }
    /* A rule under the words rather than a box around them. A box is a
       form; a rule is a line somebody writes on. */
    .seek { position: relative; border-bottom: 1px solid var(--hair); }
    .seek input {
      width: 100%; background: none; border: 0;
      color: var(--paper); font-family: "Cormorant Garamond", Georgia, serif;
      font-size: 1rem; font-style: italic;
      padding: 2px 0 9px 20px; outline: none;
    }
    .seek input::placeholder { color: var(--dim); opacity: 1; }
    .seek:focus-within { border-bottom-color: var(--gold); }
    .seek i {
      position: absolute; left: 0; top: 7px;
      color: var(--gold); font-size: .7rem;
    }
    .seek-note { font-size: .68rem; color: var(--dim); letter-spacing: .04em; min-height: 1em; }

    .sec { margin-top: 26px; }
    .sec-name {
      font-size: .58rem; letter-spacing: .26em; text-transform: uppercase;
      color: var(--gold); padding: 0 0 10px; border-top: 1px solid var(--hair);
      padding-top: 16px;
    }
    /* No rule between the rows. Twenty-one hairlines down a column is a
       spreadsheet; the section rules above are enough to group them. */
    .cat {
      display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
      padding: 5px 0 5px 12px; cursor: pointer; color: #cfcabd;
      font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.02rem;
      transition: color .15s ease;
    }
    .cat:hover { color: var(--paper); }
    .cat.on { color: var(--gold-lit); }
    .cat span:last-child {
      font-size: .8rem; color: var(--dim); flex: none;
      font-variant-numeric: tabular-nums;
    }

    /* ── the field ────────────────────────────── */
    .field { margin-left: var(--rail); padding: 34px 40px 70px; }
    .head { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; margin-bottom: 6px; }
    .head h1 {
      margin: 0; font-size: 3rem; font-weight: 300; color: var(--paper);
      letter-spacing: .005em; line-height: 1.05;
    }
    /* A rule that takes whatever width is left, so the title and the far
       label are tied together rather than floating apart. */
    .head .rule { flex: 1 1 60px; height: 1px; background: var(--hair); }
    .head .where { font-size: .62rem; letter-spacing: .28em; text-transform: uppercase; color: var(--gold); }
    .head .tally {
      font-size: .62rem; letter-spacing: .24em; text-transform: uppercase;
      color: var(--dim); flex: none;
    }
    .sub {
      font-family: "Cormorant Garamond", Georgia, serif; font-style: italic;
      font-size: 1.05rem; color: var(--dim); margin: 0 0 30px;
    }
    .back {
      background: none; border: 1px solid var(--hair); color: var(--dim);
      font-family: inherit; font-size: .72rem; letter-spacing: .16em;
      text-transform: uppercase; padding: 6px 12px; cursor: pointer;
    }
    .back:hover { border-color: var(--gold); color: var(--gold-lit); }

    .grid { display: grid; gap: 34px 30px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
    .piece { cursor: zoom-in; }
    /* A GOLD FRAME ON A CREAM MAT.
       The liners are printed on paper and this is the one move that says
       so: a thin gold edge, a margin of the paper colour, and the pattern
       sitting inside it like a mounted swatch rather than a tile in a
       grid. It costs nothing and it is the whole difference between a
       stock page and a stationer\u2019s. */
    .piece .mat {
      background: var(--paper); aspect-ratio: 1 / 1; overflow: hidden;
      border: 1px solid var(--gold); padding: 9px;
      box-shadow: 0 10px 26px rgba(0,0,0,.45);
      transition: transform .22s ease, box-shadow .22s ease;
    }
    .piece:hover .mat {
      transform: translateY(-4px);
      box-shadow: 0 16px 34px rgba(0,0,0,.6);
    }
    .piece img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .piece .cap {
      margin-top: 13px; font-size: .64rem; letter-spacing: .2em;
      text-transform: uppercase; color: var(--dim); text-align: center;
    }
    .piece .cap b {
      display: block; color: var(--gold-lit); font-weight: 400;
      letter-spacing: .26em; margin-bottom: 3px;
    }

    .empty { padding: 70px 0; text-align: center; color: var(--dim); }

    /* ── one design, full size ────────────────── */
    .lb {
      position: fixed; inset: 0; z-index: 90; background: rgba(8,9,10,.95);
      display: none; align-items: center; justify-content: center; padding: 60px;
    }
    .lb.on { display: flex; }
    .lb img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .lb .cap2 {
      position: absolute; left: 0; right: 0; bottom: 22px; text-align: center;
      font-size: .7rem; letter-spacing: .24em; text-transform: uppercase;
      color: var(--dim); pointer-events: none;
    }
    .lb button {
      position: absolute; background: none; border: 0; color: var(--dim);
      cursor: pointer; font-size: 2rem; line-height: 1;
    }
    .lb button:hover { color: var(--gold-lit); }
    .lb .x { top: 18px; right: 26px; }
    .lb .prev { left: 20px; top: 50%; transform: translateY(-50%); font-size: 2.6rem; }
    .lb .next { right: 20px; top: 50%; transform: translateY(-50%); font-size: 2.6rem; }

    /* The three promises. A quiet band rather than a loud one: it sits under
       the liners because somebody scrolls to the end of a category and then
       wonders what else is possible, which is exactly when these answer. */
    .offer {
      margin-left: var(--rail); padding: 10px 40px 34px;
      display: grid; gap: 34px; grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid var(--hair);
    }
    .offer-one h2 {
      margin: 26px 0 10px; font-family: Jost, sans-serif; font-weight: 400;
      font-size: .66rem; letter-spacing: .26em; text-transform: uppercase;
      color: var(--gold);
    }
    .offer-one p {
      margin: 0; font-size: .82rem; line-height: 1.7; color: #b8b3a7;
      max-width: 38ch;
    }
    .offer-one a { color: var(--gold-lit); text-decoration: none; border-bottom: 1px solid var(--hair); }
    .offer-one a:hover { border-bottom-color: var(--gold-lit); }

    .foot { margin-left: var(--rail); padding: 0 40px 40px; color: var(--dim); font-size: .7rem; letter-spacing: .1em; }

    @media (max-width: 900px) {
      :root { --rail: 0px; }
      .rail {
        position: static; width: auto; inset: auto;
        border-right: 0; border-bottom: 1px solid var(--hair); padding: 22px 18px;
        /* THE LINERS HAVE TO BE ON THE FIRST SCREEN.
           Stacked above them, twenty-one category names filled a phone
           entirely - somebody opening the link was shown a list of words
           and had to scroll before a single pattern appeared, which is the
           opposite of what this page is for. The list keeps its own
           scrolling area and the liners start just under it. */
        max-height: 44vh; overflow-y: auto;
      }
      .mark { font-size: 1rem; }
      .sec { margin-top: 18px; }
      .field, .foot, .offer { margin-left: 0; padding-left: 18px; padding-right: 18px; }
      .offer { grid-template-columns: 1fr; gap: 0; }
      .lb { padding: 46px 12px; }
    }
  </style>
</head>
<body>
<%# Only inside the portal: served on its own, this page has nothing
    to go back to. portalHome is set by the mount in routes/clientPortal.js. %>
<% if (typeof portalHome !== 'undefined' && portalHome) { %>
<a href="<%= portalHome %>" style="
   position:fixed;top:0;left:0;right:0;z-index:999;display:block;
   background:rgba(16,18,21,.94);border-bottom:1px solid rgba(201,162,39,.28);
   color:#c99a3b;text-decoration:none;font-family:Jost,'Segoe UI',sans-serif;
   font-size:.62rem;letter-spacing:.26em;text-transform:uppercase;
   padding:9px 20px;backdrop-filter:blur(3px);">
  &lsaquo;&nbsp;&nbsp;Back to your account
</a>
<div style="height:34px;"></div>
<% } %>


<aside class="rail">
  <%# No town under the name. The reference this was drawn from said
      "FINE STATIONERY · LONDON", which the office is not - and a false
      address on the page a customer is sent is not a design decision. %>
  <div class="mark serif">Arabella Papers<small>Fine Stationery</small></div>
  <div class="mark-rule"></div>

  <div class="seek-label">Search the collection</div>
  <div class="seek">
    <i class="fas fa-search"></i>
    <input type="text" id="q" autocomplete="off"
           placeholder="blue flower, gold geometric, CT-TS-07...">
  </div>
  <div class="seek-note" id="qnote"></div>

  <div id="rail"></div>
</aside>

<main class="field">
  <div id="field">
    <div class="empty">Loading…</div>
  </div>
</main>

<%# The three things the office most wants a customer to know. Outside
    #field on purpose: that panel is rewritten every time a category is
    opened or a search is run, and these are true of every liner on the
    page, not of whichever one is showing. %>
<section class="offer">
  <div class="offer-one">
    <h2>Unlimited Colour Options</h2>
    <p>Every envelope liner in our collection is available in any colour of your
      choice. Our ink library is extensive, so we don't want to limit you to a
      predefined palette. Simply give us the uncoated side of the Pantone colour
      you want, and we'll customise it for you.</p>
  </div>
  <div class="offer-one">
    <h2>Complimentary Customisation</h2>
    <p>Every design is fully customisable at no additional cost. Increase or
      decrease the scale of a pattern, adjust individual elements, change
      colours, or modify the design in any other way — we're happy to
      accommodate your preferences.</p>
  </div>
  <div class="offer-one">
    <h2>Printing Techniques</h2>
    <p>To discuss the printing techniques available for a particular envelope
      liner, write to us at
      <a href="mailto:info@arabellapapers.com">info@arabellapapers.com</a>.</p>
  </div>
</section>

<div class="foot">Shown here is what is currently in stock as a liner. Ask the office for anything you cannot see.</div>

<div class="lb" id="lb" onclick="lbClose(event)">
  <button class="x" onclick="lbClose(event, true)" title="Close">&times;</button>
  <button class="prev" onclick="lbStep(event, -1)">&lsaquo;</button>
  <img id="lbImg" alt="">
  <button class="next" onclick="lbStep(event, 1)">&rsaquo;</button>
  <div class="cap2" id="lbCap"></div>
</div>

<script>
// The page answers to two addresses - /liners, which is the one given
// out, and /linears, the first spelling, kept alive because it is
// already in somebody's chat. Everything it asks for is asked of the
// address it was opened at, so neither one has to know about the other.
var BASE = location.pathname.replace(/\/+$/, '');
var sections = [];
var picked = 0;
var shown = [];
var at = -1;
var seekTimer = null;

function esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

async function boot() {
  try {
    var r = await fetch(BASE + '/api/board');
    var j = await r.json();
    if (!j.success) throw new Error('no');
    sections = j.sections || [];
    drawRail();
    var first = null;
    for (var i = 0; i < sections.length && !first; i++) {
      if (sections[i].items.length) first = sections[i].items[0];
    }
    if (first) openCat(first.id);
    else document.getElementById('field').innerHTML =
      '<div class="empty">Nothing is published here yet.</div>';
  } catch (e) {
    document.getElementById('field').innerHTML =
      '<div class="empty">Could not load the liners just now. Please try again shortly.</div>';
  }
}

function drawRail() {
  var html = '';
  for (var i = 0; i < sections.length; i++) {
    var s = sections[i];
    html += '<div class="sec"><div class="sec-name">' + esc(s.section) + '</div>';
    for (var k = 0; k < s.items.length; k++) {
      var it = s.items[k];
      html += '<div class="cat' + (it.id === picked ? ' on' : '') + '" onclick="openCat(' + it.id + ')">'
        + '<span>' + esc(it.category) + '</span>'
        + '<span>(' + it.count + ')</span></div>';
    }
    html += '</div>';
  }
  document.getElementById('rail').innerHTML = html;
}

// Not called `open`: window already has one of those, and quietly replacing
// it for the whole page so that a category id can be passed where a URL was
// expected is the kind of thing that breaks something else six months later.
async function openCat(id) {
  picked = id;
  drawRail();
  document.getElementById('q').value = '';
  document.getElementById('qnote').textContent = '';
  var field = document.getElementById('field');
  field.innerHTML = '<div class="empty">Loading…</div>';
  try {
    var r = await fetch(BASE + '/api/category/' + id);
    var j = await r.json();
    if (!j.success) throw new Error('no');
    if (picked !== id) return;      // somebody picked another while this came
    shown = j.items.filter(function (x) { return x.hasImage; });
    at = -1;
    field.innerHTML =
      '<div class="head"><h1 class="serif">' + esc(j.category) + '</h1>'
      + '<span class="rule"></span>'
      + '<span class="where">' + esc(j.section) + '</span>'
      + '<span class="tally">' + j.items.length
      + (j.items.length === 1 ? ' design' : ' designs') + '</span></div>'
      + '<p class="sub">Each design can be customised in any colour and to any scale.</p>'
      + tiles(j.items, false);
  } catch (e) {
    field.innerHTML = '<div class="empty">Could not load that just now.</div>';
  }
}

function tiles(items, withCategory) {
  if (!items.length) return '<div class="empty">Nothing here.</div>';
  var html = '<div class="grid">';
  for (var i = 0; i < items.length; i++) {
    var it = items[i];
    // Lazy here and NOT inside the lightbox: this is an ordinary page being
    // scrolled, which is what lazy loading is for, while the one picture
    // somebody has just asked to see must start loading at once.
    var pic = it.hasThumb
      ? '<img src="' + BASE + '/thumb/' + it.id + '" alt="' + esc(it.code) + '" loading="lazy">'
      : '';
    html += '<div class="piece" onclick="lb(' + it.id + ')">'
      + '<div class="mat">' + pic + '</div>'
      + '<div class="cap"><b>' + esc(it.code) + '</b>'
      + (withCategory ? esc(it.category) : '') + '</div></div>';
  }
  return html + '</div>';
}

function seekSoon() {
  clearTimeout(seekTimer);
  var q = (document.getElementById('q').value || '').trim();
  if (q.length < 2) {
    document.getElementById('qnote').textContent = '';
    return;
  }
  document.getElementById('qnote').textContent = 'Looking…';
  seekTimer = setTimeout(function () { seek(q); }, 350);
}

async function seek(q) {
  var field = document.getElementById('field');
  try {
    var r = await fetch(BASE + '/api/search?q=' + encodeURIComponent(q));
    var j = await r.json();
    if (!j.success) throw new Error('no');
    var now = (document.getElementById('q').value || '').trim();
    if (now !== q) return;

    picked = 0;
    drawRail();
    shown = j.items.filter(function (x) { return x.hasImage; });
    at = -1;
    document.getElementById('qnote').textContent =
      j.found + (j.found === 1 ? ' design' : ' designs');

    field.innerHTML =
      '<div class="head">'
      + '<button class="back" onclick="clearSeek()">&larr; All liners</button>'
      + '<h1 class="serif">' + esc(q) + '</h1>'
      + '<span class="rule"></span>'
      + '<span class="tally">' + j.found + (j.found === 1 ? ' design' : ' designs')
      + (j.found > j.items.length ? ', showing ' + j.items.length : '') + '</span></div>'
      + (j.items.length ? tiles(j.items, true)
        : '<div class="empty">Nothing matches that. Try a colour on its own — '
          + 'blue, gold, red — or the kind of pattern.</div>');
  } catch (e) {
    document.getElementById('qnote').textContent = '';
    field.innerHTML = '<div class="empty">Could not search just now.</div>';
  }
}

function clearSeek() {
  document.getElementById('q').value = '';
  document.getElementById('qnote').textContent = '';
  var first = null;
  for (var i = 0; i < sections.length && !first; i++) {
    if (sections[i].items.length) first = sections[i].items[0];
  }
  if (first) openCat(first.id);
}

function lbShow(i) {
  if (i < 0 || i >= shown.length) return;
  at = i;
  document.getElementById('lbImg').src = BASE + '/image/' + shown[i].id;
  document.getElementById('lbCap').textContent = shown[i].code
    + (shown.length > 1 ? '  ·  ' + (i + 1) + ' of ' + shown.length : '');
  document.getElementById('lb').classList.add('on');
}

function lb(id) {
  for (var i = 0; i < shown.length; i++) if (shown[i].id === id) return lbShow(i);
}

function lbStep(ev, by) {
  if (ev) ev.stopPropagation();
  if (!shown.length) return;
  lbShow((at + by + shown.length) % shown.length);
}

function lbClose(ev, force) {
  // Only the backdrop closes it. Clicking the picture does not, or every
  // attempt to look closely at a liner shuts the thing being looked at.
  if (force || !ev || ev.target.id === 'lb') {
    document.getElementById('lb').classList.remove('on');
    document.getElementById('lbImg').removeAttribute('src');
  }
}

document.addEventListener('keydown', function (ev) {
  var box = document.getElementById('lb');
  if (!box.classList.contains('on')) return;
  if (ev.key === 'Escape') lbClose(null, true);
  else if (ev.key === 'ArrowRight') lbStep(null, 1);
  else if (ev.key === 'ArrowLeft') lbStep(null, -1);
});

document.getElementById('q').addEventListener('input', seekSoon);
boot();
</script>
</body>
</html>
