<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Track your order — Arabella Papers</title>
  <%# Outside the app shell on purpose: there is no session here, no sidebar
      and no logged-in user, so inheriting the shell would mean inheriting a
      navigation nobody on this page can use. %>
  <meta name="robots" content="noindex, nofollow">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <style>
    body { background:#f4f6f9; min-height:100vh; }
    .wrap { max-width: 620px; margin: 0 auto; padding: 32px 16px 64px; }
    .brand { letter-spacing:.18em; font-weight:700; color:#5A6E96; }
    .card-soft { border:0; border-radius:.75rem; box-shadow:0 2px 14px rgba(0,0,0,.07); }
    /* The line of steps. Done ones fill in; the rest stay outlined, so how
       far along it is readable at a glance without reading any words. */
    .steps { list-style:none; margin:0; padding:0; }
    .steps li { display:flex; align-items:flex-start; gap:14px; padding:10px 0; }
    .dot { width:26px; height:26px; border-radius:50%; flex:0 0 26px;
           display:flex; align-items:center; justify-content:center;
           border:2px solid #ced4da; color:#adb5bd; font-size:.75rem; background:#fff; }
    .steps li.done .dot { background:#198754; border-color:#198754; color:#fff; }
    .steps li.done .txt { color:#146c43; font-weight:600; }
    .txt { color:#6c757d; padding-top:2px; }
    .rail { width:2px; background:#e9ecef; margin-left:12px; height:12px; }
    .steps li.done + .rail { background:#198754; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="text-center mb-4">
      <div class="brand h5 mb-1">ARABELLA PAPERS</div>
      <div class="text-muted small">Track your order</div>
    </div>

    <div class="card card-soft mb-3">
      <div class="card-body">
        <label class="form-label fw-bold text-dark" for="t_id">Order number</label>
        <div class="input-group">
          <input type="text" class="form-control" id="t_id" placeholder="e.g. K-160437"
                 value="<%= orderId %>" autocomplete="off" inputmode="text">
          <button class="btn btn-dark px-4" id="t_go" onclick="t_look()">
            <i class="fas fa-magnifying-glass me-1"></i>Check
          </button>
        </div>
        <div class="form-text">It is on the confirmation you were sent.</div>
      </div>
    </div>

    <div id="t_out"></div>
  </div>

<script>
var t_esc = v => String(v == null ? '' : v)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function t_msg(kind, text) {
  document.getElementById('t_out').innerHTML =
    '<div class="alert alert-' + kind + ' card-soft">' + t_esc(text) + '</div>';
}

function t_render(d) {
  // Cancelled is said on its own rather than drawn as a half-finished line:
  // showing two green ticks and a dead end would read as "still coming".
  if (d.cancelled) {
    document.getElementById('t_out').innerHTML =
      '<div class="card card-soft"><div class="card-body">'
      + '<div class="h5 mb-1">' + t_esc(d.orderId) + '</div>'
      + (d.client ? '<div class="text-muted mb-3">' + t_esc(d.client) + '</div>' : '')
      + '<div class="alert alert-secondary mb-0">This order was cancelled. '
      + 'Please speak to the person you ordered through.</div>'
      + '</div></div>';
    return;
  }

  var steps = d.steps.map(function (s, i) {
    return '<li class="' + (s.done ? 'done' : '') + '">'
      + '<span class="dot">' + (s.done ? '<i class="fas fa-check"></i>' : (i + 1)) + '</span>'
      + '<span class="txt">' + t_esc(s.label) + '</span></li>'
      + (i < d.steps.length - 1 ? '<div class="rail"></div>' : '');
  }).join('');

  var courier = '';
  if (d.docket || d.courier) {
    courier = '<div class="mt-3 pt-3 border-top small">'
      + '<div class="text-muted">Sent by ' + t_esc(d.courier || 'courier')
      + (d.dispatchedOn ? ' on ' + t_esc(d.dispatchedOn) : '') + '</div>'
      + (d.docket ? '<div class="fw-bold">Tracking number: ' + t_esc(d.docket) + '</div>' : '')
      + '</div>';
  }

  document.getElementById('t_out').innerHTML =
    '<div class="card card-soft"><div class="card-body">'
    + '<div class="h5 mb-1">' + t_esc(d.orderId) + '</div>'
    + (d.client ? '<div class="text-muted mb-1">' + t_esc(d.client) + '</div>' : '')
    + (d.placed ? '<div class="text-muted small mb-3">Placed ' + t_esc(d.placed) + '</div>' : '')
    + '<ul class="steps">' + steps + '</ul>'
    + courier
    + '</div></div>';
}

async function t_look() {
  var id = document.getElementById('t_id').value.trim();
  if (!id) { t_msg('warning', 'Please enter your order number.'); return; }

  var btn = document.getElementById('t_go');
  btn.disabled = true;
  t_msg('light', 'Looking it up...');
  try {
    var res = await fetch('/track/api/' + encodeURIComponent(id));
    var json = await res.json();
    if (!json.success) { t_msg('warning', json.error || 'Could not find that order.'); return; }
    t_render(json.data);
  } catch (e) {
    t_msg('danger', 'Could not reach us just now. Please try again in a moment.');
  } finally {
    btn.disabled = false;
  }
}

document.getElementById('t_id').addEventListener('keydown', function (e) {
  if (e.key === 'Enter') t_look();
});

// A link can carry the number - /track?order=K-160437 - so the office can
// send somebody straight to their own order without them typing anything.
if (document.getElementById('t_id').value.trim()) t_look();
</script>
</body>
</html>
