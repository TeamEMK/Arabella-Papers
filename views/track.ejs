<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Track your order — Arabella Papers</title>
  <meta name="robots" content="noindex, nofollow">
  <%# Same dark and gold as the catalogue: the client sends both links to the
      same people, and two pages in two different liveries read as two
      different companies. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <style>
    :root {
      --void: #15171a; --panel: #121417;
      --gold: #c99a3b; --gold-lit: #d8ad55;
      --dim: #8a8578; --hair: rgba(201,154,59,.22);
      --paper: #f7f4ed;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--void); color: #e8e4da; min-height: 100vh;
      font-family: Jost, 'Segoe UI', sans-serif; font-weight: 300;
      -webkit-font-smoothing: antialiased;
    }
    .serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .wrap { max-width: 760px; margin: 0 auto; padding: 56px 20px 100px; position: relative; }

    .photo { position: absolute; pointer-events: none; mix-blend-mode: screen;
             right: -90px; top: -40px; width: 460px; max-width: 70%; opacity: .4; z-index: 0; }
    .crest, .finder, .result { position: relative; z-index: 1; }

    .crest { text-align: center; margin-bottom: 40px; }
    .crest svg { color: var(--gold); width: 52px; height: 52px; }
    .crest h1 { font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 25px;
                letter-spacing: .24em; margin: 12px 0 0; color: #fff; text-indent: .24em; }
    .crest .papers { font-family: 'Cormorant Garamond', serif; font-size: 14px;
                     letter-spacing: .4em; color: #cfc9ba; text-indent: .4em; }
    .crest .eyebrow { font-size: 10.5px; letter-spacing: .34em; color: var(--gold);
                      text-transform: uppercase; margin-top: 18px; text-indent: .34em; }

    .finder { border: 1px solid var(--hair); background: rgba(255,255,255,.02);
              border-radius: 3px; padding: 26px 26px 24px; }
    .finder .row { display: flex; gap: 14px; flex-wrap: wrap; }
    .fld { flex: 1 1 220px; }
    .fld label { display: block; font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase;
                 color: var(--gold); margin-bottom: 8px; text-indent: .22em; }
    .fld input {
      width: 100%; padding: 13px 15px; border: 1px solid rgba(255,255,255,.1);
      background: rgba(21,23,26,.8); color: #efebe1; border-radius: 2px;
      font-family: Jost, sans-serif; font-weight: 300; font-size: 14px; outline: 0;
    }
    .fld input::placeholder { color: #5f5b53; }
    .fld input:focus { border-color: var(--gold); }
    .go {
      margin-top: 18px; width: 100%; border: 0; border-radius: 40px; padding: 14px;
      background: var(--gold); color: #17181b; font-family: Jost, sans-serif;
      font-weight: 500; font-size: 11.5px; letter-spacing: .22em; text-transform: uppercase;
      cursor: pointer; transition: filter .18s;
    }
    .go:hover { filter: brightness(1.1); }
    .go:disabled { opacity: .55; cursor: default; }
    .hint { font-size: 12px; color: var(--dim); margin-top: 12px; text-align: center; }

    .result { margin-top: 30px; }
    .note { border: 1px solid var(--hair); border-radius: 3px; padding: 18px 20px;
            font-size: 14px; color: #e8e4da; background: rgba(255,255,255,.02); }
    .note.bad { border-color: rgba(224,138,138,.4); color: #e8b4b4; }

    .head { text-align: center; padding: 6px 0 26px; }
    .head .num { font-family: 'Cormorant Garamond', serif; font-size: 36px; color: #fff; }
    .head .who { color: var(--dim); font-size: 14px; margin-top: 4px; }
    .head .when { color: var(--dim); font-size: 12.5px; margin-top: 8px; letter-spacing: .06em; }

    .est { border: 1px solid var(--hair); border-radius: 3px; padding: 16px 20px;
           margin-bottom: 26px; display: flex; gap: 14px; align-items: flex-start;
           background: rgba(201,154,59,.06); font-size: 14px; line-height: 1.6; }
    .est i { color: var(--gold); margin-top: 3px; }
    .est.late { background: rgba(224,138,138,.07); border-color: rgba(224,138,138,.35); }
    .est.late i { color: #e8b4b4; }

    .band { font-size: 9.5px; letter-spacing: .26em; text-transform: uppercase;
            color: var(--dim); margin: 26px 0 12px; text-indent: .26em;
            display: flex; align-items: center; gap: 14px; }
    .band::after { content: ''; flex: 1; height: 1px; background: var(--hair); }

    /* Each step is a dot on a rail. Done fills, skipped is hollow and dim,
       the one in hand is ringed, and what has not been reached stays faint -
       so how far along it is reads before any word does. */
    .steps { list-style: none; margin: 0; padding: 0; }
    .steps li { display: flex; gap: 16px; align-items: flex-start; position: relative; padding-bottom: 18px; }
    .steps li::before {
      content: ''; position: absolute; left: 10px; top: 22px; bottom: 0; width: 1px;
      background: rgba(255,255,255,.1);
    }
    .steps li:last-child::before { display: none; }
    .dot { width: 21px; height: 21px; flex: 0 0 21px; border-radius: 50%; margin-top: 1px;
           border: 1px solid rgba(255,255,255,.18); display: flex; align-items: center;
           justify-content: center; font-size: 9px; color: transparent; background: var(--void); }
    li.done .dot { background: var(--gold); border-color: var(--gold); color: #17181b; }
    li.doing .dot { border-color: var(--gold); color: var(--gold); box-shadow: 0 0 0 3px rgba(201,154,59,.18); }
    li.skipped .dot { border-style: dashed; }
    .what { flex: 1; min-width: 0; }
    .what .name { font-size: 14.5px; color: #e8e4da; }
    li.waiting .what .name, li.skipped .what .name { color: #6f6a5f; }
    li.done .what .name { color: #fff; }
    .what .sub { font-size: 11.5px; color: var(--dim); margin-top: 3px; letter-spacing: .04em; }
    .when2 { font-size: 11.5px; color: var(--dim); white-space: nowrap; margin-top: 2px; }

    .ship { margin-top: 26px; border: 1px solid var(--hair); border-radius: 3px; padding: 18px 20px; }
    .ship .k { font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--gold); }
    .ship .v { font-size: 16px; color: #fff; margin-top: 5px; font-family: 'Cormorant Garamond', serif; }

    .foot { text-align: center; margin-top: 42px; font-size: 9.5px; letter-spacing: .3em;
            color: #55514a; line-height: 2.2; text-indent: .3em; }
    @media (max-width: 640px) {
      .wrap { padding: 34px 16px 80px; }
      .photo { display: none; }
      .head .num { font-size: 28px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <img class="photo" src="/ornament/seal.jpg" alt="" onerror="this.remove()">

    <div class="crest">
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
        <circle cx="32" cy="32" r="5.5"/>
        <circle cx="32" cy="32" r="14.5" stroke-opacity=".5"/>
        <circle cx="32" cy="32" r="21" stroke-opacity=".28"/>
        <path d="M32 10c3.6 4.2 3.6 9.3 0 13.5-3.6-4.2-3.6-9.3 0-13.5zM32 54c-3.6-4.2-3.6-9.3 0-13.5 3.6 4.2 3.6 9.3 0 13.5zM10 32c4.2-3.6 9.3-3.6 13.5 0-4.2 3.6-9.3 3.6-13.5 0zM54 32c-4.2 3.6-9.3 3.6-13.5 0 4.2-3.6 9.3-3.6 13.5 0z"/>
      </svg>
      <h1 class="serif">ARABELLA</h1>
      <div class="papers">PAPERS</div>
      <div class="eyebrow">Track your order</div>
    </div>

    <div class="finder">
      <div class="row">
        <div class="fld">
          <label for="t_name">Name on the order</label>
          <input type="text" id="t_name" value="<%= name %>" placeholder="e.g. Sarah Mitchell" autocomplete="name">
        </div>
        <div class="fld">
          <label for="t_id">Order number</label>
          <input type="text" id="t_id" value="<%= orderId %>" placeholder="e.g. K-160437" autocomplete="off">
        </div>
      </div>
      <button class="go" id="t_go" onclick="t_look()">Check my order</button>
      <div class="hint">Both are on the confirmation you were sent.</div>
    </div>

    <div class="result" id="t_out"></div>

    <div class="foot">FINE PAPERS &middot; TIMELESS CELEBRATIONS</div>
  </div>

<script>
var esc = function (v) {
  return String(v == null ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
};

function t_note(kind, text) {
  document.getElementById('t_out').innerHTML =
    '<div class="note' + (kind === 'bad' ? ' bad' : '') + '">' + esc(text) + '</div>';
}

function t_steps(list) {
  return '<ul class="steps">' + list.map(function (s) {
    return '<li class="' + s.state + '">'
      + '<span class="dot">' + (s.state === 'done' ? '<i class="fas fa-check"></i>'
          : s.state === 'skipped' ? '&ndash;' : '') + '</span>'
      + '<span class="what"><span class="name">' + esc(s.label) + '</span>'
      + (s.note ? '<div class="sub">' + esc(s.note) + '</div>' : '') + '</span>'
      + (s.at ? '<span class="when2">' + esc(s.at) + '</span>' : '')
      + '</li>';
  }).join('') + '</ul>';
}

function t_render(d) {
  var head = '<div class="head">'
    + '<div class="num serif">' + esc(d.orderId) + '</div>'
    + (d.client ? '<div class="who">' + esc(d.client) + '</div>' : '')
    + (d.placed ? '<div class="when">Placed ' + esc(d.placed) + '</div>' : '')
    + '</div>';

  if (d.cancelled) {
    document.getElementById('t_out').innerHTML = head
      + '<div class="note">This order was cancelled. Please speak to the person you ordered through.</div>';
    return;
  }

  var est = '';
  if (d.estimate) {
    est = '<div class="est' + (d.estimate.kind === 'running-late' ? ' late' : '') + '">'
      + '<i class="fas fa-' + (d.estimate.kind === 'waiting-on-you' ? 'hourglass-half'
          : d.estimate.kind === 'running-late' ? 'triangle-exclamation' : 'truck-fast') + '"></i>'
      + '<div>' + esc(d.estimate.text) + '</div></div>';
  }

  var ship = '';
  if (d.docket || d.courier) {
    ship = '<div class="ship">'
      + '<div class="k">On its way</div>'
      + '<div class="v">' + esc(d.courier || 'Courier')
      + (d.dispatchedOn ? ' &middot; ' + esc(d.dispatchedOn) : '') + '</div>'
      + (d.docket ? '<div class="v">Tracking ' + esc(d.docket) + '</div>' : '')
      + '</div>';
  }

  document.getElementById('t_out').innerHTML = head + est
    + '<div class="band">Design</div>' + t_steps(d.before)
    + '<div class="band">In our workshop</div>' + t_steps(d.production)
    + '<div class="band">Dispatch</div>' + t_steps(d.after)
    + ship;
}

async function t_look() {
  var name = document.getElementById('t_name').value.trim();
  var id = document.getElementById('t_id').value.trim();
  if (!name) { t_note('bad', 'Please enter the name the order was placed in.'); return; }
  if (!id) { t_note('bad', 'Please enter your order number.'); return; }

  var btn = document.getElementById('t_go');
  var label = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Looking it up...';
  try {
    var json = await fetch('/track/api?order=' + encodeURIComponent(id)
      + '&name=' + encodeURIComponent(name)).then(function (r) { return r.json(); });
    if (!json.success) { t_note('bad', json.error || 'We could not find that.'); return; }
    t_render(json.data);
  } catch (e) {
    t_note('bad', 'Could not reach us just now. Please try again in a moment.');
  } finally {
    btn.disabled = false;
    btn.textContent = label;
  }
}

['t_name', 't_id'].forEach(function (id) {
  document.getElementById(id).addEventListener('keydown', function (e) {
    if (e.key === 'Enter') t_look();
  });
});

// A link can carry both - /track?name=Sarah&order=K-160437 - so the office
// can send somebody straight to their own order with nothing to type.
if (document.getElementById('t_id').value.trim() && document.getElementById('t_name').value.trim()) {
  t_look();
}
</script>
</body>
</html>
