<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Price your order — <%= brandLabel %></title>
<%#
  THE PUBLIC CALCULATOR

  One of two pages, one per brand. The brand is fixed by the link and the
  dropdown the module draws is hidden, so nobody sent the Arabella link can
  put themselves on the other price list.

  A name and an address are asked for before the calculator opens. It is a
  gate rather than a form at the bottom on purpose: asked afterwards, the
  people who already have their number walk away, and the office learns
  nothing about who was pricing what.
%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/<%= assets %>/css/pricing-calculator.css">
<style>
  /* ══════════════════════════════════════════════════════
     THE CALCULATOR, DRESSED LIKE THE ROOMS BESIDE IT
     ══════════════════════════════════════════════════════
     This page is one of three doors inside a customer's account, and the
     other two - the liner book and the design catalogue - are dark, gold
     and set in Cormorant. This one was cream and blush, so walking from
     one to the other read as leaving the shop and arriving somewhere
     else. The palette, the rail, the masthead and the hairlines below
     are the same ones those two pages use; the tokens are copied rather
     than imported because each of these pages is served on its own.

     THE WIDTH. The module ships with `#pricing { max-width: 1320px }`
     and this page used to add its own 1320 wrapper on top. On an office
     screen that left two empty columns either side of a form the office
     then had to scroll - so the cap is lifted here and the room is given
     its own measure, wide enough to use the glass and short enough that
     a line of small print is still readable.

     THE MODULE IS NOT EDITED. It is tokenised (--apc-*), so the dark
     skin is a handful of variables set on the one element it mounts in.
     Anything hard-coded in it - the white field backgrounds - is
     overridden here and nowhere else, so an updated module keeps working.
  */
  :root {
    --void: #15171a;
    --rail-bg: #121417;
    --gold: #c99a3b;
    --gold-lit: #d8ad55;
    --paper: #f7f4ed;
    --dim: #8a8578;
    --hair: rgba(201,162,39,.22);
    --rail: 286px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  html { background: var(--void); }
  body {
    background: var(--void); color: #e8e4da;
    font-family: Jost, 'Segoe UI', sans-serif; font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }
  .serif { font-family: 'Cormorant Garamond', Georgia, serif; }
  ::selection { background: var(--gold); color: #000; }

  /* ── the rail ─────────────────────────────────── */
  .rail {
    position: fixed; inset: 0 auto 0 0; width: var(--rail);
    background: var(--rail-bg); border-right: 1px solid rgba(201,154,59,.3);
    display: flex; flex-direction: column; z-index: 40;
    padding: 30px 26px 26px; overflow-y: auto; scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { width: 0; height: 0; }
  .mark {
    font-size: 1.45rem; letter-spacing: .22em; color: #fff; line-height: 1.25;
    text-indent: .22em; text-align: center;
  }
  .mark small {
    display: block; font-size: .62rem; letter-spacing: .4em;
    color: #cfc9ba; margin-top: 6px; text-indent: .4em;
  }
  .mark-rule { height: 1px; background: var(--hair); margin: 18px 6px 24px; }

  /* What this page is, in the rail rather than over the photograph. */
  .rail-eyebrow {
    font-size: .6rem; letter-spacing: .34em; color: var(--gold);
    text-transform: uppercase; text-indent: .34em; margin-bottom: 10px;
  }
  .rail-note {
    font-size: .76rem; line-height: 1.85; color: var(--dim); letter-spacing: .03em;
  }
  .rail-note b { color: #e8e4da; font-weight: 400; }
  .rail-steps { margin: 22px 0 0; padding: 0; list-style: none; }
  .rail-steps li {
    display: flex; gap: 12px; padding: 11px 0; border-top: 1px solid rgba(201,162,39,.12);
    font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: #d8d3c7;
  }
  .rail-steps li:last-child { border-bottom: 1px solid rgba(201,162,39,.12); }
  .rail-steps .n {
    flex: 0 0 auto; color: var(--gold); font-family: 'Cormorant Garamond', serif;
    font-size: .95rem; letter-spacing: 0;
  }
  .creed {
    margin-top: auto; padding-top: 26px; text-align: center; font-size: .58rem;
    letter-spacing: .3em; color: var(--dim); line-height: 2.3; text-indent: .3em;
  }
  .creed .sep { color: var(--gold); opacity: .6; display: block; margin-bottom: 8px; }

  /* ── the page ─────────────────────────────────── */
  .main { margin-left: var(--rail); min-height: 100vh; }
  .measure { max-width: 1560px; margin: 0 auto; padding: 0 46px 70px; }

  /* The suite, photographed, as a strip at the head - the same picture
     the page always opened with, but faded into the dark instead of
     sitting on cream. Nothing is written on it: small labels over
     leaves and ribbon are unreadable at the moment somebody is typing a
     quantity into them. */
  .band {
    position: relative; width: 100%; height: clamp(150px, 19vw, 260px);
    background: url('/ornament/suite-band.jpg') center/cover no-repeat #1b1e22;
  }
  .band::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(21,23,26,.25) 0%, rgba(21,23,26,.72) 58%, var(--void) 100%);
  }

  .masthead { padding: 34px 46px 26px; max-width: 1560px; margin: 0 auto; }
  .eyebrow {
    font-size: .68rem; letter-spacing: .42em; color: var(--gold);
    text-transform: uppercase; text-indent: .42em; margin-bottom: 14px;
    display: flex; align-items: center; gap: 18px;
  }
  .eyebrow i { flex: 0 0 86px; height: 1px; background: var(--gold); opacity: .55; }
  .masthead h1 {
    font-family: 'Cormorant Garamond', serif; font-weight: 400; margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.6rem); line-height: .98; color: #fff;
    letter-spacing: .05em; text-transform: uppercase;
  }
  .masthead .lede {
    margin: 16px 0 0; max-width: 54ch; color: var(--dim);
    font-size: .95rem; line-height: 1.75;
  }
  .underline { height: 1px; background: var(--gold); width: 92px; margin-top: 18px; opacity: .8; }
  .q-brand {
    display: inline-block; margin-top: 18px; padding: 6px 18px;
    border: 1px solid var(--hair); border-radius: 999px; color: var(--gold-lit);
    font-size: .6rem; letter-spacing: .24em; text-transform: uppercase;
    background: rgba(201,162,39,.06);
  }

  /* ── the gate ─────────────────────────────────── */
  .gate {
    display: flex; max-width: 900px; margin: 10px auto 0;
    background: #1b1e22; border: 1px solid var(--hair); border-radius: 3px;
    overflow: hidden; box-shadow: 0 30px 60px -40px #000;
  }
  /* THE hidden ATTRIBUTE IS ONLY display:none FROM THE BROWSER'S OWN
     STYLESHEET, and any author `display` beats it - so the gate stayed on
     screen above the calculator it had just opened. Said by class and
     attribute, which wins without an !important. */
  .gate[hidden] { display: none; }
  .gate-art {
    flex: 0 0 40%; min-height: 430px;
    background: url('/ornament/suite-tall.jpg') center/cover no-repeat #1b1e22;
    border-right: 1px solid var(--hair);
  }
  .gate-form { flex: 1 1 auto; padding: 38px 36px 32px; }
  .gate-form h2 {
    font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 1.75rem;
    letter-spacing: .05em; margin: 0 0 6px; color: #fff;
  }
  .gate-form > p { margin: 0 0 24px; color: var(--dim); font-size: .9rem; line-height: 1.7; }
  .gate-form label {
    display: block; font-size: .62rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--dim); margin-bottom: 7px;
  }
  .gate-form input {
    width: 100%; padding: 11px 2px; border: 0; border-bottom: 1px solid var(--hair);
    border-radius: 0; font: inherit; font-size: .95rem; margin-bottom: 20px;
    background: transparent; color: #f2efe7;
  }
  .gate-form input::placeholder { color: #6a655c; }
  .gate-form input:focus { outline: none; border-bottom-color: var(--gold); }
  .gate-form button {
    width: 100%; margin-top: 6px; padding: 14px; border: 1px solid var(--gold);
    border-radius: 2px; cursor: pointer; background: transparent; color: var(--gold-lit);
    font: inherit; font-size: .68rem; letter-spacing: .24em; text-transform: uppercase;
    transition: background .18s, color .18s;
  }
  .gate-form button:hover { background: rgba(201,162,39,.14); color: #fff; }
  .gate-form .err { color: #e08b8b; font-size: .85rem; margin: -12px 0 16px; display: none; }
  .gate-foot { margin: 18px 0 0; font-size: .7rem; letter-spacing: .06em; color: #6a655c; text-align: center; }

  /* ── who it is being priced for ────────────────── */
  .q-who {
    font-size: .72rem; letter-spacing: .18em; text-transform: uppercase;
    color: var(--dim); margin: 0 0 18px;
  }
  .q-who b { color: var(--gold-lit); font-weight: 400; }

  /* ── the module, in this room's clothes ────────── */
  #pricing {
    /* The module caps itself at 1320px and this page already has its own
       measure; left on, the form sat in a column with empty dark either
       side of it. */
    max-width: none; margin: 0;
    background: transparent; padding: 0;
  }
  /* THE MODULE PUTS ITS CLASSES ON THIS ELEMENT, NOT INSIDE IT.
     ArabellaPricing.mount() adds `apc apc-premium` to #pricing itself, so
     `#pricing .apc` - the obvious selector - matches nothing at all, and
     the page sat in its dark room with a white calculator in the middle
     of it. The variables go on #pricing, which is both the element and
     the ancestor, and custom properties inherit from there. */
  #pricing {
    --apc-ink: #ece8de;
    --apc-muted: #9d9688;
    --apc-page: transparent;
    --apc-sheet: #1b1e22;
    --apc-rule: rgba(201,162,39,.22);
    --apc-field-rule: rgba(201,162,39,.34);
    --apc-plum: #c99a3b;
    --apc-plum-tint: rgba(201,162,39,.14);
    --apc-focus: #d8ad55;
    --apc-warn-bg: rgba(201,162,39,.12); --apc-warn-ink: #d8ad55;
    --apc-error-bg: rgba(190,90,90,.16); --apc-error-ink: #e3a0a0;
    color: #ece8de;
    font-family: Jost, 'Segoe UI', sans-serif;
  }
  /* The module's premium skin writes its own light values on the same
     element; an id beats its two classes, so these win without an
     !important and the module file is never edited. */
  #pricing.apc.apc-premium { background: transparent; padding: 0 0 1rem; }
  #pricing .apc-panel {
    border-radius: 2px; border-color: var(--hair);
    box-shadow: 0 24px 50px -44px #000;
  }
  /* Hard-coded in the module: #fbfcfd fields and a white focus. On a dark
     panel that is a bright block with pale text in it. */
  #pricing input,
  #pricing select,
  #pricing textarea {
    background: #15181b; color: #f2efe7; border-radius: 2px;
  }
  #pricing input:focus,
  #pricing select:focus,
  #pricing textarea:focus {
    background: #15181b; border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,162,39,.18);
  }
  #pricing select option { background: #15181b; color: #f2efe7; }
  #pricing .apc-btn1 { color: #15171a; font-weight: 500; }
  #pricing .apc-btn1:hover { background: var(--gold-lit); }
  #pricing .apc-btn2 { background: transparent; }
  #pricing .apc-summary { background: #15181b; color: #f2efe7; }
  #pricing .apc-lines th { border-bottom-color: var(--hair); }
  #pricing .apc-wordmark { color: var(--gold); }
  /* The module draws a brand dropdown; the link already decided it. */
  #pricing [data-n="brand"] { display: none; }
  #pricing .apc-brand-hidden { display: none !important; }

  /* THE PAGE RAN OFF THE RIGHT-HAND EDGE.
     The module keeps two columns until the VIEWPORT is 1000px wide, and
     each column cannot go below about 420px of fields. With the rail at
     286 and the room's own padding, that needs around 1240px of window -
     so at 1200 the calculate button and the add-ons panel were cut off
     the side and the whole page scrolled sideways. The columns are
     stacked here while the room is narrow; the module is untouched.

     Also a floor on the whole thing: nothing may be wider than the room
     it is in, whatever a panel asks for. */
  #pricing, #pricing * { max-width: 100%; }
  @media (max-width: 1300px) {
    #pricing .apc-cols { grid-template-columns: minmax(0, 1fr); }
  }

  /* ── the two buttons under it ──────────────────── */
  .q-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .q-actions button {
    padding: 13px 34px; border-radius: 2px; border: 1px solid var(--gold);
    background: transparent; color: var(--gold-lit); font: inherit; font-size: .68rem;
    letter-spacing: .22em; text-transform: uppercase; cursor: pointer;
    transition: background .18s, color .18s;
  }
  .q-actions button.solid { background: var(--gold); color: #15171a; }
  .q-actions button.solid:hover { background: var(--gold-lit); border-color: var(--gold-lit); }
  .q-actions button:hover { background: rgba(201,162,39,.14); color: #fff; }
  .q-actions button[disabled] { opacity: .45; cursor: default; }

  .q-note { font-size: .85rem; color: var(--dim); margin-top: 18px; min-height: 21px; line-height: 1.6; }
  .q-note b { color: #e8e4da; font-weight: 400; }
  .q-note.bad { color: #e08b8b; }

  .foot {
    margin-left: var(--rail); padding: 0 46px 42px; color: var(--dim);
    font-size: .62rem; letter-spacing: .26em; text-transform: uppercase;
  }

  /* ── on a small screen ─────────────────────────── */
  @media (max-width: 900px) {
    :root { --rail: 0px; }
    .rail {
      position: static; width: auto; inset: auto; padding: 22px 18px;
      border-right: 0; border-bottom: 1px solid var(--hair);
    }
    /* The three steps and the creed are decoration, and on a phone they
       are decoration standing between somebody and the thing they opened
       the link for. The name and the one line of explanation stay. */
    .rail-steps, .creed { display: none; }
    .main, .foot { margin-left: 0; }
    .measure, .masthead { padding-left: 18px; padding-right: 18px; }
    .foot { padding-left: 18px; padding-right: 18px; }
    .band { height: 140px; }
    .gate { display: block; }
    .gate-art { display: none; }
    .gate-form { padding: 26px 22px 24px; }
  }
</style>
</head>
<body>
<%# Only inside the portal: served on its own, this page has nothing
    to go back to. portalHome is set by the mount in routes/clientPortal.js. %>
<% if (typeof portalHome !== 'undefined' && portalHome) { %>
<a href="<%= portalHome %>" style="
   position:fixed;top:0;left:0;right:0;z-index:999;display:block;
   background:rgba(16,18,21,.94);border-bottom:1px solid rgba(201,162,39,.28);
   color:#c99a3b;text-decoration:none;font-family:Jost,'Segoe UI',sans-serif;
   font-size:.62rem;letter-spacing:.26em;text-transform:uppercase;
   padding:9px 20px;backdrop-filter:blur(3px);">
  &lsaquo;&nbsp;&nbsp;Back to your account
</a>
<div style="height:34px;"></div>
<% } %>


<%# Ours while the gate is up. Once the calculator mounts, the build draws
    its own masthead and this gets out of the way - two headers on one page
    is one too many. %>
<%# The suite itself, photographed. Decorative only: nothing is written
    over it, because small grey labels on a photograph of leaves and
    ribbon are unreadable at exactly the moment somebody is typing a
    quantity. The paper is dressed here and at the foot; everything to
    be READ sits on plain cream between. %>
<aside class="rail">
  <div class="mark serif">Arabella Papers<small>Fine Stationery</small></div>
  <div class="mark-rule"></div>

  <div class="rail-eyebrow">Price estimate</div>
  <p class="rail-note">
    Choose the pieces for your suite and see a cost <b>straight away</b>.
    Nothing is ordered here &mdash; the estimate is emailed to you.
  </p>

  <ol class="rail-steps">
    <li><span class="n">I</span><span>Choose your pieces</span></li>
    <li><span class="n">II</span><span>Calculate the estimate</span></li>
    <li><span class="n">III</span><span>Emailed to you, with a PDF</span></li>
  </ol>

  <div class="creed">
    <span class="sep">&#10022;</span>
    Fine Papers<br>Timeless<br>Celebrations
  </div>
</aside>

<main class="main">
  <%# The suite, photographed, faded into the dark. Decorative only:
      nothing is written over it. %>
  <div class="band" role="presentation"></div>

  <header class="masthead" id="q_head">
    <div class="eyebrow"><i></i> Wedding stationery</div>
    <h1 class="serif">Price your suite</h1>
    <div class="underline"></div>
    <%# The one word that tells the two links apart. Both pages are signed
        Arabella Papers and look identical otherwise, so it is said once
        and only here. Nothing is in it on the Arabella link, where it
        would repeat the wordmark above it. %>
    <% if (brandPill) { %><div class="q-brand"><%= brandPill %></div><% } %>
    <p class="lede">Tell us the pieces and the quantities, and the estimate
      builds itself as you go. You can change anything and calculate again.</p>
  </header>

  <div class="measure">

    <%# One sheet: the suite down one side, the three questions down the
        other. The form alone in the middle of an empty page looked like a
        form on an empty page. %>
    <div class="gate" id="gate">
      <div class="gate-art" role="presentation"></div>
      <div class="gate-form">
        <h2 class="serif">Before we begin</h2>
        <p>Tell us who you are, and we will email your cost summary when you are done.</p>
        <label for="g_name">Your name</label>
        <input type="text" id="g_name" autocomplete="name" placeholder="e.g. Sarah Mitchell">
        <label for="g_email">Email</label>
        <input type="email" id="g_email" autocomplete="email" placeholder="you@example.com">
        <label for="g_store">Company <span style="text-transform:none;letter-spacing:0;">(optional)</span></label>
        <input type="text" id="g_store" autocomplete="organization" placeholder="Your shop or studio">
        <div class="err" id="g_err"></div>
        <button type="button" onclick="q_open()">Open the calculator</button>
        <p class="gate-foot">Your estimate is emailed to you. Nothing is ordered here.</p>
      </div>
    </div>

    <div id="calc" hidden>
      <p class="q-who">Pricing for <b id="q_whoName"></b> &middot; <span id="q_whoEmail"></span></p>
      <div id="pricing"></div>
      <div class="q-actions">
        <%# Download PDF was taken off both links at the office's request. The
            customer still gets the PDF - it is attached to the mail that goes
            out when they take the quote - and the module's own "Print or save
            as PDF" is still on the panel above for anyone who wants it on
            screen. %>
        <button type="button" class="solid" id="q_copy" onclick="q_send('copy', this)">Copy the quote</button>
      </div>
      <div class="q-note" id="q_note">Fill in your quantities, choose <b>Calculate estimate</b>,
        then press <b>Copy the quote</b> &mdash; it is copied for you and emailed
        with a PDF.</div>
    </div>

  </div>
</main>

<div class="foot">Fine Papers &nbsp;&middot;&nbsp; Timeless Celebrations</div>

<script src="/<%= assets %>/js/pricing-rates.js"></script>
<script src="/<%= assets %>/js/pricing-engine.js"></script>
<script src="/<%= assets %>/js/pricing-ui.js"></script>
<script>
// THE PAGE ASKS ITS OWN ADDRESS, NOT A FIXED ONE.
// It is served at two: on its own, and inside the client portal at
// /client/<brand>/... Hard-coded paths worked only at the first, so
// everything it fetches hangs off the address it was actually opened at.
var BASE = location.pathname.replace(/\/+$/, '');

(function () {
  var BRAND = <%- JSON.stringify(brandCode) %>;
  var SLUG = <%- JSON.stringify(brandSlug) %>;
  var WORDMARK = <%- JSON.stringify(wordmark) %>;
  var PAGE_TITLE = <%- JSON.stringify(pageTitle) %>;
  var who = null, lastQuote = null;

  // ALREADY SIGNED IN? THEN WE KNOW WHO THEY ARE.
  //
  // The three questions in front of this page are how the office learned
  // who was pricing what, back when it was a public address anybody could
  // open. Inside the client portal that is the account, so asking again is
  // asking a signed-in customer to introduce themselves - and whatever
  // they typed would be less trustworthy than the session they are sitting
  // in, because they could type anything.
  var KNOWN = <%- JSON.stringify(typeof portalWho !== 'undefined' ? portalWho : null) %>;

  // Opens the calculator for somebody we already know, with no gate in
  // front of it.
  function q_openKnown() {
    who = { name: KNOWN.name || KNOWN.email, email: KNOWN.email, store: KNOWN.company || '' };
    document.getElementById('q_whoName').textContent = who.name;
    document.getElementById('q_whoEmail').textContent = who.email;
    document.getElementById('gate').hidden = true;
    document.getElementById('q_head').hidden = true;
    document.getElementById('calc').hidden = false;
    mount();
  }

  window.q_open = function () {
    var name = (document.getElementById('g_name').value || '').trim();
    var email = (document.getElementById('g_email').value || '').trim();
    var store = (document.getElementById('g_store').value || '').trim();
    var err = document.getElementById('g_err');
    err.style.display = 'none';
    if (!name) { err.textContent = 'Please tell us your name.'; err.style.display = 'block'; return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      err.textContent = 'That email address does not look right.'; err.style.display = 'block'; return;
    }
    who = { name: name, email: email, store: store };
    document.getElementById('q_whoName').textContent = name;
    document.getElementById('q_whoEmail').textContent = email;
    document.getElementById('gate').hidden = true;
    document.getElementById('q_head').hidden = true;
    document.getElementById('calc').hidden = false;
    mount();
  };

  function mount() {
    ArabellaPricing.mount(document.getElementById('pricing'), {
      rates: window.ArabellaPricingRates,
      brand: BRAND,
      // The build's own customer mode, which drops the store name, both
      // discounts and the rush fee, and puts its masthead at the top. These
      // are the words from the mount call at the foot of the file the office
      // sent; they are passed through rather than reworded here.
      mode: 'customer',
      wordmark: WORDMARK,
      title: PAGE_TITLE,
      customer: who.name,
      onQuote: function (quote) { lastQuote = quote; q_note(''); },
    });

    // An older build still draws the brand dropdown; the newer one hides it
    // itself when the rates carry one brand. Either way the link has already
    // decided the price list, so the whole field goes - hiding only the
    // select would leave a floating "Brand" label above nothing.
    var sel = document.querySelector('#pricing [data-n="brand"]');
    if (sel) {
      sel.value = BRAND;
      var field = sel.closest('label') || sel.parentNode;
      if (field) field.classList.add('apc-brand-hidden');
    }
  }

  // The error state is a class rather than a colour written in here, so
  // the palette lives in one place - a hard-coded red survived two
  // restyles of this page before anybody noticed it had.
  function q_note(msg, bad) {
    var el = document.getElementById('q_note');
    el.innerHTML = msg || '';
    el.classList.toggle('bad', !!bad);
  }

  /** @returns {Promise<boolean>} whether it actually reached the clipboard */
  async function q_copyText(s) {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(s);
        return true;
      }
    } catch (e) { /* fall through to the old way */ }
    try {
      var ta = document.createElement('textarea');
      ta.value = s;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:-1000px;left:-1000px;';
      document.body.appendChild(ta);
      ta.select();
      var ok = document.execCommand('copy');
      ta.remove();
      return !!ok;
    } catch (e) { return false; }
  }

  // Whatever the browser allows, the words themselves are never withheld.
  function q_showText(s) {
    var box = document.getElementById('q_text');
    if (!box) {
      box = document.createElement('textarea');
      box.id = 'q_text';
      box.readOnly = true;
      box.style.cssText = 'width:100%;max-width:620px;margin:14px auto 0;display:block;'
        + 'height:190px;padding:12px;border:1px solid var(--line);border-radius:8px;'
        + 'font:13px/1.5 monospace;background:#fff;color:var(--ink);';
      document.getElementById('q_note').after(box);
    }
    box.value = s;
    box.select();
  }

  // Copy and Download do the same three things - price it on the server,
  // keep it, email it - and differ only in what happens with the answer.
  window.q_send = async function (what, btn) {
    if (!lastQuote) {
      q_note('Choose <b>Calculate quote</b> first, then this will be ready.', true);
      return;
    }
    // Whichever of them this page has. Listing a button that is not on the
    // page puts a null in here, and disabling a null throws - which lands in
    // the catch at the bottom and tells the customer "Something went wrong"
    // about a quote that was never attempted.
    var buttons = ['q_copy', 'q_pdf']
      .map(function (id) { return document.getElementById(id); })
      .filter(Boolean);
    buttons.forEach(function (b) { b.disabled = true; });
    q_note('One moment…');
    try {
      var res = await fetch(BASE + '/api/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: who.name, email: who.email, store: who.store,
          additionalDiscount: lastQuote.result.additionalDiscountPercent,
          rushFee: lastQuote.result.rushFeePercent || 0,
          items: lastQuote.order.items,
          totals: {
            total: lastQuote.result.total,
            balance: lastQuote.result.balance,
            baseDiscount: lastQuote.result.baseDiscountAmount,
            additionalDiscount: lastQuote.result.additionalDiscountAmount,
            rushFee: lastQuote.result.rushFeeAmount || 0,
          },
        }),
      });
      var json = await res.json();
      if (!json.success) { q_note(json.error || 'Something went wrong.', true); return; }

      if (what === 'pdf') {
        var bytes = atob(json.pdf);
        var buf = new Uint8Array(bytes.length);
        for (var i = 0; i < bytes.length; i++) buf[i] = bytes.charCodeAt(i);
        var url = URL.createObjectURL(new Blob([buf], { type: 'application/pdf' }));
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Arabella-Quote-' + json.id + '.pdf';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
      }

      // The clipboard refuses more often than it looks: a browser that has
      // not been given permission, a page that is not focused, anything not
      // on https. Its failure must not read as the quote having failed -
      // by this point the quote is priced, saved and emailed.
      var copied = true;
      if (what === 'copy') copied = await q_copyText(json.summary);

      q_note((json.emailed
        ? 'Done — a copy is on its way to <b>' + who.email + '</b>.'
        : 'Done. We could not email it just now, but you have it here.')
        + (copied === false
          ? ' Your browser would not let us copy it, so it is below to select.'
          : ''));
      if (copied === false) q_showText(json.summary);
    } catch (e) {
      q_note('Something went wrong. Please try again.', true);
    } finally {
      buttons.forEach(function (b) { b.disabled = false; });
    }
  };

  // On load, because there is nothing to ask somebody already signed in.
  if (KNOWN && KNOWN.email) q_openKnown();
})();
</script>
</body>
</html>
