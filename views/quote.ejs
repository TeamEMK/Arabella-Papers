<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Price your order — <%= brandLabel %></title>
<%#
  THE PUBLIC CALCULATOR

  One of two pages, one per brand. The brand is fixed by the link and the
  dropdown the module draws is hidden, so nobody sent the Arabella link can
  put themselves on the other price list.

  A name and an address are asked for before the calculator opens. It is a
  gate rather than a form at the bottom on purpose: asked afterwards, the
  people who already have their number walk away, and the office learns
  nothing about who was pricing what.
%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/<%= assets %>/css/pricing-calculator.css">
<style>
  /* ══════════════════════════════════════════════════════
     THE PUBLIC CALCULATOR — a wedding palette, on paper
     ══════════════════════════════════════════════════════
     The customer here is usually a bride or groom planning a wedding,
     not a buyer. So: blush, sage and champagne on warm cream, which is
     the stationery itself rather than a brand's dashboard.

     TEXT NEVER SITS ON THE PHOTOGRAPH. The two images are real
     flat-lays with leaves, ribbon and a wax seal in them, and small
     grey labels over that are unreadable at exactly the moment
     somebody is typing a quantity into them. So the paper is dressed
     at the top and the foot, and everything anybody has to READ sits
     on plain cream between.

     The pale values below are FILLS. Anything that has to be read uses
     --ink or --muted; the -deep colours are for rules and small
     accents, never for body text.
  */
  :root {
    --cream:#fdfbf7; --ivory:#f6f1e8;
    --ink:#3a3632; --muted:#6f6760;
    --blush:#e8d5d1; --blush-deep:#b8898a;
    --sage:#cfd8c8;  --sage-deep:#6f8064;
    --champagne:#e6d9c3; --gold:#a08a5e;
    /* The module's own primary, read out of its stylesheet
       (--apc-plum). Our buttons take it so the page reads as one thing:
       the loudest control on the screen is the module's CALCULATE
       ESTIMATE, and a sage-green button above it made the wrapper and
       the calculator look like two different companies. */
    --slate:#3e5576; --slate-deep:#32455f;
    --line:rgba(58,54,50,.13);
  }
  * { box-sizing:border-box; }
  /* The page does not always fill the window. Without this the browser's
     own white - or the module's cool grey - shows as a strip under the
     foot, which reads as the page having run out. */
  html { background:var(--cream); }
  body {
    margin:0; background:var(--cream); color:var(--ink);
    font-family:'Jost',system-ui,sans-serif; font-weight:300;
    -webkit-font-smoothing:antialiased;
  }
  .wrap { max-width:1320px; margin:0 auto; padding:0 16px 10px; }

  /* ── the suite across the top ──
     A real photograph, so nothing is written on it. 8:3 is the shape it
     was made in; the height follows the width rather than being pinned,
     so the flat-lay is never squashed. */
  header.q-head { text-align:center; padding:0 0 26px; }
  .q-band {
    width:100%; aspect-ratio:8/3; max-height:300px;
    background:url('/ornament/suite-band.jpg') center/cover no-repeat var(--ivory);
    border-bottom:1px solid var(--line);
  }
  .q-name {
    font-family:'Cormorant Garamond',serif; font-weight:400;
    font-size:34px; letter-spacing:.24em; text-indent:.24em;
    margin:26px 0 0; color:var(--ink);
  }
  .q-rule { width:84px; height:1px; background:var(--gold); opacity:.5; margin:14px auto 0; }
  .q-sub { font-size:11px; letter-spacing:.3em; color:var(--muted); margin-top:13px; }
  .q-brand {
    margin-top:16px; display:inline-block; border:1px solid var(--line);
    border-radius:999px; padding:5px 17px; font-size:10.5px; letter-spacing:.18em;
    color:var(--muted); background:var(--ivory);
  }

  /* ── the gate ──
     A sheet laid on the paper: a hairline and a whisper of shadow, no
     heavy border and no rounded-card look. Pastels plus big rounded
     boxes is what makes a page like this read as a greetings card. */
  .gate {
    display:flex; max-width:860px; margin:6px auto 0; background:#fff;
    border:1px solid var(--line); border-top:2px solid var(--blush);
    border-radius:3px; overflow:hidden;
    box-shadow:0 1px 2px rgba(58,54,50,.04), 0 14px 40px -28px rgba(58,54,50,.38);
  }
  /* The tall flat-lay, cropped to a column. Its composition puts the
     leaves at the head and the seal at the foot with bare paper between,
     so a tall narrow crop of it still reads. */
  .gate-art {
    flex:0 0 42%; min-height:430px;
    background:url('/ornament/suite-tall.jpg') center/cover no-repeat var(--ivory);
    border-right:1px solid var(--line);
  }
  .gate-form { flex:1 1 auto; padding:36px 34px 30px; }
  /* THE hidden ATTRIBUTE IS ONLY display:none FROM THE BROWSER'S OWN
     STYLESHEET, and any author `display` beats it. So the moment .gate got
     display:flex, q_open()'s `gate.hidden = true` stopped hiding anything
     and the gate sat on screen above the calculator it had just opened.
     The other pages never hit this because Bootstrap carries a
     [hidden]{display:none!important} of its own; this page does not load
     Bootstrap. Said here by class+attribute, which wins on specificity
     without an !important. */
  .gate[hidden] { display:none; }
  .gate-foot {
    margin:16px 0 0; font-size:11px; letter-spacing:.06em;
    color:#9b948c; text-align:center;
  }
  .gate-form h2 {
    font-family:'Cormorant Garamond',serif; font-weight:400; font-size:25px;
    letter-spacing:.04em; margin:0 0 5px;
  }
  .gate-form > p { margin:0 0 20px; color:var(--muted); font-size:13.5px; line-height:1.6; }
  .gate-form label {
    display:block; font-size:10px; letter-spacing:.16em; text-transform:uppercase;
    color:var(--muted); margin-bottom:6px;
  }
  .gate-form input {
    width:100%; padding:11px 2px; border:0; border-bottom:1px solid var(--line);
    border-radius:0; font:inherit; font-size:14.5px; margin-bottom:18px;
    background:transparent; color:var(--ink);
  }
  .gate-form input::placeholder { color:#b9b2aa; }
  .gate-form input:focus { outline:none; border-bottom-color:var(--slate); }
  .gate-form button {
    width:100%; margin-top:4px; padding:13px; border:0; border-radius:999px;
    cursor:pointer; background:var(--slate); color:#fff; font:inherit;
    font-size:11.5px; letter-spacing:.2em; text-transform:uppercase;
    transition:background .15s;
  }
  .gate-form button:hover { background:var(--slate-deep); }
  .gate-form .err { color:#a3484b; font-size:13px; margin:-10px 0 14px; display:none; }

  /* The module draws a brand dropdown; the link already decided it. */
  #pricing [data-n="brand"] { display:none; }
  #pricing .apc-brand-hidden { display:none !important; }

  /* The module's own panel is white. On cream that reads as a sheet
     laid down, so it is given the room and the edge to say so rather
     than being left to float. */
  #pricing {
    margin:6px 0 0; padding:4px; background:var(--ivory);
    border:1px solid var(--line); border-radius:3px;
    box-shadow:0 10px 34px -26px rgba(58,54,50,.45);
  }

  .q-who {
    text-align:center; font-size:12.5px; letter-spacing:.04em;
    color:var(--muted); margin:22px 0 18px;
  }
  .q-who b { color:var(--ink); font-weight:400; }
  .q-actions { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:22px; }
  .q-actions button {
    padding:12px 30px; border-radius:999px; border:1px solid var(--gold);
    background:transparent; color:var(--gold); font:inherit; font-size:11.5px;
    letter-spacing:.18em; text-transform:uppercase; cursor:pointer;
    transition:background .15s, color .15s;
  }
  .q-actions button.solid { background:var(--gold); color:#fff; }
  .q-actions button.solid:hover { background:#8d7850; border-color:#8d7850; }
  .q-actions button[disabled] { opacity:.45; cursor:default; }

  /* One line that is ordinary most of the time and an apology
     occasionally. The error state is a class the page adds: .bad */
  .q-note {
    text-align:center; font-size:13px; color:var(--muted);
    margin-top:16px; min-height:21px; line-height:1.5;
  }
  .q-note.bad { color:#a3484b; }

  /* ── the foot ──
     The same photograph, turned over, so the page is closed the way it
     was opened. Nothing is written on it either. */
  .q-bandfoot {
    width:100%; aspect-ratio:8/3; max-height:220px; margin-top:34px;
    background:url('/ornament/suite-band.jpg') center/cover no-repeat var(--ivory);
    transform:scaleX(-1); border-top:1px solid var(--line);
  }
  footer.q-foot {
    text-align:center; font-size:10px; letter-spacing:.26em; color:#9b948c;
    padding:22px 16px 26px; text-transform:uppercase; background:var(--cream);
  }

  /* ── on a phone ──
     The tall flat-lay was made for this shape: decoration at the top
     and the foot, bare paper down the middle. It becomes the page
     itself, and the two bands step aside rather than repeating it. */
  @media (max-width:760px) {
    body {
      background:url('/ornament/suite-tall.jpg') center top/cover no-repeat fixed var(--cream);
    }
    .q-band, .q-bandfoot { display:none; }
    header.q-head { padding-top:118px; }
    .q-name { font-size:26px; margin-top:0; }
    .wrap { padding-bottom:0; }
    .gate { display:block; max-width:440px; background:rgba(255,255,255,.93); backdrop-filter:blur(2px); }
    .gate-art { display:none; }
    .gate-form { padding:28px 24px 24px; }
    /* The tall photograph has leaves and a wax seal across its foot, and
       on a short page the footer line lands right on them. A plate of
       paper under it, rather than grey text over a photograph. */
    footer.q-foot {
      background:rgba(253,251,247,.9); backdrop-filter:blur(2px);
      padding:16px 16px 18px; margin-top:26px;
    }
  }
</style>
</head>
<body>

<%# Ours while the gate is up. Once the calculator mounts, the build draws
    its own masthead and this gets out of the way - two headers on one page
    is one too many. %>
<%# The suite itself, photographed. Decorative only: nothing is written
    over it, because small grey labels on a photograph of leaves and
    ribbon are unreadable at exactly the moment somebody is typing a
    quantity. The paper is dressed here and at the foot; everything to
    be READ sits on plain cream between. %>
<div class="q-band" role="presentation"></div>

<header class="q-head" id="q_head">
  <div class="q-name">ARABELLA PAPERS</div>
  <div class="q-rule"></div>
  <div class="q-sub">PRICE YOUR ORDER</div>
  <%# Only where it says something. On the Arabella link it would repeat
      the wordmark directly above it. %>
  <% if (brandPill) { %><div class="q-brand"><%= brandPill %></div><% } %>
</header>

<div class="wrap">

  <%# One sheet, laid on the paper: the suite down one side, the three
      questions down the other. The form on its own in the middle of an
      empty page looked like a form on an empty page. The picture is
      decoration and carries no text, and it steps aside on a phone -
      the page background there is already the same photograph. %>
  <div class="gate" id="gate">
    <div class="gate-art" role="presentation"></div>
    <div class="gate-form">
    <h2>Before we begin</h2>
    <p>Tell us who you are, and we will email your cost summary when you are done.</p>
    <label for="g_name">Your name</label>
    <input type="text" id="g_name" autocomplete="name" placeholder="e.g. Sarah Mitchell">
    <label for="g_email">Email</label>
    <input type="email" id="g_email" autocomplete="email" placeholder="you@example.com">
    <label for="g_store">Company <span style="text-transform:none;letter-spacing:0;">(optional)</span></label>
    <input type="text" id="g_store" autocomplete="organization" placeholder="Your shop or studio">
    <div class="err" id="g_err"></div>
    <button type="button" onclick="q_open()">Open the calculator</button>
    <p class="gate-foot">Your estimate is emailed to you. Nothing is ordered here.</p>
    </div>
  </div>

  <div id="calc" hidden>
    <p class="q-who">Pricing for <b id="q_whoName"></b> · <span id="q_whoEmail"></span></p>
    <div id="pricing"></div>
    <div class="q-actions">
      <%# Download PDF was taken off both links at the office's request. The
          customer still gets the PDF - it is attached to the mail that goes
          out when they take the quote - and the module's own "Print or save
          as PDF" is still on the panel above for anyone who wants it on
          screen. The server side of it is untouched, so putting the button
          back is one line. %>
      <button type="button" class="solid" id="q_copy" onclick="q_send('copy', this)">Copy the quote</button>
    </div>
    <div class="q-note" id="q_note">Fill in your quantities, choose <b>Calculate quote</b>, then take it away.</div>
  </div>

</div>

<%# The same photograph, turned over, so the page closes the way it
    opened. Also decorative; also carries no text. %>
<div class="q-bandfoot" role="presentation"></div>
<footer class="q-foot">Fine Papers &nbsp;·&nbsp; Timeless Celebrations</footer>

<script src="/<%= assets %>/js/pricing-rates.js"></script>
<script src="/<%= assets %>/js/pricing-engine.js"></script>
<script src="/<%= assets %>/js/pricing-ui.js"></script>
<script>
(function () {
  var BRAND = <%- JSON.stringify(brandCode) %>;
  var SLUG = <%- JSON.stringify(brandSlug) %>;
  var WORDMARK = <%- JSON.stringify(wordmark) %>;
  var PAGE_TITLE = <%- JSON.stringify(pageTitle) %>;
  var who = null, lastQuote = null;

  window.q_open = function () {
    var name = (document.getElementById('g_name').value || '').trim();
    var email = (document.getElementById('g_email').value || '').trim();
    var store = (document.getElementById('g_store').value || '').trim();
    var err = document.getElementById('g_err');
    err.style.display = 'none';
    if (!name) { err.textContent = 'Please tell us your name.'; err.style.display = 'block'; return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      err.textContent = 'That email address does not look right.'; err.style.display = 'block'; return;
    }
    who = { name: name, email: email, store: store };
    document.getElementById('q_whoName').textContent = name;
    document.getElementById('q_whoEmail').textContent = email;
    document.getElementById('gate').hidden = true;
    document.getElementById('q_head').hidden = true;
    document.getElementById('calc').hidden = false;
    mount();
  };

  function mount() {
    ArabellaPricing.mount(document.getElementById('pricing'), {
      rates: window.ArabellaPricingRates,
      brand: BRAND,
      // The build's own customer mode, which drops the store name, both
      // discounts and the rush fee, and puts its masthead at the top. These
      // are the words from the mount call at the foot of the file the office
      // sent; they are passed through rather than reworded here.
      mode: 'customer',
      wordmark: WORDMARK,
      title: PAGE_TITLE,
      customer: who.name,
      onQuote: function (quote) { lastQuote = quote; q_note(''); },
    });

    // An older build still draws the brand dropdown; the newer one hides it
    // itself when the rates carry one brand. Either way the link has already
    // decided the price list, so the whole field goes - hiding only the
    // select would leave a floating "Brand" label above nothing.
    var sel = document.querySelector('#pricing [data-n="brand"]');
    if (sel) {
      sel.value = BRAND;
      var field = sel.closest('label') || sel.parentNode;
      if (field) field.classList.add('apc-brand-hidden');
    }
  }

  // The error state is a class rather than a colour written in here, so
  // the palette lives in one place - a hard-coded red survived two
  // restyles of this page before anybody noticed it had.
  function q_note(msg, bad) {
    var el = document.getElementById('q_note');
    el.innerHTML = msg || '';
    el.classList.toggle('bad', !!bad);
  }

  /** @returns {Promise<boolean>} whether it actually reached the clipboard */
  async function q_copyText(s) {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(s);
        return true;
      }
    } catch (e) { /* fall through to the old way */ }
    try {
      var ta = document.createElement('textarea');
      ta.value = s;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:-1000px;left:-1000px;';
      document.body.appendChild(ta);
      ta.select();
      var ok = document.execCommand('copy');
      ta.remove();
      return !!ok;
    } catch (e) { return false; }
  }

  // Whatever the browser allows, the words themselves are never withheld.
  function q_showText(s) {
    var box = document.getElementById('q_text');
    if (!box) {
      box = document.createElement('textarea');
      box.id = 'q_text';
      box.readOnly = true;
      box.style.cssText = 'width:100%;max-width:620px;margin:14px auto 0;display:block;'
        + 'height:190px;padding:12px;border:1px solid var(--line);border-radius:8px;'
        + 'font:13px/1.5 monospace;background:#fff;color:var(--ink);';
      document.getElementById('q_note').after(box);
    }
    box.value = s;
    box.select();
  }

  // Copy and Download do the same three things - price it on the server,
  // keep it, email it - and differ only in what happens with the answer.
  window.q_send = async function (what, btn) {
    if (!lastQuote) {
      q_note('Choose <b>Calculate quote</b> first, then this will be ready.', true);
      return;
    }
    // Whichever of them this page has. Listing a button that is not on the
    // page puts a null in here, and disabling a null throws - which lands in
    // the catch at the bottom and tells the customer "Something went wrong"
    // about a quote that was never attempted.
    var buttons = ['q_copy', 'q_pdf']
      .map(function (id) { return document.getElementById(id); })
      .filter(Boolean);
    buttons.forEach(function (b) { b.disabled = true; });
    q_note('One moment…');
    try {
      var res = await fetch('/quote/' + SLUG + '/api/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: who.name, email: who.email, store: who.store,
          additionalDiscount: lastQuote.result.additionalDiscountPercent,
          rushFee: lastQuote.result.rushFeePercent || 0,
          items: lastQuote.order.items,
          totals: {
            total: lastQuote.result.total,
            balance: lastQuote.result.balance,
            baseDiscount: lastQuote.result.baseDiscountAmount,
            additionalDiscount: lastQuote.result.additionalDiscountAmount,
            rushFee: lastQuote.result.rushFeeAmount || 0,
          },
        }),
      });
      var json = await res.json();
      if (!json.success) { q_note(json.error || 'Something went wrong.', true); return; }

      if (what === 'pdf') {
        var bytes = atob(json.pdf);
        var buf = new Uint8Array(bytes.length);
        for (var i = 0; i < bytes.length; i++) buf[i] = bytes.charCodeAt(i);
        var url = URL.createObjectURL(new Blob([buf], { type: 'application/pdf' }));
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Arabella-Quote-' + json.id + '.pdf';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
      }

      // The clipboard refuses more often than it looks: a browser that has
      // not been given permission, a page that is not focused, anything not
      // on https. Its failure must not read as the quote having failed -
      // by this point the quote is priced, saved and emailed.
      var copied = true;
      if (what === 'copy') copied = await q_copyText(json.summary);

      q_note((json.emailed
        ? 'Done — a copy is on its way to <b>' + who.email + '</b>.'
        : 'Done. We could not email it just now, but you have it here.')
        + (copied === false
          ? ' Your browser would not let us copy it, so it is below to select.'
          : ''));
      if (copied === false) q_showText(json.summary);
    } catch (e) {
      q_note('Something went wrong. Please try again.', true);
    } finally {
      buttons.forEach(function (b) { b.disabled = false; });
    }
  };
})();
</script>
</body>
</html>
