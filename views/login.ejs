<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Arabella Paper - Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap");
    * { box-sizing: border-box; font-family: "Poppins", sans-serif; }
    body { margin: 0; padding: 0; min-height: 100vh; background: #1a1a2e; display: flex; justify-content: center; align-items: center; }
    .login-container {
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(10px);
      border-radius: 15px;
      padding: 30px;
      width: 350px;
      text-align: center;
      box-shadow: 0 8px 32px 0 rgba(0,0,0,0.3);
      animation: fadeIn 0.8s ease-in-out;
    }
    h2 { font-size: 24px; color: white; margin-bottom: 20px; }
    .input-group-custom { position: relative; margin-bottom: 20px; }
    .input-group-custom input {
      width: 100%; padding: 10px; outline: none;
      background: transparent; color: white; font-size: 16px;
      border: none; border-bottom: 1px solid rgba(255,255,255,0.3);
      transition: 0.3s;
    }
    .input-group-custom label {
      position: absolute; top: 10px; left: 0; color: white;
      font-size: 16px; pointer-events: none; transition: 0.3s;
    }
    .input-group-custom input:focus ~ label,
    .input-group-custom input:valid ~ label {
      top: -15px; font-size: 12px; color: #ffcc00;
    }
    .login-btn {
      width: 100%; padding: 10px; border: none;
      background: #ffcc00; color: black; font-size: 18px;
      border-radius: 25px; cursor: pointer;
      transition: 0.3s ease-in-out;
    }
    .login-btn:hover { background: #ffa500; transform: translateY(-2px); }
    .login-btn:disabled { opacity: 0.7; cursor: not-allowed; }
    .error-msg { color: #ff6347; font-size: 14px; margin-top: 10px; }
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }
    .logo { width: 80px; margin-bottom: 15px; border-radius: 8px; }
  </style>
</head>
<body>
  <div class="login-container">
    <img src="https://drive.google.com/thumbnail?id=1bTV0jEU5E8f0QeqBO8urDPa4BaCH1QsB" alt="Arabella Papers" class="logo"/>
    <h2>Login</h2>
    <form method="POST" action="/login" id="loginForm">
      <div class="input-group-custom">
        <input type="email" id="email" name="email" required autocomplete="email"/>
        <label for="email">Email</label>
      </div>
      <div class="input-group-custom">
        <input type="password" id="password" name="password" required autocomplete="current-password"/>
        <label for="password">Password</label>
      </div>
      <button type="submit" class="login-btn" id="loginBtn">Login</button>
      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>
    </form>
  </div>
  <script>
    document.getElementById('loginForm').addEventListener('submit', function() {
      const btn = document.getElementById('loginBtn');
      btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Verifying...';
      btn.disabled = true;
    });
  </script>
</body>
</html>
